<div class="sprout" style="--hue: 150;">
  <div class="min-h-screen w-full flex items-center justify-center relative" style="background: var(--bg); min-height: 100dvh;">
    <!-- Close button -->
    <% close_path = params[:returnto].presence || root_path %>
    <%= link_to close_path, class: "s-ctl absolute", style: "top: 24px; left: 16px; box-shadow: none;" do %>
      <svg class="w-6 h-6" fill="none" stroke="var(--muted)" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    <% end %>

    <!-- Sign in link -->
    <div class="absolute" style="top: 30px; right: 18px;">
      <% signin_params = params[:returnto].present? ? { returnto: params[:returnto] } : {} %>
      <%= link_to "SIGN IN", new_user_session_path(signin_params), class: "font-bold tracking-wide", style: "color: var(--accent);" %>
    </div>

    <!-- Forgot password form container -->
    <div class="w-full max-w-md px-6">
      <div class="text-center mb-8">
        <h1 class="s-h1" style="font-size: 30px;">Reset password</h1>
        <p class="s-small" style="margin-top: 6px;">Enter your email to receive reset instructions</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
        <% if params[:returnto].present? %>
          <%= hidden_field_tag :returnto, params[:returnto] %>
        <% end %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email address", class: "s-input" %>
        </div>

        <div>
          <%= f.submit "SEND RESET INSTRUCTIONS", class: "s-btn s-btn--full s-btn--lg" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <p class="s-small">
          Remember your password?
          <% signin_params = params[:returnto].present? ? { returnto: params[:returnto] } : {} %>
          <%= link_to "Sign in", new_user_session_path(signin_params), style: "color: var(--accent); font-weight: 700;" %>
        </p>
      </div>

      <div class="mt-8 text-center">
        <p class="s-small">
          By using Langlets, you agree to our
          <a href="#" style="color: var(--text); font-weight: 700;">Terms</a> and
          <a href="#" style="color: var(--text); font-weight: 700;">Privacy Policy</a>
        </p>
      </div>
    </div>
  </div>
</div>
