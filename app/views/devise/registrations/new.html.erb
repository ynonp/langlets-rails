<div class="min-h-screen w-full flex items-center justify-center relative bg-emerald-50 dark:bg-gray-950" style="min-height: 100dvh;">
  <!-- Close button -->
  <% close_path = params[:returnto].presence || root_path %>
  <%= link_to close_path, class: "absolute top-6 left-4 w-11 h-11 rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400" do %>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  <% end %>

  <!-- Log in link -->
  <div class="absolute top-[30px] right-[18px]">
    <% login_params = params[:returnto].present? ? { returnto: params[:returnto] } : {} %>
    <%= link_to "LOG IN", new_user_session_path(login_params), class: "font-bold tracking-wide text-emerald-600 dark:text-emerald-400" %>
  </div>

  <!-- Signup form container -->
  <div class="w-full max-w-md px-6">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-extrabold tracking-tight text-[30px]">Sign up</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <% if params[:returnto].present? %>
        <%= hidden_field_tag :returnto, params[:returnto] %>
      <% end %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: "w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-50 font-semibold placeholder-gray-400 dark:placeholder-gray-500 shadow-md transition-colors focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 dark:focus:ring-emerald-900/40" %>
      </div>

      <div>
        <%= f.password_field :password, autocomplete: "new-password",
            placeholder: "Password #{'(' + @minimum_password_length.to_s + ' characters minimum)' if @minimum_password_length}",
            class: "w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-50 font-semibold placeholder-gray-400 dark:placeholder-gray-500 shadow-md transition-colors focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 dark:focus:ring-emerald-900/40" %>
      </div>

      <div>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password", class: "w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-50 font-semibold placeholder-gray-400 dark:placeholder-gray-500 shadow-md transition-colors focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 dark:focus:ring-emerald-900/40" %>
      </div>

      <div>
        <%= f.submit "SIGN UP", class: "w-full inline-flex items-center justify-center gap-2 h-[58px] rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-base tracking-wide transition-colors cursor-pointer" %>
      </div>

      <div class="flex items-center gap-3 text-gray-400 dark:text-gray-600 font-bold text-xs tracking-wide before:content-[''] before:flex-1 before:h-px before:bg-gray-200 dark:before:bg-gray-700 after:content-[''] after:flex-1 after:h-px after:bg-gray-200 dark:after:bg-gray-700">OR</div>
    <% end %>

    <%= render "devise/shared/social_buttons" %>

    <!-- Terms and Privacy -->
    <div class="mt-8 text-center">
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">
        By signing up to Langlets, you agree to our
        <a href="#" class="text-gray-900 dark:text-gray-50 font-bold">Terms</a> and
        <a href="#" class="text-gray-900 dark:text-gray-50 font-bold">Privacy Policy</a>
      </p>
    </div>
  </div>
</div>
