<% 
  current_activity_order = params[:a].to_i
  current_activity_order = @activity.order if current_activity_order == 0 
%>

<div class="py-2 px-2 overflow-x-auto">
  <div class="flex items-center min-w-min">  
    <%= link_to @course_path, class: "text-white mr-4 p-2 rounded-md hover:bg-white hover:bg-opacity-10 transition-colors duration-200", title: "Back to Course", data: {turbo: "false"} do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
        <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 010-1.06l7.5-7.5a.75.75 0 111.06 1.06L9.31 12l6.97 6.97a.75.75 0 11-1.06 1.06l-7.5-7.5z" clip-rule="evenodd" />
      </svg>
    <% end %>

    <% @activities.each do |activity| %>
      <% 
        status = if activity.order < current_activity_order
                  "completed"
                elsif activity.order == current_activity_order
                  "current"
                else
                  "upcoming"
                end
      %>
      <div class="flex items-center">
        <a href="<%= lesson_path(@lesson.slug, a: activity.order) %>" 
           class="w-8 h-8 mx-2 rounded-full flex items-center justify-center font-bold no-underline relative z-10 transition-all duration-200 text-sm <%= case status
             when 'completed' then 'bg-green-500 text-white'
             when 'current' then 'bg-yellow-400 text-gray-900 shadow-lg ring-2 ring-yellow-400 ring-opacity-30'
             else 'bg-white border-2 border-dashed border-gray-300 text-gray-700'
           end %>" 
           aria-label="Activity <%= activity.order %>">
          <% if status == "completed" %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
            </svg>
          <% else %>
            <%= activity.order %>
          <% end %>
        </a>
      </div>
    <% end %>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .w-8.h-8 {
      width: 1.75rem !important;
      height: 1.75rem !important;
      font-size: 0.75rem !important;
    }
    
    .w-8 {
      width: 1.5rem !important;
    }
    
    .w-4.h-4 {
      width: 0.875rem !important;
      height: 0.875rem !important;
    }

    .w-5.h-5 {
      width: 1rem !important;
      height: 1rem !important;
    }
  }
</style> 