<% content_for :title, "Resync Timestamps" %>

<div class="min-h-screen bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50">
  <header class="py-6 border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <%= link_to courses_path, class: "text-2xl font-bold tracking-tight hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" do %>
        ← Langlets
      <% end %>
      <h1 class="text-xl font-semibold text-gray-500 dark:text-gray-400">Resync Timestamps</h1>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-md border border-gray-200 dark:border-gray-800 p-8">

      <div class="mb-8">
        <h2 class="text-3xl font-bold mb-2">Resync Phrase Timestamps</h2>
        <p class="text-gray-500 dark:text-gray-400">Upload a JSON or SRT file with corrected timestamps for a course's phrases.</p>
      </div>

      <% if flash[:alert] %>
        <div class="mb-6 p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-500/50 rounded-lg">
          <p class="text-red-600 dark:text-red-300"><%= flash[:alert] %></p>
        </div>
      <% end %>

      <%= form_with url: resync_timestamps_path, local: true, multipart: true, class: "space-y-6" do |form| %>

        <div>
          <%= form.label :course_slug, "Course Slug", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= form.text_field :course_slug,
                class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent",
                placeholder: "e.g., my-course-slug" %>
        </div>

        <div>
          <%= form.label :file, "JSON or SRT File", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= form.file_field :file,
                accept: ".json,.srt,application/json",
                class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent file:mr-4 file:py-1 file:px-4 file:rounded-lg file:border-0 file:bg-emerald-500 file:text-white file:font-semibold file:cursor-pointer hover:file:bg-emerald-600" %>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Upload a JSON or SRT file with fixed timestamps. Must match phrase count and order.</p>
        </div>

        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-300 dark:border-emerald-700/50 rounded-lg">
          <h3 class="text-emerald-700 dark:text-emerald-300 font-semibold mb-2">JSON / SRT File Format</h3>
          <p class="text-gray-500 dark:text-gray-400 text-sm mb-3">The file must contain exactly one entry per phrase, in the same order as the course phrases:</p>

          <h4 class="text-emerald-600 dark:text-emerald-400 font-medium text-sm mb-1">JSON</h4>
          <pre class="bg-gray-100 dark:bg-gray-800/60 p-3 rounded text-xs text-gray-600 dark:text-gray-300 overflow-x-auto mb-4">[
  { "text_l1": "Phrase text", "timestamp": "00:22.00" },
  { "text_l1": "Next phrase",  "timestamp": "00:24.00" }
]</pre>

          <h4 class="text-emerald-600 dark:text-emerald-400 font-medium text-sm mb-1">SRT</h4>
          <pre class="bg-gray-100 dark:bg-gray-800/60 p-3 rounded text-xs text-gray-600 dark:text-gray-300 overflow-x-auto">1
00:00:22,000 --&gt; 00:00:24,000
Phrase text

2
00:00:24,000 --&gt; 00:00:27,500
Next phrase</pre>
        </div>

        <div class="p-4 bg-yellow-100 dark:bg-yellow-900/30 border border-yellow-400 dark:border-yellow-500/50 rounded-lg">
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-600 dark:text-yellow-400 mr-3 mt-0.5 flex-shrink-0">
              <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="text-yellow-700 dark:text-yellow-400 font-semibold">Important</h4>
              <p class="text-yellow-700 dark:text-yellow-200 text-sm mt-1">
                The JSON array must have exactly the same number of objects as phrases in the course medium, and they must be in the same order (ordered by timestamp). The job runs in the background.
              </p>
            </div>
          </div>
        </div>

        <div class="flex justify-end space-x-4 pt-6">
          <%= link_to "Cancel", courses_path, class: "px-6 py-3 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-50 font-semibold transition-colors" %>
          <%= form.submit "Resync Timestamps",
                class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors cursor-pointer" %>
        </div>

      <% end %>
    </div>
  </main>
</div>
