<%# Expects params[:cards] - array of flashcard objects
    Each card: { id, phrase_html, translation, correct, options, audio_url }
%>

<%# Expects params[:token_translations] and prepares cards on the client side %>
<% token_translations = params[:token_translations] || [] %>
<% cards = prepare_flashcards_for_tokens(token_translations, params[:unique_words]) %>
<% l1_rtl = params[:l1_rtl] %>

<div data-controller="flashcard-activity" data-flashcard-activity-cards-value="<%= cards.to_json %>" data-flashcard-activity-l1-rtl-value="<%= l1_rtl %>" data-flashcard-activity-is-review-lesson-value="<%= params[:is_review_lesson] || false %>" class="flex-1 min-h-0 overflow-y-auto flex flex-col items-center bg-emerald-50 dark:bg-gray-950">
  <div class="w-full max-w-2xl p-6 bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-2xl shadow-md">
    <h2 class="text-2xl md:text-3xl text-gray-900 dark:text-gray-50 mb-2 font-bold"><%= @activity.text_header || "Flashcards" %></h2>

    <p data-flashcard-activity-target="progress" class="text-gray-500 dark:text-gray-400 mb-4">Question 1 of <%= cards.length %></p>

    <div data-flashcard-activity-target="card" dir="<%= l1_rtl ? 'rtl' : 'ltr' %>" class="bg-gray-100 dark:bg-gray-800 p-8 rounded-lg text-gray-900 dark:text-gray-50 flex flex-col justify-between min-h-[50dvh] <%= l1_rtl ? 'text-right' : 'text-left' %>">
    </div>


    <div data-flashcard-activity-target="completion" class="hidden mt-6 text-center" data-progress-tracker-target="completion">
      <h3 class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mb-4">Good Work!</h3>
      <%= link_to_next_activity "Next", @next_activity_path, { class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors" } %>
    </div>
  </div>
</div>

<style>
.option-button { cursor: pointer; width: 100%; }
.correct { background-color: rgba(34,197,94,0.2); }
.incorrect { background-color: rgba(239,68,68,0.2); }
</style>
