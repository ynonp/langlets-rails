<%
  container_class = local_assigns[:container_class] || ""
%>
<div
  id="main-player"
  data-main-video-player-target="playerContainer"
  data-action="loadedmetadata->main-video-player#setMediaRatio:capture"
  class="flex-shrink-0 sticky top-0 h-[clamp(160px,30vh,280px)] bg-black overflow-hidden <%= container_class %>"
>
    <%# Every provider gets the same vertical budget. Native portrait video is
        cropped around its upper-middle content; landscape video is contained
        after loadedmetadata reports its dimensions. %>
    <div data-main-video-player-target="media"
     class="relative flex h-full w-full items-center justify-center bg-cover bg-center bg-no-repeat [&_iframe]:h-full [&_iframe]:w-full [&_video]:h-full [&_video]:w-full [&_video]:object-cover [&_video]:[object-position:50%_30%] data-[ratio=landscape]:[&_video]:object-contain"
     style="<%= "background-image: url('#{j local_assigns[:thumbnail_url]}')".html_safe if local_assigns[:thumbnail_url].present? %>"
     role="img"
     aria-label="Video thumbnail">

      <%# No custom chrome here: the container is only ever visible when
          interactive_video_player is set, and that layout uses the provider's
          native controls. See docs/video-player.md. %>
      <div
          data-main-video-player-target="player"
          class="absolute inset-0 h-full w-full [&>iframe]:absolute [&>iframe]:inset-0 [&>iframe]:h-full [&>iframe]:w-full">
      </div>
    </div>
</div>
