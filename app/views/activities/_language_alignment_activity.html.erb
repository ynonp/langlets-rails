<%#
  Language alignment activity:
  1. User is presented with 1 translation (l2) phrase at the top with tokens marked in red
  2. User sees all original (l1) phrases below
  3. User has to click on the matching token in the original text for the highlighted token in the translation
  4. Every successful match the token in the original text is highlighted in green
  5. After all tokens in a phrase are matched, the next translation phrase is shown
  6. After all phrases are completed, the user is presented with a "Good Work!" banner and a "Next" button
%>

<% 
  phrases = params[:phrases] || []
  rtl = params[:rtl]  
  l1 = params[:l1]
  l2 = params[:l2]
  total_phrases = phrases.length
  
  phrases_with_all_tokens = phrases.filter_map do |phrase|
    {
      original_text: phrase[:text],
      translation: phrase[:translation],
      tokens: phrase[:tokens]
    } if phrase[:tokens].present?
  end
%>

<div class=" flex-col flex items-center bg-gray-800 h-[calc(100vh-160px)]" data-controller="find-words">
  <div class=" w-full max-w-[640px] p-4 sm:p-6 bg-gray-800 rounded-lg shadow-lg flex flex-col">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl text-white mb-2"><%= @activity.text_header || "Click on the words in the original text that match the highlighted words" %></h2>      
      <div class="w-full bg-gray-700 rounded-full h-2.5 mt-4">
        <div data-find-words-target="progressBar" id="progress" class="bg-green-500 h-2.5 rounded-full w-0 transition-all duration-500"></div>
      </div>
    </div>

    <%= render partial: 'activities/mini_video_player', locals: {params: params} %>

    <div id="language-alignment" class="flex flex-col gap-4 flex-1 min-h-0">
      <!-- Translation phrase at the top -->
      <div class="relative">
        <% phrases_with_all_tokens.each_with_index do |phrase, phrase_index| %>
          <div 
            class="translation-phrase px-4 py-4 border border-gray-700 rounded-lg bg-gray-800 text-white text-center text-base text-md md:text-xl <%= phrase_index == 0 ? '' : 'hidden' %>" 
            data-find-words-target="translationPhrase" 
            data-phrase-id="<%= phrase_index %>"
          >
            <% 
              # Build segments based on word boundaries for L2 text
              l2_words = phrase[:translation].scan(/\p{L}+(?:'\p{L}+)*/u)
              segments = []
              current_word_index = 0
              
              # Sort tokens by start position to process them in order
              sorted_tokens = phrase[:tokens].select { |t| t[:l2_start_index].present? && t[:l2_end_index].present? }
                                           .sort_by { |t| t[:l2_start_index] }
              
              sorted_tokens.each_with_index do |token, token_index|
                # Add words before the token
                while current_word_index < token[:l2_start_index]
                  segments << l2_words[current_word_index]
                  current_word_index += 1
                end
                
                # The token itself (get all words in this token)
                if token[:l2_start_index] <= current_word_index && current_word_index <= token[:l2_end_index]
                  token_words = l2_words[token[:l2_start_index]..token[:l2_end_index]]
                  segments << {
                    text: token_words.join(' '),
                    token_index: token_index
                  }
                  current_word_index = token[:l2_end_index] + 1
                end
              end
              
              # Add any remaining words after the last token
              while current_word_index < l2_words.length
                segments << l2_words[current_word_index]
                current_word_index += 1
              end
            %>
            
            <% segments.each do |segment| %>
              <% if segment.is_a?(String) %>
                <span class="regular-word"><%= segment.strip %></span>
              <% else %>
                <span class="text-red-400" data-token-id="<%= segment[:token_index] %>"><%= segment[:text].strip %></span>
              <% end %>
              <span class="word-separator"> </span>
            <% end %>
          </div>
        <% end %>

        <!-- Completion message now positioned to replace the translation phrase -->
        <div data-find-words-target="completionMessage" data-progress-tracker-target="completion" class="hidden translation-phrase p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="text-center sm:text-left text-xl font-bold text-white">Good Work!</h3>
            <p class="text-center sm:text-left text-gray-300">You've matched all the words correctly.</p>
          </div>
          <%= link_to_next_activity("Next", @next_activity_path, class: "w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center") %>
        </div>
      </div>

      <!-- Original phrases below -->
      <div class=" max-h-80 flex-1 space-y-3 bg-gray-900 rounded-t-lg overflow-y-auto" data-find-words-target="originalPhrasesContainer">
        <div class="text-center px-2 sm:px-4 py-2 bg-gray-700 text-white font-semibold rounded-t-lg text-xs sm:text-base sticky top-0 z-10">
          <%= l1 %> Original Phrases
        </div>
        
        <% phrases_with_all_tokens.each_with_index do |phrase, phrase_index| %>          
          <div
            dir="<%= rtl ? 'rtl' : 'ltr' %>"
            class="original-phrase px-2 sm:px-4 py-2 sm:py-3 rounded-lg bg-gray-900 hover:bg-gray-800 text-white sm:min-h-[72px] text-md md:text-xl transition-all duration-200" data-phrase-id="<%= phrase_index %>"
          >          
            <% 
              # Build segments based on word boundaries instead of character positions
              l1_words = phrase[:original_text].scan(/\p{L}+(?:'\p{L}+)*/u)
              segments = []
              current_word_index = 0
              
              # Sort tokens by start position to process them in order
              sorted_tokens = phrase[:tokens].sort_by { |t| t[:l1_start_index] }
              
              sorted_tokens.each_with_index do |token, token_index|
                # Add words before the token
                while current_word_index < token[:l1_start_index]
                  segments << l1_words[current_word_index]
                  current_word_index += 1
                end
                
                # The token itself (get all words in this token)
                if token[:l1_start_index] <= current_word_index && current_word_index <= token[:l1_end_index]
                  token_words = l1_words[token[:l1_start_index]..token[:l1_end_index]]
                  segments << {
                    text: token_words.join(' '),
                    token_index: token_index,
                    phrase_index: phrase_index,
                    audio_url: token[:audio_url],
                    word_indexes: (token[:l1_start_index]..token[:l1_end_index]).to_a
                  }
                  current_word_index = token[:l1_end_index] + 1
                end
              end
              
              # Add any remaining words after the last token
              while current_word_index < l1_words.length
                segments << l1_words[current_word_index]
                current_word_index += 1
              end
            %>
            
            <% segments.each do |segment| %>
              <% if segment.is_a?(String) %>
                <span class="regular-word"><%= segment.strip %></span>
              <% else %>
                <button 
                  class="token cursor-pointer" 
                  data-action="click->find-words#findToken" 
                  data-find-words-target="token" 
                  data-phrase-id="<%= segment[:phrase_index] %>" 
                  data-token-id="<%= segment[:token_index] %>" 
                  data-audio-url="<%= segment[:audio_url] %>"
                  data-word-indexes="<%= segment[:word_indexes].join(',') %>"
                  data-found="false"
                ><%= segment[:text].strip %></button>
              <% end %>
              <span class="word-separator"> </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out forwards;
  }

  @keyframes gentle-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  .animate-pulse {
    animation: gentle-pulse 0.5s ease-in-out;
  }

  .token {
    transition: all 0.3s ease;
  }

  .token:hover {
    text-decoration: underline;
  }
</style>
