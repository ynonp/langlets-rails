<% content_for :title, "Vocabulary · langlets." %>

<div class="app-scroll-pad px-5 pt-6 flex flex-col gap-5">
  <%= render "app/shared/header", title: t(".title") %>

  <%# The Dictionary. Typing here is the tab's main action: anything in the
      target language is explained in the native language, anything else is
      translated into the target language (DictionaryLookup). %>
  <%= render "app/dictionary_lookups/lookup_form", target_language: @target_language %>

  <section class="flex flex-col gap-1" aria-labelledby="your-words-heading">
    <div class="flex items-baseline justify-between gap-3 pb-1.5">
      <h2 id="your-words-heading" class="text-[17px] font-bold text-app-text">
        <%= t("app.dictionary.your_words") %>
        <span class="font-medium text-app-text-2">· <%= @total_count %></span>
      </h2>
      <%= link_to t("app.dictionary.add_from_sentence"), new_app_vocabulary_entry_path,
                  class: "text-[13px] font-semibold text-app-accent" %>
    </div>

    <% if @total_count.zero? %>
      <%= render "empty" %>
    <% else %>
      <turbo-frame id="vocabulary-results" class="flex flex-col gap-3">
        <% if @languages.many? || @paused_count.positive? %>
          <%= render "filters", filter: @filter, query: @query,
                     languages: @languages, paused_count: @paused_count %>
        <% end %>

        <% if @visible.empty? %>
          <div class="rounded-[20px] border border-dashed border-white/10 px-5 py-7 text-center">
            <p class="text-[16px] font-semibold text-app-text-dim"><%= t(".no_matches") %></p>
            <p class="mt-1.5 text-[14px] text-app-text-3"><%= t(".no_matches_hint") %></p>
          </div>
        <% else %>
          <div id="vocabulary-entries" class="flex flex-col">
            <% @visible.each do |entry| %>
              <%= render "entry", entry: entry, fresh: entry.id == flash[:saved_entry_id] %>
            <% end %>
          </div>
          <%= render "load_more", page: @page, has_more: @has_more,
                                  filter: @filter, query: @query %>
        <% end %>
      </turbo-frame>
    <% end %>
  </section>
</div>

<%= render "app/vocabulary_entries/toast" %>
