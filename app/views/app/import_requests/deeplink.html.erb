<div class="app-scroll-pad px-5 pt-6 flex flex-col gap-4">
  <%= render "app/shared/header", title: t("app.import_requests.new.title") %>
  <p class="text-app-text-2"><%= t("app.import_requests.status.in_progress", count: 1) %></p>
  <%= form_with url: app_import_requests_path, method: :post, data: { controller: "deeplink-import", turbo: false } do |form| %>
    <%= form.hidden_field :url, value: @video_url %>
    <%= form.hidden_field :deeplink, value: "1" %>
    <%= form.submit t("app.import_requests.new.title"), class: "text-app-accent" %>
  <% end %>
</div>
