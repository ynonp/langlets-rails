<% if @daily_vocab_language %>
  <%= link_to review_lessons_path(language_code: @daily_vocab_language),
                class: "w-full rounded-xl border border-white/10 bg-app-card p-3 text-left",
                data: { testid: "daily-vocab-banner", turbo: false } do %>
    <span class="flex items-center gap-2.5">
      <span class="text-xl" aria-hidden="true">📚</span>
      <span class="flex-1">
        <span class="block text-[15px] font-bold text-app-text"><%= t("app.home.index.daily_vocab.title") %></span>
        <span class="block text-[12px] text-app-text-2"><%= t("app.home.index.daily_vocab.body") %></span>
      </span>
      <span class="text-lg text-app-accent" aria-hidden="true">›</span>
    </span>
  <% end %>
<% end %>
