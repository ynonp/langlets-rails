<%# Home's Pro row: the upsell once the free tier has actually run out, and a
    plain statement of what the user has once they subscribe.

    The upsell only appears at zero credits. It used to render for every free
    account with a "you've used N of 3" meter, which meant an account with a
    balance in the hundreds got a full progress bar and a nag above everything
    else on Home — a CTA for a limit it had not reached. Credit balance, not the
    signup allowance, is what decides whether the next import is possible, so
    that is what gates the card.

    It sits directly under the header because at zero credits, running out is the
    one thing on this screen that stops the user doing anything new. The Pro
    state stays rendered rather than disappearing: a subscription the app never
    mentions again is a subscription people forget they are paying for, and then
    dispute. %>
<% if current_user.pro? %>
  <div class="flex items-center gap-3.5 rounded-app-hero px-4.5 py-4 bg-app-accent/[0.08] border border-app-accent/30">
    <div class="w-[38px] h-[38px] shrink-0 rounded-[11px] bg-app-accent text-app-on-accent flex items-center justify-center text-[17px] font-extrabold">
      l.
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-base font-bold">
        <%= t(".pro.title") %>
        <span class="ms-1.5 align-[2px] text-[11px] font-extrabold text-app-on-accent-sm bg-app-accent rounded-md px-[7px] py-0.5">
          <%= t(".pro.badge") %>
        </span>
      </p>
      <p class="mt-0.5 text-[13px] text-app-text-2"><%= t(".pro.body") %></p>
    </div>
  </div>

<%# Out of credits, no subscription: the only state where this is a real block
    rather than a nag. `credits?` is the same question the import path asks
    before it lets a paste through, so the card appears exactly when the next
    import would be refused. %>
<% elsif !current_user.credits? %>
  <%= link_to app_pro_path, data: { testid: "pro-upsell" },
              class: "block rounded-app-hero px-4.5 pt-4 pb-4 border border-app-accent/35 bg-gradient-to-br from-app-accent/[0.16] to-app-accent/[0.05]" do %>
    <div class="flex items-start gap-3.5">
      <div class="w-[38px] h-[38px] shrink-0 rounded-[11px] bg-app-accent text-app-on-accent flex items-center justify-center">
        <%= app_icon "bolt", class: "w-[19px] h-[19px]" %>
      </div>

      <div class="flex-1 min-w-0">
        <%# The headline is the ask, in full. The old one ("Go Pro — unlimited
            imports") named the product and left the user to work out what it
            was for; this names the thing they were just stopped from doing. %>
        <p class="text-[17px] font-extrabold leading-[1.25]"><%= t(".upsell.title") %></p>
        <p class="mt-1 text-[13px] text-app-text-2 leading-[1.4]">
          <%= t(".upsell.body", count: User::SIGNUP_CREDITS) %>
        </p>
      </div>
    </div>

    <%# A span, not a nested <a> or <button>: the whole card is already the link,
        and an interactive element inside one is invalid and unusable with a
        screen reader. It reads as the button it looks like because it is the
        only filled accent surface on the screen. %>
    <span class="mt-3.5 block rounded-full bg-app-accent text-app-on-accent text-center py-3 text-[15px] font-extrabold">
      <%= t(".upsell.cta") %>
    </span>
  <% end %>
<% end %>
