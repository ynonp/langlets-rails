<% content_for :head do %>
  <% youtube_video_id = @course.main_media_url.split("v=").last %>
  <% thumbnail_url = youtube_thumbnail_url(youtube_video_id) %>
  <% course_url = course_url(@course) %>
  
  <!-- Page title -->
  <title><%= @course.name %> - Langlets</title>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= course_url %>">
  <meta property="og:title" content="<%= @course.name %> - Langlets">
  <meta property="og:description" content="Learn <%= @course.name %> with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities.">
  <meta property="og:image" content="<%= thumbnail_url %>">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="og:site_name" content="Langlets">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="<%= course_url %>">
  <meta property="twitter:title" content="<%= @course.name %> - Langlets">
  <meta property="twitter:description" content="Learn <%= @course.name %> with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities.">
  <meta property="twitter:image" content="<%= thumbnail_url %>">
<% end %>


<!-- Top bar: Refined for clarity and presence -->
<header class="py-6 border-b border-slate-700/60">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-4">
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-100 tracking-tight flex-1">
      <%= @course.name %>
    </h1>
    <% if user_signed_in? %>
      <div class="relative group">
        <input type="checkbox" id="user-menu-toggle" class="hidden peer">
        <label for="user-menu-toggle" class="flex items-center cursor-pointer">
          <img src="<%= 'https://ui-avatars.com/api/?name=' + ERB::Util.url_encode(current_user.email) %>" alt="Avatar" class="w-10 h-10 rounded-full border-2 border-blue-500 shadow" />
        </label>
        <div class="absolute right-0 mt-2 w-40 bg-slate-800 border border-slate-700 rounded-lg shadow-lg opacity-0 invisible peer-checked:opacity-100 peer-checked:visible transition-all duration-150 z-50">
          <%= link_to "Logout",
            destroy_user_session_path,
            method: :delete,
            data: { turbo_method: :delete },
            class: "block px-4 py-3 text-slate-200 hover:bg-slate-700 rounded-lg transition-colors duration-150"
          %>
        </div>
      </div>
    <% else %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
        <span class="text-slate-300 text-sm sm:text-base hidden sm:block">Sign in now to not lose your progress</span>
        <div class="flex gap-2">
          <%= link_to "Sign up", new_user_registration_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-3 sm:px-5 py-2 rounded-lg transition-colors duration-200 text-sm sm:text-base" %>
          <%= link_to "Log in", new_user_session_path, class: "text-blue-400 hover:text-blue-600 font-semibold px-3 sm:px-5 py-2 rounded-lg transition-colors duration-200 text-sm sm:text-base" %>
        </div>
      </div>
    <% end %>
  </div>
</header>

<!-- Main content wrapper -->
<div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 pb-44 md:pb-44">
  <main class="flex flex-col lg:flex-row gap-8 lg:gap-12">
    <!-- Main lesson list area -->
    <div class="flex-1">
      <!-- Description text -->
      <p class="text-slate-400 text-lg mt-8 mb-2 leading-relaxed">
        Pick any lesson to begin learning. Each one breaks down a line of the song and teaches you something new.         
      </p>
      <p  class="text-slate-400 text-lg mb-8 leading-relaxed">
        Pro Tip: Practice 1 lesson every day to maximize spaced repetition effect.
      </p>

      <!-- Lessons list -->
      <div class="space-y-4">
        <% @lessons.each_with_index do |lesson, index| %>
          <div class="bg-slate-800/50 border border-slate-700/50 rounded-xl p-6 hover:bg-slate-800/70 transition-all duration-200 group <%= index == 0 ? 'ring-2 ring-blue-500/20 border-blue-500/30' : '' %>">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3 flex-1">
                <!-- Progress Icon -->
                <div class="flex-shrink-0">
                  <% if lesson.completed? %>
                    <!-- Completed lesson icon -->
                    <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                  <% elsif lesson.in_progress? %>
                    <!-- Partially completed lesson icon -->
                    <svg class="w-6 h-6 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                    </svg>
                  <% else %>
                    <!-- Not started lesson icon -->
                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10"></circle>
                    </svg>
                  <% end %>
                </div>
                
                <div>
                  <% if lesson.completed? %>
                    <%= link_to lesson do %>
                      <h3 class="text-xl font-semibold text-white group-hover:text-blue-300 transition-colors cursor-pointer">
                        <%= lesson.name %>
                      </h3>
                    <% end %>
                  <% else %>
                    <%= link_to "#{lesson_path(lesson.slug)}?a=#{lesson.next_activity_order}" do %>
                      <h3 class="text-xl font-semibold text-white group-hover:text-blue-300 transition-colors cursor-pointer">
                        <%= lesson.name %>
                      </h3>
                    <% end %>
                  <% end %>
                </div>
              </div>
              
              <% if lesson.completed? %>
                <%= link_to lesson, class: "ml-6 md:bg-slate-900 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-medium transition-all duration-200 flex items-center gap-2 group-hover:scale-105" do %>
                  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="hidden md:inline">Review</span>
                <% end %>
              <% else %>
                <%= link_to "#{lesson_path(lesson.slug)}?a=#{lesson.next_activity_order}", class: "ml-6 md:bg-slate-900 hover:bg-green-600 text-white px-6 py-3 rounded-lg font-medium transition-all duration-200 flex items-center gap-2 group-hover:scale-105" do %>
                  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="hidden md:inline">Start Lesson</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right sidebar with video -->
    <aside class="w-full lg:w-[400px] lg:sticky lg:top-8 self-start">
      <div class="bg-slate-800/70 rounded-xl p-6 backdrop-blur-md border border-slate-700/50 shadow-2xl">
        <!-- Play Song section -->
        <div class="mb-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white">Listen to the Full Song</h3>
            <span class="bg-slate-900 p-2 rounded-lg transition-colors">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </span>
          </div>
          
          <p class="text-slate-400 text-sm mb-4">
            You can listen to the full song anytime. After each lesson, come back here and replay the lyrics you've just learned — you'll understand more every time.
          </p>
        </div>

        <!-- Video player -->
        <% youtube_video_id = @course.main_media_url.split("v=").last %>
        <div class="aspect-video overflow-hidden rounded-lg shadow-xl shadow-black/30">
          <iframe class="w-full h-full" src="https://www.youtube.com/embed/<%= youtube_video_id %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </aside>
  </main>
</div>

    
    <footer class="bg-gray-800 border-t border-gray-700 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
          <div class="text-gray-400 text-sm">
            © <%= Date.current.year %> Langlets. All rights reserved.
          </div>
          <div class="flex space-x-6">
            <%= link_to "Privacy Policy", "/home/privacy", class: "text-gray-400 hover:text-white text-sm transition-colors duration-200" %>
            <%= link_to "Terms of Service", "/home/terms", class: "text-gray-400 hover:text-white text-sm transition-colors duration-200" %>
          </div>
        </div>
      </div>
    </footer>