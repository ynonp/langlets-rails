<% if playlists.any? %>
  <%= render layout: "shared/card_grid" do %>
    <% playlists.each do |playlist| %>
      <%= link_to playlist_path(playlist), class: "block bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md cursor-pointer flex flex-col h-full overflow-hidden p-0" do %>
        <% if playlist.cover_image_url %>
          <img src="<%= playlist.cover_image_url %>" alt="<%= playlist.name %>" class="w-full h-40 object-cover flex-shrink-0">
        <% else %>
          <div class="w-full h-40 flex-shrink-0 bg-gray-100 dark:bg-gray-800"></div>
        <% end %>

        <div class="p-4 flex flex-col flex-grow">
          <div class="flex-grow">
            <h3 class="text-lg font-extrabold tracking-tight mb-2"><%= playlist.name %></h3>
            <% if playlist.description.present? %>
              <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-3 line-clamp-2"><%= truncate(playlist.description, length: 80) %></p>
            <% end %>
            <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-3">
              <%= t("courses.playlists_grid.clip_count", count: playlist.visible_clip_count) %>
            </div>
          </div>
          <div class="inline-flex items-center justify-center h-14 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors w-full">Start Path</div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p class="px-2 text-gray-400 dark:text-gray-600">No courses available yet.</p>
<% end %>
