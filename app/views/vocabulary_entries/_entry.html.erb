<%# One saved word. Wider than the phone row, so it uses the space for the one
    thing the phone has to cut: the whole context phrase, with the saved span
    marked in place. `turbo_frame: "_top"` for the same reason as the native
    row — this sits inside the results frame the search and filters drive. %>
<%= link_to vocabulary_entry_path(entry.id),
            class: "group block rounded-2xl border border-[#DED4C2] bg-[#FFFDF8] px-6 py-5 transition hover:border-[#C4451C] #{'opacity-60' if entry.paused?}",
            data: { testid: "vocabulary-entry", turbo_frame: "_top" } do %>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <div class="min-w-0">
      <p class="text-xl font-extrabold tracking-[-0.01em] [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif]" dir="auto">
        <%= entry.word %>
      </p>
      <p class="mt-1 text-[15px] text-[#55503F]"><%= entry.translation %></p>
    </div>

    <div class="flex min-w-0 max-w-full items-center gap-3 overflow-hidden text-xs font-semibold text-[#8A8170]">
      <% if entry.paused? %>
        <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#EFE7D8] px-2.5 py-1 text-[#6B6152]">
          <span class="flex gap-[2px]" aria-hidden="true">
            <span class="block h-[9px] w-[2.5px] bg-[#6B6152]"></span>
            <span class="block h-[9px] w-[2.5px] bg-[#6B6152]"></span>
          </span>
          <%= t("app.vocabulary_entries.paused") %>
        </span>
      <% end %>
      <span class="shrink-0 uppercase tracking-[0.08em]"><%= localized_language_name(entry.source_language) %></span>
      <% if entry.source.present? %>
        <span class="h-1 w-1 shrink-0 rounded-full bg-[#CFC2AB]"></span>
        <span data-testid="vocabulary-entry-source"
              class="min-w-0 truncate normal-case tracking-normal"
              dir="auto"><%= entry.source %></span>
      <% end %>
    </div>
  </div>

  <p class="mt-3 break-words text-[15px] italic leading-relaxed text-[#716A5D]" dir="auto">
    <%= highlighted_vocabulary_context(entry, quoted: true,
                                       mark_class: "font-bold not-italic text-[#C4451C]") %>
  </p>
<% end %>
