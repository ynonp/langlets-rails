<%#
  Input locals:
    params = { video_id: "kJQP7kiw5Fk", start_timestamp: "00:40", end_timestamp: "01:00", phrases: [ { text: "Ya llevo un rato mirándote", translation: "I've been looking at you for a while now", tokens: [ { l1_start_index: 0, l1_end_index: 1, l2_start_index: 37, l2_end_index: 39 }, { l1_start_index: 3, l1_end_index: 7, l2_start_index: 0, l2_end_index: 8 }, { l1_start_index: 9, l1_end_index: 15, l2_start_index: 25, l2_end_index: 35 }, { l1_start_index: 17, l1_end_index: 25, l2_start_index: 10, l2_end_index: 23 } ] }, { text: "Tengo que bailar contigo hoy", translation: "I have to dance with you today", tokens: [ { l1_start_index: 0, l1_end_index: 8, l2_start_index: 0, l2_end_index: 8 }, { l1_start_index: 10, l1_end_index: 15, l2_start_index: 10, l2_end_index: 14 }, { l1_start_index: 17, l1_end_index: 23, l2_start_index: 16, l2_end_index: 23 }, { l1_start_index: 25, l1_end_index: 27, l2_start_index: 25, l2_end_index: 29 } ] }, { text: "Tu mirada ya estaba llamándome", translation: "Your gaze was already calling me", tokens: [ { l1_start_index: 0, l1_end_index: 8, l2_start_index: 0, l2_end_index: 8 }, { l1_start_index: 10, l1_end_index: 11, l2_start_index: 14, l2_end_index: 20 }, { l1_start_index: 13, l1_end_index: 18, l2_start_index: 10, l2_end_index: 12 }, { l1_start_index: 20, l1_end_index: 29, l2_start_index: 22, l2_end_index: 31 } ] }, { text: "Muéstrame el camino que yo voy", translation: "Show me the way that I go", tokens: [ { l1_start_index: 0, l1_end_index: 8, l2_start_index: 0, l2_end_index: 6 }, { l1_start_index: 10, l1_end_index: 11, l2_start_index: 8, l2_end_index: 10 }, { l1_start_index: 13, l1_end_index: 18, l2_start_index: 12, l2_end_index: 14 }, { l1_start_index: 20, l1_end_index: 22, l2_start_index: 16, l2_end_index: 19 }, { l1_start_index: 24, l1_end_index: 25, l2_start_index: 21, l2_end_index: 21 }, { l1_start_index: 27, l1_end_index: 29, l2_start_index: 23, l2_end_index: 24 } ] } ], l1: "es", l2: "en" }

  Language alignment activity:
  1. User is presented with 1 translation (l2) phrase at the top with tokens marked in red
  2. User sees all original (l1) phrases below
  3. User has to click on the matching token in the original text for the highlighted token in the translation
  4. Every successful match the token in the original text is highlighted in green
  5. After all tokens in a phrase are matched, the next translation phrase is shown
  6. After all phrases are completed, the user is presented with a "Good Work!" banner and a "Next" button
%>

<% 
  phrases = params[:phrases] || []
  l1 = params[:l1]
  l2 = params[:l2]
  total_phrases = phrases.length
  
  phrases_with_all_tokens = phrases.map do |phrase|
    {
      original_text: phrase[:text],
      translation: phrase[:translation],
      tokens: phrase[:tokens]
    }
  end
%>

<div class="flex-col flex items-center bg-gray-800" data-controller="find-words">
  <div class="w-full max-w-[640px] p-4 sm:p-6 bg-gray-800 rounded-lg shadow-lg">
    <div class="mb-6 text-center">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Language Alignment</h2>
      <p class="text-gray-400 text-sm sm:text-base">Click on the words in the original text that match the highlighted words</p>
      <p class="text-gray-400 text-sm sm:text-base mt-2">
        <span data-find-words-target="progressText">Phrase 1 of <%= total_phrases %></span>
      </p>
      <div class="w-full bg-gray-700 rounded-full h-2.5 mt-4">
        <div data-find-words-target="progressBar" id="progress" class="bg-green-500 h-2.5 rounded-full w-0 transition-all duration-500"></div>
      </div>
    </div>

    <%= render partial: 'activities/mini_video_player', locals: {params: params} %>

    <div id="language-alignment" class="flex flex-col gap-4">
      <!-- Translation phrase at the top -->
      <div class="relative">
        <% phrases_with_all_tokens.each_with_index do |phrase, phrase_index| %>
          <div 
            class="translation-phrase px-4 py-4 border border-gray-700 rounded-lg bg-gray-800 text-white text-center text-base sm:text-xl <%= phrase_index == 0 ? '' : 'hidden' %>" 
            data-find-words-target="translationPhrase" 
            data-phrase-id="<%= phrase_index %>"
          >
            <% 
              text = phrase[:translation]
              segments = []
              current_pos = 0
              
              # Sort tokens by start position to process them in order
              sorted_tokens = phrase[:tokens].sort_by { |t| t[:l2_start_index] }
              
              sorted_tokens.each_with_index do |token, token_index|
                # Text before the token
                if token[:l2_start_index] > current_pos
                  segments << text[current_pos...token[:l2_start_index]]
                end
                
                # The token itself
                token_text = text[token[:l2_start_index]..token[:l2_end_index]]
                segments << {
                  text: token_text,
                  token_index: token_index
                }
                
                current_pos = token[:l2_end_index] + 1
              end
              
              # Add any remaining text after the last token
              if current_pos < text.length
                segments << text[current_pos..-1]
              end
            %>
            
            <% segments.each do |segment| %>
              <% if segment.is_a?(String) %>
                <%= segment.strip %><%= segment.strip.empty? ? "" : "&nbsp;".html_safe %>
              <% else %>
                <span class="text-red-400" data-token-id="<%= segment[:token_index] %>"><%= segment[:text].strip %></span><%= "&nbsp;".html_safe %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <!-- Completion message now positioned to replace the translation phrase -->
        <div data-find-words-target="completionMessage" class="hidden translation-phrase p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="text-center sm:text-left text-xl font-bold text-white">Good Work!</h3>
            <p class="text-center sm:text-left text-gray-300">You've matched all the words correctly.</p>
          </div>
          <a href="<%= @next_activity_path %>" class="w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center">Next</a>
        </div>
      </div>

      <!-- Original phrases below -->
      <div class="space-y-3 bg-gray-900 rounded-t-lg ">
        <div class="text-center px-2 sm:px-4 py-2 bg-gray-700 text-white font-semibold rounded-t-lg text-xs sm:text-base">
          <%= l1 %> Original Phrases
        </div>
        
        <% phrases_with_all_tokens.each_with_index do |phrase, phrase_index| %>          
          <div class="original-phrase px-2 sm:px-4 py-2 sm:py-3 rounded-lg bg-gray-900 hover:bg-gray-800 text-white sm:min-h-[72px] text-xl transition-all duration-200" data-phrase-id="<%= phrase_index %>">          
            <% 
              text = phrase[:original_text]
              segments = []
              current_pos = 0
              
              # Sort tokens by start position to process them in order
              sorted_tokens = phrase[:tokens].sort_by { |t| t[:l1_start_index] }
              
              sorted_tokens.each_with_index do |token, token_index|
                # Text before the token
                if token[:l1_start_index] > current_pos
                  segments << text[current_pos...token[:l1_start_index]]
                end
                
                # The token itself
                token_text = text[token[:l1_start_index]..token[:l1_end_index]]
                segments << {
                  text: token_text,
                  token_index: token_index,
                  phrase_index: phrase_index
                }
                
                current_pos = token[:l1_end_index] + 1
              end
              
              # Add any remaining text after the last token
              if current_pos < text.length
                segments << text[current_pos..-1]
              end
            %>
            
            <% segments.each do |segment| %>
              <% if segment.is_a?(String) %>
                <%= segment.strip %><%= segment.strip.empty? ? "" : "&nbsp;".html_safe %>
              <% else %>
                <button 
                  class="token cursor-pointer" 
                  data-action="click->find-words#findToken" 
                  data-find-words-target="token" 
                  data-phrase-id="<%= segment[:phrase_index] %>" 
                  data-token-id="<%= segment[:token_index] %>" 
                  data-found="false"
                ><%= segment[:text].strip %></button><%= "&nbsp;".html_safe %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out forwards;
  }

  @keyframes gentle-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  .animate-pulse {
    animation: gentle-pulse 0.5s ease-in-out;
  }

  .token {
    transition: all 0.3s ease;
  }

  .token:hover {
    text-decoration: underline;
  }
</style>
