<%
    phrases = params[:phrases]
    l1_rtl = params[:l1_rtl]
    l2_rtl = params[:l2_rtl]
    font_size_class = (params[:l1_name] == 'ar-JO') ? 'text-3xl' : 'text-xl'

    timestamp_start = params[:start_timestamp]
    timestamp_end = params[:end_timestamp]
%>

<%= content_for :head do %>

<% end %>

<div
    class="contents"  
    data-controller="watch-video-activity"  
    data-main-video-player-target="videoListener videoSegment"
    data-action="
      video:play->main-video-player#fullPlayerStartPlayback
      video:stop->main-video-player#fullPlayerStopPlayback
      video:play->watch-video-activity#handleVideoStart
      video:end->watch-video-activity#handleVideoEnd
      video:stop->watch-video-activity#handleVideoPause
      video:progress->watch-video-activity#progress
    "
    data-show-player="true"
    data-segment-start="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
    data-segment-end="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
    data-watch-video-activity-current-text-line-class="bg-gray-700"
>
  <div class="contents">
    <div class="mb-2 text-center order-1">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2"><%= @activity.text_header %></h2>
      <p class="text-sm sm:text-base text-gray-400"><%= @activity.text_subheader %></p>
    </div>
    
    <!-- Control Bar -->
    <div
      class="px-4 order-4 my-4 pb-4 border-b border-gray-700 flex justify-between items-center">
      <label class="flex items-center text-white">
        <input
          checked="true"
          type="checkbox"
          data-watch-video-activity-target="showTranslation"
          data-action="change->watch-video-activity#toggleTranslation"
          class="mr-2">
        Translation
      </label>
      <a href="<%= @next_activity_path %>"
         data-watch-video-activity-target="startPracticeButton"
         class="hidden px-6 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200">
        Start Practice
      </a>
    </div>

    <!-- Phrases Container with scrolling -->
    <div
        data-controller="popover-translation"
        data-popover-translation-l1-language-value="<%= phrases.first&.l1&.english_name || 'Language' %>"
        id="phrases-container"
        data-watch-video-activity-target="container"
        data-action="scroll@document->popover-translation#hidePopup click@document->popover-translation#hidePopup"
        class="order-4 w-full mx-auto bg-gray-800 min-h-0 overflow-y-auto flex-1"                
        >
      <div
        id="phrases-list" 
        data-watch-video-activity-target="phrasesList"
        class="text-white text-sm sm:text-base"
      >
        <% phrases.each do |phrase| %>
        <div
          data-watch-video-activity-target="subtitles"
          data-action="click->main-video-player#seekToTimestamp"
          data-timestamp="<%= timestamp_to_seconds(phrase.timestamp) %>"  
          class="flex flex-col <%= l1_rtl ? 'items-end' : 'items-start' %>"
        >
<div
            class="px-4 py-3 transition-all duration-200">
            <div
              class="text-white text-xl md:text-xl"
              dir="<%= l1_rtl ? 'rtl' : 'ltr' %>"
            >
              <%= wrap_tokens_in_spans(phrase,
                                       {class: "cursor-pointer hover:bg-gray-600 rounded inline #{font_size_class}",
                                      data: {action: "click->popover-translation#showPopup" }}) %>
            </div>
            <div
              class="text-teal-400 mt-1 text-md md:text-xl" data-watch-video-activity-target="translation"
              dir="<%= l2_rtl ? 'rtl' : 'ltr' %>"
            >

              <%= phrase.text_l2 %>
            </div>
          </div>
        </div>
          
        <% end %>
      </div>
      <!-- Translation Popup -->
      <%= render partial: 'activities/translation_popup' %>
    </div>
  </div>

  <!-- preload audio files -->
</div>
