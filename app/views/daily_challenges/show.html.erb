<% content_for :title, t("daily_challenge.nav") %>
<div class="mx-auto max-w-4xl px-5 pt-8 pb-[max(7rem,env(safe-area-inset-bottom,1rem))]">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-extrabold"><%= t("daily_challenge.today_title") %></h1>
      <p class="mt-2 leading-relaxed"><%= t("daily_challenge.title") %></p>
    </div>
    <% if @challenge %>
      <details class="shrink-0" data-testid="daily-langlets-settings">
        <summary class="cursor-pointer list-none rounded-full p-3" aria-label="<%= t('daily_challenge.settings') %>" title="<%= t('daily_challenge.settings') %>">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 7h16M4 17h16" stroke-linecap="round" />
            <circle cx="9" cy="7" r="3" fill="currentColor" /><circle cx="15" cy="17" r="3" fill="currentColor" />
          </svg>
        </summary>
        <div class="absolute inset-x-5 z-10 mx-auto mt-3 max-w-4xl rounded-2xl <%= native_app? ? 'bg-app-sheet text-app-text' : 'bg-base-100' %> border border-current/20 p-5">
          <%= render "selection", destination: daily_challenge_path %>
        </div>
      </details>
    <% end %>
  </div>
  <% if flash[:alert] %><p role="alert" class="my-4 text-red-600"><%= flash[:alert] %></p><% end %>
  <% if @challenge.nil? %>
    <section role="region" aria-label="<%= t('daily_challenge.choose_languages') %>">
      <%= render "selection", destination: daily_challenge_path %>
    </section>
  <% elsif @current_quest.nil? %>
    <div data-testid="challenge-waiting">
      <% pending = @challenge.pending_quest %>
      <% if pending&.personalized? && pending.available_at <= Time.zone.now %>
        <p><%= t(pending.recommendation_state == "failed" ? "daily_challenge.recommendation.unavailable" : "daily_challenge.recommendation.preparing") %></p>
      <% else %>
        <p><%= t("daily_challenge.waiting_body", time: l(pending.available_at.in_time_zone(@challenge.time_zone), format: :long)) %></p>
      <% end %>
    </div>
  <% else %>
    <% quest = @current_quest %>
    <section id="day-<%= quest.day %>" class="scroll-mt-6" data-testid="quest-<%= quest.day %>">
      <% if quest.unlocked? %>
        <% if quest.quest.in?(%w[song story tiktok recommendation]) %>
          <% (quest.personalized? ? [quest.language] : @challenge.languages.order(:english_name)).each do |language| %>
            <% videos = quest.videos_for(language.iso_name, catalog: @catalog) %>
            <% unless quest.personalized? %><h2 class="mb-3 font-bold"><%= language.native_name %></h2><% end %>
            <div class="flex flex-col gap-5 mb-5">
              <% videos.each do |video| %>
                <article class="w-full overflow-hidden rounded-2xl border border-current/20" data-testid="daily-langlets-video">
                  <% thumbnail = video["thumbnail_url"].presence || VideoSource.derived_thumbnail_url(video.fetch("url")) %>
                  <% if thumbnail.present? %>
                    <%= image_tag thumbnail, alt: video.fetch("title"), loading: "lazy", class: "block w-full aspect-video object-cover" %>
                  <% else %>
                    <div class="aspect-video bg-current/10 flex items-center justify-center text-3xl" role="img" aria-label="<%= video.fetch('title') %>">▶</div>
                  <% end %>
                  <div class="p-4">
                    <%= button_to t("daily_challenge.import_video"), app_import_requests_path,
                      method: :post, params: { url: video.fetch("url"), daily_challenge_id: quest.id },
                      class: "block w-full rounded-full bg-app-accent text-app-on-accent px-6 py-3 text-center font-bold",
                      form: { data: { turbo: false } } %>
                  </div>
                </article>
              <% end %>
            </div>
            <% if videos.empty? %><p><%= t("daily_challenge.empty_catalog") %></p><% end %>
          <% end %>
        <% else %>
          <h2 class="text-xl font-bold"><%= t("daily_challenge.quests.#{quest.quest}.title") %></h2>
          <p class="my-4"><%= t("daily_challenge.quests.#{quest.quest}.body") %></p>
          <%= link_to t("daily_challenge.open_library"), (native_app? ? app_library_path : gallery_path), class: "underline font-bold" %>
          <% if quest.quest == "vocabulary" %>
            · <%= link_to t("daily_challenge.open_vocabulary"), (native_app? ? app_vocabulary_entries_path : vocabulary_entries_path), class: "underline font-bold" %>
          <% end %>
        <% end %>
      <% else %>
        <p><%= t("daily_challenge.locked", date: l(quest.available_at.in_time_zone(@challenge.time_zone), format: :long)) %></p>
      <% end %>
    </section>
  <% end %>
</div>
