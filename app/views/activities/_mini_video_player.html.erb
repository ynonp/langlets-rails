<div    
    class="mb-6 px-3 py-2 sm:px-4 sm:py-3 bg-gray-700 rounded-lg">
    <div class="flex items-center space-x-3">
      <button
        data-main-video-player-target="playButton"
        data-action="click->main-video-player#playSegment"
        data-main-video-player-segment-start-param="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
        data-main-video-player-segment-end-param="<%= timestamp_to_seconds(params[:end_timestamp]) %>"    

        class="text-white bg-blue-600 p-2 rounded-full hover:bg-blue-700 transition"
      >
        ▶
      </button>
      <button
        data-main-video-player-target="pauseButton"
        data-action="click->main-video-player#stopPlayback"
        data-main-video-player-segment-start-param="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
        data-main-video-player-segment-end-param="<%= timestamp_to_seconds(params[:end_timestamp]) %>"    

        class="text-white bg-blue-600 p-2 rounded-full hover:bg-blue-700 transition hidden"
      >
        ❚❚
      </button>
      <div class="flex-1 h-2 bg-gray-600 rounded-full cursor-pointer"
           data-main-video-player-target="progressBarContainer"
           data-action="click->video-player#seekToPosition">
        <div
            data-main-video-player-target="progressBar" id="audio-progress-bar" class="h-full bg-blue-500 rounded-full transition-all duration-100" style="width: 0%"></div>
      </div>
    </div>    
</div>


