<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab in the web accent, the rest in the secondary text colour —
     the Android counterpart of the iOS tab bar inheriting the global
     AccentColor (#1DC77C, the same value as the CSS color-app-accent token). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/app_accent" android:state_checked="true" />
    <item android:color="@color/app_text_secondary" />
</selector>
