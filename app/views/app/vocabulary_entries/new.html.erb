<% content_for :title, "Add a word · langlets." %>

<%# Frames 04 and 05, and they are deliberately one page rather than a wizard.
    The whole lesson this screen has to teach is that a saved word is a span
    inside a phrase — so the phrase is typed first, and the word is picked out
    of the saved phrase rather than typed again. Two screens would let someone
    finish the first and forget why. %>
<div class="app-scroll-pad flex min-h-dvh flex-col px-5 pt-4"
     data-controller="vocabulary-picker"
     data-vocabulary-picker-token-class-value="rounded-xl border border-white/10 bg-app-inset px-3.5 py-2.5 text-[17px] text-app-text-dim"
     data-vocabulary-picker-token-active-class-value="rounded-xl border border-app-accent bg-app-accent/15 px-3.5 py-2.5 text-[17px] font-bold text-app-accent">
  <div class="mb-5 flex items-center gap-3">
    <%= link_to app_vocabulary_entries_path,
                class: "flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-xl text-app-text-dim",
                aria: { label: t(".cancel") } do %>
      <%= app_icon "close", class: "h-4 w-4" %>
    <% end %>
    <h1 class="text-[17px] font-bold text-app-text"><%= t(".title") %></h1>
  </div>

  <h2 class="text-[26px] font-bold leading-tight tracking-[-0.5px] text-app-text"><%= t(".lead") %></h2>
  <p class="mt-2.5 text-[15px] leading-relaxed text-app-text-2"><%= t(".body") %></p>

  <% if @error.present? %>
    <p data-testid="vocabulary-add-error"
       class="mt-4 rounded-app-field border border-[#3a2229] px-4 py-3 text-[14px] font-semibold text-[#ff8189]">
      <%= @error %>
    </p>
  <% end %>

  <%= form_with url: app_vocabulary_entries_path, method: :post,
                data: { testid: "vocabulary-add-form" },
                class: "flex flex-1 flex-col" do |f| %>
    <section class="app-hairline mt-5 rounded-[18px] bg-app-card px-[18px] py-4">
      <div class="mb-2 flex items-center justify-between">
        <h3 class="text-[12px] uppercase tracking-[0.1em] text-app-text-2"><%= t(".phrase") %></h3>
        <button type="button" data-action="vocabulary-picker#editPhrase"
                data-vocabulary-picker-target="editButton"
                class="hidden text-[14px] font-bold text-app-accent"><%= t(".edit") %></button>
      </div>

      <%# Step one: the sentence, and what language it is in. %>
      <div data-vocabulary-picker-target="composer">
        <%= f.text_area :sentence, value: @sentence, rows: 3, dir: "auto",
                        placeholder: t(".phrase_placeholder"),
                        data: { vocabulary_picker_target: "sentence",
                                action: "input->vocabulary-picker#sentenceChanged" },
                        class: "w-full resize-none bg-transparent text-[20px] leading-snug text-app-text placeholder:text-app-text-3 outline-none" %>

        <div class="mt-3.5 flex flex-wrap gap-2.5">
          <% @language_choices.each_with_index do |language, index| %>
            <label class="cursor-pointer">
              <%= f.radio_button :language, language.iso_name,
                                 checked: (@language ? @language == language : index.zero?),
                                 class: "peer sr-only" %>
              <span class="block rounded-full bg-app-chip px-5 py-2.5 text-[15px] font-semibold text-app-text-dim peer-checked:bg-app-text peer-checked:text-app-bg">
                <%= localized_language_name(language) %>
              </span>
            </label>
          <% end %>
        </div>

        <button type="button" data-action="vocabulary-picker#savePhrase"
                data-vocabulary-picker-target="savePhraseButton"
                disabled
                class="mt-3.5 w-full rounded-app-field bg-app-segment px-4 py-[15px] text-[16px] font-bold text-app-text-3 enabled:bg-app-accent enabled:text-app-on-accent">
          <%= t(".save_phrase") %>
        </button>
      </div>

      <%# Step two: the saved phrase, one button per word. Tap one, or press and
          drag across several for a compound. %>
      <div data-vocabulary-picker-target="picker" class="hidden">
        <div data-vocabulary-picker-target="tokens" dir="auto"
             data-action="pointermove@window->vocabulary-picker#dragOver pointerup@window->vocabulary-picker#endDrag pointercancel@window->vocabulary-picker#endDrag"
             class="flex select-none flex-wrap gap-2 [touch-action:none]"></div>
        <%# Both hints live on the element so the strings stay in the locale
            file rather than inside the controller. %>
        <p data-vocabulary-picker-target="hint"
           data-empty-hint="<%= t(".pick_hint") %>"
           data-picked-hint="<%= t(".pick_hint_picked") %>"
           class="mt-3 text-[13px] leading-snug text-app-text-2"><%= t(".pick_hint") %></p>
      </div>
    </section>

    <%# Only appears once there is a pick — asking what a word means before one
        has been chosen has nothing to name. %>
    <section data-vocabulary-picker-target="translation"
             class="app-hairline mt-3 hidden rounded-[18px] bg-app-card px-[18px] py-4">
      <%# The word is a live placeholder the picker fills in, so it goes in as
          markup. The key is deliberately not `_html`: those escape their
          interpolations, which is what turned this heading into visible tag
          soup. The locale string itself carries no markup. %>
      <h3 class="mb-1.5 text-[12px] uppercase tracking-[0.1em] text-app-text-2">
        <%= t(".translation_of", word: tag.span(data: { vocabulary_picker_target: "pickedWord" }, dir: "auto")).html_safe %>
      </h3>
      <%= f.text_field :translation, autocomplete: "off",
                       placeholder: t(".translation_placeholder"),
                       data: { vocabulary_picker_target: "translationField",
                               action: "input->vocabulary-picker#refresh" },
                       class: "w-full bg-transparent text-[22px] font-semibold text-app-text placeholder:text-app-text-3 outline-none" %>
    </section>

    <%= f.hidden_field :token_start, data: { vocabulary_picker_target: "tokenStart" } %>
    <%= f.hidden_field :token_end, data: { vocabulary_picker_target: "tokenEnd" } %>
    <%= f.hidden_field :word, data: { vocabulary_picker_target: "wordField" } %>

    <div class="flex-1"></div>

    <%= f.submit t(".submit"),
                 data: { vocabulary_picker_target: "submitButton" },
                 disabled: true,
                 class: "mt-6 w-full rounded-app-field bg-app-segment px-4 py-[17px] text-[17px] font-bold text-app-text-3 enabled:bg-app-accent enabled:text-app-on-accent" %>
  <% end %>
</div>
