<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
<head>
  <title><%= content_for(:title) || t('doorkeeper.layouts.application.title') %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50 min-h-screen">
  <%= render "shared/beta_notice" %>
  <%- if flash[:notice].present? %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md m-4 px-4 py-3.5 text-emerald-600 dark:text-emerald-400">
      <%= flash[:notice] %>
    </div>
  <% end -%>

  <%= yield %>
</body>
</html>
