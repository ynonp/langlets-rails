<% content_for :title, "Credits · langlets." %>

<%# Presented as a bottom sheet by the path configuration, same as Add a video. %>
<div class="min-h-dvh flex flex-col justify-end">
  <div class="app-sheet-top app-sheet-pad bg-app-sheet rounded-t-app-sheet px-5 pt-2.5 flex flex-col gap-4">
    <div class="flex justify-center">
      <div class="w-9 h-[5px] rounded-full bg-white/20"></div>
    </div>

    <div class="flex justify-end">
      <%= link_to app_home_path,
                  class: "w-[30px] h-[30px] rounded-full bg-app-pill flex items-center justify-center text-app-text-2",
                  aria: { label: "Close" } do %>
        <%= app_icon "close", class: "w-3.5 h-3.5" %>
      <% end %>
    </div>

    <% if @balance.positive? %>
      <div class="flex flex-col items-center text-center gap-2.5 pb-2">
        <div class="w-14 h-14 rounded-full bg-app-accent/[0.14] flex items-center justify-center">
          <%= app_icon "bolt", class: "w-[26px] h-[26px] text-app-accent", stroke: 1.2 %>
        </div>
        <h2 class="text-xl font-extrabold tracking-[-0.4px]">
          <%= pluralize(@balance, "credit") %> left
        </h2>
        <p class="text-app-text-2 text-sm leading-[1.45] max-w-[290px]">
          Each import uses 1 credit. Adding something from the Library is always free.
        </p>
      </div>
    <% else %>
      <%= render "app/credits/out_of_credits_body" %>
    <% end %>

    <section class="flex flex-col gap-3"
             aria-labelledby="credit-packs-title"
             data-controller="bridge--apple-purchase"
             data-bridge--apple-purchase-endpoint-value="<%= app_apple_purchases_path %>"
             data-bridge--apple-purchase-account-token-value="<%= @apple_app_account_token %>">
      <h3 id="credit-packs-title" class="text-center text-sm font-bold text-app-text-2">Buy credits</h3>

      <div>
        <% @apple_credit_packs.each do |pack| %>
          <button type="button"
                  data-action="click->bridge--apple-purchase#purchase"
                  data-product-id="<%= pack.product_id %>"
                  class="w-full rounded-2xl border border-white/15 px-2 py-3 text-center hover:border-app-accent disabled:opacity-50">
            <span class="block text-base font-extrabold"><%= pack.price %> · <%= pack.credits %> credits</span>
            <span class="block text-xs text-app-text-3">Apple In-App Purchase</span>
          </button>
        <% end %>
      </div>
      <p class="text-center text-[11px] leading-relaxed text-app-text-3">
        Payment is handled securely by Apple.
      </p>
    </section>

    <% if (video_url = Youtube::Url.canonical(params[:url])) %>
      <%= link_to "Back to the video", new_app_import_request_path(url: video_url),
                  class: "block text-center text-app-text-3 text-[13px] py-1" %>
    <% end %>
  </div>
</div>
