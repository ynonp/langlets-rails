<% badge = local_assigns[:badge].to_i %>

<%= link_to path,
            class: "relative w-16 flex flex-col items-center gap-[3px] #{current ? 'text-app-accent' : 'text-[#7C8B98]'}",
            aria: { current: (current ? "page" : nil) } do %>
  <span class="relative">
    <%= app_icon icon, class: "w-6 h-6" %>

    <%# Rendered on every tab, including Queue itself — matches the mockup. %>
    <% if badge.positive? %>
      <span class="absolute -top-1 -right-2 min-w-4 h-4 px-1 rounded-full bg-app-accent text-app-on-accent-sm
                   text-[10px] font-extrabold leading-4 text-center">
        <%= badge %>
      </span>
    <% end %>
  </span>

  <span class="text-[10px] font-semibold"><%= label %></span>
<% end %>
