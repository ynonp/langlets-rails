<div class="h-screen w-screen bg-slate-900 flex items-center justify-center">
  <!-- Close button -->
  <% if params[:returnto].present? %>
    <%= link_to params[:returnto], class: "absolute top-6 left-6 text-slate-400 hover:text-white transition-colors duration-200" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    <% end %>
  <% else %>
    <%= link_to root_path, class: "absolute top-6 left-6 text-slate-400 hover:text-white transition-colors duration-200" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    <% end %>
  <% end %>

  <!-- Log in button -->
  <div class="absolute top-6 right-6">
    <% login_params = params[:returnto].present? ? { returnto: params[:returnto] } : {} %>
    <%= link_to "LOG IN", new_user_session_path(login_params), class: "text-blue-400 hover:text-blue-300 font-semibold tracking-wide transition-colors duration-200" %>
  </div>

  <!-- Signup form container -->
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Sign up</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <!-- Hidden field to preserve returnto param -->
      <% if params[:returnto].present? %>
        <%= hidden_field_tag :returnto, params[:returnto] %>
      <% end %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Email field -->
      <div>
        <%= f.email_field :email, 
            autofocus: true, 
            autocomplete: "email",
            placeholder: "Email",
            class: "w-full px-4 py-4 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" %>
      </div>

      <!-- Password field -->
      <div>
        <%= f.password_field :password, 
            autocomplete: "new-password",
            placeholder: "Password #{'(' + @minimum_password_length.to_s + ' characters minimum)' if @minimum_password_length}",
            class: "w-full px-4 py-4 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" %>
      </div>

      <!-- Password confirmation field -->
      <div>
        <%= f.password_field :password_confirmation, 
            autocomplete: "new-password",
            placeholder: "Confirm password",
            class: "w-full px-4 py-4 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" %>
      </div>

      <!-- Sign up button -->
      <div>
        <%= f.submit "SIGN UP", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-4 rounded-lg transition-colors duration-200 tracking-wide" %>
      </div>

      <!-- OR divider -->
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-700"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-slate-900 text-slate-400 tracking-wide">OR</span>
        </div>
      </div>

      <!-- Social signup buttons -->
      <div class="grid grid-cols-2 gap-4">
        <button type="button" class="flex items-center justify-center px-4 py-3 border border-slate-700 rounded-lg bg-slate-800 hover:bg-slate-700 transition-colors duration-200">
          <svg class="w-5 h-5 text-white mr-2" viewBox="0 0 24 24">
            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="text-white font-medium tracking-wide">GOOGLE</span>
        </button>
        
        <button type="button" class="flex items-center justify-center px-4 py-3 border border-slate-700 rounded-lg bg-slate-800 hover:bg-slate-700 transition-colors duration-200">
          <svg class="w-5 h-5 text-blue-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span class="text-white font-medium tracking-wide">FACEBOOK</span>
        </button>
      </div>
    <% end %>

    <!-- Terms and Privacy -->
    <div class="mt-8 text-center space-y-2">
      <p class="text-slate-400 text-sm">
        By signing up to Langlets, you agree to our 
        <a href="#" class="text-slate-300 hover:text-white">Terms</a> and 
        <a href="#" class="text-slate-300 hover:text-white">Privacy Policy</a>
      </p>
      <p class="text-slate-500 text-xs">
        This site is protected by reCAPTCHA Enterprise and the<br>
        Google <a href="#" class="text-slate-400 hover:text-slate-300">Privacy Policy</a> and <a href="#" class="text-slate-400 hover:text-slate-300">Terms of Service</a> apply.
      </p>
    </div>
  </div>
</div>
