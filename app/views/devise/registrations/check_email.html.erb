<div class="min-h-screen w-full flex items-center justify-center bg-emerald-50 px-6 dark:bg-gray-950" style="min-height: 100dvh;">
  <div class="w-full max-w-md text-center" data-testid="check-email-page">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-white text-emerald-600 shadow-md ring-1 ring-gray-200 dark:bg-gray-900 dark:text-emerald-400 dark:ring-gray-700" aria-hidden="true">
      <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 6.75A2.25 2.25 0 0 1 5.25 4.5h13.5A2.25 2.25 0 0 1 21 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 17.25V6.75Z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m3.75 6 7.19 5.393a1.75 1.75 0 0 0 2.12 0L20.25 6" />
      </svg>
    </div>

    <h1 class="mt-8 text-[30px] font-extrabold tracking-tight text-gray-900 dark:text-gray-50"><%= t(".title") %></h1>
    <p class="mt-3 text-base font-semibold leading-7 text-gray-600 dark:text-gray-300"><%= t(".instructions") %></p>
    <p class="mt-2 text-sm font-semibold leading-6 text-gray-500 dark:text-gray-400"><%= t(".spam_hint") %></p>

    <div class="mt-8 border-t border-gray-200 pt-6 dark:border-gray-800">
      <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">
        <%= t(".not_received") %>
        <%= link_to t(".resend"), new_user_confirmation_path, class: "font-bold text-emerald-600 dark:text-emerald-400" %>
      </p>
    </div>
  </div>
</div>
