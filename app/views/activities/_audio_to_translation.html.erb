<%# Expects:
  params[:phrases] - An array of phrase objects with timestamp, calculated_end_timestamp, text_l1, text_l2
  params[:l1] - Language object for original phrases (the audio language)
  params[:l2] - Language object for translation phrases
  params[:video_id] - YouTube video ID
  params[:start_timestamp] - Start timestamp for the video segment
  params[:end_timestamp] - End timestamp for the video segment

  This activity shows a 2-column grid where users match audio to their translations:
  1. Left column shows audio cards (play button + a waveform "fingerprint" of the phrase)
  2. Right column shows translations in L2
  3. Columns are shuffled separately so audio and translations are not aligned
  4. The waveform bars are generated deterministically from the phrase text (see controller)
  5. User plays an audio card, then selects its matching translation
  6. Correct matches flash green, then stay in place disabled + marked done (✓)
  7. Failed matches flash red and selection is cleared
  8. Progress bar + counter show completion status
  9. When all phrases are matched, shows completion message

  Per-cell state is driven by a `data-state` attribute (set by the controller to
  "selected" or "matched"); all styling is Tailwind via data-/group-data variants.
%>

<%
  phrases = params[:phrases] || []
  l1 = params[:l1]
  l2 = params[:l2]
  total_phrases = phrases.length

  # Shuffle each column separately for server-side rendering, then zip so each
  # grid row holds one (unrelated) audio card and one translation card.
  rows = phrases.shuffle.zip(phrases.shuffle)

  # Shared cell styling. The state variants mirror the old CSS: a gentle emerald
  # outline while selected, and a dimmed emerald "done" look once matched.
  cell_base = "group relative flex items-center min-h-[76px] max-h-[5.5rem] overflow-hidden px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 cursor-pointer transition-all duration-200 hover:scale-[1.02]"
  cell_state = "data-[state=selected]:border-emerald-400 data-[state=selected]:ring-2 data-[state=selected]:ring-emerald-500/25 data-[state=selected]:bg-emerald-50/70 dark:data-[state=selected]:bg-emerald-900/40 data-[state=matched]:border-emerald-500 data-[state=matched]:bg-emerald-50 dark:data-[state=matched]:bg-emerald-900/40 data-[state=matched]:opacity-[0.65] data-[state=matched]:cursor-default data-[state=matched]:pointer-events-none"
  check_classes = "hidden group-data-[state=matched]:block shrink-0 text-base font-bold leading-none text-emerald-600 dark:text-emerald-300"
%>

<div
    data-controller="audio-to-translation-activity"
    data-audio-to-translation-activity-total-phrases-value="<%= total_phrases %>"
    class="flex-1 min-h-0 overflow-y-auto flex-col flex items-center">

  <div class="w-full max-w-[640px] p-4 sm:p-6">
    <div class="mb-6">
      <div class="flex items-center gap-3 sm:gap-4">
        <p data-audio-to-translation-activity-target="counter" class="shrink-0 text-sm sm:text-base font-medium text-gray-700 dark:text-gray-300 tabular-nums">
          <%= t(".matched", current: 0, total: total_phrases) %>
        </p>
      </div>
      <p class="text-gray-500 dark:text-gray-400 text-sm sm:text-base mt-4"><%= @activity.text_header || t(".instruction") %></p>
    </div>

    <div id="audio-to-translation" class="flex flex-col gap-4">

      <!-- Completion message -->
      <div data-audio-to-translation-activity-target="completionMessage" data-progress-tracker-target="completion" class="hidden p-4 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-center sm:text-left text-xl font-bold text-gray-900 dark:text-gray-50"><%= t(".great_job") %></h3>
          <p class="text-center sm:text-left text-gray-500 dark:text-gray-400"><%= t(".completed") %></p>
        </div>
        <%= link_to_next_activity(t(".next"), @next_activity_path, class: "w-full sm:w-auto inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors") %>
      </div>

      <!-- Grid container: audio cards (left) + translations (right) -->
      <div class="grid grid-cols-2 gap-x-4 gap-y-3.5" data-audio-to-translation-activity-target="grid">

        <!-- Column headers -->
        <div class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 font-semibold px-1 mb-1"><%= t(".audio", language: l1.native_name) %></div>
        <div class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 font-semibold px-1 mb-1"><%= t(".translation", language: l2.native_name) %></div>

        <% rows.each do |audio_phrase, translation_phrase| %>
          <!-- Audio card (L1) -->
          <button
            class="<%= cell_base %> gap-3.5 <%= cell_state %>"
            data-phrase-id="<%= audio_phrase.id %>"
            data-column="l1"
            data-text-l1="<%= audio_phrase.text_l1 %>"
            data-text-l2="<%= audio_phrase.text_l2 %>"
            data-action="click->main-video-player#playSegment click->audio-to-translation-activity#selectPhrase"
            data-main-video-player-segment-start-param="<%= timestamp_to_seconds(audio_phrase.timestamp) %>"
            data-main-video-player-segment-end-param="<%= timestamp_to_seconds(audio_phrase.calculated_end_timestamp) %>">
            <span class="shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500 text-white text-sm" style="padding-left: 2px;">▶</span>
            <!-- Waveform fingerprint (hidden once solved) -->
            <span class="wf flex items-center justify-between gap-0.5 h-7 flex-1 min-w-0 group-data-[state=matched]:hidden" data-audio-to-translation-activity-target="waveform" data-text="<%= audio_phrase.text_l1 %>"></span>
            <!-- Revealed phrase text (shown once solved) -->
            <span class="hidden group-data-[state=matched]:block flex-1 min-w-0 truncate text-[15px] leading-snug text-emerald-700 dark:text-emerald-300" dir="auto"><%= audio_phrase.text_l1 %></span>
            <span class="<%= check_classes %> ms-auto ps-2" aria-hidden="true">✓</span>
          </button>

          <!-- Translation card (L2) -->
          <div
            class="<%= cell_base %> <%= l2.rtl ? 'justify-end' : 'justify-start' %> <%= cell_state %>"
            data-phrase-id="<%= translation_phrase.id %>"
            data-column="l2"
            data-text-l1="<%= translation_phrase.text_l1 %>"
            data-text-l2="<%= translation_phrase.text_l2 %>"
            data-action="click->audio-to-translation-activity#selectPhrase">
            <span class="line-clamp-3 break-words leading-normal text-[15px] <%= l2.rtl ? 'text-right' : 'text-left' %> group-data-[state=matched]:text-emerald-700 dark:group-data-[state=matched]:text-emerald-300"><%= translation_phrase.text_l2 %></span>
            <span class="<%= check_classes %> <%= l2.rtl ? 'me-auto pe-2' : 'ms-auto ps-2' %>" aria-hidden="true">✓</span>
          </div>
        <% end %>

      </div>

    </div>
  </div>
</div>
