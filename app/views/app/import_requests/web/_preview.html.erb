<%
  balance = current_user.credit_balance
  cost = preview.cost
  video = preview.video
  # Pro is bought in the iOS app but entitles the account, so the browser has to
  # honour it too — otherwise a subscriber pasting a link here is asked to buy
  # credits they don't need.
  pro = current_user.pro?
  short = !pro && cost.positive? && balance < cost
%>

<div class="overflow-hidden rounded-[22px] border border-[#E4DCCC] bg-[#FFFDF8] shadow-[6px_6px_0_#EADFC9]">
  <div class="grid sm:grid-cols-[14rem_minmax(0,1fr)]">
    <%= image_tag video.thumbnail_url, alt: "", loading: "lazy", class: "aspect-video h-full w-full bg-[#F2EADB] object-cover" %>
    <div class="min-w-0 p-5 sm:p-6">
      <p class="text-lg font-extrabold leading-snug [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif]"><%= video.title %></p>
      <p class="mt-1 text-sm text-[#8A8170]"><%= video.author_name %></p>
    </div>
  </div>

  <div class="border-t border-[#E4DCCC] p-5 sm:p-6">
    <% if preview.paused? %>
      <%# Pro is bought in the iOS app, so the browser can explain the state but
          cannot sell the way out of it. %>
      <p class="text-sm text-[#55503F]"><%= t("app.import_requests.new.paused") %></p>
      <p class="mt-2 text-sm text-[#8A8170]"><%= t("app.import_requests.new.paused_web_hint") %></p>
    <% elsif preview.in_library? %>
      <p class="text-sm text-[#55503F]"><%= t("app.import_requests.new.already_in_library") %></p>
      <%= link_to t("app.import_requests.new.open_lesson"), course_path(preview.course), data: { turbo_frame: "_top" }, class: "mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#C4451C] px-5 py-3 text-sm font-extrabold text-[#FFFDF8] hover:bg-[#9E3410] sm:w-auto" %>
    <% elsif preview.in_queue? %>
      <p class="text-sm text-[#55503F]"><%= t("app.import_requests.new.already_importing") %></p>
      <%= link_to t("app.import_requests.new.view_in_library"), gallery_path(imports: "pending"), data: { turbo_frame: "_top" }, class: "mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#C4451C] px-5 py-3 text-sm font-extrabold text-[#FFFDF8] hover:bg-[#9E3410] sm:w-auto" %>
    <% else %>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-relaxed text-[#55503F]">
          <%= t("app.import_requests.new.imports_as_lesson") %>
          <% if pro %>
            <strong class="text-[#C4451C]"><%= t("app.import_requests.new.included_with_pro") %></strong>
          <% else %>
            <strong class="<%= short ? 'text-[#9E3410]' : 'text-[#C4451C]' %>"><%= pluralize(cost, "credit") %> · <%= balance %> left</strong>
          <% end %>
        </p>
        <% if short %>
          <%# No button: individual credits are not sold anywhere, and the only
              way past an empty balance is Langlets Pro, which is bought in the
              iOS app. Same shape as the paused state above — the browser can
              explain where they stand but cannot sell the way out of it. %>
          <p class="shrink-0 max-w-xs text-sm text-[#8A8170]"><%= t("app.import_requests.new.out_of_credits_web_hint") %></p>
        <% else %>
          <%= form_with url: app_import_requests_path, method: :post, data: { turbo: false }, class: "shrink-0" do |f| %>
            <%= hidden_field_tag :url, video.canonical_url %>
            <%= hidden_field_tag :translation_language, translation_language.english_name %>
            <%= f.submit(app_approve_label(preview: preview, pro: pro), class: "min-h-11 w-full cursor-pointer rounded-xl bg-[#C4451C] px-5 py-3 text-sm font-extrabold text-[#FFFDF8] hover:bg-[#9E3410]") %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
