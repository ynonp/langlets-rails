<% content_for :title, "Create New Course" %>

<div class="min-h-screen bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50">
  <!-- Header -->
  <header class="py-6 border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <%= link_to courses_path, class: "text-2xl font-bold tracking-tight hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" do %>
        ← Langlets
      <% end %>
      <h1 class="text-xl font-semibold text-gray-500 dark:text-gray-400">Create New Course</h1>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-md border border-gray-200 dark:border-gray-800 p-8">

      <!-- Form Header -->
      <div class="mb-8">
        <h2 class="text-3xl font-bold mb-2">Create a New Language Course</h2>
        <p class="text-gray-500 dark:text-gray-400">Fill out the form below to create an AI-generated language learning course from YouTube content.</p>
      </div>

      <!-- Error Messages -->
      <% if @course.errors.any? %>
        <div class="mb-6 p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-500/50 rounded-lg">
          <h3 class="text-red-700 dark:text-red-300 font-semibold mb-2">Please fix the following errors:</h3>
          <ul class="text-red-600 dark:text-red-300 text-sm space-y-1">
            <% @course.errors.full_messages.each do |message| %>
              <li>• <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Form -->
      <%= form_with model: @course, local: true, class: "space-y-6", data: { controller: "youtube-form" } do |form| %>

        <!-- Course Name -->
        <div>
          <%= form.label :name, "Course Name", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= form.text_field :name,
                class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent",
                placeholder: "e.g., 'French Songs with Édith Piaf'",
                data: { youtube_form_target: "nameField" } %>
        </div>

        <!-- Course Slug -->
        <div>
          <%= form.label :slug, "Course Slug (URL identifier)", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= form.text_field :slug,
                class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent",
                placeholder: "e.g., 'french-edith-piaf' (lowercase, no spaces)",
                data: { youtube_form_target: "slugField" } %>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">This will be used in the URL. Use lowercase letters, numbers, and dashes only.</p>
        </div>

        <!-- YouTube URL -->
        <div>
          <%= form.label :main_media_url, "YouTube URL", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= form.url_field :main_media_url,
                class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent",
                placeholder: "https://www.youtube.com/watch?v=...",
                data: {
                  youtube_form_target: "urlField",
                  action: "input->youtube-form#urlChanged"
                } %>
        </div>

        <!-- Language Selection -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= label_tag "clip_language", "Content Language", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
            <%= select_tag "clip_language",
                  options_for_select(@languages.map { |lang| [lang.english_name, lang.english_name] }, params.dig(:clip_language)),
                  { class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" } %>
          </div>

          <div>
            <%= label_tag "translation_language", "Translation Language", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
            <%= select_tag "translation_language",
                  options_for_select(@languages.map { |lang| [lang.english_name, lang.english_name] }, params.dig(:translation_language) || 'English'),
                  { class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" } %>
          </div>
        </div>

        <!-- Course Language (for database) -->
        <div>
          <%= form.label :language_id, "Primary Language (for categorization)", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= form.collection_select :language_id, @languages, :id, :english_name,
                { prompt: "Select the primary language of this course" },
                { class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" } %>
        </div>



        <!-- Lyrics URL (Optional) -->
        <div>
          <%= label_tag "lyrics", "Lyrics (Optional)", class: "block text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2" %>
          <%= text_area_tag "lyrics", params.dig(:lyrics),
                class: "w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent",
                placeholder: "If you know the exact lyrics you can type them here. This may improve lesson accuracy. (leave blank to let the AI listen and transcribe the song automatically)" %>
        </div>

        <!-- Warning Box -->
        <div class="p-4 bg-yellow-100 dark:bg-yellow-900/30 border border-yellow-400 dark:border-yellow-500/50 rounded-lg">
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-600 dark:text-yellow-400 mr-3 mt-0.5 flex-shrink-0">
              <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="text-yellow-700 dark:text-yellow-400 font-semibold">Course Generation Takes Time</h4>
              <p class="text-yellow-700 dark:text-yellow-200 text-sm mt-1">
                Creating your course will take approximately 10-15 minutes. We'll send you an email when it's ready!
              </p>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end space-x-4 pt-6">
          <%= link_to "Cancel", courses_path, class: "px-6 py-3 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-50 font-semibold transition-colors" %>
          <%= form.submit "Create Course",
                class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors cursor-pointer" %>
        </div>

      <% end %>
    </div>
  </main>
</div>
