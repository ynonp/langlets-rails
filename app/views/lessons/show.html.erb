<% content_for :head do %>
  <% youtube_video_id = @videoid %>
  <% thumbnail_url = youtube_thumbnail_url(youtube_video_id) %>
  <% title = "#{@lesson.course&.name || @lesson.name} - Langlets" %>
  <% description = "Learn languages with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities." %>
  
  <!-- Page title -->
  <title><%= title %></title>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= thumbnail_url %>">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="og:site_name" content="Langlets">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="<%= course_url %>">
  <meta property="twitter:title" content="<%= title %>">
  <meta property="twitter:description" content="<%= description %>">
  <meta property="twitter:image" content="<%= thumbnail_url %>">
<% end %>

<% 
  activity_params = @activity.activity_params 
%>

<div class=" h-screen flex flex-col max-w-xl mx-auto w-full bg-gray-800"
    data-controller="main-video-player activity-navigation "    
    data-main-video-player-video-id-value="<%= @videoid %>"
    
>
  <div
    id="main-player"    
    data-main-video-player-target="playerContainer"
    class="<%= activity_params[:video_player] ? 'px-4 order-2' : 'hidden' %>"
  >
      <div class="w-full aspect-video bg-cover bg-center bg-no-repeat flex items-center justify-center relative" 
       style="background-image: url('<%= "https://img.youtube.com/vi/#{@videoid}/maxresdefault.jpg" %>')" 
       role="img" 
       aria-label="Video thumbnail">
    
        <div class="absolute inset-0 z-20" 
              data-action="click->main-video-player#togglePlayPause"></div>
        

        <div data-main-video-player-target="player" class="absolute inset-0 w-full h-full [&>iframe]:w-full [&>iframe]:h-full [&>iframe]:absolute [&>iframe]:inset-0"></div>
              <!-- Custom Progress Bar -->
        <div class="absolute bottom-0 left-0 w-full h-2 bg-gray-700 z-30 cursor-pointer"
            data-main-video-player-target="progressBarContainer"
            data-action="click->main-video-player#seekToPosition"
            style="pointer-events: auto;">
          <div data-main-video-player-target="progressBar" class="h-full bg-blue-500 transition-all duration-100 ease-linear" style="width: 0%"></div>
        </div>
        <button data-main-video-player-target="playButton" 
                class="text-white text-3xl sm:text-5xl bg-blue-600 bg-opacity-90 px-4 py-3 sm:px-6 sm:py-4 rounded-full shadow-lg hover:bg-blue-700 transition relative z-10">
          ▶
        </button>             
      </div>
  </div>

  <turbo-frame
    id="activity"
    class="contents"
    data-action="
    turbo:before-frame-render->main-video-player#handleBeforeRender
    turbo:frame-render->main-video-player#handleFrameRender
    turbo:frame-render->activity-navigation#activityChange
    "    
  >
    <!-- Combined top bar with X button, gamification stats, and Skip button -->
    <div class="bg-gray-900 py-3 px-4">
      <div class="flex items-center justify-between">
        <!-- Back to Course X Button -->
        <%= link_to @course_path,
          class: "text-white p-2 rounded-md hover:bg-white hover:bg-opacity-10 transition-colors duration-200",
          title: "Back to Course",
          data: {
            :"turbo-frame" => "_top",
            :turbo => false
          } do %>
          <svg xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 384 512"
            class="h-5 w-5 fill-white"
          >
            <path d="M376.6 84.5c11.3-13.6 9.5-33.8-4.1-45.1s-33.8-9.5-45.1 4.1L192 206 56.6 43.5C45.3 29.9 25.1 28.1 11.5 39.4S-3.9 70.9 7.4 84.5L150.3 256 7.4 427.5c-11.3 13.6-9.5 33.8 4.1 45.1s33.8 9.5 45.1-4.1L192 306 327.4 468.5c11.3 13.6 31.5 15.4 45.1 4.1s15.4-31.5 4.1-45.1L233.7 256 376.6 84.5z"/>
          </svg>
        <% end %>

        <!-- Gamification content will be inserted here -->
        <%= render partial: 'gamification_bar' %>

        <!-- Skip Button -->
        <%= link_to @next_activity_path,
          class: "text-white bg-gray-600 hover:bg-gray-700 px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200",
          title: "Skip to next activity",
          data: {
            :"turbo-frame" => "_top",
            :turbo => false
          } do %>
          Skip
        <% end %>
      </div>
    </div>
    <div
      data-controller="progress-tracker audio-feedback"
      data-action="activity:completed->progress-tracker#sendProgressUpdate audio:correct->audio-feedback#handleCorrect audio:incorrect->audio-feedback#handleIncorrect audio:complete->audio-feedback#handleComplete"
      data-progress-tracker-progress-data-value="<%= @progress_data.to_json %>"
      class="contents"
      data-activity-navigation-target="content"
      data-activity-navigation-url="<%= @current_url %>"
    >  
      <%= render partial: @activity.partial_name, locals: { params: activity_params } %>
    </div>
  </turbo-frame>
</div>
