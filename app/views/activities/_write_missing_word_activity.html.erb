<% phrase_tokens = params[:phrase_tokens] || [] %>
<% cards = prepare_flashcards_for_tokens(phrase_tokens, params[:unique_words]) %>
<% l1_rtl = params[:l1]&.rtl %>
<% l2_rtl = params[:l2]&.rtl %>

<div data-controller="write-missing-word-activity"
     data-write-missing-word-activity-cards-value="<%= cards.to_json %>"
     data-write-missing-word-activity-l1-rtl-value="<%= l1_rtl %>"
     data-write-missing-word-activity-is-review-lesson-value="<%= params[:is_review_lesson] || false %>"
     data-main-video-player-target="videoListener videoSegment"
     data-show-player="true"
     data-action="video:play->main-video-player#seekToSegmentStartIfBefore"
     class="order-4 flex-1 min-h-0 overflow-y-auto flex flex-col items-center bg-gray-50 dark:bg-gray-950">
  <div data-write-missing-word-activity-target="activityContent" class="w-full max-w-[460px] px-4 py-3 sm:py-5">
    <h2 class="sr-only"><%= @activity.text_header || t(".title") %></h2>
    <p data-write-missing-word-activity-target="progress" class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-2 sm:mb-4"><%= t(".question_of", current: 1, total: cards.length) %></p>

    <div data-write-missing-word-activity-target="card"
         dir="<%= l1_rtl ? 'rtl' : 'ltr' %>"
         class="bg-transparent px-1 py-5 text-gray-900 dark:text-gray-50 <%= l1_rtl ? 'text-right' : 'text-left' %>">
      <div class="flex min-h-[125px] items-center justify-center py-4 text-center sm:min-h-[150px]">
        <div data-write-missing-word-activity-target="sentence" class="text-gray-900 dark:text-gray-50 font-medium text-2xl sm:text-[28px] leading-relaxed"></div>
      </div>

      <div data-write-missing-word-activity-target="writeInterface" class="flex flex-col gap-2.5">
        <input type="text"
               data-write-missing-word-activity-target="answer"
               data-action="keydown.enter->write-missing-word-activity#checkAnswer"
               class="w-full min-h-[58px] px-4 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-50 text-base border border-gray-200 dark:border-white/10 focus:border-emerald-500 focus:outline-none"
               placeholder="<%= t('js.write_missing_word.placeholder') %>"
               autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
        <div class="grid grid-cols-2 gap-2.5">
          <button data-action="click->write-missing-word-activity#checkAnswer"
                  data-write-missing-word-activity-target="checkButton"
                  class="min-h-[58px] rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-bold"><%= t("js.write_missing_word.check") %></button>
          <button data-action="click->write-missing-word-activity#showHint"
                  data-write-missing-word-activity-target="hintButton"
                  class="min-h-[58px] rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-white/10 text-gray-900 dark:text-gray-50 font-medium"><%= t("js.write_missing_word.hint") %></button>
        </div>
      </div>

      <div data-write-missing-word-activity-target="hintOptions" class="hidden grid grid-cols-2 gap-2.5"></div>
      <div data-write-missing-word-activity-target="feedback" class="hidden text-base font-semibold mt-3" role="status"></div>
      <div data-write-missing-word-activity-target="stopPracticingContainer"></div>
    </div>
  </div>

  <%= render "activities/completion_message",
        controller: "write-missing-word-activity",
        target: "completion",
        title: t(".great_work"),
        next_label: t(".next"),
        phrases: [],
        dynamic_translation: { rtl: l2_rtl },
        next_action: "click->write-missing-word-activity#continue" %>
</div>

<style>
.flashcard-answer-reveal {
  text-shadow: 0 0 18px rgb(52 211 153 / 0.7);
  animation: flashcard-answer-flash-in 650ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes flashcard-answer-flash-in {
  0% { opacity: 0; transform: scale(0.35) rotate(-6deg); filter: brightness(2.2); }
  55% { opacity: 1; transform: scale(1.08) rotate(2deg); filter: brightness(1.45); }
  75% { transform: scale(0.98) rotate(-1deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); filter: brightness(1); }
}

@media (prefers-reduced-motion: reduce) {
  .flashcard-answer-reveal { animation: none; }
}
</style>
