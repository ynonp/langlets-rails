<div
    class="mb-6 px-3 py-2 sm:px-4 sm:py-3 bg-gray-100 dark:bg-gray-800 rounded-lg"
    data-controller="mini-player"
    data-main-video-player-target="videoListener"
    data-action="
      video:play->mini-player#handleVideoStart
      video:stop->mini-player#handleVideoPause
    "
  >
    <div class="flex items-center space-x-3">
      <button
        data-mini-player-target="playButton"
        data-speak-activity-target="playButton"
        data-action="click->main-video-player#playSegment"
        data-main-video-player-segment-start-param="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
        data-main-video-player-segment-end-param="<%= timestamp_to_seconds(params[:end_timestamp]) %>"

        class="text-white bg-emerald-500 p-2 rounded-full hover:bg-emerald-600 transition"
      >
        ▶
      </button>
      <button
        data-mini-player-target="pauseButton"
        data-action="click->main-video-player#stopPlayback"
        class="text-white bg-emerald-500 p-2 rounded-full hover:bg-emerald-600 transition hidden"
      >
        ❚❚
      </button>
      <div class="flex-1 h-2 bg-gray-200 dark:bg-gray-700 rounded-full cursor-pointer"
           data-main-vieo-player-target="progressBarContainer"
           data-action="click->main-video-player#seekToPosition">
        <div
          data-main-video-player-target="progressBar"
          id="audio-progress-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-100" style="width: 0%"></div>
      </div>
    </div>
</div>


