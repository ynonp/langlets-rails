<% content_for :head do %>
  <% video_id = @videoid %>
  <% thumb_url = youtube_thumbnail_url(video_id) if video_id %>
  <% title = "#{@lesson.name} - Langlets" %>
  <% desc = @lesson.course ? "Learn #{@lesson.course.language&.english_name || 'a new language'} with interactive video lessons based on \"#{@lesson.course.name}\"." : "Learn languages with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities." %>

  <title><%= title %></title>
  <%= render_meta_tags(
    title: title,
    description: desc,
    url: canonical_url(course_lesson_path(@lesson.course, @lesson)),
    image_url: thumb_url
  ) %>
<% end %>

<% content_for :canonical_url, canonical_url(course_lesson_path(@lesson.course, @lesson)) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/breadcrumb_list", items: [
    { name: "Home", url: canonical_url(root_path) },
    { name: @lesson.course.name, url: canonical_url(course_path(@lesson.course)) },
    { name: @lesson.name, url: canonical_url(course_lesson_path(@lesson.course, @lesson)) }
  ] %>
<% end %>

<% 
  activity_params = @activity.activity_params
%>

<div class=" h-screen flex flex-col max-w-xl mx-auto w-full bg-gray-800"
    data-controller="main-video-player activity-navigation "    
    data-main-video-player-video-id-value="<%= @videoid %>"
    data-main-video-player-hl-value="<%= activity_params[:video_hl] %>"
    data-main-video-player-preload-player-value="<%= activity_params[:preload_player] || false %>"
>
  <div
    id="main-player"    
    data-main-video-player-target="playerContainer"
    class="<%= activity_params[:video_player] ? 'px-4 order-2' : 'hidden' %>"
  >
      <div class="w-full aspect-video bg-cover bg-center bg-no-repeat flex items-center justify-center relative" 
       style="background-image: url('<%= "https://img.youtube.com/vi/#{@videoid}/hqdefault.jpg" %>')" 
       role="img" 
       aria-label="Video thumbnail">
    
        <div class="absolute inset-0 z-20" 
              data-action="click->main-video-player#togglePlayPause"></div>
        

        <div
            data-main-video-player-target="player"
            class="absolute inset-0 w-full h-full [&>iframe]:w-full [&>iframe]:h-full [&>iframe]:absolute [&>iframe]:inset-0">
        </div>
              <!-- Custom Progress Bar -->
        <div class="absolute bottom-0 left-0 w-full h-2 bg-gray-700 z-30 cursor-pointer"
            data-main-video-player-target="progressBarContainer"
            data-action="click->main-video-player#seekToPosition"
            style="pointer-events: auto;">
          <div data-main-video-player-target="progressBar" class="h-full bg-blue-500 transition-all duration-100 ease-linear" style="width: 0%"></div>
        </div>
        <button data-main-video-player-target="playButton" 
                class="text-white text-3xl sm:text-5xl bg-blue-600 bg-opacity-90 px-4 py-3 sm:px-6 sm:py-4 rounded-full shadow-lg hover:bg-blue-700 transition relative z-10">
          ▶
        </button>             
      </div>
  </div>

  <turbo-frame
    id="activity"
    class="contents"
    data-action="
    turbo:before-frame-render->main-video-player#handleBeforeRender
    turbo:frame-render->main-video-player#handleFrameRender
    turbo:frame-render->activity-navigation#activityChange
    "    
  >
    <%= render partial: 'activity_navigation' %>
    <div
      data-controller="progress-tracker audio-feedback bridge--progress-haptic bridge--native-audio-feedback"
      data-action="activity:completed->progress-tracker#sendProgressUpdate audio:correct->audio-feedback#handleCorrect audio:incorrect->audio-feedback#handleIncorrect audio:complete->audio-feedback#handleComplete"
      data-progress-tracker-progress-data-value="<%= @progress_data.to_json %>"
      class="contents"
      data-activity-navigation-target="content"
      data-activity-navigation-url="<%= @current_url %>"
    >  
      <%= render partial: @activity.partial_name, locals: { params: activity_params } %>
    </div>
  </turbo-frame>
</div>
