[Unit]
Description=Surfshark WireGuard in %i network namespace
After=network-online.target
Wants=network-online.target
Before=langlets-pipeline.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/surfshark-wg-netns up %i
ExecStop=/usr/local/sbin/surfshark-wg-netns down %i
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
