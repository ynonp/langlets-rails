<% active_count = @import_requests.count(&:active?) %>

<%= turbo_stream.replace "queue-status-text" do %>
  <%= render "status_text", active_count: active_count %>
<% end %>

<%# Parse the set of cards the client already has: "id1:status1,id2:status2" %>
<% known = (params[:known].presence || "").split(",").map { |s| id, status = s.split(":"); [id, status] }.to_h %>

<%# Remove cards the client has but the server no longer lists %>
<% known.each_key do |id| %>
  <% unless @import_requests.any? { |ir| dom_id(ir) == id } %>
    <%= turbo_stream.remove id %>
  <% end %>
<% end %>

<%# Update or add each card %>
<% @import_requests.each do |import_request| %>
  <% id = dom_id(import_request) %>
  <% old_status = known[id] %>

  <% if old_status.nil? %>
    <%# New card — prepend the whole thing %>
    <%= turbo_stream.prepend "queue-list" do %>
      <%= render "import_request", import_request: import_request %>
    <% end %>
  <% elsif old_status == import_request.status %>
    <%# Same status — only the body may have changed (progress bar, stage label).
        The thumb stays untouched so the image doesn't flash. %>
    <%= turbo_stream.replace dom_id(import_request, :body) do %>
      <%= render "import_request_body", import_request: import_request %>
    <% end %>
  <% else %>
    <%# Status changed — replace the thumb (clock → image or vice versa) and body.
        Also update the card's outer classes and data attribute by replacing the
        whole card. The thumb replacement is safe because either the old state
        was "queued" (clock placeholder, no image to flash) or the new state is
        "queued" (replacing an image with a clock, which is fine). %>
    <%= turbo_stream.replace id do %>
      <%= render "import_request", import_request: import_request %>
    <% end %>
  <% end %>
<% end %>

<%= turbo_stream.replace "queue-footer-note" do %>
  <%= render "footer_note", active_count: active_count %>
<% end %>
