<% content_for :head do %>
  <title>Profile - Langlets</title>
<% end %>

<div class="min-h-screen bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50">
  <div class="profile-safe-area max-w-3xl mx-auto py-8">
    <div class="flex items-center gap-3 mb-2">
      <%= link_to root_path, class: "text-emerald-600 dark:text-emerald-400" do %>
        <%= render "shared/home_icon", size: 26 %>
      <% end %>
      <h1 class="text-2xl sm:text-3xl font-bold">Profile</h1>
    </div>
    <p class="font-semibold text-[15.5px] mb-8 text-gray-500 dark:text-gray-400">
      <%= current_user.email %>
    </p>

    <% if notice.present? %>
      <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md mb-6 px-4 py-3.5 text-emerald-600 dark:text-emerald-400">
        <%= notice %>
      </div>
    <% end %>

    <%# ---------------------------------------------------------------- XP %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
      <div class="flex items-baseline justify-between mb-1.5">
        <h2 class="text-lg font-extrabold tracking-tight">XP this week</h2>
        <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">
          <%= number_with_delimiter(@total_xp) %> XP all time
        </p>
      </div>
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-5">
        <% if @streak[:count].positive? %>
          <%= pluralize(@streak[:count], "day") %> streak<%= " — no lesson yet today" if !@streak[:completed_today] %>
        <% else %>
          Complete a lesson to start a streak.
        <% end %>
      </p>

      <% max_xp = [@xp_series.map { |day| day[:xp] }.max.to_i, 1].max %>
      <div class="flex items-end justify-between gap-2 sm:gap-3 h-44"
           role="img"
           aria-label="<%= @xp_series.map { |day| "#{day[:date].strftime('%A')}: #{day[:xp]} XP" }.join(', ') %>">
        <% @xp_series.each do |day| %>
          <% is_today = day[:date] == Time.zone.now.to_date %>
          <div class="flex-1 flex flex-col items-center justify-end h-full gap-2">
            <span class="text-xs font-extrabold <%= day[:xp].positive? ? 'text-gray-900 dark:text-gray-50' : 'text-gray-300 dark:text-gray-700' %>">
              <%= day[:xp] %>
            </span>

            <%# Full-height track so the bars share a common baseline. %>
            <div class="w-full flex-1 flex items-end rounded-lg bg-gray-100 dark:bg-gray-800/60 overflow-hidden">
              <div class="w-full rounded-lg transition-all <%= is_today ? 'bg-emerald-500' : 'bg-emerald-500/45' %>"
                   style="height: <%= day[:xp].positive? ? [(day[:xp] / max_xp.to_f * 100).round, 4].max : 0 %>%">
              </div>
            </div>

            <span class="text-xs font-bold <%= is_today ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400' %>">
              <%= day[:date].strftime("%a") %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <%# ---------------------------------------------------------- Language %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
      <h2 class="text-lg font-extrabold tracking-tight mb-1.5">Learning language</h2>
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-4">
        <% if @current_language %>
          You're currently learning <%= @current_language.english_name %>.
        <% elsif native_app? %>
          You haven't picked a language yet.
        <% else %>
          You're seeing content in every language.
        <% end %>
      </p>

      <%# The native app always has a language, picked during onboarding, so it
          gets the button list without the "show all content" escape hatch. %>
      <% if native_app? %>
        <%= render "native_languages", languages: @languages, current_language: @current_language %>
      <% else %>
        <select
          data-controller="language-select"
          data-action="change->language-select#navigate"
          aria-label="Learning language"
          class="w-full px-4 py-3 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 font-semibold border border-gray-200 dark:border-gray-700 rounded-2xl cursor-pointer"
        >
          <option value="<%= language_redirect_url(ApplicationController::ALL_LANGUAGES) %>" <%= "selected" if @current_language.nil? %>>
            Show All Content
          </option>
          <% @languages.each do |language| %>
            <option value="<%= language_redirect_url(language.iso_name) %>" <%= "selected" if @current_language&.id == language.id %>>
              <%= language.native_name %> — <%= language.english_name %>
            </option>
          <% end %>
        </select>
      <% end %>
    </div>

    <%# ------------------------------------------------------------- Theme %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-extrabold tracking-tight mb-1.5">Theme</h2>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">
            Currently <%= current_theme %>. Tap to switch between light and dark.
          </p>
        </div>
        <%= render "shared/theme_toggle" %>
      </div>
    </div>

    <%# Nothing on this page is unsaved — language and theme both apply on the
        spot — so this is a way out, not a save. Deliberately outside a card:
        it's a page-level action, not another setting. %>
    <%= link_to "Continue Learning", root_path,
          data: { turbo_action: "replace" },
          class: "w-full inline-flex items-center justify-center gap-2 h-14 mb-6 rounded-2xl text-white font-extrabold transition-colors bg-emerald-600 hover:bg-emerald-700" %>

    <%# ---------------------------------------------------- Delete account %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-extrabold tracking-tight mb-1.5">Delete my account</h2>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">
            This permanently deletes your account and everything attached to it —
            your saved words, progress, XP and streak, and any courses you created.
            It can't be undone.
          </p>
        </div>
        <%= button_to "Delete account", registration_path(:user), method: :delete,
              data: {
                turbo_confirm: "Permanently delete your account and all your saved words and progress? This can't be undone."
              },
              class: "inline-flex items-center justify-center h-11 px-5 rounded-xl text-white text-sm font-extrabold whitespace-nowrap transition-colors bg-red-600 hover:bg-red-700 cursor-pointer",
              form: { class: "shrink-0" } %>
      </div>
    </div>
  </div>
</div>
