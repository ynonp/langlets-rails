<% content_for :title, t(".page_title") %>

<%# A plain pushed screen inside the Create tab: native back arrow at the top,
    native tab bar at the bottom, page content in between. It used to be a
    medium-detent sheet, which lost on both ends — the iOS 26 floating tab bar
    drew over its controls, and the sheet overflowed its own detent as soon as a
    preview card appeared. Nothing here wants to be a sheet; it's a form.

    Laid out like Create and Library (app-scroll-pad, px-5, pt-6) so it sits in
    the same grid as the screen it's pushed from. app-scroll-pad is what keeps
    the last control clear of the tab bar. %>
<div class="app-scroll-pad px-5 pt-6 flex flex-col gap-4"
     data-controller="add-video"
     data-add-video-resolve-url-value="<%= resolve_app_import_requests_path %>">

  <h1 class="text-[30px] font-extrabold tracking-[-0.6px]"><%= t(".title") %></h1>

  <%= render "app/shared/daily_vocab_card" %>

  <div>
    <p class="text-app-text-2 text-sm mt-1">
      <%# A subscriber has no balance worth reporting, and telling them how many
          credits they have left invites them to worry about a meter that no
          longer runs. %>
      <% if current_user.pro? %>
        <%= t(".pro_subtitle") %>
      <% else %>
        <%= t(".credits_subtitle", credits: app_credits_label(current_user.credit_balance)) %>
      <% end %>
    </p>
    <%# The share extension is iOS-only, so this sentence is simply untrue on
        Android — it would send users hunting through TikTok's share sheet for a
        Langlets target that isn't installed. Hidden there until Android grows a
        SEND intent filter, at which point this guard comes back out. %>
    <% unless android_app? %>
      <p class="text-app-text-2 text-sm mt-2 leading-[1.45]">
        <%= t(".share_hint") %>
      </p>
    <% end %>
  </div>

  <% if flash[:alert] %>
    <p class="rounded-app-field border-[0.5px] border-red-500/30 bg-red-500/10 text-red-300 text-[13px] leading-relaxed py-3 px-3.5">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <%# An empty balance doesn't block the screen. The user should get all the way
      to a rendered preview of what they'd be importing and only then meet the
      paywall — seeing the thing is the reason to buy it. %>
  <div class="flex flex-col gap-1.5">
    <%# Border turns green once the value parses as a video. %>
    <div class="app-inset-hairline bg-app-inset rounded-app-input py-3 px-3.5 flex items-center gap-2.5 transition-colors"
         data-add-video-target="field">
      <%= app_icon "link", class: "w-4 h-4 shrink-0 text-app-text-3" %>

      <%# inputmode=url rather than type=url: the URL keyboard is the right one,
          but type=url would fight a bare video id, which is a perfectly good
          thing to paste here. %>
      <input type="text"
             inputmode="url"
             data-add-video-target="input"
             data-action="input->add-video#inputChanged"
             placeholder="<%= t(".paste_placeholder") %>"
             value="<%= params[:url] %>"
             autofocus autocomplete="off" autocapitalize="off"
             autocorrect="off" spellcheck="false"
             enterkeyhint="go"
             class="flex-1 min-w-0 bg-transparent text-[16px] text-app-text placeholder:text-app-text-3 outline-none">

      <button type="button"
              data-add-video-target="clear"
              data-action="add-video#clearInput"
              class="hidden shrink-0 text-app-text-3"
              aria-label="Clear">
        <%= app_icon "close", class: "w-3.5 h-3.5" %>
      </button>
    </div>

    <%# Hint and confirmation occupy the same slot so the layout doesn't jump
        when a link resolves. %>
    <p class="text-app-text-3 text-[11px] pl-0.5" data-add-video-target="hint">
      <%= t(".url_hint") %>
    </p>
    <p class="hidden items-center gap-1 text-app-accent text-[11px] pl-0.5"
       data-add-video-target="recognized">
      <%= app_icon "check_circle", class: "w-3 h-3" %>
      <%= t(".link_recognized") %>
    </p>
  </div>

  <%# Everything below the input — empty state, preview card, errors — is one
      swappable region the server owns entirely. The Stimulus controller only
      points this frame at #resolve; it never renders a state itself. %>
  <turbo-frame id="add_video_result">
    <%= render "app/import_requests/empty_state" %>
  </turbo-frame>
</div>
