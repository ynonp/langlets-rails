    params = { "video_id": "kJQP7kiw5Fk", "start_timestamp": "00:40", "end_timestamp": "01:00", "texts": [ { "text_l1": "Ya llevo un rato mirándote", "text_l2": "I've been looking at you for a while now", "timestamp": "00:43", "token_translations": [ { "start_index": 0, "end_index": 1, "translation": "now", "questions": null }, { "start_index": 3, "end_index": 7, "translation": "I've been", "questions": null }, { "start_index": 9, "end_index": 15, "translation": "for a while", "questions": [ "¿Cuánto tiempo lleva?" ] }, { "start_index": 17, "end_index": 25, "translation": "looking at you", "questions": [ "¿Qué está haciendo?", "¿A quién mira?" ] } ] }, { "text_l1": "Tengo que bailar contigo hoy", "text_l2": "I have to dance with you today", "timestamp": "00:47", "token_translations": [ { "start_index": 0, "end_index": 8, "translation": "I have to", "questions": [] }, { "start_index": 10, "end_index": 15, "translation": "dance", "questions": [ "¿Qué vas a hacer hoy?" ] }, { "start_index": 17, "end_index": 23, "translation": "with you", "questions": [ "¿Con quién bailas hoy?" ] }, { "start_index": 25, "end_index": 27, "translation": "today", "questions": [ "¿Cuándo bailas?" ] } ] }, { "text_l1": "Tu mirada ya estaba llamándome", "text_l2": "Your gaze was already calling me", "timestamp": "00:53", "token_translations": [ { "start_index": 0, "end_index": 8, "translation": "Your gaze", "questions": [ "¿Quién me llamaba?" ] }, { "start_index": 10, "end_index": 11, "translation": "already", "questions": null }, { "start_index": 13, "end_index": 18, "translation": "was", "questions": null }, { "start_index": 20, "end_index": 29, "translation": "calling me", "questions": [ "¿Qué hacía tu mirada?" ] } ] }, { "text_l1": "Muéstrame el camino que yo voy", "text_l2": "Show me the way that I go", "timestamp": "00:58", "token_translations": [ { "start_index": 0, "end_index": 8, "translation": "Show me", "questions": [ "¿Qué pide el hablante?" ] }, { "start_index": 10, "end_index": 11, "translation": "the", "questions": null }, { "start_index": 13, "end_index": 18, "translation": "way", "questions": [ "¿Qué quiere que muestre?" ] }, { "start_index": 20, "end_index": 22, "translation": "that", "questions": null }, { "start_index": 24, "end_index": 25, "translation": "I", "questions": [ "¿Quién va?" ] }, { "start_index": 27, "end_index": 29, "translation": "go", "questions": null } ] } ] }

  1. The activity has 3 parts:
    a. At the top show the translated text (text_l2)
    b. Next line we show the original text (text_l1)
    c. Next line we show a microphone icon

  2. For the original text line, user can click on any token to show a popup with its translation

  3. When the user clicks on the microphone icon user is expected to speak the sentence in L1 language. The microphone icon changes to a recording icon and the user can start speaking.
     Clicking on the recording icon stops the recording.
  
  4. When the user is done speaking the text is checked for accuracy and correctness and user is presented with a "Good Work!" banner and a "Next" button
    a. The banner shows the sentence marking the user's errors:
      - ErrorType: "Mispronunciation" => The word is highlighted in yellow
      - ErrorType: "Omission" => The word is highlighted in grey and surrounded by square brackets
      - ErrorType: "Insertion" => The word is highlighted in red and marked with a strike through  
%>

<div
    data-controller="speak-activity"
    data-speak-activity-l1-value="<%= params[:azure_speech_name] %>"
  class="flex-col flex items-center min-h-screen bg-gray-800">
  <div class="w-full max-w-[640px] p-4 sm:p-6 bg-gray-800 rounded-lg shadow-lg">
    <div class="mb-6 text-center">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Pronunciation Practice</h2>
      <p class="text-sm sm:text-base text-gray-400">Click on the microphone and say the phrases in <%= params[:l1] %></p>
      
      <!-- Progress Bar -->
      <div class="w-full bg-gray-700 rounded-full h-2.5 mt-3">
        <div data-speak-activity-target="progressBar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
    </div>
    
    <!-- Audio Player -->
    <%= render partial: 'activities/mini_video_player', locals: { params: } %>

    <!-- Single-Column Layout for Phrases -->
    <div id="speak-activity-phrases" class="flex flex-col space-y-3" data-speak-activity-target="phrasesContainer">
      <% params[:phrases].each_with_index do |phrase, phrase_index| %>
        <div class="relative phrase-container <%= phrase_index == 0 ? '' : 'hidden' %>" data-phrase-id="<%= phrase_index %>" data-speak-activity-target="phraseContainer">
          <!-- Original Text (L1) with Microphone -->
          <div 
            class="original-phrase px-4 py-4 border border-gray-700 rounded-lg bg-gray-800 text-white text-center text-base sm:text-xl mb-3"
            data-phrase-id="<%= phrase_index %>"
            data-speak-activity-target="originalPhrase">
            <div class="flex items-center justify-between">
              <div data-controller="popover-translation" class="flex-grow text-center">
                <%= wrap_tokens_in_spans(phrase, {class: "cursor-pointer hover:bg-gray-600 rounded"}) %>
                
                <!-- Translation Popup -->
                <div data-popover-translation-target="translationPopup" class="hidden absolute bg-white text-gray-900 p-2 rounded shadow-lg z-30">
                  <div data-popover-translation-target="translationText"></div>
                </div>
              </div>
              
              <!-- Microphone Button with its own Speech Recognition Controller -->
              <div 
                  data-controller="speech-recognition"
                  data-speech-recognition-phrase-text-value="<%= phrase.text_l1 %>"
                  data-speech-recognition-phrase-index-value="<%= phrase_index %>"
                  data-speech-recognition-l1-value="<%= params[:azure_speech_name] %>"
              >
                <button
                    data-action="click->speech-recognition#toggleRecord"
                    class="microphone-button text-white bg-blue-600 p-2 rounded-full hover:bg-blue-700 transition ml-2">
                    <svg
                        data-speech-recognition-target="micIcon"
                        class="mic-icon" 
                        xmlns="http://www.w3.org/2000/svg" 
                        width="18" 
                        height="18" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round" 
                        class="feather feather-mic">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                        <line x1="12" y1="19" x2="12" y2="23"></line>
                        <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                    <svg
                        data-speech-recognition-target="recordingIcon"
                        class="recording-icon hidden" 
                        xmlns="http://www.w3.org/2000/svg" 
                        width="18" 
                        height="18" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round" 
                        class="feather feather-square">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Translation (L2) -->
          <div 
            class="translation-phrase px-4 py-4 border border-gray-700 rounded-lg bg-gray-900 text-white text-center text-base sm:text-lg"
            data-phrase-id="<%= phrase_index %>"
            data-speak-activity-target="translationPhrase">
            <%= phrase.text_l2 %>
          </div>
        </div>
      <% end %>

      <!-- Completion Message - positioned to replace the original phrase -->
      <div 
        data-speak-activity-target="completionMessage" 
        class="hidden p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-center sm:text-left text-xl font-bold text-white">Good Work!</h3>
          <p class="text-center sm:text-left text-gray-300">You've completed this pronunciation exercise.</p>
        </div>
        <a href="<%= @next_activity_path %>" class="w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center">Next</a>
      </div>
    </div>
    
    <!-- Assessment Result -->
    <div data-speak-activity-target="assessmentResult" id="assessment-result" class="hidden mt-4">
      <div id="result-details" class="p-4 bg-gray-700 rounded-lg mb-4">
        <h3 class="text-lg font-semibold text-white mb-2">Your pronunciation:</h3>
        <div
          data-speak-activity-target="pronunciationText"
          id="pronunciation-text" class="text-white text-center py-2"></div>
        <div class="flex justify-between mt-4">
          <div class="text-center">
            <div data-speak-activity-target="accuracyScore" class="text-lg font-bold text-white" id="accuracy-score">0</div>
            <div class="text-sm text-gray-400">Accuracy</div>
          </div>
          <div class="text-center">
            <div data-speak-activity-target="fluencyScore" class="text-lg font-bold text-white" id="fluency-score">0</div>
            <div class="text-sm text-gray-400">Fluency</div>
          </div>
          <div class="text-center">
            <div data-speak-activity-target="completenessScore" class="text-lg font-bold text-white" id="completeness-score">0</div>
            <div class="text-sm text-gray-400">Completeness</div>
          </div>
        </div>
      </div>
    </div>
  
  </div>
</div>

<style>
@keyframes fade-in {
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fade-in 0.5s ease-out forwards;
}

.microphone-button {
  transition: all 0.2s;
}

.microphone-button:hover {
  transform: scale(1.05);
}

.microphone-button:active {
  transform: scale(0.95);
}

#token-popup {
  max-width: 90vw;
  width: auto;
}

/* Pulsing animation for recording button */
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
  70% { box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); }
  100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
}

.microphone-button:has(.recording-icon:not(.hidden)) {
  background-color: rgb(220, 38, 38);
  animation: pulse 2s infinite;
}

/* Phrase transition animations */
.original-phrase,
.translation-phrase {
  transition: opacity 0.3s ease-out, transform 0.3s ease-out;
}

.original-phrase:not(.hidden),
.translation-phrase:not(.hidden) {
  animation: fade-in 0.5s ease-out forwards;
}
</style>
