<% content_for :title, "Vocabulary · langlets." %>

<div class="app-scroll-pad px-5 pt-6 flex flex-col gap-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <%= render "app/shared/header", title: t(".title") %>
    </div>
  </div>

  <% if @total_count.zero? %>
    <%= render "empty" %>
  <% else %>
    <div class="flex items-center gap-2.5">
      <%= form_with url: app_vocabulary_entries_path, method: :get,
                    data: { turbo_frame: "vocabulary-results" },
                    class: "min-w-0 flex-1" do |f| %>
        <%= f.hidden_field :filter, value: @filter if @filter.present? %>
        <label class="app-hairline bg-app-card rounded-app-field flex items-center gap-2.5 py-3 px-3.5">
          <span class="sr-only"><%= t(".search_label") %></span>
          <%= app_icon "search", class: "w-[18px] h-[18px] text-app-text-3 shrink-0" %>
          <%= f.search_field :q, value: @query,
                             placeholder: t(".search_placeholder"),
                             class: "w-full bg-transparent text-[15px] text-app-text placeholder:text-app-text-3 outline-none",
                             autocomplete: "off" %>
        </label>
      <% end %>

      <%= link_to new_app_vocabulary_entry_path,
                  class: "shrink-0 w-[46px] h-[46px] rounded-app-field bg-app-pill text-app-accent flex items-center justify-center",
                  aria: { label: t(".add") } do %>
        <%= app_icon "plus", class: "w-5 h-5" %>
      <% end %>
    </div>

    <turbo-frame id="vocabulary-results" class="flex flex-col gap-4">
      <%= render "filters", filter: @filter, query: @query,
                 languages: @languages, paused_count: @paused_count %>

      <p class="text-[14px] text-app-text-2">
        <%= t(".summary", words: t(".word_count", count: @total_count),
                          paused: @paused_count) %>
      </p>

      <% if @visible.empty? %>
        <div class="rounded-[20px] border border-dashed border-white/10 px-5 py-7 text-center">
          <p class="text-[16px] font-semibold text-app-text-dim"><%= t(".no_matches") %></p>
          <p class="mt-1.5 text-[14px] text-app-text-3"><%= t(".no_matches_hint") %></p>
        </div>
      <% else %>
        <div class="flex flex-col gap-3">
          <% @visible.each do |entry| %>
            <%= render "entry", entry: entry %>
          <% end %>
        </div>
      <% end %>
    </turbo-frame>
  <% end %>
</div>

<%= render "app/vocabulary_entries/toast" %>
