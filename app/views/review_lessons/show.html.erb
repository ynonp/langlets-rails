<% content_for :head do %>
  <title><%= @lesson.name %> - Langlets</title>
  <meta name="robots" content="noindex, follow">
<% end %>

<%# Immersive activity screen — hide the floating theme toggle so it doesn't
    overlap the video player controls. %>
<% content_for(:suppress_floating_theme_toggle) { "1" } %>

<% activity_params = @activity.activity_params.merge(is_review_lesson: true) %>

<div class="sprout s-screen s-screen--fixed max-w-[480px] mx-auto w-full"
    style="--hue: 150;"
    data-controller="main-video-player activity-navigation"
    data-main-video-player-video-id-value=""
    data-main-video-player-hl-value=""
    data-main-video-player-preload-player-value="false"
>
  <turbo-frame
    id="activity"
    class="contents"
    data-action="
    turbo:frame-render->activity-navigation#activityChange
    "
  >
    <%= render partial: 'review_lessons/activity_navigation' %>
    <div
      data-controller="progress-tracker audio-feedback"
      data-action="activity:completed->progress-tracker#sendProgressUpdate audio:correct->audio-feedback#handleCorrect audio:incorrect->audio-feedback#handleIncorrect audio:complete->audio-feedback#handleComplete"
      data-progress-tracker-progress-data-value="<%= @progress_data.to_json %>"
      class="contents"
      data-activity-navigation-target="content"
      data-activity-navigation-url="<%= @current_url %>"
    >
      <%= render partial: @activity.partial_name, locals: { params: activity_params } %>
    </div>
  </turbo-frame>
</div>
