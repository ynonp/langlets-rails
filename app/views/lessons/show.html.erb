<% content_for :head do %>
  <% thumb_url = course_thumbnail_url(@lesson.course) %>
  <% title = "#{@lesson.localized_name} - Langlets" %>
  <% desc = @lesson.course ? "Learn #{@lesson.course.language&.english_name || 'a new language'} with interactive video lessons based on \"#{@lesson.course.localized_name}\"." : "Learn languages with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities." %>

  <title><%= title %></title>
  <%= render_meta_tags(
    title: title,
    description: desc,
    url: canonical_url(course_lesson_path(@lesson.course, @lesson)),
    image_url: thumb_url
  ) %>
<% end %>

<% content_for :canonical_url, canonical_url(course_lesson_path(@lesson.course, @lesson)) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/breadcrumb_list", items: [
    { name: "Home", url: canonical_url(root_path) },
    { name: @lesson.course.localized_name, url: canonical_url(course_path(@lesson.course)) },
    { name: @lesson.localized_name, url: canonical_url(course_lesson_path(@lesson.course, @lesson)) }
  ] %>
<% end %>

<%
  activity_params = @activity.activity_params
%>

<div class="h-dvh-safe min-h-0 flex flex-col overflow-hidden bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50 max-w-[480px] mx-auto w-full"
    data-controller="main-video-player activity-navigation "
    data-main-video-player-provider-value="<%= @video_provider %>"
    data-main-video-player-video-id-value="<%= @videoid %>"
    data-main-video-player-hl-value="<%= @video_hl %>"
    data-main-video-player-preload-player-value="<%= activity_params[:preload_player] || false %>"
    data-main-video-player-interactive-value="<%= activity_params[:interactive_video_player] || false %>"
    data-action="flashcard-activity:card-change->main-video-player#configureSegment"
>
  <%= render "shared/video_media_box",
        thumbnail_url: course_thumbnail_url(@lesson.course),
        container_class: activity_params[:video_player] ? 'order-2' : 'hidden' %>

  <turbo-frame
    id="activity"
    class="contents"
    data-action="
    turbo:before-frame-render->main-video-player#handleBeforeRender
    turbo:frame-render->main-video-player#handleFrameRender
    turbo:frame-render->activity-navigation#activityChange
    "    
  >
    <%= render partial: 'activity_navigation' %>
    <div
      data-controller="progress-tracker audio-feedback bridge--progress-haptic bridge--native-audio-feedback"
      data-action="activity:completed->progress-tracker#sendProgressUpdate audio:correct->audio-feedback#handleCorrect audio:incorrect->audio-feedback#handleIncorrect audio:complete->audio-feedback#handleComplete"
      data-progress-tracker-progress-data-value="<%= @progress_data.to_json %>"
      class="contents"
      data-activity-navigation-target="content"
      data-activity-navigation-url="<%= @current_url %>"
      data-activity-navigation-next-url="<%= @next_activity_path unless @is_last_activity %>"
    >
      <%= render partial: @activity.partial_name, locals: { params: activity_params } %>
    </div>
  </turbo-frame>
</div>
