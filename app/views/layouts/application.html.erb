<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || "Langlets - Learn Languages Through Interactive Video Clips" %></title>
    <meta name="description" content="<%= content_for(:meta_description) || SeoHelper::DEFAULT_DESCRIPTION %>">
    <link rel="canonical" href="<%= content_for(:canonical_url) || 'https://www.langlets.app' %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="view-transition" content="same-origin" />

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <% if Rails.env.production? %>
      <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "cc08f0c2f839468e8821ed7f43213c15"}'></script><!-- End Cloudflare Web Analytics -->

      <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "r5h6kovuse");
      </script>
    <% end %>
  </head>

  <body>
    <main class="flex flex-col min-h-screen">
      <%= yield %>
    </main>

    <%= render "shared/theme_toggle" %>

    <%= yield :structured_data %>
    <% unless content_for?(:structured_data) %>
      <%= render "shared/structured_data/website" %>
    <% end %>
  </body>
</html>
