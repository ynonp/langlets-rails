<div id="gallery-results">
  <% if @search.present? %>
    <div class="gallery-summary">
      <span><%= pluralize(@total_count, "result") %></span>
      <button type="button" class="gallery-clear" data-action="gallery-filters#clearSearch">Clear Search</button>
    </div>
  <% end %>

  <% if @entries.any? || @import_requests.any? %>
    <section class="gallery-grid" aria-label="Gallery results">
      <%= render partial: "import_request_card", collection: @import_requests, as: :import_request %>
      <%= render partial: "card", collection: @entries, as: :entry %>
    </section>
  <% else %>
    <div class="gallery-empty">No Langlets match those filters.</div>
  <% end %>

  <% if @total_pages > 1 %>
    <nav class="gallery-pagination" aria-label="Pagination">
      <% ([1, @page - 1, @page, @page + 1, @total_pages].select { |page| page.between?(1, @total_pages) }.uniq.sort).each do |page| %>
        <%= link_to page, gallery_path(search: @search.presence, imports: @import_filter, types: @selected_types, languages: @selected_languages.map(&:iso_name), page: page),
              class: "gallery-page-link", aria: (page == @page ? { current: "page" } : {}),
              data: { turbo_stream: true } %>
      <% end %>
    </nav>
  <% end %>
</div>
