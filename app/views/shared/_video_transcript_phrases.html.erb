<%
  container_class = local_assigns[:container_class] || "flex-1 overflow-y-auto flex flex-col gap-4 px-5"
  saved_ids_url = local_assigns[:saved_ids_url]
  saved_ids = current_user ? current_user.saved_phrase_tokens.pluck(:id) : []
%>
<div
    data-controller="popover-translation"
    data-popover-translation-saved-ids-value="<%= saved_ids.to_json %>"
    data-popover-translation-saved-ids-url-value="<%= saved_ids_url %>"
    data-popover-translation-saved-token-classes-value="underline decoration-emerald-500 decoration-[2.5px] underline-offset-4"
    id="phrases-container"
    data-watch-video-activity-target="container"
    data-action="click->popover-translation#showPopup click->watch-video-activity#handleTranslationClick scroll->popover-translation#hidePopup:passive click@document->popover-translation#hidePopup click@document->watch-video-activity#resumeAfterTranslation scroll@document->popover-translation#hidePopup"
    class="<%= container_class %>"
    style="padding-bottom: calc(16px + env(safe-area-inset-bottom));"
    >
  <div id="phrases-list" data-watch-video-activity-target="phrasesList"
       data-action="click->main-video-player#seekToTimestamp">
    <% phrases.each do |phrase| %>
      <div
        data-watch-video-activity-target="subtitles"
        data-timestamp="<%= timestamp_to_seconds(phrase.timestamp) %>"
        class="phrase block cursor-pointer rounded-2xl px-3.5 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 data-active:bg-emerald-100! dark:data-active:bg-emerald-900/40!"
      >
        <div class="text-xl font-extrabold leading-relaxed <%= 'hidden' if wv_prefs["translation"] %>"
             data-watch-video-activity-target="l1Text"
             dir="<%= l1_rtl ? 'rtl' : 'ltr' %>">
          <%= wrap_tokens_in_spans(phrase, { class: "token cursor-pointer rounded px-0.5 border-b-[2.5px] border-dotted border-gray-400 dark:border-gray-600 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 data-active:bg-emerald-500! data-active:text-white data-active:rounded-md" }) %>
        </div>
        <div class="text-xl font-extrabold leading-relaxed <%= 'hidden' unless wv_prefs["translation"] %>"
             data-watch-video-activity-target="l2Text"
             dir="<%= l2_rtl ? 'rtl' : 'ltr' %>">
          <%= phrase.text_l2 %>
        </div>
      </div>
    <% end %>
  </div>
  <%= render partial: 'activities/translation_popup', locals: { popup_class: "hidden absolute z-40 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 border border-gray-200 dark:border-gray-700 rounded-2xl p-3 shadow-md min-w-[180px]", l1_rtl: l1_rtl } %>
</div>
