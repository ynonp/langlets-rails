<%# Course page "..." dropdown, anchored to the button that opens it (not centered): add to playlist, share a public link, or delete from the viewer's own library. %>
<div data-course-menu-target="menuOverlay" class="hidden fixed inset-0 z-30" data-action="click->course-menu#closeMenu"></div>

<div data-course-menu-target="menuPanel"
     class="hidden absolute top-14 right-4 z-40 w-56 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-2xl overflow-hidden py-1.5"
     role="menu">
  <button type="button" data-action="course-menu#closeMenu course-paths#open"
          class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left text-sm font-bold text-gray-900 dark:text-gray-50">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 text-gray-500 dark:text-gray-400"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    <%= t(".add_to_playlist") %>
  </button>
  <button type="button" data-course-menu-target="shareButton"
          data-action="course-menu#toggleShare"
          data-share-path="<%= share_course_path(course) %>"
          data-unshare-path="<%= unshare_course_path(course) %>"
          data-shared="<%= shared %>"
          class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left text-sm font-bold text-gray-900 dark:text-gray-50">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 text-gray-500 dark:text-gray-400"><path d="M15 8a3 3 0 1 0-2.977-3.346M15 8a3 3 0 0 1-2.977-3.346M15 8l-6.03 3.481M8.97 4.654 15 8m-6.03 3.481a3 3 0 1 1-2.94-3.435m2.94 3.435a3 3 0 0 0-2.94-3.435m0 0L15 16m0 0a3 3 0 1 0 2.977 3.346M15 16a3 3 0 0 1 2.977 3.346" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span data-course-menu-target="shareLabel"><%= shared ? t(".stop_sharing") : t(".share_to_public_url") %></span>
  </button>
  <% if deletable %>
    <button type="button" data-action="course-menu#openDelete"
            class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors text-left text-sm font-bold text-red-600 dark:text-red-400">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0"><path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" /></svg>
      <%= t(".delete") %>
    </button>
  <% end %>
</div>

<% if deletable %>
  <div data-course-menu-target="deleteOverlay"
       class="playlist-sheet-overlay hidden fixed inset-0 z-[100] flex items-end sm:items-center justify-center bg-black/60"
       role="dialog" aria-modal="true" aria-labelledby="delete-course-title">
    <%= form_with url: course_path(course), method: :delete, class: "playlist-sheet block w-full max-w-[480px] rounded-t-3xl sm:rounded-3xl bg-white dark:bg-gray-900 p-6 text-left shadow-2xl" do %>
      <strong id="delete-course-title" class="block text-lg font-extrabold text-gray-900 dark:text-gray-50"><%= t(".delete_title") %></strong>
      <span class="mt-2 block text-sm text-gray-600 dark:text-gray-300"><%= t(".delete_message", name: course.localized_name) %></span>
      <span class="mt-6 flex gap-3">
        <button type="button" data-action="course-menu#closeDelete"
                class="flex-1 h-11 rounded-full border border-gray-300 dark:border-gray-600 font-bold text-gray-700 dark:text-gray-200"><%= t(".cancel") %></button>
        <button type="submit"
                class="flex-1 h-11 rounded-full bg-red-600 hover:bg-red-700 text-white font-extrabold"><%= t(".delete") %></button>
      </span>
    <% end %>
  </div>
<% end %>

<div data-course-menu-target="toast"
     class="hidden fixed course-menu-toast-offset inset-x-4 z-[110] mx-auto max-w-[420px] rounded-2xl bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-sm font-bold text-center px-4 py-3 shadow-2xl"
     role="status" aria-live="polite"></div>
