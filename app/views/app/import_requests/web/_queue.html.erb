<div id="queue"
     data-controller="poll"
     data-poll-interval-value="3000"
     data-poll-active-value="<%= active_count.positive? %>">
  <div id="queue-empty" class="<%= 'hidden' if import_requests.any? %> rounded-3xl border border-dashed border-gray-300 bg-white px-6 py-14 text-center shadow-sm dark:border-gray-700 dark:bg-gray-900 sm:py-20">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" aria-hidden="true">+</div>
    <h2 class="mt-4 text-lg font-extrabold"><%= t("app.import_requests.index.empty") %></h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-gray-500 dark:text-gray-400">Add a YouTube video and we’ll turn it into a language lesson.</p>
    <%= link_to "Add your first video", new_app_import_request_path,
                class: "mt-5 inline-flex min-h-11 items-center justify-center rounded-2xl bg-emerald-500 px-5 py-3 text-sm font-extrabold text-white hover:bg-emerald-600" %>
  </div>

  <div id="queue-list" class="<%= 'hidden' if import_requests.empty? %> grid gap-4">
    <%= render partial: "app/import_requests/web/import_request", collection: import_requests %>
  </div>
</div>
