<%# Wordmark, credits pill, avatar. The brand is "langlets." — lowercase, with a
    green full stop. (The written spec calls the app "Turn"; the mockup never
    does, and "turn" is the verb from the tagline.) %>
<div class="flex items-center justify-between">
  <span class="text-2xl font-extrabold tracking-[-0.5px]">
    langlets<span class="text-app-accent">.</span>
  </span>

  <div class="flex items-center gap-2.5">
    <%= link_to app_credits_path,
                class: "flex items-center gap-1.5 bg-app-pill rounded-full py-1.5 px-3",
                aria: { label: app_credits_label(current_user.credit_balance) } do %>
      <%= app_icon "bolt", class: "w-[13px] h-[13px] text-app-accent" %>
      <span class="text-app-credits text-[13px] font-bold"><%= current_user.credit_balance %></span>
    <% end %>

    <details class="relative"
             data-testid="app-profile-menu"
             data-controller="profile-menu"
             data-action="click@document->profile-menu#close">
      <summary class="w-[34px] h-[34px] rounded-full bg-app-pill flex items-center justify-center cursor-pointer list-none [&::-webkit-details-marker]:hidden"
               aria-label="Open profile menu">
        <span class="text-[13px] font-bold text-[#B9C7D2]"><%= current_user.email.first.upcase %></span>
      </summary>

      <div class="absolute right-0 top-full mt-2 w-56 rounded-2xl overflow-hidden z-50 bg-app-card border border-white/10 shadow-xl">
        <% current_user.languages_with_saved_words.order(:iso_name).each do |language| %>
          <%= button_to "Practice Words (#{language.iso_name})",
                        review_lessons_path(language_code: language.iso_name),
                        method: :post,
                        class: "w-full text-left px-4 py-3 text-sm font-semibold text-app-text hover:bg-white/5",
                        data: { turbo: false } %>
        <% end %>
        <% if current_user.languages_with_saved_words.exists? %>
          <div class="border-t border-white/10"></div>
        <% end %>
        <%= link_to "Profile", profile_path,
                    class: "block px-4 py-3 text-sm font-semibold text-app-text hover:bg-white/5" %>
        <div class="border-t border-white/10"></div>
        <%= link_to "Logout",
                    destroy_user_session_path(returnto: app_home_path),
                    data: { turbo_method: :delete },
                    class: "block px-4 py-3 text-sm font-semibold text-app-text hover:bg-white/5" %>
      </div>
    </details>
  </div>
</div>
