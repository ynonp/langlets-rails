<div id="<%= dom_id(entry, :practice) %>">
  <button type="submit" name="practicing" value="<%= !entry.practising? %>"
          data-testid="vocabulary-practice-toggle"
          aria-pressed="<%= entry.practising? %>"
          class="app-hairline flex w-full items-center gap-3.5 rounded-[18px] bg-app-card px-[18px] py-4 text-left">
    <span class="flex-1">
      <span class="block text-[16px] font-semibold text-app-text"><%= t("app.vocabulary_entries.show.practice") %></span>
      <span class="mt-1 block text-[13px] leading-snug text-app-text-2">
        <%= entry.practising? ? t("app.vocabulary_entries.show.practice_on") : t("app.vocabulary_entries.show.practice_off") %>
      </span>
    </span>

    <span class="flex h-8 w-[52px] shrink-0 items-center rounded-full p-[3px] transition-colors <%= entry.practising? ? "bg-app-accent" : "bg-app-segment" %>">
      <span class="block h-[26px] w-[26px] rounded-full bg-white transition-transform <%= "translate-x-5" if entry.practising? %>"></span>
    </span>
  </button>
</div>
