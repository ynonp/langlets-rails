<%
    phrases = params[:phrases]
    rtl = params[:rtl]
%>

<style>
  @keyframes pulse-attention {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  
  .word-option-button {
    --option-bg: var(--color-gray-100);
  }
  [data-theme="dark"] .word-option-button {
    --option-bg: var(--color-gray-800);
  }

  @keyframes correct-feedback {
    0% { background-color: var(--option-bg); }
    50% { background-color: rgb(34, 197, 94); }
    100% { background-color: var(--option-bg); }
  }

  @keyframes incorrect-feedback {
    0% { background-color: var(--option-bg); }
    50% { background-color: rgb(239, 68, 68); }
    100% { background-color: var(--option-bg); }
  }
  
  .word-option-button {
    animation: pulse-attention 1.5s infinite ease-in-out;
  }
  
  .correct-animation {
    animation: correct-feedback 0.6s ease-in-out;
  }
  
  .incorrect-animation {
    animation: incorrect-feedback 0.6s ease-in-out;
  }
</style>

<div
    class="flex-1 min-h-0 flex-col flex items-center bg-emerald-50 dark:bg-gray-950 overflow-hidden"
    data-controller="listen-activity"
    data-main-video-player-target="videoListener videoSegment"
    data-segment-start="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
    data-segment-end="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
    data-next-activity-path="<%= @next_activity_path %>"
    data-action="
      video:progress->listen-activity#progress
      listen-activity:pause-video->main-video-player#stopPlayback
      listen-activity:play-video->main-video-player#resume"
>
  <div class="w-full max-w-[640px] p-4 sm:p-6 rounded-2xl shadow-md flex flex-col flex-1 min-h-0 bg-white dark:bg-gray-900 dark:border dark:border-gray-800">
    <div class="mb-6 text-center">
      <h2 class="text-xl sm:text-2xl text-gray-900 dark:text-gray-50 mb-2"><%= @activity.text_header || t(".instruction") %></h2>
      <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400"><%= @activity.text_subheader %></p>
    </div>

    <%= render partial: 'activities/mini_video_player', locals: {params: params} %>

    <!-- Completion Message (Initially Hidden) -->
    <div class="my-4 p-4 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4 hidden" data-listen-activity-target="completion">
      <div>
        <h3 class="text-center sm:text-left text-xl font-bold text-gray-900 dark:text-gray-50"><%= t(".great_job") %></h3>
        <p class="text-center sm:text-left text-gray-500 dark:text-gray-400"><%= t(".completed") %></p>
      </div>
      <%= link_to_next_activity("Next", @next_activity_path, class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors w-full sm:w-auto") %>
    </div>

    <!-- Phrases Container with scrolling -->
    <div
        id="phrases-container"
        data-listen-activity-target="phrasesContainer container"
        class="w-full mx-auto bg-white dark:bg-gray-900 flex-1 overflow-y-auto"
        dir="<%= rtl ? 'rtl' : 'ltr' %>"
        >
      <div
        id="phrases-list"
        data-listen-activity-target="phrasesList"
        class="text-gray-900 dark:text-gray-50 text-sm sm:text-base pb-14 ">
        <% phrases.each_with_index do |phrase, phrase_index| %>
          <div
            data-listen-activity-target="subtitles phrase"
            data-timestamp="<%= timestamp_to_seconds(phrase.timestamp) %>"
            data-phrase-id="<%= phrase_index %>"
            class="px-4 py-3 transition-all duration-200">
            <div class="text-gray-900 dark:text-gray-50 text-md md:text-xl">
              <%= render_phrase_with_blanks(phrase) %>
            </div>
            <div class="text-gray-500 dark:text-gray-400 mt-1 text-md md:text-xl hidden" data-listen-activity-target="translation">
              <%= phrase.text_l2 %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Word Selection Area -->
    <div class="my-6 flex justify-center space-x-4" data-listen-activity-target="wordSelection">
      <%
        token_with_similar = nil
        phrases.each do |p|
          next unless p.phrase_tokens.present?
          p.phrase_tokens.each do |t|
            if similar_sounds_for_token(p, t).present?
              token_with_similar = { phrase: p, token: t }
              break
            end
          end
          break if token_with_similar
        end

        if token_with_similar
          first_phrase_with_tokens = token_with_similar[:phrase]
          first_token = token_with_similar[:token]
          words = []

          if first_token
            correct_word = first_token.original_text
            similar_candidates = similar_sounds_for_token(first_phrase_with_tokens, first_token) || []
            similar_word = similar_candidates.sample

            if correct_word.present? && similar_word.present?
              words = [{word: correct_word, correct: true}, {word: similar_word, correct: false}].shuffle
            end
          end

          words.each do |word_data|
      %>
            <button 
              data-listen-activity-target="wordOption" 
              data-word="<%= word_data[:word] %>" 
              data-correct="<%= word_data[:correct] %>"
              data-action="click->listen-activity#selectWord"
              class="px-6 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-gray-50 font-medium rounded-lg transition-colors duration-200 text-center word-option-button">
              <%= word_data[:word] %>
            </button>
      <%  end
        end
      %>
    </div>

  </div>
</div>
