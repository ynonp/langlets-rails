<%
  header_class = local_assigns[:header_class] || "flex items-center justify-between px-5 pt-3 pb-2"
  leading = local_assigns[:leading]
  full_player_controls = local_assigns[:full_player_controls]
%>
<div class="<%= header_class %>">
  <% if full_player_controls %>
    <div class="font-mono text-xs font-extrabold uppercase tracking-wide text-emerald-600 dark:text-emerald-400 mb-2"><%= t("shared.video_transcript_panel.tap_any_word") %></div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <label class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-600 dark:text-gray-300 cursor-pointer whitespace-nowrap">
        <input type="checkbox" class="accent-emerald-500"
          data-full-player-target="textOnlyToggle"
          data-action="change->full-player#toggleTextOnly">
        <%= t("shared.video_transcript_panel.text_only") %>
      </label>
      <label class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-600 dark:text-gray-300 cursor-pointer whitespace-nowrap">
        <input type="checkbox" class="accent-emerald-500"
          data-full-player-target="sentencePauseToggle"
          data-action="change->full-player#toggleSentencePause">
        <%= t("shared.video_transcript_panel.pause_each_sentence") %>
      </label>
      <% if word_timing %>
        <label class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-500 dark:text-gray-400 cursor-pointer whitespace-nowrap">
          <input type="checkbox" class="accent-emerald-500" <%= "checked" if wv_prefs["karaoke"] %>
            data-watch-video-activity-target="showKaraoke"
            data-action="change->watch-video-activity#toggleKaraoke">
          <%= t("shared.video_transcript_panel.karaoke") %>
        </label>
      <% end %>
      <div class="ml-auto flex items-center gap-1">
        <%= render "shared/video_transcript_icon_controls", wv_prefs: wv_prefs %>
      </div>
    </div>
  <% else %>
    <div class="flex items-center gap-3">
      <% if leading.present? %><%= leading %><% end %>
      <div class="font-mono text-xs font-extrabold uppercase tracking-wide text-emerald-600 dark:text-emerald-400"><%= t("shared.video_transcript_panel.tap_any_word") %></div>
    </div>
    <div class="flex items-center gap-2">
      <% if word_timing %>
        <label class="inline-flex items-center gap-2 text-xs font-bold text-gray-500 dark:text-gray-400 cursor-pointer">
          <input type="checkbox" <%= "checked" if wv_prefs["karaoke"] %>
            data-watch-video-activity-target="showKaraoke"
            data-action="change->watch-video-activity#toggleKaraoke">
          <%= t("shared.video_transcript_panel.karaoke") %>
        </label>
      <% end %>
      <%= render "shared/video_transcript_icon_controls", wv_prefs: wv_prefs %>
    </div>
  <% end %>
</div>
