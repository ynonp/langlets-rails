<%#
  Sprout lesson row. Shared by courses/show (full render) and the
  progress#toggle_lesson Turbo Stream so both look identical.

  Locals:
  - lesson, course        (required)
  - index                 (optional) zero-based position, used for "Lesson N"
  - is_first_incomplete   (optional) highlights the row with the accent ring
  - hue                   (optional) language hue; defaults from the course
-%>
<%
  state = lesson.completed? ? :done : (lesson.in_progress? ? :progress : :todo)
  is_first_incomplete = local_assigns.fetch(:is_first_incomplete, false)
  hue = local_assigns[:hue] || lang_hue(course.language&.iso_name)
  number = local_assigns[:index] ? index.to_i + 1 : lesson.order
%>
<div class="s-row" id="<%= dom_id(lesson) %>"
     style="<%= "border:2px solid var(--accent);" if is_first_incomplete %>"
     <%= raw('data-scroll-into-view-target="element"') if is_first_incomplete %>>
  <!-- Progress toggle -->
  <% if user_signed_in? %>
    <%= button_to toggle_lesson_progress_index_path(lesson_id: lesson.id), method: :post, class: "flex-shrink-0", style: "background:none;border:none;padding:0;cursor:pointer;line-height:0;" do %>
      <%= render "courses/lesson_state_icon", state: state, hue: hue %>
    <% end %>
  <% else %>
    <span class="flex-shrink-0" style="line-height:0;"><%= render "courses/lesson_state_icon", state: state, hue: hue %></span>
  <% end %>

  <%= link_to course_lesson_path(course, lesson), class: "flex-1 min-w-0", style: "text-decoration:none; color:inherit;" do %>
    <div class="s-body truncate" style="font-weight: 800;"><%= lesson.name %></div>
    <div class="s-small" style="margin-top: 2px;">
      <%= state == :done ? "Completed" : (state == :progress ? "In progress" : "Lesson #{number}") %>
    </div>
  <% end %>

  <%= link_to course_lesson_path(course, lesson), class: "flex-shrink-0 flex items-center justify-center", style: "width:38px;height:38px;border-radius:999px;background:#{state == :todo ? 'var(--accent)' : 'var(--surface2)'};text-decoration:none;", title: (state == :done ? "Review" : "Start lesson") do %>
    <% if state == :done %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12.5l5 5 11-11" stroke="var(--muted)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <% else %>
      <svg width="16" height="16" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="<%= state == :todo ? '#fff' : 'var(--muted)' %>"/></svg>
    <% end %>
  <% end %>
</div>
