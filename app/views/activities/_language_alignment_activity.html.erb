<%#
  Language alignment activity:
  1. User is presented with 1 translation (l2) phrase at the top with tokens marked in red
  2. User sees all original (l1) phrases below
  3. User has to click on the matching token in the original text for the highlighted token in the translation
  4. Every successful match the token in the original text is highlighted in green
  5. After all tokens in a phrase are matched, the next translation phrase is shown
  6. After all phrases are completed, the user is presented with a "Good Work!" banner and a "Next" button
%>

<% 
  phrases_with_tokens = params[:phrases_with_tokens] || []
  phrases = prepare_phrases_with_tokens_for_alignment(phrases_with_tokens)
  rtl = params[:rtl]  
  l1 = params[:l1]
  l2 = params[:l2]
  total_phrases = phrases.length
  
  phrases_with_all_tokens = phrases.filter_map do |phrase|
    {
      original_text: phrase[:original_text],
      translation: phrase[:translation],
      tokens: phrase[:tokens]
    } if phrase[:tokens].present?
  end
%>

<div class="flex-1 min-h-0 overflow-y-auto flex-col flex items-center bg-emerald-50 dark:bg-gray-950" data-controller="find-words">
  <div class=" w-full max-w-[640px] p-4 sm:p-6 bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-2xl shadow-md flex flex-col">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl text-gray-900 dark:text-gray-50 mb-2"><%= @activity.text_header || t(".instruction") %></h2>
    </div>

    <%= render partial: 'activities/mini_video_player', locals: {params: params} %>

    <div id="language-alignment" class="flex flex-col gap-4 flex-1 min-h-0">
      <!-- Translation phrase at the top -->
      <div class="relative">
        <% phrases_with_all_tokens.each_with_index do |phrase, phrase_index| %>
          <div
            class="translation-phrase px-4 py-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 text-center text-base text-md md:text-xl <%= phrase_index == 0 ? '' : 'hidden' %>"
            data-find-words-target="translationPhrase" 
            data-phrase-id="<%= phrase_index %>"
          >
            <% 
              text = phrase[:translation]
              segments = []
              current_pos = 0
              
              # Sort tokens by start position to process them in order
              sorted_tokens = phrase[:tokens].sort_by { |t| t[:l2_start_index] }
              
              sorted_tokens.each_with_index do |token, token_index|
                # Text before the token
                if token[:l2_start_index] > current_pos
                  segments << text[current_pos...token[:l2_start_index]]
                end
                
                # The token itself
                token_text = text[token[:l2_start_index]..token[:l2_end_index]]
                segments << {
                  text: token_text,
                  token_index: token_index
                }
                
                current_pos = token[:l2_end_index] + 1
              end
              
              # Add any remaining text after the last token
              if current_pos < text.length
                segments << text[current_pos..-1]
              end
            %>
            
            <% segments.each do |segment| %>
              <% if segment.is_a?(String) %>
                <%= segment.strip %><%= segment.strip.empty? ? "" : "&nbsp;".html_safe %>
              <% else %>
                <span class="text-red-500 dark:text-red-400" data-token-id="<%= segment[:token_index] %>"><%= segment[:text].strip %></span><%= "&nbsp;".html_safe %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <!-- Completion message now positioned to replace the translation phrase -->
        <div data-find-words-target="completionMessage" data-progress-tracker-target="completion" class="hidden translation-phrase p-4 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="text-center sm:text-left text-xl font-bold text-gray-900 dark:text-gray-50"><%= t(".good_work") %></h3>
            <p class="text-center sm:text-left text-gray-500 dark:text-gray-400"><%= t(".completed") %></p>
          </div>
          <%= link_to_next_activity(t(".next"), @next_activity_path, class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors w-full sm:w-auto") %>
        </div>
      </div>

      <!-- Original phrases below -->
      <div class=" max-h-80 flex-1 space-y-3 bg-gray-50 dark:bg-gray-900 rounded-t-lg overflow-y-auto" data-find-words-target="originalPhrasesContainer">
        <div class="text-center px-2 sm:px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-50 font-semibold rounded-t-lg text-xs sm:text-base sticky top-0 z-10">
          <%= l1 %> Original Phrases
        </div>

        <% phrases_with_all_tokens.each_with_index do |phrase, phrase_index| %>
          <div
            dir="<%= rtl ? 'rtl' : 'ltr' %>"
            class="original-phrase px-2 sm:px-4 py-2 sm:py-3 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-900 dark:text-gray-50 sm:min-h-[72px] text-md md:text-xl transition-all duration-200" data-phrase-id="<%= phrase_index %>"
          >
            <% 
              text = phrase[:original_text]
              segments = []
              current_pos = 0
              
              # Sort tokens by start position to process them in order
              sorted_tokens = phrase[:tokens].sort_by { |t| t[:l1_start_index] }
              
              sorted_tokens.each_with_index do |token, token_index|
                # Text before the token
                if token[:l1_start_index] > current_pos
                  segments << text[current_pos...token[:l1_start_index]]
                end
                
                # The token itself
                token_text = text[token[:l1_start_index]..token[:l1_end_index]]
                segments << {
                  text: token_text,
                  token_index: token_index,
                  phrase_index: phrase_index,
                  audio_url: token[:audio_url]
                }
                
                current_pos = token[:l1_end_index] + 1
              end
              
              # Add any remaining text after the last token
              if current_pos < text.length
                segments << text[current_pos..-1]
              end
            %>
            
            <% segments.each do |segment| %>
              <% if segment.is_a?(String) %>
                <%= segment.strip %><%= segment.strip.empty? ? "" : "&nbsp;".html_safe %>
              <% else %>
                <button 
                  class="token cursor-pointer" 
                  data-action="click->find-words#findToken" 
                  data-find-words-target="token" 
                  data-phrase-id="<%= segment[:phrase_index] %>" 
                  data-token-id="<%= segment[:token_index] %>" 
                  data-audio-url="<%= segment[:audio_url] %>"
                  data-found="false"
                ><%= segment[:text].strip %></button><%= "&nbsp;".html_safe %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out forwards;
  }

  @keyframes gentle-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  .animate-pulse {
    animation: gentle-pulse 0.5s ease-in-out;
  }

  .token {
    transition: all 0.3s ease;
  }

  .token:hover {
    text-decoration: underline;
  }
</style>
