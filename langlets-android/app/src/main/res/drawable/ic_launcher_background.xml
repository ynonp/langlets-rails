<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer: the same slate gradient the iOS app icon
  and public/icon.svg paint behind the mark (#0F172A to #1E293B, corner to
  corner).

  The gradient runs 18,18 -> 90,90 rather than 0,0 -> 108,108 on purpose. A
  launcher masks an adaptive icon down to its middle 72dp and keeps the outer
  18dp only as parallax bleed, so anchoring the stops at the canvas corners
  would show the user just the washed-out middle third of the ramp. These
  endpoints put the full range inside the part that is actually visible, which
  is what makes it read like the iOS icon rather than a flat navy square.

  Not a solid @color/app_background: the icon is the brand mark, not app chrome.
  colors.xml stays the palette for the native surfaces.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FF0F172A" />
                <item android:offset="1" android:color="#FF1E293B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
