<%# Course card partial for grid layout - handles both regular courses and courses with progress %>
<% is_completed = course.respond_to?(:completed?) && course.completed? %>
<%= link_to course_path(id: course.slug), class: "block bg-white dark:bg-gray-900 rounded-2xl shadow-md hover:shadow-lg transition duration-300 cursor-pointer border border-gray-200 dark:border-gray-800 flex flex-col h-full min-w-0" do %>
  <% if course.main_media_url.present? %>
    <% youtube_video_id = course_youtube_video_id(course) %>
    <div class="relative">
      <img src="<%= youtube_thumbnail_url(youtube_video_id) %>" alt="<%= course.localized_name %>" class="w-full h-40 object-cover rounded-t-xl flex-shrink-0">
      <% if is_completed %>
        <div class="absolute top-2 right-2 bg-emerald-500 text-white text-xs font-bold px-2 py-1 rounded-full shadow-md flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          Completed
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="relative w-full h-40 bg-gray-100 dark:bg-gray-800 rounded-t-xl flex items-center justify-center flex-shrink-0">
      <svg class="w-12 h-12 text-gray-400 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
      </svg>
      <% if is_completed %>
        <div class="absolute top-2 right-2 bg-emerald-500 text-white text-xs font-bold px-2 py-1 rounded-full shadow-md flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          Completed
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="p-4 flex flex-col flex-grow">
    <div class="flex-grow">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-50 mb-2 min-h-[1.75rem] flex items-center">
        <%= course.localized_name.present? ? course.localized_name : "Untitled Course" %>
      </h3>
      <div class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-3">
        <% if course.language.present? %>
          <% if is_completed %>
            <span class="mr-2 px-2 py-0.5 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 rounded-full text-xs font-medium">
              <%= course.language.english_name %>
            </span>
          <% elsif course.respond_to?(:has_progress?) && course.has_progress? %>
            <span class="mr-2 px-2 py-0.5 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-full text-xs font-medium">
              <%= course.language.english_name %>
            </span>
          <% else %>
            <span class="mr-2 px-2 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-xs font-medium">
              <%= course.language.english_name %>
            </span>
          <% end %>
          <span class="mr-2">·</span>
        <% end %>
        <% lesson_count = course.respond_to?(:total_lessons_count) ? course.total_lessons_count : course.lessons.count %>
        <span><%= pluralize(lesson_count, 'lesson') %></span>
      </div>

      <%# Show progress bar for in-progress courses %>
      <% if !is_completed && course.respond_to?(:has_progress?) && course.has_progress? && course.user_progress > 0 %>
        <div class="mb-3">
          <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 mb-1">
            <span><%= t(".progress") %></span>
            <span><%= course.user_progress %>%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-800 rounded-full h-2">
            <div class="bg-emerald-500 h-2 rounded-full transition-all duration-300" style="width: <%= course.user_progress %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Show appropriate button based on progress %>
    <% if is_completed %>
      <div class="inline-flex items-center justify-center h-14 rounded-2xl font-extrabold transition-colors w-full mt-auto bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300">
        Review
      </div>
    <% elsif course.respond_to?(:has_progress?) && course.has_progress? %>
      <div class="inline-flex items-center justify-center h-14 rounded-2xl font-extrabold transition-colors w-full mt-auto bg-emerald-500 hover:bg-emerald-600 text-white">
        Continue Learning
      </div>
    <% else %>
      <div class="inline-flex items-center justify-center h-14 rounded-2xl font-extrabold transition-colors w-full mt-auto bg-emerald-500 hover:bg-emerald-600 text-white">
        Start Course
      </div>
    <% end %>
  </div>
<% end %>
