<%# Expects:
  params[:phrases_for_sorting] - An array of phrase objects
  current_script - Script object for current script (passed as local)
  
  This activity shows a sortable column of phrases:
  
  1. The list starts shuffled. The correct order is determined by the original array at params[:phrases_for_sorting]
  2. The user can click and drag to rearrange the phrases
  3. When the user is done, they can click a button to check their answer
  4. If they got it wrong, the phrases will be shuffled again and they can try again
  5. If they got it right, they can move on to the next activity
 %>

<% phrase_objects = (params[:phrases_for_sorting] || []) %>
<% phrases = prepare_phrases_for_sorting(phrase_objects) %>
<% correct_order = phrases.map { |phrase, i| i } %>
<% shuffled_phrases = phrases.map.with_index { |phrase, i| { text: phrase, id: i } }.shuffle %>

<div
    data-controller="sort-phrases-activity"
    data-sort-phrases-activity-correct-order-value="<%= phrases %>"
    class="flex-col flex items-center bg-gray-800">
  <div class="w-full max-w-[640px] p-4 sm:p-6 bg-gray-800 rounded-lg shadow-lg">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl text-white mb-2"><%= @activity.text_header || "Drag The Phrases To The Correct Order" %></h2>
    </div>
    
    <%= render partial: 'activities/mini_video_player', locals: {params: params} %>

    <div id="sort-phrases" class="flex flex-col">
      <button
        data-action="click->sort-phrases-activity#checkOrder"
        data-sort-phrases-activity-target="checkButton"
        id="check-order"
        class="my-2 w-full sm:w-auto px-6 py-3 sm:py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200 text-md sm:text-base"
      >Check Order</button>
      <div data-sort-phrases-activity-target="completionMessage" data-progress-tracker-target="completion" id="completion-message" class="hidden my-4 p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-center sm:text-left text-xl font-bold text-white">Great job!</h3>
          <p class="text-center sm:text-left text-gray-300">You've sorted all the phrases correctly.</p>
        </div>
        <%= link_to_next_activity("Next", @next_activity_path, class: "w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center") %>
      </div>

      <div
          data-sort-phrases-activity-target="phrasesContainer"
          id="phrases-container"
          class="flex flex-col space-y-3 mt-3">
        <% shuffled_phrases.each do |item| %>
          <div
              data-sort-phrases-activity-target="phraseItem"
              draggable
              class="md:my-4 px-4 py-3 sm:px-5 border border-gray-700 rounded-lg bg-gray-900 hover:bg-gray-700 text-white text-center cursor-move text-md md:text-xl"
              data-id="<%= item[:id] %>"
              >
            <%= item[:text] %>
          </div>
        <% end %>
      </div>
    </div>

    <div data-sort-phrases-activity-target="resultMessage" id="result-message" class="mt-4 p-4 bg-red-200 border border-red-500 text-red-800 rounded-lg text-center hidden">
      <p id="result-text" class="text-lg font-medium">Not quite right. Try again!</p>
    </div>    
  </div>  
</div>

<style>
@keyframes fade-in {
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fade-in 0.5s ease-out forwards;
}

.phrase-item {
  user-select: none;
  touch-action: none; /* Improve touch interactions */
  position: relative;
  z-index: 1;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.phrase-item.opacity-80 {
  z-index: 10; /* Ensure dragged item stays on top */
}

.phrase-item.shadow-lg {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
}

.phrase-item.scale-105 {
  transform: scale(1.05);
}

.sortable-ghost {
  background-color: lightblue !important;
  z-index: 10 !important;
}

</style>

