<title><%= content_for(:title) || t(".title") %></title>
<meta name="description" content="<%= content_for(:meta_description) || SeoHelper::DEFAULT_DESCRIPTION %>">
<link rel="canonical" href="<%= content_for(:canonical_url) || 'https://langlets.app' %>">
<%# maximum-scale/user-scalable are appended only for the native app: WKWebView
    honours both, so focusing a field can never zoom the shell out of alignment
    with the native tab bar. Mobile Safari has ignored them since iOS 10, so
    adding them unconditionally would be a no-op on the web — but leaving them
    off there keeps the intent honest: pinch-zoom stays available on the site. %>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover<%= ",maximum-scale=1,user-scalable=no" if native_app? %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<script type="application/json" id="i18n-strings"><%= raw I18n.t("js").to_json %></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<%= yield :head %>

<%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
<%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">
<meta name="view-transition" content="same-origin" />

<%# Link only the compiled CSS. The Tailwind source file contains build-time
    imports that browsers would otherwise request as separate assets. %>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

