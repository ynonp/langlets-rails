<% content_for :head do %>
  <% youtube_video_id = @videoid %>
  <% thumbnail_url = youtube_thumbnail_url(youtube_video_id) %>
  <% title = "#{@lesson.course&.name || @lesson.name} - Langlets" %>
  <% description = "Learn languages with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities." %>
  
  <!-- Page title -->
  <title><%= title %></title>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= thumbnail_url %>">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="og:site_name" content="Langlets">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="<%= course_url %>">
  <meta property="twitter:title" content="<%= title %>">
  <meta property="twitter:description" content="<%= description %>">
  <meta property="twitter:image" content="<%= thumbnail_url %>">
<% end %>

<div class="flex flex-col min-h-screen w-full bg-gray-900"
    data-controller="main-video-player activity-navigation "
    data-action="play->main-video-player#playFrom"
    data-main-video-player-video-id-value="<%= @videoid %>"
    
>
  <div
    id="main-player"
    data-turbo-permanent
    class="hidden"
    data-main-video-player-target="player"    
  >
  </div>

  <turbo-frame
    id="activity"
    data-action="turbo:frame-render->activity-navigation#activityChange"    
  >
    <%= render partial: 'activity_navigation' %>
    <div
      data-controller="progress-tracker"
      data-action="activity:completed->progress-tracker#sendProgressUpdate"
      data-progress-tracker-progress-data-value="<%= @progress_data.to_json %>"
      class="items-stretch flex-1 bg-gray-800"
      data-activity-navigation-target="content"
      data-activity-navigation-url="<%= @current_url %>"
    >  
      <%= render partial: @activity.partial_name, locals: { params: @activity.activity_params } %>
    </div>
  </turbo-frame>
</div>
