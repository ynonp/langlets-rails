<div class="sprout" style="--hue: 150;">
  <div class="min-h-screen w-full flex items-center justify-center relative" style="background: var(--bg); min-height: 100dvh;">
    <%= link_to root_path, class: "s-ctl absolute", style: "top: 24px; left: 16px; box-shadow: none;" do %>
      <svg class="w-6 h-6" fill="none" stroke="var(--muted)" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    <% end %>

    <div class="w-full max-w-md px-6">
      <div class="text-center mb-8">
        <h1 class="s-h1" style="font-size: 30px;">Change password</h1>
        <% if @minimum_password_length %>
          <p class="s-small" style="margin-top: 6px;"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "New password", class: "s-input" %>
        </div>

        <div>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password", class: "s-input" %>
        </div>

        <div>
          <%= f.submit "CHANGE MY PASSWORD", class: "s-btn s-btn--full s-btn--lg" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <p class="s-small">
          <%= link_to "Back to sign in", new_user_session_path, style: "color: var(--accent); font-weight: 700;" %>
        </p>
      </div>
    </div>
  </div>
</div>
