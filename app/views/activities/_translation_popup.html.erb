<% popup_class = local_assigns[:popup_class] || "hidden absolute bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-50 p-2 rounded shadow-lg z-30" %>
<% l1_rtl = local_assigns[:l1_rtl] || false %>
<div data-popover-translation-target="translationPopup" class="<%= popup_class %>">
  <div data-popover-translation-target="translationText" dir="<%= l1_rtl ? 'rtl' : 'ltr' %>" class="<%= 'text-right' if l1_rtl %>"></div>
  <% if user_signed_in? %>
  <button
    data-popover-translation-target="saveButton"
    data-action="click->popover-translation#toggleSave"
    class="mt-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 border border-gray-200 dark:border-gray-600 rounded-md flex items-center justify-center transition-colors w-full"
    title="Save for review">
    <span data-popover-translation-target="saveIcon" class="mr-1 text-lg">🔖</span>
    <span data-popover-translation-target="saveText" class="text-sm text-gray-700 dark:text-gray-300 font-medium"><%= t(".save") %></span>
  </button>
  <% end %>
</div>
