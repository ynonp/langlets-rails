<%# Course card partial for grid layout - handles both regular courses and courses with progress %>
<%= link_to course_path(id: course.slug), class: "block bg-slate-800 rounded-xl shadow-lg hover:shadow-xl transition duration-300 cursor-pointer border border-slate-700 flex flex-col h-full min-w-0" do %>
  <% if course.main_media_url.present? %>
    <% youtube_video_id = course.main_media_url.split("v=").last %>
    <img src="<%= youtube_thumbnail_url(youtube_video_id) %>" alt="<%= course.name %>" class="w-full h-40 object-cover rounded-t-xl flex-shrink-0">
  <% else %>
    <div class="w-full h-40 bg-slate-700 rounded-t-xl flex items-center justify-center flex-shrink-0">
      <svg class="w-12 h-12 text-slate-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
      </svg>
    </div>
  <% end %>
  <div class="p-4 flex flex-col flex-grow">
    <div class="flex-grow">
      <h3 class="text-lg font-semibold text-slate-100 mb-2 min-h-[1.75rem] flex items-center">
        <%= course.name.present? ? course.name : "Untitled Course" %>
      </h3>
      <div class="flex items-center text-sm text-slate-400 mb-3">
        <% if course.language.present? %>
          <% if course.respond_to?(:has_progress?) && course.has_progress? %>
            <span class="mr-2 px-2 py-0.5 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium">
              <%= course.language.english_name %>
            </span>
          <% else %>
            <span class="mr-2 px-2 py-0.5 bg-blue-100 text-blue-800 rounded-full text-xs font-medium">
              <%= course.language.english_name %>
            </span>
          <% end %>
          <span class="mr-2">·</span>
        <% end %>
        <% lesson_count = course.respond_to?(:total_lessons_count) ? course.total_lessons_count : course.lessons.count %>
        <span><%= pluralize(lesson_count, 'lesson') %></span>
      </div>
      
      <%# Show progress bar if user has progress on this course %>
      <% if course.respond_to?(:has_progress?) && course.has_progress? && course.user_progress > 0 %>
        <div class="mb-3">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span>Progress</span>
            <span><%= course.user_progress %>%</span>
          </div>
          <div class="w-full bg-slate-700 rounded-full h-2">
            <div class="bg-green-500 h-2 rounded-full transition-all duration-300" style="width: <%= course.user_progress %>%"></div>
          </div>
        </div>
      <% end %>
    </div>
    
    <%# Show appropriate button based on progress %>
    <% if course.respond_to?(:has_progress?) && course.has_progress? %>
      <div class="w-full bg-green-600 text-white py-2 rounded-lg font-medium hover:bg-green-700 transition duration-200 text-center mt-auto">
        Continue Learning
      </div>
    <% else %>
      <div class="w-full bg-blue-600 text-white py-2 rounded-lg font-medium hover:bg-blue-700 transition duration-200 text-center mt-auto">
        Start Course
      </div>
    <% end %>
  </div>
<% end %>
