<% compact = local_assigns.fetch(:compact, false) %>

<div class="app-hairline bg-app-card <%= compact ? 'rounded-[14px]' : 'rounded-app-card' %> overflow-hidden flex flex-col">
  <%= link_to course_path(course) do %>
    <%= image_tag course_thumbnail_url(course),
                  alt: "", loading: "lazy",
                  class: "w-full aspect-video object-cover bg-app-inset" %>
  <% end %>

  <div class="<%= compact ? 'px-2.5 pt-2 pb-2.5' : 'px-3 pt-2.5 pb-3' %> flex flex-col gap-1 flex-1">
    <%# The mockup pins these to a fixed 34px height; line-clamp is the same two
        lines without breaking when the font metrics differ. %>
    <%= link_to course.localized_name, course_path(course),
                class: "app-clamp-2 font-semibold leading-[1.25] #{compact ? 'text-[12px] min-h-[30px]' : 'text-[13px] min-h-[34px]'}" %>

    <p class="text-app-text-2 <%= compact ? 'text-[10px]' : 'text-[11px]' %>">
      <% unless compact %><%= localized_language_name(course.language) %> · <% end %><%= t("courses.lesson_count", count: lessons_count) %>
    </p>
    <% if local_assigns[:channel] %>
      <%= link_to t("channels.card.by", channel: channel.name), channel_path(channel.slug),
                  class: "text-app-text-3 text-[10px] truncate" %>
    <% end %>

    <% if local_assigns.fetch(:show_enrollment_action, true) %>
      <div class="mt-auto pt-1">
      <% if enrolled %>
        <span class="text-app-text-3 text-xs font-bold">On your Home</span>
      <% else %>
        <%# Free: the content is already imported, so there's no AI work to bill. %>
        <%= button_to app_enrollments_path(course_slug: course.slug),
                      class: "text-app-accent text-xs font-bold" do %>
          + Learn this
        <% end %>
      <% end %>
      </div>
    <% end %>
  </div>
</div>
