<%# Spotify-style "Add to learning paths" popup. Rendered only for users who can manage the course. %>
<div data-course-paths-target="overlay"
     class="hidden fixed inset-0 z-[100] flex items-end sm:items-center justify-center">
  <div class="absolute inset-0 bg-black/60" data-action="click->course-paths#close"></div>

  <div class="relative w-full max-w-[480px] max-h-[85vh] flex flex-col rounded-t-3xl sm:rounded-3xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-2xl overflow-hidden">
    <!-- Header -->
    <div class="grid grid-cols-3 items-center px-4 py-3.5 border-b border-gray-100 dark:border-gray-800">
      <button type="button" data-action="course-paths#close"
              class="justify-self-start text-sm font-semibold text-gray-500 dark:text-gray-400 hover:opacity-70">Cancel</button>
      <h3 class="text-center text-base font-extrabold text-gray-900 dark:text-gray-50">Add to path</h3>
      <span class="justify-self-end"></span>
    </div>

    <!-- New path button -->
    <div class="px-4 pt-4">
      <button type="button" data-action="course-paths#createNew"
              class="w-full h-12 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors">
        New learning path
      </button>
    </div>

    <!-- Search -->
    <div class="px-4 pt-3">
      <div class="flex items-center gap-2 h-11 px-3 rounded-xl bg-gray-100 dark:bg-gray-800">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-gray-400 flex-shrink-0"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="text" placeholder="Find a learning path"
               data-course-paths-target="search" data-action="input->course-paths#filter"
               class="flex-1 bg-transparent outline-none text-sm font-semibold text-gray-900 dark:text-gray-50 placeholder-gray-400">
      </div>
    </div>

    <!-- List -->
    <div class="flex-1 min-h-0 overflow-y-auto px-2 py-3" data-course-paths-target="list">
      <div data-course-paths-target="loading" class="py-10 text-center text-sm font-semibold text-gray-400">Loading…</div>
      <div data-course-paths-target="empty" class="hidden py-10 text-center text-sm font-semibold text-gray-400">No learning paths found.</div>
    </div>

    <!-- Footer -->
    <div class="p-4 border-t border-gray-100 dark:border-gray-800 flex justify-center">
      <button type="button" data-action="course-paths#close"
              class="h-12 px-10 rounded-full bg-gray-900 dark:bg-gray-50 text-white dark:text-gray-900 font-extrabold hover:opacity-90 transition-opacity">Done</button>
    </div>
  </div>
</div>
