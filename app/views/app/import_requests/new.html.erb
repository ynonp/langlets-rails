<% content_for :title, t(".page_title") %>
<% broke = current_user.credit_balance.zero? %>

<%# Rendered as a full page, not a Turbo Frame overlay. iOS presents it as a real
    bottom sheet via the path configuration (context: modal, modal_style: medium),
    which gives a native grabber and dismissal gesture; a frame-based overlay
    would fight that and you'd get two competing dismissals. The sheet chrome
    below is CSS so it still looks right in a desktop browser. %>
<div class="min-h-dvh flex flex-col justify-end bg-transparent">
  <div class="app-sheet-top bg-app-sheet rounded-t-app-sheet px-5 pt-2.5 pb-11 flex flex-col gap-4">
    <%# Grabber — redundant under the native sheet, but this screen is also viewed
        in a browser during development. %>
    <div class="flex justify-center">
      <div class="w-9 h-[5px] rounded-full bg-white/20"></div>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <h1 class="text-xl font-extrabold tracking-[-0.4px]"><%= t(".title") %></h1>
        <span class="flex items-center gap-1.5 bg-app-pill rounded-full py-1 px-2.5">
          <%= app_icon "bolt", class: "w-[11px] h-[11px] text-app-accent" %>
          <span class="text-app-credits text-xs font-bold"><%= app_credits_label(current_user.credit_balance) %></span>
        </span>
      </div>

      <%= link_to app_home_path,
                  class: "w-[30px] h-[30px] rounded-full bg-app-pill flex items-center justify-center text-app-text-2",
                  aria: { label: "Close" } do %>
        <%= app_icon "close", class: "w-3.5 h-3.5" %>
      <% end %>
    </div>

    <% if flash[:alert] %>
      <p class="rounded-app-field border-[0.5px] border-red-500/30 bg-red-500/10 text-red-300 text-[13px] leading-relaxed py-3 px-3.5">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <% if broke %>
      <%= render "app/credits/out_of_credits_body" %>
    <% else %>
      <%= form_with url: app_import_requests_path, method: :post, class: "flex flex-col gap-4" do |f| %>
        <%# The mockup's segmented control offers "Search YouTube" as well. Only
            "Paste link" is built: search needs the YouTube Data API and a key,
            and a segment that does nothing is worse than no segment. %>

        <div class="app-inset-hairline bg-app-inset rounded-app-input py-3.5 px-3.5">
          <%= f.url_field :url, value: params[:url],
                          placeholder: "youtube.com/watch?v=…",
                          required: true, autofocus: true,
                          autocomplete: "off", autocapitalize: "off", spellcheck: "false",
                          class: "w-full bg-transparent font-mono text-[13px] text-[#C7D3DD] placeholder:text-app-text-3 outline-none" %>
        </div>

        <div class="app-inset-hairline bg-app-inset rounded-app-field overflow-hidden">
          <label class="flex items-center justify-between py-3.5 px-4 border-b-[0.5px] border-white/8">
            <span class="text-app-text-dim text-sm"><%= t(".video_language") %></span>
            <%= f.select :clip_language,
                         options_from_collection_for_select(@languages, :english_name, :english_name, @clip_language&.english_name),
                         {},
                         class: "bg-transparent text-sm font-semibold text-app-text text-right outline-none" %>
          </label>

          <label class="flex items-center justify-between py-3.5 px-4">
            <span class="text-app-text-dim text-sm"><%= t(".translate_to") %></span>
            <%= f.select :translation_language,
                         options_from_collection_for_select(@languages, :english_name, :english_name, @translation_language&.english_name),
                         {},
                         class: "bg-transparent text-sm font-semibold text-app-text text-right outline-none" %>
          </label>
        </div>

        <div class="flex flex-col gap-2">
          <%= f.submit t(".import_credit"),
                       class: "w-full bg-app-accent text-app-on-accent rounded-full py-4 text-base font-bold" %>
          <p class="text-center text-app-text-3 text-xs">
            Usually ready in ~5 min — we'll send you a push.
          </p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
