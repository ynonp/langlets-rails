<%# 
  Course card partial - displays a single course with consistent styling
  
  Required locals:
  - course: The course object to display
  
  Optional locals:
  - container_classes: Additional CSS classes for the container (default: standard card classes)
  - show_progress: Whether to show progress bar (default: auto-detected from course.has_progress?)
-%>

<%
  # Set default values for optional locals
  container_classes ||= "block bg-slate-800 rounded-xl shadow-lg hover:shadow-xl transition duration-300 cursor-pointer border border-slate-700 flex flex-col h-full min-w-0"
  show_progress = local_assigns.fetch(:show_progress, course.respond_to?(:has_progress?) && course.has_progress?)
  
  # Determine button styling and text based on progress
  if show_progress
    button_text = "Continue Learning"
    button_classes = "w-full bg-green-600 text-white py-2 rounded-lg font-medium hover:bg-green-700 transition duration-200 text-center mt-auto"
    language_badge_classes = "mr-2 px-2 py-0.5 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium"
  else
    button_text = "Start Course"
    button_classes = "w-full bg-blue-600 text-white py-2 rounded-lg font-medium hover:bg-blue-700 transition duration-200 text-center mt-auto"
    language_badge_classes = "mr-2 px-2 py-0.5 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
  end
  
  # Get lesson count (use cached count if available to avoid N+1 queries)
  lesson_count = if course.respond_to?(:cached_lesson_count)
    course.cached_lesson_count
  elsif course.respond_to?(:total_lessons) && course.total_lessons.present?
    course.total_lessons.to_i
  else
    course.lessons.count
  end
  
  # Get user progress
  user_progress = course.respond_to?(:user_progress) ? course.user_progress : 0
%>

<%= link_to course_path(id: course.slug), class: container_classes do %>
  <!-- Course Image -->
  <% if course.main_media_url.present? %>
    <% youtube_video_id = course.main_media_url.split("v=").last %>
    <img src="<%= youtube_thumbnail_url(youtube_video_id) %>" alt="<%= course.name %>" class="w-full h-40 object-cover rounded-t-xl flex-shrink-0">
  <% else %>
    <div class="w-full h-40 bg-slate-700 rounded-t-xl flex items-center justify-center flex-shrink-0">
      <svg class="w-12 h-12 text-slate-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
      </svg>
    </div>
  <% end %>
  
  <!-- Course Content -->
  <div class="p-4 flex flex-col flex-grow">
    <div class="flex-grow">
      <!-- Course Title -->
      <h3 class="text-lg font-semibold text-slate-100 mb-2 min-h-[1.75rem] flex items-center">
        <%= course.name.present? ? course.name : "Untitled Course" %>
      </h3>
      
      <!-- Course Metadata -->
      <div class="flex items-center justify-between text-sm text-slate-400 mb-3">
        <div class="flex items-center">
          <% if course.language.present? %>
            <span class="<%= language_badge_classes %>">
              <%= course.language.english_name %>
            </span>
            <span class="mr-2">·</span>
          <% end %>
          <span><%= pluralize(lesson_count, 'lesson') %></span>
        </div>
        
        <!-- Likes section -->
        <div class="flex items-center space-x-1">
          <% 
            # Get likes data
            likes_count = course.respond_to?(:cached_likes_count) ? course.cached_likes_count : course.likes_count
            user_liked = course.respond_to?(:user_liked?) ? course.user_liked? : (user_signed_in? && course.liked_by?(current_user))
          %>
          <div class="flex items-center space-x-1" 
               data-controller="course-like"
               data-course-like-course-id-value="<%= course.id %>"
               data-course-like-liked-value="<%= user_liked %>"
               data-course-like-likes-count-value="<%= likes_count %>"
               data-authenticated="<%= user_signed_in? %>">
            <button type="button" 
                    data-action="click->course-like#toggle" 
                    class="p-1 hover:bg-slate-700 rounded transition-colors duration-200"
                    data-course-like-target="star">
              <% if user_liked %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                </svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.563.563 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                </svg>
              <% end %>
            </button>
            <span class="text-xs" data-course-like-target="count"><%= likes_count %></span>
          </div>
        </div>
      </div>
      
      <!-- Progress Bar (only if user has progress) -->
      <% if show_progress && user_progress > 0 %>
        <div class="mb-3">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span>Progress</span>
            <span><%= user_progress %>%</span>
          </div>
          <div class="w-full bg-slate-700 rounded-full h-2">
            <div class="bg-green-500 h-2 rounded-full transition-all duration-300" style="width: <%= user_progress %>%"></div>
          </div>
        </div>
      <% end %>
    </div>
    
    <!-- Action Button -->
    <div class="<%= button_classes %>">
      <%= button_text %>
    </div>
  </div>
<% end %>
