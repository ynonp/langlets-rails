<main class="profile-safe-area max-w-4xl mx-auto px-5 py-8">
  <h1 class="text-3xl font-bold mb-6"><%= t("channels.admin.title") %></h1>
  <%= form_with model: [:admin, @channel], class: "flex gap-3 mb-8" do |form| %>
    <%= form.text_field :name, required: true, placeholder: t("channels.fields.name"), class: "border rounded-xl px-4 py-2 flex-1" %>
    <%= form.submit t("channels.admin.create"), class: "rounded-xl bg-emerald-600 text-white px-4" %>
  <% end %>
  <div class="space-y-3">
    <% @channels.each do |channel| %>
      <%= form_with model: [:admin, channel], class: "rounded-2xl border p-4 flex gap-3 items-center" do |form| %>
        <%= form.text_field :name, class: "border rounded-xl px-3 py-2 flex-1" %>
        <%= form.select :visibility, Channel.visibilities.keys.map { |value| [t("channels.visibility.#{value}"), value] }, {}, class: "border rounded-xl px-3 py-2" %>
        <%= form.submit t("channels.actions.save"), class: "text-emerald-600" %>
      <% end %>
    <% end %>
  </div>
</main>
