<div id="gallery-results">
  <% if @search.present? %>
    <div class="gallery-summary">
      <span><%= t("supplemental.result_count", count: @total_count) %></span>
      <button type="button" class="gallery-clear" data-action="gallery-filters#clearSearch"><%= t("supplemental.clear_search") %></button>
    </div>
  <% end %>

  <% if @entries.any? || @import_requests.any? %>
    <section class="gallery-grid" aria-label="<%= t("supplemental.gallery_results") %>">
      <%= render partial: "import_request_card", collection: @import_requests, as: :import_request %>
      <%= render partial: "card", collection: @entries, as: :entry %>
    </section>
  <% else %>
    <div class="gallery-empty"><%= t("supplemental.gallery_empty") %></div>
  <% end %>

  <% if @total_pages > 1 %>
    <nav class="gallery-pagination" aria-label="<%= t("supplemental.pagination") %>">
      <% pages = [1, @page - 1, @page, @page + 1, @total_pages].select { |page| page.between?(1, @total_pages) }.uniq.sort %>
      <% previous_page = nil %>
      <% pages.each do |page| %>
        <% if previous_page && page - previous_page > 1 %>
          <span class="gallery-page-ellipsis" aria-hidden="true">&hellip;</span>
        <% end %>
        <%= link_to page, gallery_path(search: @search.presence, imports: @import_filter, types: @selected_types, languages: @selected_languages.map(&:iso_name), page: page),
              class: "gallery-page-link", aria: (page == @page ? { current: "page" } : {}),
              data: { turbo_stream: true } %>
        <% previous_page = page %>
      <% end %>
    </nav>
  <% end %>
</div>
