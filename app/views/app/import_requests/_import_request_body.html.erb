<%# Body + action button, replaced as one unit during polling so the thumbnail
    stays in the DOM and doesn't flash. %>
<div id="<%= dom_id(import_request, :body) %>" class="flex-1 min-w-0 flex items-center gap-3">
  <div class="flex-1 min-w-0 flex flex-col gap-1.5">
    <p class="text-sm font-semibold truncate <%= import_request.queued? ? 'text-app-text-dim' : '' %>">
      <%= import_request.title.presence || import_request.youtube_url %>
    </p>

    <% case import_request.status %>
    <% when "importing" %>
      <div class="h-[5px] rounded-full bg-white/12 overflow-hidden">
        <div class="h-[5px] rounded-full bg-app-accent transition-[width] duration-500"
             style="width: <%= import_request.display_percent %>%"></div>
      </div>
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-1.5 min-w-0">
          <%= app_icon "spinner", class: "w-3.5 h-3.5 text-app-accent animate-spin shrink-0" %>
          <p class="text-app-accent text-xs font-semibold truncate"><%= import_request.stage_label %></p>
        </div>
        <% if import_request.charged? %>
          <span class="shrink-0 text-app-text-3 text-[11px]">1 credit used</span>
        <% end %>
      </div>

    <% when "queued" %>
      <div class="flex items-center justify-between gap-2">
        <p class="text-app-text-3 text-xs">Queued — up next</p>
        <% if import_request.charged? %>
          <span class="shrink-0 text-app-text-3 text-[11px]">1 credit used</span>
        <% end %>
      </div>

    <% when "ready" %>
      <div class="flex items-center gap-1.5">
        <%= app_icon "check_circle", class: "w-3.5 h-3.5 text-app-accent" %>
        <span class="text-app-accent text-xs font-semibold">Ready</span>
      </div>

    <% when "failed" %>
      <div class="flex items-center gap-1.5">
        <%= app_icon "warning", class: "w-3.5 h-3.5 text-red-400" %>
        <span class="text-red-400 text-xs font-semibold">Import failed — credit refunded</span>
      </div>

    <% when "canceled" %>
      <p class="text-app-text-3 text-xs">Cancelled</p>
    <% end %>
  </div>

  <% if import_request.failed? %>
    <% tooltip_id = dom_id(import_request, :failed_help) %>
    <span class="group relative shrink-0">
      <button type="button"
              class="w-8 h-8 rounded-full bg-app-pill text-app-text-2 flex items-center justify-center"
              aria-label="<%= t("app.import_requests.index.failed_help_label") %>"
              aria-describedby="<%= tooltip_id %>">
        <%= app_icon "info", class: "w-4 h-4" %>
      </button>
      <span id="<%= tooltip_id %>" role="tooltip"
            class="pointer-events-none invisible absolute bottom-full end-0 z-20 mb-2 w-64 rounded-lg bg-slate-950 px-3 py-2 text-start text-xs font-medium leading-relaxed text-white opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
        <%= t("app.import_requests.index.failed_help") %>
      </span>
    </span>
  <% elsif import_request.queued? %>
    <%= button_to app_import_request_path(import_request), method: :delete,
                  data: { action: "click->swipe-to-delete#remove" },
                  class: "shrink-0 w-8 h-8 rounded-full bg-app-pill text-app-text-2 flex items-center justify-center",
                  aria: { label: "Cancel this import" } do %>
      <%= app_icon "close", class: "w-3.5 h-3.5" %>
    <% end %>
  <% end %>
</div>
