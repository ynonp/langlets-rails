<%# Expects:
  params[:phrases_for_sorting] - An array of phrase objects
  current_script - Script object for current script (passed as local)

  The phrases start shuffled and can be dragged into their original order.
 %>

<% phrase_objects = params[:phrases_for_sorting] || [] %>
<% phrases = prepare_phrases_for_sorting(phrase_objects) %>
<% shuffled_phrases = phrases.map.with_index { |phrase, index| { text: phrase, id: index } }.shuffle %>

<div
  data-controller="sort-phrases-activity"
  data-sort-phrases-activity-correct-order-value="<%= phrases %>"
  class="flex min-h-0 flex-1 flex-col items-center overflow-y-auto bg-emerald-50 px-4 py-6 dark:bg-gray-950 sm:py-10">
  <div data-sort-phrases-activity-target="activityContent" class="w-full max-w-lg">
    <header class="mb-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-50 sm:text-xl">
        <%= @activity.text_header.presence || t(".instruction") %>
      </h2>
      <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">
        <%= @activity.text_subheader.presence || t(".subinstruction") %>
      </p>
    </header>

    <%= render partial: "activities/mini_video_player", locals: { params: params } %>

    <p class="-mt-4 mb-6 flex items-start gap-2 text-sm leading-5 text-gray-500 dark:text-gray-400">
      <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path stroke-linecap="round" d="M12 11v5m0-8h.01"></path>
      </svg>
      <span><%= t(".hint") %></span>
    </p>

    <div id="sort-phrases" class="flex flex-col">
      <div
        id="phrases-container"
        data-sort-phrases-activity-target="phrasesContainer"
        class="flex flex-col gap-2.5">
        <% shuffled_phrases.each do |item| %>
          <div
            data-sort-phrases-activity-target="phraseItem"
            data-id="<%= item[:id] %>"
            draggable
            class="group flex cursor-move select-none items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 text-gray-900 shadow-sm transition hover:border-emerald-300 hover:shadow-md dark:border-gray-700 dark:bg-gray-900 dark:text-gray-50 dark:hover:border-emerald-700">
            <svg class="size-5 shrink-0 text-gray-400 transition-colors group-hover:text-emerald-500 dark:text-gray-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="9" cy="6" r="1.5"></circle>
              <circle cx="9" cy="12" r="1.5"></circle>
              <circle cx="9" cy="18" r="1.5"></circle>
              <circle cx="15" cy="6" r="1.5"></circle>
              <circle cx="15" cy="12" r="1.5"></circle>
              <circle cx="15" cy="18" r="1.5"></circle>
            </svg>
            <span class="min-w-0 flex-1 text-base leading-6 sm:text-lg"><%= item[:text] %></span>
          </div>
        <% end %>
      </div>

      <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <button
          id="check-order"
          data-action="click->sort-phrases-activity#checkOrder"
          data-sort-phrases-activity-target="checkButton"
          class="inline-flex h-11 items-center justify-center rounded-xl bg-emerald-500 px-6 font-bold text-white transition hover:bg-emerald-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 active:scale-[0.98]">
          <%= t(".check_order") %>
        </button>

        <div
          id="result-message"
          data-sort-phrases-activity-target="resultMessage"
          class="hidden text-sm font-medium text-red-600 dark:text-red-400"
          role="status">
          <%= t(".incorrect") %>
        </div>
      </div>

    </div>
  </div>

  <div
    id="completion-message"
    data-sort-phrases-activity-target="completionMessage"
    data-progress-tracker-target="completion"
    class="my-auto hidden w-full max-w-lg flex flex-col gap-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 sm:flex-row sm:items-center sm:justify-between dark:border-emerald-800 dark:bg-emerald-950/30">
    <div>
      <h3 class="font-bold text-emerald-900 dark:text-emerald-100"><%= t(".great_job") %></h3>
      <p class="mt-1 text-sm text-emerald-700 dark:text-emerald-300"><%= t(".completed") %></p>
    </div>
    <%= link_to_next_activity(t(".next"), @next_activity_path, class: "inline-flex h-11 shrink-0 items-center justify-center rounded-xl bg-emerald-500 px-6 font-bold text-white transition hover:bg-emerald-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500") %>
  </div>
</div>
