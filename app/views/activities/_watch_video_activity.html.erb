<%
    phrases = params[:phrases]
%>

<div
    class="flex-col flex items-center bg-gray-800 overflow-hidden"
    data-controller="video-player"
    data-video-player-video-id-value="<%= params[:video_id] %>"
    data-video-player-mini-player-value="false"
    data-video-player-segment-start-value="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
    data-video-player-segment-end-value="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
    data-video-player-current-text-line-class="bg-gray-700"
>
  <div class="w-full max-w-[640px] px-4 sm:p-6 rounded-lg shadow-lg flex flex-col h-[calc(100vh-120px)]">
    <div class="mb-2 text-center">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2"><%= @activity.text_header %></h2>
      <p class="text-sm sm:text-base text-gray-400"><%= @activity.text_subheader %></p>
    </div>
    
    <div id="player-container" class="w-[90vw] relative aspect-video bg-black">
      <div data-video-player-target="player" class="w-full h-full pointer-events-none"></div>

      <!-- Overlay Play Button -->
      <div id="overlay" class="absolute inset-0 z-20 flex items-center justify-center cursor-pointer bg-transparent"
                        data-action="click->video-player#togglePlayback">
        <button data-video-player-target="playButton"
          class="text-white text-3xl sm:text-5xl bg-blue-600 px-4 py-3 sm:px-6 sm:py-4 rounded-full shadow-lg hover:bg-blue-700 transition">
          ▶
        </button>
      </div>

      <!-- Custom Progress Bar -->
      <div class="absolute bottom-0 left-0 w-full h-2 bg-gray-700 z-10">
        <div data-video-player-target="progressBar" class="h-full bg-blue-500 transition-all duration-100 ease-linear" style="width: 0%"></div>
      </div>
    </div>

    <!-- Control Bar -->
    <div class="my-4 flex justify-between items-center">
      <label class="flex items-center text-white">
        <input type="checkbox" data-video-player-target="showTranslation" data-action="change->video-player#toggleTranslation" class="mr-2">
        Show Translation
      </label>
      <%= link_to "Start Activity", @next_activity_path, { class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200"} %>
    </div>

    <div class="my-6 flex justify-center hidden">
      <%= link_to "Start Practice", @next_activity_path, { class: "w-full sm:w-auto px-6 py-3 sm:py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200 text-center text-lg sm:text-base"} %>
    </div>


    <!-- Phrases Container with scrolling -->
    <div
        data-controller="popover-translation"
        id="phrases-container"
        data-video-player-target="container"
        class="w-full mx-auto bg-gray-800 flex-1 overflow-y-auto"
        >
      <div
        id="phrases-list" 
        data-video-player-target="phrasesList"
        class="text-white text-sm sm:text-base">
        <% phrases.each do |phrase| %>
          <div
            data-video-player-target="subtitles"
            data-timestamp="<%= timestamp_to_seconds(phrase.timestamp) %>"  
            class="px-4 py-3 transition-all duration-200">
            <div class="text-white text-xl">
              <%= wrap_tokens_in_spans(phrase,
                                     {class: "cursor-pointer hover:bg-gray-600 rounded"}) %>
            </div>
            <div class="text-teal-400 mt-1 text-xl hidden" data-video-player-target="translation">
              <%= phrase.text_l2 %>
            </div>
          </div>
        <% end %>
      </div>
      <!-- Translation Popup -->
      <div data-popover-translation-target="translationPopup" class="hidden absolute bg-white text-gray-900 p-2 rounded shadow-lg z-30">
        <div data-popover-translation-target="translationText"></div>
      </div>
    </div>
  </div>
</div>
