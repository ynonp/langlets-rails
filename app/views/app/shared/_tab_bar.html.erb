<%# Bottom tab bar + floating Add button. Fixed, so screens need app-scroll-pad
    or their last card hides underneath it.

    Tabs use Turbo's `replace_root` (declared in the iOS path configuration)
    rather than a native UITabBarController: a fixed HTML tab bar inside a pushed
    web view would slide in and out with the page, and tapping Home from Library
    would push rather than switch. replace_root keeps all seven screens in ERB and
    needs no App Store release to change. SceneDelegate already uses the same
    presentation for language selection. %>
<% active = local_assigns.fetch(:active) %>

<nav class="app-tabbar fixed inset-x-0 bottom-0 z-30 flex justify-around pt-2.5 px-3.5"
     style="padding-bottom: calc(30px + env(safe-area-inset-bottom, 0px));"
     aria-label="Main">
  <%= render "app/shared/tab_bar_item", icon: "home", label: "Home",
             path: app_home_path, current: active == :home %>

  <%= render "app/shared/tab_bar_item", icon: "library", label: "Library",
             path: app_library_path, current: active == :library %>

  <%= render "app/shared/tab_bar_item", icon: "queue", label: "Queue",
             path: app_import_requests_path, current: active == :queue,
             badge: @queue_badge_count %>

  <%# The FAB sits in the fourth tab slot. No label — it deliberately breaks the
      rhythm of the other three. %>
  <div class="w-16 flex justify-center items-start">
    <%= link_to new_app_import_request_path,
                class: "app-fab-shadow w-11 h-11 rounded-full bg-app-accent text-app-on-accent-sm flex items-center justify-center",
                aria: { label: "Add a video" } do %>
      <%= app_icon "plus", class: "w-5 h-5" %>
    <% end %>
  </div>
</nav>
