<%
    phrases = params[:phrases]
    l1_rtl = params[:l1_rtl]
    l2_rtl = params[:l2_rtl]

    timestamp_start = params[:start_timestamp]
    timestamp_end = params[:end_timestamp]

    wv_prefs = current_user ? current_user.watch_video_preferences : User::WATCH_VIDEO_DEFAULTS
%>

<%= content_for :head do %>

<% end %>

<div
    class="contents"
    data-controller="watch-video-activity"
    data-main-video-player-target="videoListener videoSegment"
    data-action="
      video:play->main-video-player#seekToSegmentStartIfBefore
      video:play->watch-video-activity#handleVideoStart
      video:end->watch-video-activity#handleVideoEnd
      video:stop->watch-video-activity#handleVideoPause
      video:progress->watch-video-activity#progress
      watch-video-activity:pause->main-video-player#stopPlayback
      watch-video-activity:resume->main-video-player#resume
    "
    data-show-player="true"
    data-segment-start="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
    data-segment-end="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
    data-watch-video-activity-word-timing-value="<%= params[:word_timing] ? true : false %>"
    data-watch-video-activity-prefs-url-value="<%= watch_video_preferences_path %>"
>
  <div class="contents">
    <%= render "shared/video_transcript_header",
        word_timing: params[:word_timing],
        wv_prefs: wv_prefs,
        header_class: "order-4 flex items-center justify-between px-5 pt-3 pb-2" %>

    <% if @activity.text_header.present? %>
      <div class="order-4 px-5 pb-2">
        <h2 class="text-lg font-extrabold tracking-tight"><%= @activity.text_header %></h2>
        <% if @activity.text_subheader.present? %>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mt-0.5"><%= @activity.text_subheader %></p>
        <% end %>
      </div>
    <% end %>

    <!-- Phrases breakdown -->
    <%= render "shared/video_transcript_phrases",
        phrases: phrases,
        l1_rtl: l1_rtl,
        l2_rtl: l2_rtl,
        wv_prefs: wv_prefs,
        saved_ids_url: (token_translation_users_path if current_user),
        container_class: "order-4 flex-1 overflow-y-auto flex flex-col gap-4 px-5" %>

    <!-- Start practice -->
    <div class="order-4 px-5 flex-shrink-0 pt-3 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700" style="padding-bottom: calc(20px + env(safe-area-inset-bottom));">
      <a href="<%= @next_activity_path %>"
         data-watch-video-activity-target="startPracticeButton"
         class="w-full inline-flex items-center justify-center gap-2 h-16 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-base tracking-wide transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24"><path d="M13 2L4 14h6l-1 8 9-12h-6z" fill="#fff"/></svg>
        <%= t(".start_practice") %>
      </a>
    </div>
  </div>
</div>
