<% content_for :title, "Create New Course" %>

<div class="min-h-screen bg-slate-900 text-slate-100">
  <!-- Header -->
  <header class="py-6 border-b border-slate-700/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <%= link_to courses_path, class: "text-2xl font-bold text-slate-100 tracking-tight hover:text-blue-400 transition-colors" do %>
        ← Langlets
      <% end %>
      <h1 class="text-xl font-semibold text-slate-200">Create New Course</h1>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-slate-800 rounded-xl shadow-lg border border-slate-700 p-8">
      
      <!-- Form Header -->
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-slate-100 mb-2">Create a New Language Course</h2>
        <p class="text-slate-400">Fill out the form below to create an AI-generated language learning course from YouTube content.</p>
      </div>

      <!-- Error Messages -->
      <% if @course.errors.any? %>
        <div class="mb-6 p-4 bg-red-900/50 border border-red-500 rounded-lg">
          <h3 class="text-red-400 font-semibold mb-2">Please fix the following errors:</h3>
          <ul class="text-red-300 text-sm space-y-1">
            <% @course.errors.full_messages.each do |message| %>
              <li>• <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Form -->
      <%= form_with model: @course, local: true, class: "space-y-6" do |form| %>
        
        <!-- Course Name -->
        <div>
          <%= form.label :name, "Course Name", class: "block text-sm font-semibold text-slate-200 mb-2" %>
          <%= form.text_field :name, 
                class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "e.g., 'French Songs with Édith Piaf'" %>
        </div>

        <!-- Course Slug -->
        <div>
          <%= form.label :slug, "Course Slug (URL identifier)", class: "block text-sm font-semibold text-slate-200 mb-2" %>
          <%= form.text_field :slug, 
                class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "e.g., 'french-edith-piaf' (lowercase, no spaces)" %>
          <p class="text-xs text-slate-400 mt-1">This will be used in the URL. Use lowercase letters, numbers, and dashes only.</p>
        </div>

        <!-- YouTube URL -->
        <div>
          <%= form.label :main_media_url, "YouTube URL", class: "block text-sm font-semibold text-slate-200 mb-2" %>
          <%= form.url_field :main_media_url, 
                class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "https://www.youtube.com/watch?v=..." %>
        </div>

        <!-- Language Selection -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= label_tag :clip_language, "Content Language", class: "block text-sm font-semibold text-slate-200 mb-2" %>
            <%= select_tag :clip_language,
                  options_for_select(@languages.map { |lang| [lang.english_name, lang.english_name] }),
                  { class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
          </div>

          <div>
            <%= label_tag :translation_language, "Translation Language", class: "block text-sm font-semibold text-slate-200 mb-2" %>
            <%= select_tag :translation_language,
                  options_for_select(@languages.map { |lang| [lang.english_name, lang.english_name] }, 'English'),
                  { class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
          </div>
        </div>

        <!-- Course Language (for database) -->
        <div>
          <%= form.label :language_id, "Primary Language (for categorization)", class: "block text-sm font-semibold text-slate-200 mb-2" %>
          <%= form.collection_select :language_id, @languages, :id, :english_name, 
                { prompt: "Select the primary language of this course" },
                { class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
        </div>

        <!-- Lyrics URL (Optional) -->
        <div>
          <%= label_tag :lyrics_url, "Lyrics URL (Optional)", class: "block text-sm font-semibold text-slate-200 mb-2" %>
          <%= url_field_tag :lyrics_url, "", 
                class: "w-full px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "https://www.musixmatch.com/lyrics/..." %>
          <p class="text-xs text-slate-400 mt-1">Optional: Provide a Musixmatch or similar lyrics URL for better accuracy.</p>
        </div>

        <!-- Lesson Template -->
        <div>
          <%= label_tag :lesson_template, "Lesson Template", class: "block text-sm font-semibold text-slate-200 mb-2" %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="flex items-center p-4 bg-slate-700 border border-slate-600 rounded-lg cursor-pointer hover:bg-slate-600 transition-colors">
              <%= radio_button_tag :lesson_template, "song", true, class: "mr-3 text-blue-500" %>
              <div>
                <div class="font-semibold text-slate-100">Song Template</div>
                <div class="text-sm text-slate-400">Full song analysis with comprehensive activities</div>
              </div>
            </label>
            <label class="flex items-center p-4 bg-slate-700 border border-slate-600 rounded-lg cursor-pointer hover:bg-slate-600 transition-colors">
              <%= radio_button_tag :lesson_template, "short", false, class: "mr-3 text-blue-500" %>
              <div>
                <div class="font-semibold text-slate-100">Short Template</div>
                <div class="text-sm text-slate-400">Quick lessons for shorter content</div>
              </div>
            </label>
          </div>
        </div>

        <!-- Warning Box -->
        <div class="p-4 bg-yellow-900/50 border border-yellow-500 rounded-lg">
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-3 mt-0.5 flex-shrink-0">
              <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="text-yellow-400 font-semibold">Course Generation Takes Time</h4>
              <p class="text-yellow-200 text-sm mt-1">
                Creating your course will take approximately 10-15 minutes. We'll send you an email when it's ready!
              </p>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end space-x-4 pt-6">
          <%= link_to "Cancel", courses_path, class: "px-6 py-3 text-slate-400 hover:text-slate-200 font-semibold transition-colors" %>
          <%= form.submit "Create Course", 
                class: "px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800" %>
        </div>

      <% end %>
    </div>
  </main>
</div>
