<%# Nothing on Home yet — a brand new account. Not in the mockup; the mocks all
    show a populated app. %>
<div class="app-hairline bg-app-card rounded-app-hero px-5 py-8 flex flex-col items-center text-center gap-3">
  <div class="w-14 h-14 rounded-full bg-app-accent/15 flex items-center justify-center">
    <%= app_icon "plus", class: "w-6 h-6 text-app-accent" %>
  </div>

  <h3 class="text-xl font-extrabold tracking-[-0.4px]">Turn a video into lessons</h3>
  <p class="text-app-text-2 text-sm leading-relaxed max-w-[290px]">
    Paste a YouTube link and we'll break it into bilingual lessons you can practise.
    You have <%= pluralize(current_user.credit_balance, "credit") %> to start.
  </p>

  <%= link_to "Add a video", new_app_import_request_path,
              class: "mt-1 bg-app-accent text-app-on-accent rounded-full py-3 px-6 text-[15px] font-bold" %>

  <%= link_to "Or browse the Library", app_library_path,
              class: "text-app-accent text-[13px] font-semibold" %>
</div>
