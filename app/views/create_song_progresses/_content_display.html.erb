<div>
  <% if course&.published? %>
    <!-- Course Complete -->
    <div class="text-center py-8">
      <div class="mb-4">
        <svg class="w-16 h-16 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-green-400 mb-2">Course Creation Complete!</h2>
      <p class="text-gray-400 mb-6">Your course is ready and has been published</p>
      <%= link_to "View Course", course_path(course), class: "inline-block bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-8 rounded-lg transition" %>
    </div>
  <% elsif progress.data&.dig('lessons').present? %>
    <!-- Show Lessons -->
    <h2 class="text-xl font-semibold mb-4">Course Content</h2>
    <% progress.data['lessons'].each_with_index do |lesson, idx| %>
      <div class="mb-6 border-b border-gray-700 pb-6 last:border-0">
        <h3 class="text-lg font-bold text-blue-400 mb-3"><%= lesson['title'] %></h3>
        <div class="space-y-3">
          <% lesson['phrases'].each do |phrase| %>
            <%= render partial: 'phrase_with_translation', locals: { phrase: phrase, has_token_translations: progress.data&.dig('phrases_with_token_translations').present? } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% elsif progress.data&.dig('phrases').present? %>
    <!-- Show All Phrases -->
    <h2 class="text-xl font-semibold mb-4">Lyrics</h2>
    <div class="space-y-3">
      <% progress.data['phrases'].each do |phrase| %>
        <%= render partial: 'phrase_with_translation', locals: { phrase: phrase, has_token_translations: progress.data&.dig('phrases_with_token_translations').present? } %>
      <% end %>
    </div>
  <% else %>
    <!-- Processing -->
    <div class="text-center py-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto mb-4"></div>
      <p class="text-gray-400">Processing your video... Please wait</p>
    </div>
  <% end %>
</div>
