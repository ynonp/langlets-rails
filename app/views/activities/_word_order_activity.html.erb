<%# Expects:
  params[:phrases] - An array of phrase data with word_segments
  params[:l1] - Language object for target phrase
  params[:l2] - Language object for displayed phrase
  params[:video_id] - YouTube video ID
  params[:start_timestamp] - Start timestamp for the video segment
  params[:end_timestamp] - End timestamp for the video segment

  This activity shows one phrase in L2 at a time, with blank lines below it.
  The user arranges words from L1 into the correct order to match the L2 phrase.
  Words can be dragged or clicked. Continues until all phrases are completed.

  Retrofitted to the Sprout mobile redesign (Langlets Mobile Redesign · Option 1).
 %>

<% phrases = (params[:phrases] || []) %>
<% total_phrases = phrases.length %>
<% l1_rtl = params[:l1].rtl %>
<% l2_rtl = params[:l2].rtl %>
<% hue = lang_hue(params[:l1].iso_name) %>

<%# Sprout activity screen takes over the lesson chrome (step nav hidden by design). %>
<style>#activity > .activity-stepnav { display: none; }</style>

<div
    data-controller="word-order-activity"
    data-action="stop-audio->main-video-player#stopPlayback"
    data-word-order-activity-l1-value="<%= params[:l1].iso_name %>"
    data-word-order-activity-total-phrases-value="<%= total_phrases %>"
    class="sprout"
    style="--hue: <%= hue %>; flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--bg); color: var(--text);">

  <div class="s-safetop"></div>

  <!-- Header: close + progress + hearts -->
  <div class="flex items-center s-pad" style="gap: 13px; padding-top: 12px; padding-bottom: 4px;">
    <%= link_to @course_path, class: "flex items-center justify-center", style: "color: var(--faint);", title: "Close", data: { :"turbo-frame" => "_top", :turbo => false } do %>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    <% end %>
    <div class="s-track flex-1" style="height: 11px;">
      <div data-word-order-activity-target="progressBar" id="progress" class="s-track__fill" style="width: 0%; transition: width .5s ease;"></div>
    </div>
    <div class="flex items-center" style="gap: 4px;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.7-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.3-7 10-7 10z" fill="oklch(0.65 0.2 25)" stroke="oklch(0.65 0.2 25)" stroke-width="2" stroke-linejoin="round"/></svg>
      <span style="font: 800 14px 'Nunito'; color: var(--text);">5</span>
    </div>
  </div>

  <!-- Scrollable body -->
  <div class="s-scroll s-pad" style="gap: 0; padding-top: 8px;">
    <div class="s-eyebrow" style="margin-bottom: 8px;">Build the sentence</div>
    <h2 class="s-h1" style="margin-bottom: calc(var(--gap) + 2px);"><%= @activity.text_header || "Translate this sentence" %></h2>
    <p class="s-small" data-word-order-activity-target="progressText" style="margin-bottom: var(--gap);">Question 1 of <%= total_phrases %></p>

    <% phrases.each_with_index do |phrase_data, index| %>
      <div
        data-word-order-activity-target="phraseContainer"
        data-index="<%= index %>"
        data-correct-text="<%= phrase_data[:l1_text] %>"
        class="phraseContainer <%= index == 0 ? '' : 'hidden' %>">

        <!-- Audio prompt card (L2 sentence to translate) -->
        <div class="s-card flex items-center" style="gap: 13px; padding: 16px; margin-bottom: var(--gap);">
          <button
            data-action="click->main-video-player#playSegment"
            data-main-video-player-segment-start-param="<%= timestamp_to_seconds(phrase_data[:timestamp_start]) %>"
            data-main-video-player-segment-end-param="<%= timestamp_to_seconds(phrase_data[:timestamp_end]) %>"
            data-word-order-activity-target="speakerButton"
            data-phrase="<%= phrase_data[:l2_text] %>"
            data-phrase-index="<%= index %>"
            class="flex items-center justify-center flex-shrink-0"
            style="width: 50px; height: 50px; border-radius: 999px; background: var(--accent); border: none; cursor: pointer;"
            title="Tap to listen">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="#fff"/><path d="M17 8a5 5 0 0 1 0 8" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <div class="min-w-0">
            <div class="s-small" style="margin-bottom: 2px;">Tap to listen</div>
            <div class="s-h2 <%= l2_rtl ? 'text-right' : 'text-left' %>"><%= phrase_data[:l2_text] %></div>
          </div>
        </div>

        <!-- Answer slots -->
        <div
          data-word-order-activity-target="resultLine"
          class="result-line flex flex-wrap items-center <%= l1_rtl ? 'flex-row-reverse' : '' %>"
          data-phrase-index="<%= index %>"
          style="gap: 9px; align-content: flex-start; min-height: 60px; padding-bottom: 12px; margin-bottom: 6px; border-bottom: 2px solid var(--border);">

          <% phrase_data[:word_segments].each_with_index do |segment, seg_index| %>
            <% if segment[:type] == "static" %>
              <span class="whitespace-pre-wrap s-h2" style="line-height: 44px;"><%= segment[:text] %></span>
            <% else %>
              <div
                data-word-order-activity-target="tokenSlot"
                data-action="dragover->word-order-activity#handleSlotDragOver dragleave->word-order-activity#handleSlotDragLeave drop->word-order-activity#handleSlotDrop"
                data-token-id="<%= segment[:token_id] %>"
                data-expected-text="<%= segment[:text] %>"
                data-audio-url="<%= segment[:audio_url] %>"
                data-segment-index="<%= seg_index %>"
                class="token-slot flex items-center justify-center text-center">
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="s-small" style="margin-bottom: 14px;">Tap words to add them in order</div>

        <!-- Word bank -->
        <div
          data-word-order-activity-target="wordBank"
          data-action="dragover->word-order-activity#handleDragOver dragleave->word-order-activity#handleDragLeave drop->word-order-activity#handleDrop"
          class="word-bank flex flex-wrap <%= l1_rtl ? 'flex-row-reverse' : '' %>"
          data-phrase-index="<%= index %>"
          style="gap: 10px; margin-bottom: calc(var(--gap) + 2px);">
          <%
            token_segments = phrase_data[:word_segments].select { |segment| segment[:type] == "token" }
            shuffled_tokens = token_segments.shuffle
          %>
          <% shuffled_tokens.each_with_index do |segment, token_index| %>
            <span
              data-word-order-activity-target="wordItem"
              data-token-id="<%= segment[:token_id] %>"
              data-word-text="<%= segment[:text] %>"
              data-audio-url="<%= segment[:audio_url] %>"
              data-action="click->word-order-activity#handleWordClick dragstart->word-order-activity#handleDragStart dragend->word-order-activity#handleDragEnd touchstart->word-order-activity#handleTouchStart touchmove->word-order-activity#handleTouchMove touchend->word-order-activity#handleTouchEnd"
              draggable="true"
              class="word-item s-tile">
              <%= segment[:text] %>
            </span>
          <% end %>
        </div>

        <!-- Check button -->
        <button
          data-action="click->word-order-activity#checkAnswer"
          data-word-order-activity-target="continueButton"
          data-phrase-index="<%= index %>"
          class="s-btn s-btn--full s-btn--lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 12.5l5 5 11-11" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Check
        </button>
      </div>
    <% end %>

    <div data-word-order-activity-target="feedbackMessage" class="hidden" style="margin-top: 16px; padding: 12px; border-radius: 14px; text-align: center; font: 800 16px 'Nunito';"></div>

    <div data-word-order-activity-target="completionMessage" data-progress-tracker-target="completion" class="s-card hidden flex flex-col sm:flex-row items-center justify-between" style="margin-top: 24px; gap: 16px;">
      <div>
        <h3 class="s-h2 text-center sm:text-left">Great job!</h3>
        <p class="s-body s-muted text-center sm:text-left">You've completed all the phrases.</p>
      </div>
      <a href="<%= @next_activity_path %>" class="s-btn w-full sm:w-auto">Next</a>
    </div>
  </div>
</div>

<style>
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-5px); }
  40%, 80% { transform: translateX(5px); }
}
.animate-shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }

@keyframes fade-in {
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}
.animate-fade-in { animation: fade-in 0.5s ease-out forwards; }

/* Word bank tiles */
.sprout .word-item {
  touch-action: none;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.sprout .word-item:hover { transform: translateY(-2px); }
.sprout .word-item.dragging { opacity: 0.7; transform: scale(1.05); z-index: 10; }

/* Tiles placed into the answer line read as accent chips */
.sprout .result-line .word-item {
  background: var(--accent);
  color: #fff;
  border: none;
  box-shadow: 0 3px 0 var(--accent-press);
}

/* Answer line */
.sprout .result-line { transition: border-color 0.3s ease; min-height: 60px; }
.sprout .result-line.drag-over { border-color: var(--accent); }

/* Empty answer slots (dashed ghost tiles) */
.sprout .token-slot {
  min-width: 70px;
  min-height: 44px;
  border: 2px dashed var(--border);
  border-radius: calc(var(--chip-r) + 2px);
  background: transparent;
  transition: border-color 0.3s ease, background-color 0.3s ease;
}
.sprout .token-slot.drag-over { border-color: var(--accent); background: var(--accent-soft); }
.sprout .token-slot.filled { border: 0; background: transparent; width: auto; min-width: inherit; }
.sprout .token-slot.correct { border-color: var(--accent); }
.sprout .token-slot.incorrect { border-color: oklch(0.62 0.2 25); }

/* Feedback states */
.sprout .correct-feedback { background: var(--accent-soft) !important; border-color: var(--accent) !important; color: var(--accent) !important; }
.sprout .incorrect-feedback { background: oklch(0.95 0.06 25) !important; border-color: oklch(0.62 0.2 25) !important; color: oklch(0.55 0.2 25) !important; }
@media (prefers-color-scheme: dark) {
  .sprout .incorrect-feedback { background: oklch(0.3 0.07 25) !important; }
}

/* RTL spacing */
.sprout .result-line.flex-row-reverse .word-item,
.sprout .word-bank.flex-row-reverse .word-item { margin-left: 0; margin-right: 0; }

/* Audio button inside a placed tile */
.sprout .word-item button { font-size: 12px; line-height: 1; padding: 2px; }

@media (max-width: 640px) {
  .sprout .token-slot { min-width: 60px; min-height: 40px; font-size: 14px; }
}
</style>
