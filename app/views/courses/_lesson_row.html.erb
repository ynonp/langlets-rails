<%#
  Sprout lesson row. Shared by courses/show (full render) and the
  progress#toggle_lesson Turbo Stream so both look identical.

  Locals:
  - lesson, course        (required)
  - index                 (optional) zero-based position, used for "Lesson N"
  - is_first_incomplete   (optional) highlights the row with the accent ring
  - hue                   (optional) language hue; defaults from the course
-%>
<%
  state = lesson.completed? ? :done : (lesson.in_progress? ? :progress : :todo)
  is_first_incomplete = local_assigns.fetch(:is_first_incomplete, false)
  hue = local_assigns[:hue] || lang_hue(course.language&.iso_name)
  number = local_assigns[:index] ? index.to_i + 1 : lesson.order
%>
<div class="flex items-center gap-3 bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-2xl p-2.5 shadow-md <%= "border-2 border-emerald-500" if is_first_incomplete %>" id="<%= dom_id(lesson) %>"
     <%= raw('data-scroll-into-view-target="element"') if is_first_incomplete %>>
  <!-- Progress toggle -->
  <% if user_signed_in? %>
    <%= button_to toggle_lesson_progress_index_path(lesson_id: lesson.id), method: :post, class: "flex-shrink-0 bg-transparent border-none p-0 cursor-pointer leading-none" do %>
      <%= render "courses/lesson_state_icon", state: state, hue: hue %>
    <% end %>
  <% else %>
    <span class="flex-shrink-0 leading-none"><%= render "courses/lesson_state_icon", state: state, hue: hue %></span>
  <% end %>

  <%= link_to course_lesson_path(course, lesson), class: "flex-1 min-w-0 no-underline text-inherit" do %>
    <div class="font-extrabold text-[15.5px] truncate"><%= lesson.localized_name %></div>
    <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 mt-0.5">
      <%= state == :done ? "Completed" : (state == :progress ? "In progress" : "Lesson #{number}") %>
    </div>
  <% end %>

  <%= link_to course_lesson_path(course, lesson), class: "flex-shrink-0 flex items-center justify-center w-[38px] h-[38px] rounded-full no-underline #{state == :todo ? 'bg-emerald-500' : 'bg-gray-100 dark:bg-gray-800'}", title: (state == :done ? "Review" : "Start lesson") do %>
    <% if state == :done %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12.5l5 5 11-11" stroke="currentColor" class="text-gray-500 dark:text-gray-400" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <% else %>
      <svg width="16" height="16" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="<%= state == :todo ? '#fff' : 'currentColor' %>" class="<%= 'text-gray-500 dark:text-gray-400' unless state == :todo %>"/></svg>
    <% end %>
  <% end %>
</div>
