<% content_for :title, t("app.import_requests.new.page_title") %>
<% content_for :head do %>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<% end %>

<div class="min-h-screen bg-[#FAF6EF] text-[#1E1B16] [font-family:'Instrument_Sans',ui-sans-serif,system-ui,sans-serif]">
  <%= render "app/shared/web_top_menu", active: :create %>

  <div data-testid="web-add-video"
       class="mx-auto grid w-full max-w-[1180px] gap-8 px-5 py-8 sm:px-10 sm:py-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14"
       data-controller="add-video"
       data-add-video-resolve-url-value="<%= resolve_app_import_requests_path %>">
    <section class="min-w-0">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#C4451C]">Create a lesson</p>
      <h1 class="mt-2 max-w-2xl text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-5xl [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif]"><%= t("app.import_requests.new.title") %></h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#55503F]">
        Paste any public YouTube or TikTok video. We’ll build a translated transcript and vocabulary practice from it.
      </p>

      <% if flash[:alert] %>
        <div class="mt-6 rounded-2xl border border-[#D98B8B] bg-[#FFFDF8] px-4 py-3 text-sm text-[#9E3410]"><%= flash[:alert] %></div>
      <% end %>

      <div class="mt-8">
        <label for="web-video-url" class="block text-sm font-bold">Video link</label>
        <div class="mt-2 flex min-h-14 items-center gap-3 rounded-2xl border-2 border-[#1E1B16] bg-[#FFFDF8] px-4 transition focus-within:border-[#C4451C] focus-within:ring-2 focus-within:ring-[#C4451C]/20"
             data-add-video-target="field">
          <%= app_icon "link", class: "h-5 w-5 shrink-0 text-[#8A8170]" %>
          <input id="web-video-url" type="text" inputmode="url"
                 data-add-video-target="input" data-action="input->add-video#inputChanged"
                 placeholder="<%= t('app.import_requests.new.paste_placeholder') %>"
                 value="<%= params[:url] %>" autofocus autocomplete="off" autocapitalize="off"
                 autocorrect="off" spellcheck="false" enterkeyhint="go"
                 class="min-w-0 flex-1 bg-transparent py-4 text-base text-[#1E1B16] outline-none placeholder:text-[#8A8170]">
          <button type="button" data-add-video-target="clear" data-action="add-video#clearInput"
                  class="hidden rounded-lg p-2 text-[#55503F] hover:bg-[#F2EADB]" aria-label="Clear">
            <%= app_icon "close", class: "h-4 w-4" %>
          </button>
        </div>
        <p class="mt-2 text-sm text-[#8A8170]" data-add-video-target="hint"><%= t("app.import_requests.new.url_hint") %></p>
        <p class="mt-2 hidden items-center gap-1.5 text-sm font-bold text-[#C4451C]" data-add-video-target="recognized">
          <%= app_icon "check_circle", class: "h-4 w-4" %> <%= t("app.import_requests.new.link_recognized") %>
        </p>
      </div>

      <turbo-frame id="add_video_result" class="mt-8 block">
        <%= render "app/import_requests/web/empty_state" %>
      </turbo-frame>
    </section>

    <aside class="h-fit rounded-[22px] bg-[#1E1B16] p-7 text-[#FAF6EF] shadow-[8px_8px_0_#EADFC9] lg:sticky lg:top-8">
      <p class="text-lg font-bold [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif]">What you’ll get</p>
      <ul class="mt-5 space-y-4 text-sm text-[#B5AC98]">
        <li class="flex gap-3"><span class="font-bold text-[#C4451C]">✓</span><span>Synced transcript and translation</span></li>
        <li class="flex gap-3"><span class="font-bold text-[#C4451C]">✓</span><span>Word-level vocabulary practice</span></li>
        <li class="flex gap-3"><span class="font-bold text-[#C4451C]">✓</span><span>A reusable lesson in your library</span></li>
      </ul>
      <%# Pro replaces the whole balance-and-buy block. Offering "Buy More"
          credits to somebody on an unlimited plan is not just noise, it is an
          invitation to spend money on something they already have. %>
      <% if current_user.pro? %>
        <div class="mt-7 border-t border-[#5A5245] pt-5">
          <p class="text-sm text-[#B5AC98]"><%= t("app.import_requests.new.pro_balance_label") %></p>
          <p class="mt-2 text-xl font-extrabold [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif]"><%= t("app.import_requests.new.pro_balance") %></p>
        </div>
      <% else %>
      <div class="mt-7 border-t border-[#5A5245] pt-5">
        <p class="text-sm text-[#B5AC98]">Available balance</p>
        <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
          <p class="text-xl font-extrabold [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif]"><%= app_credits_label(current_user.credit_balance) %></p>
          <% if @paypal_client.configured? %>
            <%= render layout: "paypal/form",
                       locals: {
                         paypal_client: @paypal_client,
                         pack: @credit_pack,
                         cancel_path: new_app_import_request_path,
                         return_path: new_app_import_request_path
                       } do %>
              <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-[#C4451C] px-4 py-2 text-sm font-extrabold text-[#FFFDF8] transition hover:bg-[#9E3410]">
                Buy More
              </button>
            <% end %>
          <% else %>
            <span class="text-sm text-[#B5AC98]">Purchases unavailable</span>
          <% end %>
        </div>
        <p class="mt-1 text-xs text-[#B5AC98]">Each new import uses 1 credit.</p>
      </div>
      <% end %>
    </aside>
  </div>
</div>
