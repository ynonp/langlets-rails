<%
  phrases = params[:phrases]
  activity_token_ids = params[:activity_translation_ids].to_set
  word_timing = params[:word_timing]
%>

<style>
  .listen-line {
    transform: translateY(calc(var(--listen-slot, 2) * 100%));
    transition: transform 280ms ease, opacity 220ms ease, background-color 220ms ease;
  }
  .lyric-card {
    height: auto;
    min-height: 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
  }
  .listen-line[data-slot="exit"] { --listen-slot: -1; opacity: 0; }
  .listen-line[data-slot="0"] { --listen-slot: 0; opacity: 1; }
  .listen-line[data-slot="1"] { --listen-slot: 1; opacity: .55; }
  .listen-line[data-slot="hidden"] { --listen-slot: 2; opacity: 0; visibility: hidden; }
  .listen-word { opacity: 0; transition: opacity 100ms ease; }
  .listen-word[data-revealed] { opacity: 1; }
  .listen-answer { animation: listen-pulse 1.5s ease-in-out infinite; }
  @keyframes listen-pulse { 50% { transform: scale(1.04); } }
  .listen-answer.is-correct { animation: listen-correct 600ms ease; }
  .listen-answer.is-incorrect { animation: listen-incorrect 600ms ease; }
  @keyframes listen-correct { 50% { background-color: rgb(34 197 94); color: white; } }
  @keyframes listen-incorrect { 50% { background-color: rgb(239 68 68); color: white; } }
</style>

<div
  class="contents"
  data-controller="listen-activity"
  data-main-video-player-target="videoListener videoSegment"
  data-show-player="true"
  data-segment-start="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
  data-segment-end="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
  data-listen-activity-word-timing-value="<%= word_timing %>"
  data-action="
    video:play->main-video-player#seekToSegmentStartIfBefore
    video:play->listen-activity#start
    video:progress->listen-activity#progress
    video:end->listen-activity#handleVideoEnd
    listen-activity:pause-video->main-video-player#stopPlayback
    listen-activity:play-video->main-video-player#resume
  ">
  <div class="order-4 flex min-h-0 flex-1 flex-col bg-white dark:bg-gray-900">
    <header class="px-5 pt-4 text-center">
      <h2 class="text-xl font-extrabold text-gray-900 dark:text-gray-50"><%= @activity.text_header || t(".instruction") %></h2>
      <% if @activity.text_subheader.present? %>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= @activity.text_subheader %></p>
      <% end %>
      <p class="mt-2 text-sm font-semibold text-emerald-700 dark:text-emerald-300" data-listen-activity-target="startInstruction">
        <%= t(".start_video", default: "Press Play on the video to start") %>
      </p>
    </header>

    <div class="relative mx-4 mt-4 h-[240px] flex-none overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-950 <%= 'hidden' if word_timing %>"
         dir="<%= params[:rtl] ? 'rtl' : 'ltr' %>"
         data-listen-activity-target="stage">
      <% phrases.each_with_index do |phrase, index| %>
        <%
          eligible_tokens = phrase.phrase_tokens.select { |token| activity_token_ids.include?(token.id) && similar_sounds_for_token(phrase, token).present? }
          missing_token = eligible_tokens.sample
          alternatives = missing_token ? similar_sounds_for_token(phrase, missing_token) : []
          choices = missing_token && alternatives.present? ? [
            { word: missing_token.original_text, correct: true },
            { word: alternatives.sample, correct: false }
          ].shuffle : []
          phrase_end = phrases[index + 1]&.timestamp_seconds || timestamp_to_seconds(params[:end_timestamp])
        %>
        <article
          class="listen-line lyric-card absolute inset-x-0 top-0"
          data-listen-activity-target="phrase"
          data-index="<%= index %>"
          data-start="<%= phrase.timestamp_seconds %>"
          data-end="<%= phrase_end %>"
          data-has-missing="<%= missing_token.present? %>"
          data-missing-start="<%= missing_token&.start_timestamp_seconds %>"
          data-slot="hidden">
          <div class="text-lg font-bold leading-relaxed text-gray-900 dark:text-gray-50" data-listen-activity-target="phraseText">
            <% if word_timing %>
              <% listen_phrase_segments(phrase, missing_token: missing_token).each do |segment| %>
                <span class="listen-word <%= 'blank-line underline decoration-2 underline-offset-4' if segment[:missing] %>"
                      data-start="<%= segment[:start] %>"
                      data-missing="<%= segment[:missing] %>"
                      <% if segment[:missing] %>data-answer="<%= segment[:text] %>"<% end %>><%= segment[:missing] ? "________" : segment[:text] %></span>
              <% end %>
            <% elsif missing_token %>
              <%= render_listen_phrase_with_blank(phrase, missing_token) %>
            <% else %>
              <%= phrase.text_l1 %>
            <% end %>
          </div>
          <% if missing_token %>
            <p class="mt-1 hidden text-sm font-semibold text-emerald-700 dark:text-emerald-300" data-listen-activity-target="translation">
              <%= missing_token.translation %>
            </p>
            <template data-listen-activity-target="choices">
              <% choices.each do |choice| %>
                <button type="button"
                        data-word="<%= choice[:word] %>"
                        data-correct="<%= choice[:correct] %>"
                        data-action="click->listen-activity#selectWord"
                        class="listen-answer min-h-12 flex-1 rounded-xl bg-gray-100 px-5 py-3 font-bold text-gray-900 transition-colors hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-50 dark:hover:bg-gray-700">
                  <%= choice[:word] %>
                </button>
              <% end %>
            </template>
          <% end %>
        </article>
      <% end %>
    </div>

    <div class="hidden min-h-20 items-center justify-center gap-3 px-5 py-4" data-listen-activity-target="wordSelection"></div>

    <div class="mx-5 my-4 hidden items-center justify-between gap-4 rounded-2xl bg-emerald-50 p-4 dark:bg-gray-800" data-listen-activity-target="completion">
      <div>
        <h3 class="text-lg font-extrabold"><%= t(".great_job") %></h3>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= t(".completed") %></p>
      </div>
      <%= link_to_next_activity("Next", @next_activity_path, class: "inline-flex h-12 items-center justify-center rounded-xl bg-emerald-500 px-5 font-extrabold text-white hover:bg-emerald-600") %>
    </div>
  </div>
</div>
