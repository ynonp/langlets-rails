<% content_for :head do %>
  <title>Lesson Complete - Langlets</title>
  <meta name="robots" content="noindex, follow">
<% end %>

<div class="min-h-screen flex flex-col max-w-xl mx-auto w-full bg-gray-800">
  <!-- Header with X button -->
  <div class="bg-gray-900 py-3 px-4">
    <div class="flex items-center justify-between">
      <!-- Back to Course X Button -->
      <%= link_to @course_path,
        class: "text-white p-2 rounded-md hover:bg-white hover:bg-opacity-10 transition-colors duration-200",
        title: "Back to Course",
        data: {
          :"turbo-frame" => "_top",
          :turbo => false
        } do %>
        <svg xmlns="http://www.w3.org/2000/svg" 
          viewBox="0 0 384 512"
          class="h-5 w-5 fill-white"
        >
          <path d="M376.6 84.5c11.3-13.6 9.5-33.8-4.1-45.1s-33.8-9.5-45.1 4.1L192 206 56.6 43.5C45.3 29.9 25.1 28.1 11.5 39.4S-3.9 70.9 7.4 84.5L150.3 256 7.4 427.5c-11.3 13.6-9.5 33.8 4.1 45.1s33.8 9.5 45.1-4.1L192 306 327.4 468.5c11.3 13.6 31.5 15.4 45.1 4.1s15.4-31.5 4.1-45.1L233.7 256 376.6 84.5z"/>
        </svg>
      <% end %>
      
      <h1 class="text-white text-lg font-semibold">Lesson Complete!</h1>
      <div class="w-9"></div> <!-- Spacer for centering -->
    </div>
  </div>

  <!-- Main content -->
  <div class="flex-1 flex items-center justify-center p-6">
    <div class="text-center space-y-8 max-w-sm">
      <!-- Success icon -->
      <div class="mx-auto w-20 h-20 bg-green-500 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10 text-white">
          <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
        </svg>
      </div>

      <!-- Congratulations message -->
      <div class="space-y-2">
        <h2 class="text-2xl font-bold text-white">Great Job!</h2>
        <p class="text-gray-300">You've completed this lesson</p>
      </div>

      <!-- XP earned -->
      <div class="bg-gray-700 rounded-lg p-6 space-y-4">
        <div class="flex items-center justify-center space-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-yellow-400">
            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
          </svg>
          <span class="text-white text-xl font-semibold">+<%= @lesson_xp %> XP</span>
        </div>
        
        <% if current_user %>
          <% if @first_lesson_today %>
          <div class="flex items-center justify-center space-x-2 text-orange-400">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.177A7.547 7.547 0 0 1 6.648 6.61a.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248Z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm font-medium">Streak: <%= @current_streak %> day<%= 's' if @current_streak != 1 %></span>
          </div>
          <% end %>
        <% else %>
          <!-- Login prompt for unauthenticated users -->
          <div class="text-center">
            <%= link_to new_user_session_path,
              class: "inline-flex items-center text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors duration-200",
              data: { turbo: false } do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
                <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
              </svg>
              Login / Signup to save your progress
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Continue button -->
      <%= link_to @continue_path,
        class: "block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 px-6 rounded-lg transition-colors duration-200",
        data: { turbo: false } do %>
        <% if @next_lesson %>
          Continue to Next Lesson
        <% else %>
          Back to Course
        <% end %>
      <% end %>
    </div>
  </div>
</div>