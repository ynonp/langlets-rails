<style>
  /* Paul Ive's Font Choice - Clean, Modern, Legible */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  body {
    background-color: #0F172A;
    /* slate-900 */
    color: #CBD5E1;
    /* slate-300 */
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    /* Smooth scrolling for a more polished feel */
    scroll-behavior: smooth;
    /* Antialiasing for crisp text */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @keyframes float {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  .float-animate {
    animation: float 2.5s ease-in-out infinite;
    /* Slightly slower animation for a more gentle float */
  }

  /* Custom scrollbar for a more integrated dark theme look (optional, but a nice touch) */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #1E293B;
    /* slate-800 */
  }

  ::-webkit-scrollbar-thumb {
    background: #334155;
    /* slate-700 */
    border-radius: 5px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #475569;
    /* slate-600 */
  }
</style>

<% content_for :head do %>
  <% youtube_video_id = @course.main_media_url.split("v=").last %>
  <% thumbnail_url = youtube_thumbnail_url(youtube_video_id) %>
  <% course_url = course_url(@course) %>
  
  <!-- Page title -->
  <title><%= @course.name %> - Langlets</title>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= course_url %>">
  <meta property="og:title" content="<%= @course.name %> - Langlets">
  <meta property="og:description" content="Learn <%= @course.name %> with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities.">
  <meta property="og:image" content="<%= thumbnail_url %>">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="og:site_name" content="Langlets">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="<%= course_url %>">
  <meta property="twitter:title" content="<%= @course.name %> - Langlets">
  <meta property="twitter:description" content="Learn <%= @course.name %> with interactive video lessons. Practice listening, speaking, and comprehension with AI-powered activities.">
  <meta property="twitter:image" content="<%= thumbnail_url %>">
<% end %>


<!-- Top bar: Refined for clarity and presence -->
<header class="py-6 border-b border-slate-700/60">
  <!-- Added slight transparency to border for softness -->
  <h1 class="text-3xl sm:text-4xl font-bold text-slate-100 text-center tracking-tight">
    <span class="text-slate-400">Free Language Course: </span><%= @course.name %>
  </h1>
</header>

<!-- Main content wrapper -->
<div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <main class="flex flex-col lg:flex-row gap-8 lg:gap-12">
    <!-- Main lesson list area -->
    <div class="flex-1">
      <!-- Header section with lesson list title -->
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253z"></path>
              </svg>
            </div>
            <h2 class="text-3xl font-bold text-white">Lesson List</h2>
          </div>
        </div>
      </div>

      <!-- Description text -->
      <p class="text-slate-400 text-lg mt-8 mb-2 leading-relaxed">
        Pick any lesson to begin learning. Each one breaks down a line of the song and teaches you something new.         
      </p>
      <p  class="text-slate-400 text-lg mb-8 leading-relaxed">
        Pro Tip: Practice 1 lesson every day to maximize spaced repetition effect.
      </p>

      <!-- Lessons list -->
      <div class="space-y-4">
        <% @lessons.each_with_index do |lesson, index| %>
          <%= link_to lesson do %>
          <div class="bg-slate-800/50 border border-slate-700/50 rounded-xl p-6 hover:bg-slate-800/70 transition-all duration-200 group <%= index == 0 ? 'ring-2 ring-blue-500/20 border-blue-500/30' : '' %>">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-white mb-2 group-hover:text-blue-300 transition-colors">
                  <%= lesson.name %>
                </h3>
              </div>
              
              <%= link_to lesson, class: "ml-6 bg-slate-900 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-medium transition-all duration-200 flex items-center gap-2 group-hover:scale-105" do %>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                </svg>
                Start Lesson
              <% end %>
            </div>
          </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Right sidebar with video -->
    <aside class="w-full lg:w-[400px] lg:sticky lg:top-8 self-start">
      <div class="bg-slate-800/70 rounded-xl p-6 backdrop-blur-md border border-slate-700/50 shadow-2xl">
        <!-- Play Song section -->
        <div class="mb-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white">Listen to the Full Song</h3>
            <span class="bg-slate-900 p-2 rounded-lg transition-colors">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </span>
          </div>
          
          <p class="text-slate-400 text-sm mb-4">
            You can listen to the full song anytime. After each lesson, come back here and replay the lyrics you've just learned — you'll understand more every time.
          </p>
        </div>

        <!-- Video player -->
        <% youtube_video_id = @course.main_media_url.split("v=").last %>
        <div class="aspect-video overflow-hidden rounded-lg shadow-xl shadow-black/30">
          <iframe class="w-full h-full" src="https://www.youtube.com/embed/<%= youtube_video_id %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </aside>
  </main>
</div>

    
    <footer class="bg-gray-800 border-t border-gray-700 mt-auto fixed bottom-0 left-0 right-0">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
          <div class="text-gray-400 text-sm">
            © <%= Date.current.year %> Langlets. All rights reserved.
          </div>
          <div class="flex space-x-6">
            <%= link_to "Privacy Policy", "/home/privacy", class: "text-gray-400 hover:text-white text-sm transition-colors duration-200" %>
            <%= link_to "Terms of Service", "/home/terms", class: "text-gray-400 hover:text-white text-sm transition-colors duration-200" %>
          </div>
        </div>
      </div>
    </footer>