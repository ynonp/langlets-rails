<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta http-equiv="refresh" content="10">
<% end %>
<%= turbo_stream_from @review_lesson_build %>

<div class="h-dvh-safe min-h-0 flex flex-col overflow-hidden bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50 max-w-[480px] mx-auto w-full">
  <main class="flex-1 flex items-center justify-center px-6 py-12">
    <section class="max-w-md text-center" aria-live="polite">
      <div class="relative mx-auto mb-8 h-36 w-36" aria-hidden="true">
        <div class="absolute inset-0 rounded-full bg-emerald-400/15 animate-ping"></div>
        <div class="absolute inset-3 rounded-full bg-white dark:bg-gray-900 border border-emerald-300/30 flex items-center justify-center text-6xl animate-bounce">
          📚
        </div>
        <span class="absolute -right-1 top-2 text-3xl animate-pulse">✨</span>
        <span class="absolute -left-2 bottom-4 text-2xl animate-pulse">✨</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight"><%= t(".heading") %></h1>
      <p class="mt-4 text-lg leading-relaxed text-gray-500 dark:text-slate-300"><%= t(".message") %></p>
    </section>
  </main>
</div>
