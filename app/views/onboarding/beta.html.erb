<% content_for :title, t("beta_pro.title") %>
<div class="min-h-[calc(100dvh-env(safe-area-inset-top,0px))] px-7 pt-6 pb-[max(1.5rem,env(safe-area-inset-bottom,1rem))] flex flex-col gap-8">
  <div class="my-auto max-w-md">
    <p class="text-app-accent text-sm font-bold uppercase tracking-widest">Langlets Pro</p>
    <h1 class="mt-3 text-4xl font-extrabold leading-tight"><%= t("beta_pro.title") %></h1>
    <p class="mt-5 text-app-text-2 text-lg leading-relaxed"><%= t("beta_pro.body") %></p>
    <p class="mt-4 text-app-text-2 leading-relaxed"><%= t("beta_pro.invitation") %></p>
  </div>
  <%= link_to t("beta_pro.continue"), onboarding_language_path,
      class: "w-full rounded-full bg-app-accent text-app-on-accent text-center text-lg font-bold py-4" %>
</div>
