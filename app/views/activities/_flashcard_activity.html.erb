<%# Expects params[:cards] - array of flashcard objects
    Each card: { id, phrase_html, phrase_l2, translation, correct, options, audio_url }
%>

<%# Expects params[:phrase_tokens] and prepares cards on the client side %>
<% phrase_tokens = params[:phrase_tokens] || [] %>
<% cards = prepare_flashcards_for_tokens(phrase_tokens, params[:unique_words]) %>
<% l1_rtl = params[:l1]&.rtl %>
<% l2_rtl = params[:l2]&.rtl %>

<div
  data-controller="flashcard-activity"
  data-flashcard-activity-cards-value="<%= cards.to_json %>"
  data-flashcard-activity-l1-rtl-value="<%= l1_rtl %>"
  data-flashcard-activity-is-review-lesson-value="<%= params[:is_review_lesson] || false %>"
  data-main-video-player-target="videoListener videoSegment"
  data-show-player="true"
  data-action="video:play->main-video-player#seekToSegmentStartIfBefore"
  class="order-4 flex-1 min-h-0 overflow-y-auto flex flex-col items-center bg-gray-50 dark:bg-gray-950">
  <div data-flashcard-activity-target="activityContent" class="w-full max-w-[460px] px-4 py-3 sm:py-5">
    <h2 class="sr-only"><%= @activity.text_header || t(".title") %></h2>

    <div class="flex items-center justify-between gap-4 mb-2 sm:mb-4">
      <p data-flashcard-activity-target="progress" class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm"><%= t(".question_of", current: 1, total: cards.length) %></p>
    </div>

    <div data-flashcard-activity-target="card" dir="<%= l1_rtl ? 'rtl' : 'ltr' %>" class="bg-transparent px-1 py-5 text-gray-900 dark:text-gray-50 <%= l1_rtl ? 'text-right' : 'text-left' %>">
    </div>

  </div>

  <%= render "activities/completion_message",
        controller: "flashcard-activity",
        target: "completion",
        title: t(".good_work"),
        next_label: t(".next"),
        phrases: [],
        dynamic_translation: { rtl: l2_rtl },
        next_action: "click->flashcard-activity#continue" %>
</div>

<style>
.flashcard-answer-reveal {
  text-shadow: 0 0 18px rgb(52 211 153 / 0.7);
  animation: flashcard-answer-flash-in 650ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes flashcard-answer-flash-in {
  0% { opacity: 0; transform: scale(0.35) rotate(-6deg); filter: brightness(2.2); }
  55% { opacity: 1; transform: scale(1.08) rotate(2deg); filter: brightness(1.45); }
  75% { transform: scale(0.98) rotate(-1deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); filter: brightness(1); }
}

@media (prefers-reduced-motion: reduce) {
  .flashcard-answer-reveal { animation: none; }
}
</style>
