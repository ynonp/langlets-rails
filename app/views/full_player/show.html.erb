<% content_for :head do %>
  <% video_id = @video_id %>
  <% thumb_url = youtube_thumbnail_url(video_id) if video_id.present? %>
  <% title = "#{@course.name} - Full Video - Langlets" %>
  <% desc = "Watch the complete #{@course.name} video with synchronized bilingual transcripts." %>

  <title><%= title %></title>
  <%= render_meta_tags(
    title: title,
    description: desc,
    url: canonical_url(course_path(@course)),
    image_url: thumb_url
  ) %>
<% end %>

<% content_for :canonical_url, canonical_url(course_path(@course)) %>

<%
  # Language directionality + per-language Sprout hue.
  l1 = @phrases.first&.l1
  l2 = @phrases.first&.l2
  l1_rtl = l1&.rtl || false
  l2_rtl = l2&.rtl || false
  hue = lang_hue(l1&.iso_name)
%>

<div class="sprout">
  <div class="s-screen s-screen--fixed mx-auto w-full max-w-[480px]"
      style="--hue: <%= hue %>;"
      data-controller="main-video-player watch-video-activity"
      data-main-video-player-video-id-value="<%= @video_id %>"
      data-main-video-player-hl-value="<%= l1&.iso_name || 'en' %>"
      data-main-video-player-target="videoListener videoSegment"
      data-action="
        video:play->main-video-player#fullPlayerStartPlayback
        video:stop->main-video-player#fullPlayerStopPlayback
        video:play->watch-video-activity#handleVideoStart
        video:end->watch-video-activity#handleVideoEnd
        video:stop->watch-video-activity#handleVideoPause
        video:progress->watch-video-activity#progress
      "
      data-show-player="true"
      data-segment-start="<%= timestamp_to_seconds(@start_timestamp) %>"
      data-segment-end="<%= timestamp_to_seconds(@end_timestamp) %>"
      data-watch-video-activity-current-text-line-class="s-line-active"
      data-watch-video-activity-word-timing-value="<%= @word_timing ? true : false %>"
  >
    <!-- Video hero -->
    <div class="s-video-hero" id="main-player" data-main-video-player-target="playerContainer">
      <div class="w-full aspect-video bg-cover bg-center bg-no-repeat flex items-center justify-center relative"
           style="background-image: url('https://img.youtube.com/vi/<%= @video_id %>/hqdefault.jpg')"
           role="img"
           aria-label="Video thumbnail">

        <div class="absolute inset-0 z-20" data-action="click->main-video-player#togglePlayPause"></div>

        <div data-main-video-player-target="player"
             class="absolute inset-0 w-full h-full [&>iframe]:w-full [&>iframe]:h-full [&>iframe]:absolute [&>iframe]:inset-0"></div>

        <!-- Back button -->
        <a href="<%= course_path(@course.slug) %>" class="s-hero-pill absolute z-30" style="top: 14px; left: var(--pad);" aria-label="Back to course">
          <svg width="11" height="18" viewBox="0 0 12 20"><path d="M10 2L2 10l8 8" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <!-- Language badge -->
        <% if l1 %>
          <span class="s-badge absolute z-30" style="top: 16px; right: var(--pad); --lh: <%= hue %>; background: rgba(0,0,0,0.4); color:#fff;"><%= lang_badge_code(l1) %></span>
        <% end %>

        <!-- Title gradient -->
        <div class="absolute left-0 right-0 bottom-0 z-20" style="padding: 26px var(--pad) 14px; background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
          <div class="s-h2" style="color:#fff;"><%= @course.name %></div>
        </div>

        <!-- Center play button -->
        <button data-main-video-player-target="playButton"
                class="relative z-10 flex items-center justify-center"
                style="width: 64px; height: 64px; border-radius: 999px; background: var(--accent); color:#fff; border:none; box-shadow: 0 6px 18px rgba(0,0,0,0.3); cursor:pointer;">
          <svg width="22" height="22" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="#fff"/></svg>
        </button>

        <!-- Time display (elapsed / total) -->
        <div class="absolute z-30 flex items-center gap-1 tabular-nums"
             style="bottom: 12px; right: var(--pad); color:#fff; font-size: 12px; font-variant-numeric: tabular-nums; text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
          <span data-main-video-player-target="timeElapsed">0:00</span>
          <span style="opacity: 0.7;">/</span>
          <span data-main-video-player-target="timeDuration" style="opacity: 0.7;">0:00</span>
        </div>

        <!-- Scrubber (functional progress bar) -->
        <div class="absolute bottom-0 left-0 w-full z-30 cursor-pointer"
            style="height: 6px; background: rgba(255,255,255,0.25);"
            data-main-video-player-target="progressBarContainer"
            data-action="click->main-video-player#seekToPosition">
          <div data-main-video-player-target="progressBar" class="h-full transition-all duration-100 ease-linear" style="width: 0%; background: var(--accent);"></div>
        </div>
      </div>
    </div>

    <!-- Breakdown header -->
    <div class="flex items-center justify-between s-pad" style="padding-top: 12px; padding-bottom: 4px;">
      <div class="s-eyebrow">Tap any word</div>
      <label class="s-toggle">
        <input checked="true" type="checkbox"
               data-watch-video-activity-target="showTranslation"
               data-action="change->watch-video-activity#toggleTranslation">
        Show translation
      </label>
    </div>

    <!-- Word-by-word breakdown -->
    <div
        data-controller="popover-translation"
        data-popover-translation-l1-language-value="<%= l1&.english_name || 'Language' %>"
        data-popover-translation-saved-ids-value="<%= current_user ? current_user.saved_token_translations.pluck(:id).to_json : '[]' %>"
        id="phrases-container"
        data-watch-video-activity-target="container"
        data-action="click->popover-translation#showPopup scroll->popover-translation#hidePopup:passive click@document->popover-translation#hidePopup scroll@document->popover-translation#hidePopup"
        class="s-scroll s-pad"
        style="padding-bottom: 8px;"
    >
      <div id="phrases-list" data-watch-video-activity-target="phrasesList"
           data-action="click->main-video-player#seekToTimestamp">
        <% @phrases.each do |phrase| %>
          <div
            data-watch-video-activity-target="subtitles"
            data-timestamp="<%= timestamp_to_seconds(phrase.timestamp) %>"
            class="s-phrase"
          >
            <div class="s-phrase__l1" dir="<%= l1_rtl ? 'rtl' : 'ltr' %>">
              <%= wrap_tokens_in_spans(phrase, { class: "s-token" }) %>
            </div>
            <div class="s-phrase__l2"
                 data-watch-video-activity-target="translation"
                 dir="<%= l2_rtl ? 'rtl' : 'ltr' %>">
              <%= phrase.text_l2 %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Translation popup -->
      <%= render partial: 'activities/translation_popup', locals: { popup_class: "s-popover hidden", l1_rtl: l1_rtl } %>
    </div>

    <!-- Bottom action bar -->
    <% if @course.lessons.any? %>
      <% first_lesson = @course.lessons.order(:order).first %>
      <div class="s-pad" style="flex-shrink: 0; padding-top: 12px; padding-bottom: calc(26px + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1px solid var(--border);">
        <%= button_to course_lesson_path(@course, first_lesson), method: :get, class: "s-btn s-btn--full s-btn--lg", form: { style: "width:100%" } do %>
          <svg width="20" height="20" viewBox="0 0 24 24"><path d="M13 2L4 14h6l-1 8 9-12h-6z" fill="#fff"/></svg>
          Start practice
        <% end %>
      </div>
    <% end %>
  </div>
</div>
