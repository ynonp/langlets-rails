<%# Expects params[:cards] - array of flashcard objects
    Each card: { id, phrase_html, translation, correct, options, audio_url }
%>

<%# Expects params[:phrase_tokens] and prepares cards on the client side %>
<% phrase_tokens = params[:phrase_tokens] || [] %>
<% cards = prepare_flashcards_for_tokens(phrase_tokens, params[:unique_words]) %>
<% l1_rtl = params[:l1_rtl] %>

<div data-controller="flashcard-activity" data-flashcard-activity-cards-value="<%= cards.to_json %>" data-flashcard-activity-l1-rtl-value="<%= l1_rtl %>" data-flashcard-activity-is-review-lesson-value="<%= params[:is_review_lesson] || false %>" class="flex-1 min-h-0 overflow-y-auto flex flex-col items-center bg-gray-50 dark:bg-gray-950">
  <div class="w-full max-w-[460px] p-4 sm:py-6">
    <h2 class="sr-only"><%= @activity.text_header || "Flashcards" %></h2>

    <div class="flex items-center justify-between gap-4 mb-5">
      <p data-flashcard-activity-target="progress" class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm">Question 1 of <%= cards.length %></p>
      <div data-flashcard-activity-target="progressTrack" class="w-24 bg-gray-200 dark:bg-gray-700 rounded-full h-1 overflow-hidden" role="progressbar" aria-label="Question progress" aria-valuemin="1" aria-valuemax="<%= cards.length %>" aria-valuenow="<%= cards.any? ? 1 : 0 %>">
        <div data-flashcard-activity-target="progressBar" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: <%= cards.any? ? 100.0 / cards.length : 0 %>%"></div>
      </div>
    </div>

    <div data-flashcard-activity-target="card" dir="<%= l1_rtl ? 'rtl' : 'ltr' %>" class="bg-transparent px-1 py-5 text-gray-900 dark:text-gray-50 <%= l1_rtl ? 'text-right' : 'text-left' %>">
    </div>


    <div data-flashcard-activity-target="completion" class="hidden mt-6 text-center" data-progress-tracker-target="completion">
      <h3 class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mb-4">Good Work!</h3>
      <%= link_to_next_activity "Next", @next_activity_path, { class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors" } %>
    </div>
  </div>
</div>

<style>
.flashcard-answer-reveal {
  text-shadow: 0 0 18px rgb(52 211 153 / 0.7);
  animation: flashcard-answer-flash-in 650ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes flashcard-answer-flash-in {
  0% { opacity: 0; transform: scale(0.35) rotate(-6deg); filter: brightness(2.2); }
  55% { opacity: 1; transform: scale(1.08) rotate(2deg); filter: brightness(1.45); }
  75% { transform: scale(0.98) rotate(-1deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); filter: brightness(1); }
}

@media (prefers-reduced-motion: reduce) {
  .flashcard-answer-reveal { animation: none; }
}
</style>
