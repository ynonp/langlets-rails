<%# Expects:
  params[:token_translations] - An array of token translation objects
  params[:l1] - Language object for original words
  params[:l2] - Language object for translation words
  params[:video_id] - YouTube video ID
  params[:start_timestamp] - Start timestamp for the video segment
  params[:end_timestamp] - End timestamp for the video segment
  current_script - Script object for current script (passed as local)
  
  This activity shows a 2x5 grid where users match tokens to their translations:
  1. Left column shows words in L1, right column shows translations in L2
  2. Columns are shuffled separately so words and translations are not aligned
  3. User clicks on a word in one column, then its match in the other column
  4. Successful matches flash green and disappear
  5. Failed matches flash red and selection is cleared
  6. New token pairs are inserted randomly when matches are made
  7. Progress bar shows completion status
  8. When all tokens are matched, shows completion message
 %>

<% 
  # Prepare tokens data using helper with current script
  tokens = prepare_tokens_for_matching(params[:token_translations], current_script)
  l1 = params[:l1]
  l2 = params[:l2]
  total_tokens = tokens.length
%>

<div
    data-controller="match-tokens-activity"
    data-match-tokens-activity-tokens-value="<%= tokens.to_json %>"
    data-match-tokens-activity-total-tokens-value="<%= total_tokens %>"
    class="flex-col flex items-center bg-gray-800">
  
  <div class="w-full max-w-[640px] p-4 sm:p-6 bg-gray-800 rounded-lg shadow-lg">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl text-white mb-2"><%= @activity.text_header || "Match Words to Their Translations" %></h2>
      <div class="w-full bg-gray-700 rounded-full h-2.5 mt-4">
        <div data-match-tokens-activity-target="progressBar" id="progress" class="bg-green-500 h-2.5 rounded-full w-0 transition-all duration-500"></div>
      </div>
    </div>

    <div id="match-tokens" class="flex flex-col gap-4">

      <!-- Completion message -->
      <div data-match-tokens-activity-target="completionMessage" data-progress-tracker-target="completion" class="hidden p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-center sm:text-left text-xl font-bold text-white">Great job!</h3>
          <p class="text-center sm:text-left text-gray-300">You've matched all the words correctly.</p>
        </div>
        <%= link_to_next_activity("Next", @next_activity_path, class: "w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center") %>
      </div>

      <!-- Grid container -->
      <div class="grid grid-cols-2 gap-4 min-h-[400px]" data-match-tokens-activity-target="grid">
        <!-- Left column (L1 words) -->
        <div class="flex flex-col gap-3">
          <div class="text-center px-2 py-2 bg-gray-700 text-white font-semibold rounded text-sm">
            <%= l1.english_name %> Words
          </div>
          <div data-match-tokens-activity-target="l1Column" class="flex flex-col gap-3">
            <!-- L1 words will be inserted here -->
          </div>
        </div>

        <!-- Right column (L2 translations) -->
        <div class="flex flex-col gap-3">
          <div class="text-center px-2 py-2 bg-gray-700 text-white font-semibold rounded text-sm">
            <%= l2.english_name %> Translations
          </div>
          <div data-match-tokens-activity-target="l2Column" class="flex flex-col gap-3">
            <!-- L2 translations will be inserted here -->
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
@keyframes flash-success {
  0% { background-color: rgb(34, 197, 94); }
  100% { background-color: transparent; }
}

@keyframes flash-error {
  0% { background-color: rgb(239, 68, 68); }
  100% { background-color: transparent; }
}

.flash-success {
  animation: flash-success 0.6s ease-out;
}

.flash-error {
  animation: flash-error 0.6s ease-out;
}

.token-word {
  transition: all 0.2s ease;
  cursor: pointer;
}

.token-word:hover {
  transform: scale(1.02);
}

.token-word.selected {
  border-color: rgb(59, 130, 246);
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3);
}

.token-word.matched {
  opacity: 0;
  transform: scale(0.8);
  pointer-events: none;
}
</style>
