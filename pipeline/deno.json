{
  "tasks": {
    "serve": "deno run --env-file --allow-net --allow-env --allow-read main.ts",
    "cli": "deno run --env-file --allow-net --allow-env --allow-read cli.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/",
    "check": "deno check main.ts cli.ts"
  },
  "imports": {
    "ai": "npm:ai@^5.0.44",
    "@ai-sdk/google": "npm:@ai-sdk/google@^2.0.17",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@^1.0.11",
    "zod": "npm:zod@^3.25.76",
    "@std/assert": "jsr:@std/assert@^1.0.13"
  },
  "fmt": {
    "lineWidth": 100
  }
}
