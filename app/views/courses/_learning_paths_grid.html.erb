<% if learning_paths.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 md:gap-8">
    <% learning_paths.each do |learning_path| %>
      <% lp_hue = lang_hue(learning_path.courses.first&.language&.iso_name) %>
      <%= link_to learning_path_path(learning_path), class: "block s-card cursor-pointer flex flex-col h-full overflow-hidden", style: "padding: 0;" do %>
        <% if learning_path.cover_image_url %>
          <img src="<%= learning_path.cover_image_url %>" alt="<%= learning_path.name %>" class="w-full h-40 object-cover flex-shrink-0">
        <% else %>
          <div class="s-thumb w-full h-40 flex-shrink-0" style="--th: <%= lp_hue %>; border-radius: 0;"></div>
        <% end %>

        <div class="p-4 flex flex-col flex-grow">
          <div class="flex-grow">
            <h3 class="s-h2 mb-2"><%= learning_path.name %></h3>
            <% if learning_path.description.present? %>
              <p class="s-small mb-3 line-clamp-2"><%= truncate(learning_path.description, length: 80) %></p>
            <% end %>
            <div class="s-small mb-3">
              <%= pluralize(learning_path.courses.count, "clip") %>
            </div>
          </div>
          <div class="s-btn w-full">Start Path</div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="px-2 text-slate-400">No courses available yet.</p>
<% end %>
