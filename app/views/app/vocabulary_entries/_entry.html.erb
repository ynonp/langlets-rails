<%# One "Your words" row. Compact (word · meaning · language badge) to sit
    under the Dictionary, but it still carries the context phrase on a second
    line: the phrase is what tells two saved senses of one word apart.
    `fresh` marks the word the Dictionary just saved. %>
<% fresh = local_assigns[:fresh] %>
<%= link_to app_vocabulary_entry_path(entry.id),
            class: "-mx-2.5 flex items-center gap-3 rounded-[10px] border-t border-white/[0.06] px-2.5 py-2.5 #{fresh ? 'bg-app-accent/10' : ''} #{'opacity-55' if entry.paused?}",
            data: { testid: "vocabulary-entry", turbo_frame: "_top" } do %>
  <div class="min-w-0 flex-1">
    <div class="flex min-w-0 items-baseline gap-2.5">
      <p class="shrink-0 text-[19px] font-semibold text-app-text" dir="auto"><%= entry.word %></p>
      <p class="truncate text-[14px] text-app-text-2" dir="auto"><%= entry.translation %></p>
    </div>
    <p class="mt-0.5 flex min-w-0 items-baseline gap-1.5 text-[12px] text-app-text-3">
      <span class="truncate italic" dir="auto"><%= highlighted_vocabulary_context(entry, quoted: true) %></span>
      <% if entry.source.present? %>
        <span class="shrink-0" aria-hidden="true">·</span>
        <span class="max-w-[40%] shrink-0 truncate"><%= entry.source %></span>
      <% end %>
    </p>
  </div>

  <% if fresh %>
    <span data-testid="vocabulary-entry-new"
          class="shrink-0 rounded-md bg-app-accent px-[7px] py-[3px] text-[11px] font-bold tracking-[0.08em] text-app-on-accent">
      <%= t("app.dictionary.new_badge") %>
    </span>
  <% end %>

  <% if entry.paused? %>
    <span class="flex shrink-0 items-center gap-1 text-[11px] font-semibold text-app-text-2"
          title="<%= t("app.vocabulary_entries.paused") %>">
      <span class="flex gap-[2px]" aria-hidden="true">
        <span class="block h-[10px] w-[3px] bg-app-text-2"></span>
        <span class="block h-[10px] w-[3px] bg-app-text-2"></span>
      </span>
      <span class="sr-only"><%= t("app.vocabulary_entries.paused") %></span>
    </span>
  <% end %>

  <span class="shrink-0 rounded-md bg-app-card px-[7px] py-[3px] text-[11px] font-semibold uppercase tracking-[0.08em] text-app-text-2"
        title="<%= localized_language_name(entry.source_language) %>">
    <%= entry.source_language.iso_name.split("-").first %>
  </span>
<% end %>
