<% content_for :head do %>
  <title>Langlets - Learn Languages Through Interactive Video Clips</title>
  <%= render_meta_tags(
    title: "Langlets - Learn Languages Through Interactive Video Clips",
    description: SeoHelper::DEFAULT_DESCRIPTION,
    url: canonical_url(root_path),
    image_url: nil
  ) %>
  <meta name="keywords" content="language learning, interactive video, learn English, learn Hebrew, learn French, learn Spanish, learn Arabic, bilingual education">
<% end %>

<% content_for :canonical_url, canonical_url(root_path) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/website" %>
  <%= render "shared/structured_data/faq_page" %>
  <% if @learning_paths.any? %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Featured Learning Paths on Langlets",
      "itemListElement": [
        <% @learning_paths.each_with_index do |lp, idx| %>
          {
            "@type": "ListItem",
            "position": <%= idx + 1 %>,
            "url": "<%= j canonical_url(learning_path_path(lp)) %>",
            "name": "<%= j lp.name %>"
          }<%= "," unless idx == @learning_paths.size - 1 %>
        <% end %>
      ]
    }
    </script>
  <% end %>
<% end %>

<!-- Top bar: Use existing authentication bar -->
<header class="py-6 border-b border-slate-700/60">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-4">
    <div class="flex-1">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-100 tracking-tight">
        Langlets
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-1">Understand native content</p>
    </div>
    
    <% if user_signed_in? %>
      <div class="flex items-center space-x-4">
        <!-- XP Display -->
        <div class="flex items-center space-x-6">
          <!-- Day Streak -->
          <% daily_xp = ActivityLog.daily_xp_for_user(current_user) %>
          <% streak_info = ActivityLog.streak_info_for_user(current_user) %>
          <% streak = streak_info[:count] %>
          
          <div class="flex items-center text-white">
            <% bg_class = streak_background_class(streak_info[:status]) %>
            <div class="flex items-center <%= bg_class %> px-3 py-1 rounded-full text-sm font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
                <path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.177A7.547 7.547 0 0 1 6.648 6.61a.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248Z" clip-rule="evenodd" />
              </svg>
              <%= streak %> day<%= 's' if streak != 1 %>
            </div>
          </div>

          <!-- Today's XP -->
          <div class="flex items-center text-white">
            <div class="flex items-center bg-blue-500 px-3 py-1 rounded-full text-sm font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <%= daily_xp %> XP
            </div>
          </div>
        </div>

        <!-- Create Course Button (for authorized users) - Hidden on mobile -->
        <% if can? :create, Course %>
          <%= link_to new_course_path, class: "hidden sm:flex bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors duration-200 text-sm items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
              <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
            </svg>
            Create Course
          <% end %>
          <%= link_to new_import_course_path, class: "hidden sm:flex bg-purple-600 hover:bg-purple-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors duration-200 text-sm items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
              <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm.53 5.47a.75.75 0 0 0-1.06 0L8.22 10.5a.75.75 0 0 0 1.06 1.06l2.22-2.22v6.69a.75.75 0 0 0 1.5 0V9.84l2.22 2.22a.75.75 0 1 0 1.06-1.06l-3.75-3.53Z" clip-rule="evenodd" transform="rotate(180 12 12)" />
            </svg>
            Import
          <% end %>
          <%= link_to new_resync_timestamp_path, class: "hidden sm:flex bg-orange-600 hover:bg-orange-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors duration-200 text-sm items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
              <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z" clip-rule="evenodd" />
            </svg>
            Resync
          <% end %>
        <% end %>

        <!-- User Menu -->
        <div class="relative group">
          <input type="checkbox" id="user-menu-toggle" class="hidden peer">
          <label for="user-menu-toggle" class="flex items-center cursor-pointer">
            <img src="<%= 'https://ui-avatars.com/api/?name=' + ERB::Util.url_encode(current_user.email) %>" alt="Avatar" class="w-10 h-10 rounded-full border-2 border-blue-500 shadow" />
          </label>
          <div class="absolute right-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-lg shadow-lg opacity-0 invisible peer-checked:opacity-100 peer-checked:visible transition-all duration-150 z-50">
            <% if native_app? %>
              <% current_lang = Language.find_by(iso_name: params[:lang]) %>
              <%= link_to onboarding_language_path(returnto: request.fullpath), class: "flex items-center px-4 py-3 text-slate-200 hover:bg-slate-700 transition-colors duration-150" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2 text-blue-400">
                  <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM8.288 9.01a.75.75 0 0 1 1.042-.018 14.83 14.83 0 0 0 2.39 1.68c.826.495 1.74.845 2.674 1.029a.75.75 0 0 1-.28 1.473 16.303 16.303 0 0 1-3.248-.986 16.304 16.304 0 0 1-2.578-1.813.75.75 0 0 1 0-1.365Zm4.922 4.49a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm-5.25-2.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm">Learning Language: <%= current_lang&.native_name || "Select" %></span>
              <% end %>
              <div class="border-t border-slate-700 my-1"></div>
            <% end %>
            <!-- Create Course Button (for mobile) -->
            <% if can? :create, Course %>
              <%= link_to new_course_path, class: "sm:hidden flex items-center px-4 py-3 text-green-400 hover:bg-slate-700 transition-colors duration-150" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
                  <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                </svg>
                Create Course
              <% end %>
              <%= link_to new_import_course_path, class: "sm:hidden flex items-center px-4 py-3 text-purple-400 hover:bg-slate-700 transition-colors duration-150" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
                  <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm.53 5.47a.75.75 0 0 0-1.06 0L8.22 10.5a.75.75 0 0 0 1.06 1.06l2.22-2.22v6.69a.75.75 0 0 0 1.5 0V9.84l2.22 2.22a.75.75 0 1 0 1.06-1.06l-3.75-3.53Z" clip-rule="evenodd" transform="rotate(180 12 12)" />
                </svg>
                Import Courses
              <% end %>
              <%= link_to new_resync_timestamp_path, class: "sm:hidden flex items-center px-4 py-3 text-orange-400 hover:bg-slate-700 transition-colors duration-150" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
                  <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z" clip-rule="evenodd" />
                </svg>
                Resync Timestamps
              <% end %>
              <div class="sm:hidden border-t border-slate-700 my-1"></div>
            <% end %>
            <% current_user.languages_with_saved_words.order(:iso_name).each do |language| %>
              <%= button_to "📚 Review Words (#{language.iso_name})", review_lessons_path(language_code: language.iso_name),
                method: :post,
                class: "w-full text-left px-4 py-3 text-yellow-300 hover:bg-slate-700 rounded-lg transition-colors duration-150",
                data: { turbo: false }
              %>
            <% end %>
            <% if current_user.languages_with_saved_words.exists? %>
              <div class="border-t border-slate-700 my-1"></div>
            <% end %>
            <%= link_to "Logout",
              destroy_user_session_path(returnto: request.fullpath),
              method: :delete,
              data: { turbo_method: :delete, controller: "bridge--sign-out", action: "click->bridge--sign-out#notifySignOut" },
              class: "block px-4 py-3 text-slate-200 hover:bg-slate-700 rounded-lg transition-colors duration-150"
            %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
        <span class="text-slate-300 text-sm sm:text-base hidden sm:block">Sign in now to not lose your progress</span>
        <div class="flex gap-2">
          <%= link_to "Sign up", new_user_registration_path(returnto: request.fullpath), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-3 sm:px-5 py-2 rounded-lg transition-colors duration-200 text-sm sm:text-base" %>
          <%= link_to "Log in", new_user_session_path(returnto: request.fullpath), class: "text-blue-400 hover:text-blue-600 font-semibold px-3 sm:px-5 py-2 rounded-lg transition-colors duration-200 text-sm sm:text-base" %>
        </div>
      </div>
    <% end %>
  </div>
</header>

<%= render "shared/language_selector", languages: @languages %>

<main class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-8 overflow-x-hidden">

  <!-- Flash Messages -->
  <% if notice %>
    <div class="mb-6 p-4 bg-green-900/50 border border-green-500 rounded-lg">
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-green-400 mr-3">
          <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
        </svg>
        <p class="text-green-200"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <% if alert %>
    <div class="mb-6 p-4 bg-red-900/50 border border-red-500 rounded-lg">
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-red-400 mr-3">
          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd" />
        </svg>
        <p class="text-red-200"><%= alert %></p>
      </div>
    </div>
  <% end %>

  <!-- GEO: Entity-rich description for search engines and AI crawlers -->
  <section class="mb-8 px-2">
    <p class="text-slate-300 text-lg leading-relaxed">
      Understand native content in
      <strong class="text-white">English</strong>,
      <strong class="text-white">Hebrew</strong>,
      <strong class="text-white">French</strong>,
      <strong class="text-white">Spanish</strong>, and
      <strong class="text-white">Arabic</strong>.
      Each course breaks down bilingual phrases with word-level translations, timestamps,
      and AI-powered activities designed to build your listening, speaking, and
      comprehension skills through spaced repetition.
    </p>
  </section>

  <!-- Continue Learning Section - show courses user has started -->
  <% if user_signed_in? && @continue_learning_courses.any? %>
    <section class="mb-10">
      <h2 class="text-3xl font-bold text-slate-100 mb-6 px-2">Continue Learning</h2>
      <div class="swiper overflow-hidden" data-controller="swiper" data-swiper-target="container">
        <div class="swiper-wrapper">
          <% @continue_learning_courses.each do |course| %>
            <div class="swiper-slide">
              <%= render 'course_card', course: course, container_classes: "block w-64 sm:w-72 md:w-80 bg-slate-800 rounded-xl shadow-lg hover:shadow-xl transition duration-300 cursor-pointer border border-slate-700 flex flex-col h-full" %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Courses (Learning Paths) -->
  <% if @learning_paths.any? %>
    <section class="mb-10">
      <h2 class="text-3xl font-bold text-slate-100 mb-6 px-2">Courses</h2>
      <div class="swiper overflow-hidden" data-controller="swiper" data-swiper-target="container">
        <div class="swiper-wrapper">
          <% @learning_paths.each_with_index do |learning_path, index| %>
            <div class="swiper-slide">
              <%= link_to learning_path_path(learning_path), class: "block w-64 sm:w-72 md:w-80 bg-slate-800 rounded-xl shadow-lg hover:shadow-xl transition duration-300 cursor-pointer border border-slate-700 flex flex-col h-full overflow-hidden" do %>
                <!-- Path Image -->
                <% if learning_path.cover_image_url %>
                  <img src="<%= learning_path.cover_image_url %>" alt="<%= learning_path.name %>" class="w-full h-40 object-cover flex-shrink-0">
                <% else %>
                  <% gradient_colors = ['from-blue-500 to-blue-700', 'from-rose-500 to-rose-700', 'from-green-500 to-green-700', 'from-purple-500 to-purple-700', 'from-amber-500 to-amber-700'] %>
                  <div class="w-full h-40 bg-gradient-to-br <%= gradient_colors[index % gradient_colors.length] %> flex-shrink-0"></div>
                <% end %>
                
                <!-- Path Content -->
                <div class="p-4 flex flex-col flex-grow">
                  <div class="flex-grow">
                    <h3 class="text-lg font-semibold text-slate-100 mb-2"><%= learning_path.name %></h3>
                    <% if learning_path.description.present? %>
                      <p class="text-sm text-slate-400 mb-3 line-clamp-2"><%= truncate(learning_path.description, length: 80) %></p>
                    <% end %>
                    <div class="text-sm text-slate-400 mb-3">
                      <%= pluralize(learning_path.courses.count, 'clip') %>
                    </div>
                  </div>
                  <div class="w-full bg-blue-600 text-white py-2 rounded-lg font-medium hover:bg-blue-700 transition duration-200 text-center">
                    Start Path
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Standalone Clips -->
  <% if @all_courses.any? %>
    <section class="px-2">
      <h2 class="text-3xl font-bold text-slate-100 mb-6 px-2">Standalone Clips</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8">
        <% @all_courses.each do |course| %>
          <%= render 'course_card', course: course %>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Row: "Next For You" - only show if user signed in and has recommended courses -->
  <% if user_signed_in? && @recommended_courses.any? %>
    <section class="mb-10">
      <h2 class="text-3xl font-bold text-slate-100 mb-6 px-2">Next For You</h2>
      <div class="swiper overflow-hidden" data-controller="swiper" data-swiper-target="container">
        <div class="swiper-wrapper">
          <% @recommended_courses.each do |course| %>
            <div class="swiper-slide">
              <%= render 'course_card', course: course, container_classes: "block w-64 sm:w-72 md:w-80 bg-slate-800 rounded-xl shadow-lg hover:shadow-xl transition duration-300 cursor-pointer border border-slate-700 flex flex-col h-full" %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

</main>

<footer class="bg-slate-800 border-t border-slate-700 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
      <div class="text-slate-400 text-sm">
        © <%= Date.current.year %> Langlets. All rights reserved.
      </div>
      <div class="flex space-x-6">
        <%= link_to "Privacy Policy", "/home/privacy", class: "text-slate-400 hover:text-white text-sm transition-colors duration-200" %>
        <%= link_to "Terms of Service", "/home/terms", class: "text-slate-400 hover:text-white text-sm transition-colors duration-200" %>
      </div>
    </div>
  </div>
</footer>
