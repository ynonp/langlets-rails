<article id="<%= dom_id(import_request, :wrapper) %>"
         class="min-w-0 w-full rounded-3xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-5">
  <div id="<%= dom_id(import_request) %>"
       data-import-request-status="<%= import_request.status %>"
       class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <div id="<%= dom_id(import_request, :thumb) %>" class="shrink-0">
      <% if import_request.queued? %>
        <div class="flex aspect-video w-full items-center justify-center rounded-2xl bg-gray-100 text-gray-400 dark:bg-gray-800 sm:w-40" aria-label="Waiting to start">
          <%= app_icon "clock", class: "h-6 w-6" %>
        </div>
      <% else %>
        <%= image_tag import_request.thumbnail_url, alt: "", loading: "lazy",
                      class: "aspect-video w-full rounded-2xl bg-gray-100 object-cover dark:bg-gray-800 sm:w-40" %>
      <% end %>
    </div>
    <%= render "app/import_requests/web/import_request_body", import_request: import_request %>
  </div>
</article>
