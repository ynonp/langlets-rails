<div
    class="flex-1 min-h-0 overflow-y-auto flex-col flex items-center bg-emerald-50 dark:bg-gray-950"
    data-controller="find-answers"
    data-find-answers-questions-value="<%= params[:questions].to_json %>"
    data-find-answers-current-question-value="0"
>
  <div data-find-answers-target="activityContent" class="w-full max-w-[800px] bg-white dark:bg-gray-900 dark:border dark:border-gray-800 p-6 rounded-2xl shadow-md text-gray-900 dark:text-gray-50">
    <h2
        data-find-answers-target="question"
        id="current-question"
        class="text-xl mb-4 font-semibold text-center">
    </h2>

    <div class="flex gap-4">
      <div id="phrases-container" class="mt-4 space-y-4 flex-1">
        <% params[:phrases].each do |p| %>
          <div class="text-lg rounded">
            <%= wrap_tokens_in_spans(p,
                                     data: {
                                       action: 'click->find-answers#checkAnswer',
                                     }) %>
          </div>
        <% end %>
      </div>

      <div id="translations-container" class="mt-4 space-y-4 flex-1 text-gray-500 dark:text-gray-400">
        <% params[:text].each do |t| %>
          <div class="text-lg rounded">
            <%= t[:translation] %>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <%= render "activities/completion_message",
        controller: "find-answers",
        target: "completionMessage",
        title: t(".good_work"),
        next_label: t(".next"),
        id: "success-message" %>
</div>
