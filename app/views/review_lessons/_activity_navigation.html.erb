<% current_activity_order = params[:a].to_i %>
<% current_activity_order = @activity.order if current_activity_order == 0 %>

<div class="s-stepnav activity-stepnav">
  <%= link_to root_path,
    class: "flex items-center justify-center flex-shrink-0",
    style: "color: var(--faint);",
    title: "Back to Home",
    data: { :"turbo-frame" => "_top", :turbo => false } do %>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
  <% end %>

  <div class="flex-1 flex items-center justify-center" style="gap: 8px;">
    <% @activities.each do |activity| %>
      <%
        status = if activity.order < current_activity_order
                   "done"
                 elsif activity.order == current_activity_order
                   "current"
                 else
                   "upcoming"
                 end
      %>
      <%= link_to review_lesson_path(@lesson, a: activity.order),
          class: "s-step s-step--#{status}",
          data: { turbo_frame: 'activity' },
          aria: { label: "Activity #{activity.order}" } do %>
        <% if status == "done" %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <% else %>
          <%= activity.order %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div style="width: 22px; flex-shrink: 0;"></div>
</div>
