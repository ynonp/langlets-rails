%>

<div
    class="flex-col flex items-center min-h-screen bg-gray-800"
    data-controller="find-answers"
    data-find-answers-questions-value="<%= params[:questions].to_json %>"
    data-find-answers-current-question-value="0"
>
  <div class="w-full max-w-[800px] bg-gray-800 p-6 rounded-lg text-white">
    <div class="mb-6">
      <%= render partial: 'activities/activity_progress_bar' %>
    </div>
    <h2
        data-find-answers-target="question"
        id="current-question"
        class="text-xl mb-4 font-semibold text-center">
    </h2>
    
    <div class="flex gap-4">
      <div id="phrases-container" class="mt-4 space-y-4 flex-1">
        <% params[:phrases].each do |p| %>
          <div class="text-lg rounded">
            <%= wrap_tokens_in_spans(p,
                                     data: {
                                       action: 'click->find-answers#checkAnswer',
                                     }) %>
          </div>
        <% end %>
      </div>
      
      <div id="translations-container" class="mt-4 space-y-4 flex-1 text-gray-400">
        <% params[:text].each do |t| %>
          <div class="text-lg rounded">
            <%= t[:translation] %>
          </div>
        <% end %>
      </div>
    </div>
    
    <div 
      data-find-answers-target="completionMessage"
      id="success-message" class="hidden mt-6 text-center">
      <h3 class="text-xl font-bold text-green-500 mb-4">Good Work!</h3>
      <%= link_to "Next", @next_activity_path, { class: "px-6 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors duration-200 text-center inline-block" } %>
    </div>
  </div>
</div>

