<% content_for :title, "#{@lookup.query} · langlets." %>

<div class="app-scroll-pad px-5 pt-6 flex flex-col gap-4 pb-28">
  <%= link_to t("app.dictionary.done"), app_vocabulary_entries_path,
              data: { turbo_action: "replace" },
              class: "self-end rounded-full bg-app-pill px-4 py-2 text-sm font-semibold text-app-text-dim" %>

  <%# Keep the current query editable until the word is saved. %>
  <%= form_with url: app_vocabulary_dictionary_lookups_path, method: :post,
                data: { testid: "dictionary-compact-form", turbo_action: "replace" },
                class: "app-hairline flex h-[52px] items-center gap-2.5 rounded-full bg-app-card ps-4 pe-2 focus-within:ring-1 focus-within:ring-app-accent" do |f| %>
    <%= app_icon "search", class: "h-[18px] w-[18px] shrink-0 text-app-text-2" %>
    <label for="dictionary-query" class="sr-only"><%= t("app.dictionary.look_up") %></label>
    <%= f.text_field :query, id: "dictionary-query", value: @saved ? "" : @lookup.query,
                     placeholder: t("app.dictionary.next_word"),
                     maxlength: DictionaryLookup::MAX_QUERY_LENGTH,
                     required: true, autocomplete: "off", autocapitalize: "off",
                     enterkeyhint: "search", dir: "auto",
                     class: "min-w-0 flex-1 bg-transparent p-0 text-[19px] font-medium text-app-text outline-none border-0 focus:ring-0" %>
    <button type="submit" aria-label="<%= t("app.dictionary.look_up") %>"
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-app-pill text-app-accent">
      <%= app_icon "arrow_right", class: "h-[18px] w-[18px] rtl:-scale-x-100" %>
    </button>
  <% end %>

  <% if flash[:notice].present? %>
    <div class="flex items-center justify-between gap-3 rounded-app-field bg-app-card px-4 py-3 text-[14px] text-app-text">
      <p role="status" dir="auto"><%= flash[:notice] %></p>
      <% if flash[:dictionary_undo_entry_id].present? %>
        <%= button_to t("app.vocabulary_entries.undo"), app_vocabulary_entry_path(flash[:dictionary_undo_entry_id]),
                      method: :delete, params: { undo_save: 1, dictionary_lookup_id: @lookup.id },
                      form: { data: { turbo_action: "replace" } },
                      data: { testid: "dictionary-undo" }, class: "font-bold text-app-accent" %>
      <% end %>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <p role="alert" class="rounded-app-field bg-red-500/10 px-4 py-3 text-[14px] font-semibold text-red-300"><%= flash[:alert] %></p>
  <% end %>

  <%= render "card", lookup: @lookup %>
</div>
