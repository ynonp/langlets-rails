<% 
  current_activity_order = params[:a].to_i
  current_activity_order = @activity.order if current_activity_order == 0 
%>

<div class="bg-gray-900 py-2 px-2 overflow-x-auto">
  <div class="flex items-center justify-between">
    <div class="flex items-center">
      <% unless native_app? %>
        <%= link_to @course_path,
          class: "text-white mr-4 p-2 rounded-md hover:bg-white hover:bg-opacity-10 transition-colors duration-200",
          title: "Back to Course",
          data: {
            :"turbo-frame" => "_top",
            :turbo => false
          } do %>
          <svg xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 384 512"
            class="h-5 w-5 fill-white"
          >
            <path d="M376.6 84.5c11.3-13.6 9.5-33.8-4.1-45.1s-33.8-9.5-45.1 4.1L192 206 56.6 43.5C45.3 29.9 25.1 28.1 11.5 39.4S-3.9 70.9 7.4 84.5L150.3 256 7.4 427.5c-11.3 13.6-9.5 33.8 4.1 45.1s33.8 9.5 45.1-4.1L192 306 327.4 468.5c11.3 13.6 31.5 15.4 45.1 4.1s15.4-31.5 4.1-45.1L233.7 256 376.6 84.5z"/>
          </svg>
        <% end %>
      <% end %>
    </div>

    <div class="flex-1 flex justify-center">
      <div class="flex items-center min-w-min">
        <% if @prev_lesson.present? %>
          <%= link_to course_lesson_path(@course, @prev_lesson),
            class: "w-8 h-8 mx-2 rounded-full flex items-center justify-center font-bold no-underline relative text-sm bg-gray-700 text-white hover:bg-gray-600",
            title: "Previous Lesson",
            data: { 
              turbo_frame: 'activity',
              lesson_invalidate_cache: 'true'
            } do %>
            «
          <% end %>
        <% end %>
        <% @activities.each do |activity| %>
          <% 
            status = if activity.order < current_activity_order
                      "completed"
                    elsif activity.order == current_activity_order
                      "current"
                    else
                      "upcoming"
                    end
          %>
          <div class="flex items-center">
            <%= link_to course_lesson_path(@course, @lesson, a: activity.order), class: "w-8 h-8 mx-2 rounded-full flex items-center justify-center font-bold no-underline relative z-10 transition-all duration-200 text-sm #{case status
                 when 'completed' then 'bg-green-500 text-white'
                 when 'current' then 'bg-yellow-400 text-gray-900 shadow-lg ring-2 ring-yellow-400 ring-opacity-30'
                 else 'bg-blue-500 text-white'
               end}", data: { turbo_frame: 'activity' }, aria: { label: "Activity #{activity.order}" } do %>
              <% if status == "completed" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                  <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
                </svg>
              <% else %>
                <%= activity.order %>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <% if @next_lesson.present? %>
          <%= link_to course_lesson_path(@course, @next_lesson),
            class: "w-8 h-8 mx-2 rounded-full flex items-center justify-center font-bold no-underline relative z-10 transition-all duration-200 text-sm bg-gray-700 text-white hover:bg-gray-600",
            title: "Next Lesson",
            data: {
              turbo_frame: 'activity',
              lesson_invalidate_cache: 'true',
              controller: 'lesson-navigation',
              action: 'click->lesson-navigation#markLessonCompleted',
              'lesson-navigation-lesson-id-value': @lesson.id
            } do %>
            »
          <% end %>
        <% else %>
          <%= link_to course_path(@course.slug),
            class: "w-8 h-8 mx-2 rounded-full flex items-center justify-center font-bold no-underline relative z-10 transition-all duration-200 text-sm bg-green-700 text-white hover:bg-green-600",
            title: "Back to Course",
            data: {
              lesson_invalidate_cache: 'true',
              controller: 'lesson-navigation',
              action: 'click->lesson-navigation#markLessonCompleted',
              'lesson-navigation-lesson-id-value': @lesson.id
            } do %>
            »
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="w-10"></div>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .w-8.h-8 {
      width: 1.75rem !important;
      height: 1.75rem !important;
      font-size: 0.75rem !important;
    }
    
    .w-8 {
      width: 1.5rem !important;
    }
    
    .w-4.h-4 {
      width: 0.875rem !important;
      height: 0.875rem !important;
    }

    .w-5.h-5 {
      width: 1rem !important;
      height: 1rem !important;
    }
  }
</style> 
