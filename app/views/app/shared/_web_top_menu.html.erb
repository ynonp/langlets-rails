<header class="border-b border-gray-200 bg-white/85 backdrop-blur dark:border-gray-800 dark:bg-gray-950/85">
  <div class="mx-auto flex w-full max-w-screen-xl items-center gap-6 px-4 py-4 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "text-xl font-extrabold tracking-tight sm:text-2xl" do %>Langlets<% end %>
    <nav class="flex flex-1 items-center gap-1" aria-label="<%= t("app.web_menu.label") %>">
      <%= link_to t("app.web_menu.library"), gallery_path,
                  aria: { current: ("page" if active == :library) },
                  class: "rounded-xl px-3 py-2 text-sm font-bold #{active == :library ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-900'}" %>
      <%= link_to t("app.web_menu.create"), app_import_requests_path,
                  aria: { current: ("page" if active == :create) },
                  class: "rounded-xl px-3 py-2 text-sm font-bold #{active == :create ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-900'}" %>
    </nav>
    <div class="flex items-center gap-3">
      <%= render "shared/theme_toggle" %>
      <%= render "shared/user_menu" %>
    </div>
  </div>
</header>
