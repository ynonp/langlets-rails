<%# Expects:
  params[:tokens] - An array of token objects with id, l1_text, l2_text
  params[:l1] - Language object for L1 tokens
  params[:l2] - Language object for L2 translations
  
  This activity shows a 4x4 grid where:
  1. Top-left square shows first L1 token (Spanish)
  2. Other 15 squares show all 16 L2 translations (English, shuffled)
  3. User clicks matching L2 translation square
  4. Matched square flips to show next L1 token
  5. Chain continues through matched squares
  6. Activity ends when all tokens are matched
%>

<% 
  tokens = params[:tokens] || []
  l1 = params[:l1]
  l2 = params[:l2]
  total_tokens = tokens.length
  
  # Get first token for the top-left square (L1 word)
  first_token = tokens.first
  
  # Shuffle all L2 translations and take only 15 for display in the other squares
  shuffled_tokens = tokens.shuffle.first(15)
%>

<div
    data-controller="tokens-chain-activity"
    data-tokens-chain-activity-tokens-value="<%= tokens.to_json %>"
    data-tokens-chain-activity-total-tokens-value="<%= total_tokens %>"
    class="flex-col flex items-center bg-emerald-50 dark:bg-gray-950">

  <div class="w-full max-w-[640px] p-4 sm:p-6 bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-2xl shadow-md">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl text-gray-900 dark:text-gray-50 mb-2"><%= @activity.text_header || "Token Chain" %></h2>
      <p class="text-gray-500 dark:text-gray-400 text-sm sm:text-base mb-4">Click on the translation of the highlighted word</p>
      <div data-tokens-chain-activity-target="stopPracticingContainer" class="mb-2 text-center"></div>
      <div class="w-full bg-gray-100 dark:bg-gray-800 rounded-full h-2.5 mt-4">
        <div data-tokens-chain-activity-target="progressBar" id="progress" class="bg-emerald-500 h-2.5 rounded-full w-0 transition-all duration-500"></div>
      </div>
    </div>

    <div id="tokens-chain-activity" class="flex flex-col gap-4">

      <!-- Completion message -->
      <div data-tokens-chain-activity-target="completionMessage" data-progress-tracker-target="completion" class="hidden p-4 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-center sm:text-left text-xl font-bold text-gray-900 dark:text-gray-50">Great job!</h3>
          <p class="text-center sm:text-left text-gray-500 dark:text-gray-400">You've matched all the tokens correctly.</p>
        </div>
        <%= link_to_next_activity("Next", @next_activity_path, class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors w-full sm:w-auto") %>
      </div>

      <!-- 4x4 Grid container -->
      <div class="grid grid-cols-4 gap-3" data-tokens-chain-activity-target="grid">
        <% # Top-left square: First L1 word (Spanish) %>
        <div
          data-tokens-chain-activity-target="startButton"
          data-action="click->tokens-chain-activity#playL1Audio"
          class="grid-square px-4 py-6 border-2 border-gray-200 dark:border-gray-700 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-50 font-semibold transition-all duration-200 flex items-center justify-center min-h-[100px] text-lg cursor-pointer showing-l1 current-l1 <%= l1.rtl ? 'text-right' : 'text-left' %>">
          <span class="token-text text-center break-words"><%= first_token[:l1_text] %></span>
          <% if first_token[:audio_url] %>
            <audio preload="auto" data-token-audio>
              <source src="<%= first_token[:audio_url] %>" type="audio/mpeg">
            </audio>
          <% end %>
        </div>

        <% # Other 15 squares: 15 L2 translations (English, shuffled) %>
        <% shuffled_tokens.each do |token| %>
          <div
            class="grid-square px-4 py-6 border-2 border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-900 dark:text-gray-50 transition-all duration-200 flex items-center justify-center min-h-[100px] cursor-pointer <%= l2.rtl ? 'text-right' : 'text-left' %>"
            data-token-id="<%= token[:id] %>"
            data-action="click->tokens-chain-activity#selectSquare">
            <span class="token-text text-center break-words"><%= token[:l2_text] %></span>
            <% if token[:audio_url] %>
              <audio preload="auto" data-token-audio>
                <source src="<%= token[:audio_url] %>" type="audio/mpeg">
              </audio>
            <% end %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>

<style>
@keyframes flash-success {
  0% { background-color: rgb(34, 197, 94); }
  100% { background-color: transparent; }
}

@keyframes flash-error {
  0% { background-color: rgb(239, 68, 68); }
  100% { background-color: transparent; }
}

.flash-success {
  animation: flash-success 0.6s ease-out;
}

.flash-error {
  animation: flash-error 0.6s ease-out;
}

.grid-square {
  transition: all 0.2s ease;
  word-wrap: break-word;
  overflow: hidden;
}

.grid-square:hover:not(:disabled):not(.showing-l1) {
  transform: scale(1.02);
  border-color: var(--color-emerald-500);
}

.grid-square.showing-l1 {
  cursor: pointer;
}

.grid-square.current-l1 {
  background-color: var(--color-emerald-500) !important;
  color: #fff !important;
  border-color: var(--color-emerald-400) !important;
  border-width: 3px;
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-emerald-500) 40%, transparent), 0 0 15px color-mix(in oklab, var(--color-emerald-500) 50%, transparent);
  transform: scale(1.05);
  z-index: 10;
}
</style>

