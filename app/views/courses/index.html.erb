<% content_for :head do %>
  <title><%= t("layouts.head.title") %></title>
  <%= render_meta_tags(
    title: t("courses.index.meta.title"),
    description: t("courses.index.meta.description"),
    url: canonical_url(root_path),
    image_url: canonical_url("/cover.png"),
    image_width: 1731,
    image_height: 909
  ) %>
  <meta name="keywords" content="language learning, interactive video, learn English, learn Hebrew, learn French, learn Spanish, learn Arabic, bilingual education">
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<% end %>

<% content_for :canonical_url, canonical_url(root_path) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/website" %>
  <%= render "shared/structured_data/faq_page" %>
  <% if @playlists.any? %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Featured Playlists on Langlets",
      "itemListElement": [
        <% @playlists.each_with_index do |lp, idx| %>
          {
            "@type": "ListItem",
            "position": <%= idx + 1 %>,
            "url": "<%= j canonical_url(playlist_path(lp)) %>",
            "name": "<%= j lp.name %>"
          }<%= "," unless idx == @playlists.size - 1 %>
        <% end %>
      ]
    }
    </script>
  <% end %>
<% end %>

<%
%>

<style>
  .lp {
    --bg:#FAF6EF; --ink:#1E1B16; --accent:#C4451C; --accent-d:#9E3410;
    --muted:#55503F; --faint:#8A8170; --card:#FFFDF8; --shadow:#EADFC9;
    --dark:#1E1B16; --dark-fg:#FAF6EF; --dark-muted:#B5AC98;
    min-height:100vh; display:flex; flex-direction:column;
    background:var(--bg); color:var(--ink);
    font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  /* Zero-specificity default (via :where) so anchors inherit their surrounding
     text colour, and every component rule below can set its own without a
     specificity war. */
  :where(.lp a) { color:inherit; text-decoration:none; }
  .lp ::selection { background:#F4D8A6; }
  .lp-display { font-family:'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif; }

  /* Nav — same 1100 content column + 40px padding as the hero and library, so
     the brand's left edge lines up with the hero headline and "Jump right in". */
  .lp-nav { display:flex; align-items:center; justify-content:space-between; gap:24px;
    padding:20px 40px; max-width:1180px; width:100%; margin:0 auto; box-sizing:border-box; flex-wrap:wrap; }
  .lp-brand { display:flex; align-items:baseline; gap:8px; }
  .lp-brand-name { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:26px; letter-spacing:-0.02em; color:var(--ink); }
  .lp-brand-dot { width:8px; height:8px; border-radius:50%; background:var(--accent); display:inline-block; transform:translateY(-2px); }
  .lp-nav-links { display:flex; align-items:center; gap:28px; font-size:15px; font-weight:500; flex-wrap:wrap; }
  .lp-navlink { color:var(--ink); }
  .lp-navlink:hover { color:var(--accent); }
  .lp-daily-vocab { display:inline-flex; align-items:center; gap:8px; border:0; border-radius:999px; background:#DFF1E8; padding:7px 14px;
    color:#0F6E56; font:inherit; font-weight:500; cursor:pointer; }
  .lp-daily-vocab:hover { background:#CFE9DC; }
  .lp-signout { background:none; border:none; padding:0; font:inherit; color:var(--ink); font-weight:500; cursor:pointer; }
  .lp-signout:hover { color:var(--accent); }

  /* Hero — max-width is 1100 (the shared content column) plus the 40px
     horizontal padding on each side, so the border-box padding doesn't inset
     the content past the library/footer edges below it. */
  .lp-hero { max-width:1180px; margin:0 auto; padding:40px 40px 56px; box-sizing:border-box; width:100%;
    display:grid; grid-template-columns:1.15fr 1fr; gap:56px; align-items:center; }
  .lp-h1 { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:52px; line-height:1.02;
    letter-spacing:-0.03em; margin:0 0 16px; text-wrap:balance; }
  .lp-supported { font-size:18px; line-height:1.45; color:var(--ink); font-weight:700; margin:0 0 12px; }
  .lp-lead { font-size:17px; line-height:1.55; color:var(--muted); margin:0 0 28px; max-width:520px; text-wrap:pretty; }
  .lp-paste { display:flex; gap:10px; background:var(--card); border:2px solid var(--ink); border-radius:16px;
    padding:8px; max-width:540px; }
  .lp-paste input { flex:1; border:none; outline:none; background:transparent; font-family:'Instrument Sans', sans-serif;
    font-size:16px; color:var(--ink); padding:8px 10px; min-width:0; }
  .lp-create { background:var(--accent); color:var(--card); border:none; border-radius:10px; padding:11px 28px;
    font-family:'Bricolage Grotesque', sans-serif; font-weight:700; font-size:16px; cursor:pointer; }
  .lp-create:hover { background:var(--accent-d); }

  /* Product preview */
  .lp-product-frame { border:2px solid var(--ink); border-radius:18px; overflow:hidden; box-shadow:6px 6px 0 var(--shadow); }
  .lp-product-img { width:100%; height:auto; display:block; }

  /* Library */
  .lp-library { background:var(--dark); color:var(--dark-fg); padding:72px 40px 80px; }
  .lp-lib-inner { max-width:1100px; margin:0 auto; }
  .lp-try-form { max-width:680px; margin-bottom:24px; }
  .lp-try-label { margin:0 0 12px; color:var(--dark-fg); font-size:20px; line-height:1.4; font-weight:700; }
  .lp-try-form .lp-paste { border-color:#5A5245; }
  .lp-try-or { max-width:800px; color:var(--dark-fg); margin:0 0 22px; font-size:18px; line-height:1.5; }
  .lp-filters { display:flex; gap:8px; flex-wrap:wrap; }
  .lp-chip { background:transparent; color:var(--dark-muted); border:1px solid #4A443A; border-radius:999px;
    padding:9px 18px; font-family:'Instrument Sans', sans-serif; font-size:14.5px; font-weight:600; cursor:pointer; }
  .lp-chip:hover { border-color:var(--accent); }
  .lp-chip.is-active { background:var(--bg); color:var(--ink); }
  .lp-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:20px; }
  .lp-card { display:flex; flex-direction:column; width:100%; padding:0; background:#2A261F; border-radius:16px; overflow:hidden;
    color:var(--dark-fg); border:1px solid #3A352C; text-align:start; font:inherit; cursor:pointer; }
  .lp-card:hover { border-color:var(--accent); color:var(--dark-fg); }
  .lp-card[aria-pressed="true"] { border-color:var(--accent); box-shadow:0 0 0 2px var(--accent); }
  .lp-card-thumb { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; background:#0B1220; }
  .lp-card-body { padding:16px 18px 18px; display:flex; flex-direction:column; gap:8px; flex:1; }
  .lp-card-title { font-weight:600; font-size:15.5px; line-height:1.35; display:-webkit-box;
    -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .lp-card-meta { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--dark-muted); margin-top:auto; }
  .lp-card-dot { width:7px; height:7px; border-radius:50%; display:inline-block; }
  .lp-empty { color:var(--dark-muted); font-size:16px; }
  .lp-browse-all { display:flex; justify-content:center; margin-top:32px; }
  .lp-browse-all a { display:inline-flex; align-items:center; justify-content:center; border:1px solid #5A5245; border-radius:999px;
    padding:12px 22px; color:var(--dark-fg); font-weight:700; }
  .lp-browse-all a:hover { border-color:var(--accent); color:var(--dark-fg); }

  /* The offset shadow is drawn to the right, which reads as "behind" only in
     LTR. Mirror it on the Hebrew subdomain. */
  [dir="rtl"] .lp-product-frame { box-shadow:-6px 6px 0 var(--shadow); }

  /* Footer */
  .lp-footer { border-top:1px solid #E4DCCC; padding:28px 40px; margin-top:auto; }
  .lp-footer-inner { max-width:1100px; margin:0 auto; display:flex; justify-content:space-between; align-items:center;
    gap:20px; flex-wrap:wrap; font-size:14px; color:var(--faint); }
  .lp-footer-links { display:flex; gap:20px; }
  .lp-footer-links a { color:var(--faint); }
  .lp-footer-links a:hover { color:var(--accent); }

  @media (max-width:860px) {
    .lp-nav { padding:16px 20px; }
    .lp-hero { grid-template-columns:1fr; gap:36px; padding:24px 20px 40px; }
    .lp-h1 { font-size:38px; }
    .lp-library { padding:56px 20px 64px; }
    .lp-footer { padding:24px 20px; }
  }
  @media (max-width:560px) {
    .lp-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .lp-card-body { padding:11px 12px 13px; gap:6px; }
    .lp-card-title { font-size:13px; }
    .lp-card-meta { font-size:11px; align-items:flex-start; }
  }
</style>

<div class="lp">
  <!-- Nav -->
  <nav class="lp-nav">
    <%= link_to root_path, class: "lp-brand", "aria-label": t(".nav.home") do %>
      <span class="lp-brand-name">langlets</span>
      <span class="lp-brand-dot"></span>
    <% end %>
    <div class="lp-nav-links">
      <% if @daily_vocab_language %>
        <%= link_to review_lessons_path(language_code: @daily_vocab_language),
                    class: "lp-daily-vocab", data: { turbo: false, testid: "daily-vocab-nav" } do %>
          <span><%= t(".nav.daily_vocab") %></span>
          <% if @daily_vocab_streak.to_i.positive? %>
            <span class="inline-flex items-center gap-1" aria-label="<%= t(".nav.day_streak", count: @daily_vocab_streak) %>">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2c1 3 4 4.5 4 8a4 4 0 0 1-8 0c0-1 .3-1.8.8-2.5C8 8.8 7 10.3 7 12.5a5 5 0 0 0 10 0c0-4.2-3-6.5-5-10.5z" fill="oklch(0.68 0.2 40)"/>
                <path d="M12 9c.7 1.3 2 2 2 3.6a2 2 0 0 1-4 0c0-1 .6-1.8 2-3.6z" fill="oklch(0.82 0.15 70)"/>
              </svg>
              <%= @daily_vocab_streak %>
            </span>
          <% end %>
        <% end %>
      <% end %>
      <% if user_signed_in? %>
        <%= link_to t(".nav.my_langlets"), gallery_path(imports: "my_imports"), class: "lp-navlink" %>
        <%= link_to t(".nav.add_video"), new_app_import_request_path(lang: current_language_code), class: "lp-navlink" %>
        <%= render "shared/user_menu",
                   avatar_type: :initial,
                   menu_item_class: "block px-4 py-3 text-sm font-semibold text-[#1E1B16] hover:bg-[#FAF6EF]",
                   review_button_class: "w-full text-left px-4 py-3 text-sm font-semibold text-[#1E1B16] hover:bg-[#FAF6EF]",
                   dropdown_class: "absolute right-0 mt-2 w-56 rounded-2xl shadow-lg opacity-0 invisible peer-checked:opacity-100 peer-checked:visible transition-all duration-150 z-50 overflow-hidden bg-[#FFFDF8] border border-[#DED4C2]",
                   divider_class: "border-t border-[#DED4C2]" %>
      <% else %>
        <%= link_to t(".nav.sign_in"), new_user_session_path, class: "lp-navlink" %>
      <% end %>
    </div>
  </nav>

  <!-- Hero -->
  <header class="lp-hero">
    <div>
      <h1 class="lp-h1"><%= t(".hero.heading") %></h1>
      <p class="lp-supported"><%= t(".hero.supported_languages") %></p>
      <p class="lp-lead"><%= t(".hero.lead") %></p>
    </div>

    <div class="lp-product-frame">
      <%= image_tag "/product.png", class: "lp-product-img", alt: t(".hero.product_alt") %>
    </div>
  </header>

  <!-- Try now -->
  <section id="try" class="lp-library" data-controller="homepage-video-picker">
    <div class="lp-lib-inner">
      <%= form_with url: try_path, method: :get, data: { turbo: false }, class: "lp-try-form" do %>
        <p class="lp-try-label"><%= t(".try_now.paste_prompt") %></p>
        <div class="lp-paste">
          <input type="url" required name="url" inputmode="url" autocomplete="off" autocapitalize="off"
                 autocorrect="off" spellcheck="false" enterkeyhint="go"
                 data-homepage-video-picker-target="input"
                 placeholder="<%= t('.try_now.url_placeholder') %>" aria-label="<%= t('.try_now.url_label') %>">
          <button type="submit" class="lp-create"><%= t(".try_now.submit") %></button>
        </div>
      <% end %>

      <p class="lp-try-or"><%= t(".try_now.or_choose") %></p>
      <div class="lp-grid">
        <% @homepage_videos.each do |video| %>
          <button type="button" class="lp-card" aria-pressed="false"
                  data-homepage-video-picker-target="card"
                  data-video-url="<%= video.url %>"
                  data-action="homepage-video-picker#select">
            <%= image_tag video.thumbnail_url, alt: "", loading: "lazy", class: "lp-card-thumb" %>
            <div class="lp-card-body">
              <div class="lp-card-title"><%= video.title %></div>
              <div class="lp-card-meta"><%= video.clip_language %></div>
            </div>
          </button>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="lp-footer">
    <div class="lp-footer-inner">
      <span><%= t(".footer.tagline", year: Date.current.year) %></span>
      <div class="lp-footer-links">
        <%= link_to t("shared.footer.privacy_policy"), "/home/privacy" %>
        <%= link_to t("shared.footer.terms_of_service"), "/home/terms" %>
      </div>
    </div>
  </footer>
</div>
