<% content_for :head do %>
  <% video_id = extract_youtube_id(@course.main_media_url) %>
  <% thumb_url = youtube_thumbnail_url(video_id) if video_id %>

  <title><%= @course.name %> - Langlets</title>
  <meta name="turbo-cache-control" content="no-cache">
  <%= render_meta_tags(
    title: "#{@course.name} - Langlets",
    description: course_description(@course),
    url: canonical_url(course_path(@course)),
    image_url: thumb_url
  ) %>
  <%= hreflang_tags_for_course(@course) %>
<% end %>

<% content_for :canonical_url, canonical_url(course_path(@course)) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/breadcrumb_list", items: [
    { name: "Home", url: canonical_url(root_path) },
    { name: @course.name, url: canonical_url(course_path(@course)) }
  ] %>
  <%= render "shared/structured_data/course", course: @course, description: course_description(@course), course_url: canonical_url(course_path(@course)) %>
  <% if (vid = extract_youtube_id(@course.main_media_url)) %>
    <%= render "shared/structured_data/video_object",
        name: @course.name,
        description: course_description(@course),
        thumbnail_url: youtube_thumbnail_url(vid),
        video_id: vid,
        upload_date: @course.created_at.iso8601 %>
  <% end %>
<% end %>

<%
  hue = lang_hue(@course.language&.iso_name)
  course_rtl = @course.language&.rtl || false
  youtube_video_id = @course.main_media_url.to_s.split("v=").last
  user_name = user_signed_in? ? current_user.email.to_s.split("@").first.split(/[._-]/).first.capitalize : "there"
  streak = user_signed_in? ? @streak_info[:count] : 0
  next_lesson = @lessons.find { |l| l.id == @first_incomplete_lesson_id } || @lessons.first
%>

<div class="sprout" style="--hue: <%= hue %>;">
  <div class="s-screen mx-auto w-full max-w-[480px]">
    <div class="flex-1 flex flex-col overflow-hidden">
      <div class="s-safetop"></div>

      <!-- Header: back + streak + avatar -->
      <header class="flex items-center justify-between s-pad" style="margin-top: 14px; margin-bottom: var(--gap);">
        <%= link_to root_path, class: "s-ctl", style: "box-shadow:none;", title: "Home" do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <% end %>

        <div class="flex items-center" style="gap: 10px;">
          <div class="s-streak">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
              <path d="M12 2c1 3 4 4.5 4 8a4 4 0 0 1-8 0c0-1 .3-1.8.8-2.5C8 8.8 7 10.3 7 12.5a5 5 0 0 0 10 0c0-4.2-3-6.5-5-10.5z" fill="oklch(0.68 0.2 40)"/>
              <path d="M12 9c.7 1.3 2 2 2 3.6a2 2 0 0 1-4 0c0-1 .6-1.8 2-3.6z" fill="oklch(0.82 0.15 70)"/>
            </svg>
            <span><%= streak %></span>
          </div>

          <% if user_signed_in? %>
            <div class="relative">
              <input type="checkbox" id="user-menu-toggle" class="hidden peer">
              <label for="user-menu-toggle" class="s-avatar cursor-pointer" style="border: 2px solid var(--accent);"><%= user_name.first.upcase %></label>
              <div class="absolute right-0 mt-2 w-56 rounded-2xl shadow-lg opacity-0 invisible peer-checked:opacity-100 peer-checked:visible transition-all duration-150 z-50 overflow-hidden"
                   style="background: var(--surface); border: 1px solid var(--border);">
                <% current_user.languages_with_saved_words.order(:iso_name).each do |language| %>
                  <%= button_to "📚 Review Words (#{language.iso_name})", review_lessons_path(language_code: language.iso_name),
                    method: :post, class: "w-full text-left px-4 py-3 s-body hover:opacity-70", style: "color: var(--text);", data: { turbo: false } %>
                <% end %>
                <% if current_user.languages_with_saved_words.exists? %>
                  <div style="border-top: 1px solid var(--border);"></div>
                <% end %>
                <%= link_to "Logout", destroy_user_session_path(returnto: request.fullpath),
                  method: :delete,
                  data: { turbo_method: :delete, controller: "auth bridge--sign-out", action: "click->auth#signOut click->bridge--sign-out#notifySignOut" },
                  class: "block px-4 py-3 s-body hover:opacity-70", style: "color: var(--text);" %>
              </div>
            </div>
          <% else %>
            <%= link_to "Sign up", new_user_registration_path(returnto: request.fullpath), class: "s-btn", style: "height: 40px; padding: 0 16px; font-size: 14px;" %>
          <% end %>
        </div>
      </header>

      <!-- Scrollable content -->
      <div class="s-scroll s-pad" style="padding-bottom: 8px;">

        <% if notice %>
          <div class="s-card" style="padding: 12px 16px; color: var(--accent);"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="s-card" style="padding: 12px 16px; color: oklch(0.6 0.2 25);"><%= alert %></div>
        <% end %>

        <!-- Hero: title + video -->
        <div class="s-hero">
          <div class="flex items-center" style="gap: 7px; margin-bottom: 8px;">
            <% if @course.language %>
              <span class="s-badge" style="--lh: <%= hue %>;"><%= lang_badge_code(@course.language) %></span>
            <% end %>
            <span class="s-small"><%= pluralize(@lessons.size, "lesson") %></span>
          </div>
          <h1 class="s-h1" style="margin-bottom: 13px;" dir="<%= course_rtl ? 'rtl' : 'ltr' %>"><%= @course.name %></h1>

          <% if youtube_video_id.present? %>
            <div class="s-thumb" style="--th: <%= hue %>; aspect-ratio: 16/9; height: auto; margin-bottom: 13px;">
              <iframe class="w-full h-full" style="display:block; border:0;" src="https://www.youtube.com/embed/<%= youtube_video_id %>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          <% end %>

          <div class="flex" style="gap: 10px;">
            <% if @course.show_full_course_player %>
              <%= link_to course_full_player_path(@course.slug), class: "s-btn", style: "flex:1;" do %>
                <svg width="18" height="18" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg>
                Watch full video
              <% end %>
            <% end %>
            <% if user_signed_in? %>
              <%= render "courses/mark_done_button", course: @course, all_done: @all_done %>
            <% end %>
          </div>
        </div>

        <p class="s-small" style="margin-top: -6px;">
          Pick any lesson to begin. Each one breaks down a line of the song. Pro tip: practice one lesson a day to maximize spaced repetition.
        </p>

        <!-- Lessons -->
        <div style="padding-bottom: 6px;">
          <div class="s-section-head">
            <h2 class="s-h2">Lessons</h2>
            <span class="s-small" id="lessons-done-count"><%= @lessons.count(&:completed?) %>/<%= @lessons.size %> done</span>
          </div>

          <div class="flex flex-col" style="gap: 8px;" data-controller="scroll-into-view" data-action="turbo:load@document->scroll-into-view#handleTurboLoad">
            <% @lessons.each_with_index do |lesson, index| %>
              <%= render "courses/lesson_row",
                    lesson: lesson,
                    course: @course,
                    index: index,
                    is_first_incomplete: (lesson.id == @first_incomplete_lesson_id),
                    hue: hue %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom tab bar -->
    <nav class="s-tabbar">
      <%= link_to root_path, class: "s-tab" do %>
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none"><path d="M3 11l9-7 9 7M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" stroke="var(--faint)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Home</span>
      <% end %>
      <%= link_to root_path, class: "s-tab" do %>
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="var(--faint)" stroke-width="1.9"/><path d="M15.5 8.5l-2 5-5 2 2-5z" stroke="var(--faint)" stroke-width="1.9" stroke-linejoin="round"/></svg>
        <span>Explore</span>
      <% end %>
      <% if next_lesson %>
        <%= link_to course_lesson_path(@course, next_lesson), class: "s-tab s-tab--active" do %>
          <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11M4 9l-1.5-1.5M9 4L7.5 2.5M15 20l1.5 1.5M20 15l1.5 1.5"/><rect x="4.5" y="4.5" width="4" height="4" rx="1" transform="rotate(45 6.5 6.5)"/><rect x="15.5" y="15.5" width="4" height="4" rx="1" transform="rotate(45 17.5 17.5)"/></svg>
          <span>Practice</span>
        <% end %>
      <% end %>
      <%= link_to root_path, class: "s-tab" do %>
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="var(--faint)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.5 7-5.5s7 1.9 7 5.5"/></svg>
        <span>You</span>
      <% end %>
    </nav>
  </div>
</div>
