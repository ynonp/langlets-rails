<%
  avatar_type = local_assigns.fetch(:avatar_type, :image)
  show_theme_toggle = local_assigns.fetch(:show_theme_toggle, false)
  show_xp_badge = local_assigns.fetch(:show_xp_badge, false)
  menu_item_class = local_assigns.fetch(:menu_item_class, "block px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-50 hover:opacity-70")
  dropdown_class = local_assigns.fetch(:dropdown_class, "absolute end-0 mt-2 w-56 rounded-2xl shadow-lg opacity-0 invisible peer-checked:opacity-100 peer-checked:visible transition-all duration-150 z-50 overflow-hidden bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-start")
  divider_class = local_assigns.fetch(:divider_class, "border-t border-gray-200 dark:border-gray-800")
  logout_data = local_assigns.fetch(:logout_data, { turbo_method: :delete })
  display_name = local_assigns.fetch(:display_name) { current_user.email.to_s.split("@").first.split(/[._-]/).first.capitalize }
  daily_xp = local_assigns.fetch(:daily_xp) { ActivityLog.daily_xp_for_user(current_user) }
%>
<div class="relative group"
     data-controller="profile-menu"
     data-action="click@document->profile-menu#close">
  <input type="checkbox" id="user-menu-toggle" class="hidden peer" data-profile-menu-target="toggle">
  <label for="user-menu-toggle" class="relative flex items-center cursor-pointer">
    <% if avatar_type == :initial %>
      <span class="w-10 h-10 rounded-full border-2 border-emerald-500 bg-gradient-to-br from-emerald-300 to-emerald-500 flex items-center justify-center font-extrabold text-white"><%= display_name.first.upcase %></span>
    <% else %>
      <img src="<%= 'https://ui-avatars.com/api/?name=' + ERB::Util.url_encode(current_user.email) %>" alt="<%= t("shared.menu.avatar_alt") %>" class="w-10 h-10 rounded-full shadow border-2 border-emerald-500" />
    <% end %>

    <%# Unread notifications, on the closed menu — the only hint the user gets
        that there is something to open it for. %>
    <% if unread_notifications_count.positive? %>
      <span data-testid="user-menu-notification-badge"
            aria-label="<%= t("notifications.unread_badge", count: unread_notifications_count) %>"
            class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-extrabold flex items-center justify-center">
        <%= unread_notifications_count > 9 ? "9+" : unread_notifications_count %>
      </span>
    <% end %>
  </label>
  <div class="<%= dropdown_class %>">
    <% if current_user.admin? %>
      <%= render "shared/menu_link", label: "Admin panel", path: admin_root_path, class_name: menu_item_class %>
    <% end %>
    <% if show_theme_toggle %>
      <div class="sm:hidden px-4 py-3" data-testid="header-theme-mobile-menu">
        <%= render "shared/theme_toggle" %>
      </div>
    <% end %>
    <% if show_xp_badge %>
      <div class="sm:hidden px-4 pb-3" data-testid="header-xp-mobile-menu">
        <div class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-bold bg-blue-500 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
          </svg>
          <%= t("shared.menu.daily_xp", count: daily_xp) %>
        </div>
      </div>
    <% end %>
    <% if show_theme_toggle || show_xp_badge %>
      <div class="sm:hidden <%= divider_class %>"></div>
    <% end %>
    <%= render "shared/menu_link",
               label: t("app.web_menu.vocabulary"),
               path: vocabulary_entries_path,
               class_name: menu_item_class %>
    <% current_user.languages_with_saved_words.order(:iso_name).each do |language| %>
      <%= render "shared/menu_link",
                 label: t("shared.menu.review_words", language: language.iso_name),
                 path: review_lessons_path(language_code: language.iso_name),
                 class_name: menu_item_class,
                 data: { turbo: false } %>
    <% end %>
    <div class="<%= divider_class %>"></div>
    <%= render "shared/menu_link",
               label: t("shared.menu.notifications"),
               path: notifications_path,
               class_name: menu_item_class,
               badge: (unread_notifications_count > 9 ? "9+" : unread_notifications_count if unread_notifications_count.positive?) %>
    <%= render "shared/menu_link", label: t("shared.menu.profile"), path: profile_path, class_name: menu_item_class %>
    <%= render "shared/menu_link", label: t("shared.menu.connected_apps"), path: settings_connections_path, class_name: menu_item_class %>
    <%= render "shared/menu_link",
               label: t("shared.menu.logout"),
               path: destroy_user_session_path(returnto: request.fullpath),
               class_name: menu_item_class,
               method: :delete,
               data: logout_data %>
  </div>
</div>
