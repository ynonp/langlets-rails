<%# Expects:
  params[:phrase_tokens] - An array of token translation objects
  params[:l1] - Language object for original words
  params[:l2] - Language object for translation words
  params[:video_id] - YouTube video ID
  params[:start_timestamp] - Start timestamp for the video segment
  params[:end_timestamp] - End timestamp for the video segment
  current_script - Script object for current script (passed as local)

  This activity shows a 2x4 grid where users match tokens to their translations:
  1. Left column shows words in L1, right column shows translations in L2
  2. The pairs are built as a list, sliced into pages of max_tokens_in_page
     pairs, then each page's pairs are split into an L1 list and an L2 list
     and shuffled independently so the L1 and L2 cells of the same pair are
     not in the same row
  3. User clicks on a word in one column, then its match in the other column
  4. Successful matches flash green and stay in place dimmed with a ✓
  5. Failed matches flash red and selection is cleared
  6. Tapping an L1 cell plays the L1 audio for that pair; L2 cells are silent
  7. Progress bar + counter show completion status
  8. When all tokens on a page are matched, the page is hidden and the next
     page (up to max_tokens_in_page pairs = 8 cells per page) is revealed
     without playing audio until the user taps an L1 cell
  9. When all tokens are matched, shows completion message
 %>

<%
  # Prepare tokens data using helper
  tokens = prepare_tokens_for_matching(params[:phrase_tokens])
  l1 = params[:l1]
  l2 = params[:l2]
  total_tokens = tokens.length

  # Same page-sizing convention as tokens-chain-activity: at most 4 pairs per
  # page so the L1/L2 columns stay readable (4 boxes per column).
  max_tokens_in_page = 4
  # Spread the pairs across pages as evenly as possible.
  #   page_count   = ceil(total / max_tokens_in_page)  (fewest pages allowed)
  #   page_size    = ceil(total / page_count)          (so each page holds as
  #                                                    many pairs as it can)
  # With max=4 and 5 total pairs that gives page_count=2, page_size=3, and the
  # activity renders as 3+2 instead of an awkward 4+1.
  page_count = (total_tokens.to_f / max_tokens_in_page).ceil
  page_count = 1 if page_count < 1
  page_size = (total_tokens.to_f / page_count).ceil
  page_size = 1 if page_size < 1
  # Build the full list of pairs, slice into pages, then split each page into
  # an L1 list and an L2 list so we can render the two columns independently.
  token_pages = tokens.shuffle.each_slice(page_size).to_a

  # Shared cell styling. The state variants mirror audio-to-translation: a
  # gentle emerald outline while selected, and a dimmed "done" look once
  # matched (kept in place instead of hiding/replacing).
  cell_base = "group relative flex items-center min-h-[96px] overflow-hidden px-4 py-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 cursor-pointer transition-all duration-200 hover:scale-[1.02]"
  cell_state = "data-[state=selected]:border-emerald-400 data-[state=selected]:ring-2 data-[state=selected]:ring-emerald-500/25 data-[state=selected]:bg-emerald-50/70 dark:data-[state=selected]:bg-emerald-900/40 data-[state=matched]:border-emerald-500 data-[state=matched]:bg-emerald-50 dark:data-[state=matched]:bg-emerald-900/40 data-[state=matched]:opacity-[0.6] data-[state=matched]:cursor-default data-[state=matched]:pointer-events-none data-[state=matched]:grayscale"
  check_classes = "hidden group-data-[state=matched]:block shrink-0 text-base font-bold leading-none text-emerald-600 dark:text-emerald-300"
%>

<div
    data-controller="match-tokens-activity"
    data-match-tokens-activity-tokens-value="<%= tokens.to_json %>"
    data-match-tokens-activity-total-tokens-value="<%= total_tokens %>"
    data-match-tokens-activity-page-size-value="<%= max_tokens_in_page %>"
    data-match-tokens-activity-is-review-lesson-value="<%= params[:is_review_lesson] || false %>"
    class="flex-1 min-h-0 overflow-y-auto flex-col flex items-center">

  <div class="w-full max-w-[640px] p-4 sm:p-6">
    <div class="mb-6">
      <div class="flex items-center gap-3 sm:gap-4">
        <p data-match-tokens-activity-target="progressText" class="shrink-0 text-sm sm:text-base font-medium text-gray-700 dark:text-gray-300 tabular-nums">
          <%= t(".matched", current: 0, total: total_tokens) %>
        </p>
      </div>
      <p class="text-gray-500 dark:text-gray-400 text-sm sm:text-base mt-4"><%= @activity.text_header || t(".instruction") %></p>
    </div>

    <div id="match-tokens" class="flex flex-col gap-4">

      <!-- Completion message -->
      <div data-match-tokens-activity-target="completionMessage" data-progress-tracker-target="completion" class="hidden p-4 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-center sm:text-left text-xl font-bold text-gray-900 dark:text-gray-50"><%= t(".great_job") %></h3>
          <p class="text-center sm:text-left text-gray-500 dark:text-gray-400"><%= t(".completed") %></p>
        </div>
        <%= link_to_next_activity("Next", @next_activity_path, class: "inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors w-full sm:w-auto") %>
      </div>

      <!-- Pages: each page holds up to max_tokens_in_page pairs. We split each
           page's pair list into an L1 list and an L2 list and render the two
           columns independently. This keeps every L1 cell in the left column
           and every L2 cell in the right column while still allowing the two
           columns to be shuffled in different orders. Cells in the two
           columns still match each other via the shared data-token-id, which
           is checked by the controller. -->
      <% token_pages.each_with_index do |page_pairs, page_index| %>
        <% l1_list = page_pairs.shuffle %>
        <% l2_list = page_pairs.shuffle %>
        <div
          data-match-tokens-activity-target="page"
          class="grid grid-cols-2 gap-x-4 gap-y-3.5 <%= 'hidden' if page_index.positive? %>"
          data-action="touchstart->match-tokens-activity#handleTouchStart:!passive touchend->match-tokens-activity#handleTouchEnd:!passive">

          <!-- L1 column: header + L1 list -->
          <div class="flex flex-col gap-3">
            <div class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 font-semibold px-1 mb-1"><%= l1.english_name %> Words</div>
            <% l1_list.each do |token| %>
              <div
                class="<%= cell_base %> justify-center text-center <%= cell_state %>"
                data-token-id="<%= token[:id] %>"
                data-column="l1"
                data-l1-text="<%= token[:l1_word] %>"
                data-l2-text="<%= token[:l2_translation] %>"
                data-audio-url="<%= token[:audio_url] %>"
                data-action="click->match-tokens-activity#selectToken">
                <span lang="<%= l1.iso_name %>" class="line-clamp-2 break-words leading-snug text-xl sm:text-2xl font-semibold text-center"><%= token[:l1_word] %></span>
                <span class="<%= check_classes %> ms-auto ps-2" aria-hidden="true">✓</span>
              </div>
            <% end %>
          </div>

          <!-- L2 column: header + L2 list -->
          <div class="flex flex-col gap-3">
            <div class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 font-semibold px-1 mb-1"><%= l2.english_name %> Translations</div>
            <% l2_list.each do |token| %>
              <div
                class="<%= cell_base %> justify-center text-center <%= cell_state %>"
                data-token-id="<%= token[:id] %>"
                data-column="l2"
                data-l1-text="<%= token[:l1_word] %>"
                data-l2-text="<%= token[:l2_translation] %>"
                data-audio-url="<%= token[:audio_url] %>"
                data-action="click->match-tokens-activity#selectToken">
                <span lang="<%= l2.iso_name %>" class="line-clamp-3 break-words leading-snug text-xl sm:text-2xl font-semibold text-center"><%= token[:l2_translation] %></span>
                <span class="<%= check_classes %> ms-auto ps-2" aria-hidden="true">✓</span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
