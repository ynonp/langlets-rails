<!DOCTYPE html>
<html lang="<%= current_translation_language&.iso_name || I18n.locale %>" dir="<%= current_translation_language&.rtl? ? 'rtl' : 'ltr' %>" data-theme="<%= current_theme %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50" <%= "data-native-tabs" if native_app? %>>
    <%# Authentication is a full-screen native root. Assert its chrome from the
        rendered destination too, because a redirect can hide the auth URL from
        the native proposal handler. %>
    <% if native_app? && devise_controller? %>
      <div data-controller="bridge--tab-visibility"
           data-bridge--tab-visibility-visible-value="false"
           hidden></div>
    <% end %>

    <main class="flex flex-col min-h-screen"
          data-controller="audio-cache"
          data-action="click->audio-cache#handleClick:capture audio-cache:play->audio-cache#playEvent audio-cache:preload->audio-cache#preloadEvent audio-cache:stop->audio-cache#stop">
      <%= yield %>
    </main>

    <%= yield :structured_data %>
    <% unless content_for?(:structured_data) %>
      <%= render "shared/structured_data/website" %>
    <% end %>

    <% if params[:signed_out].present? %>
      <div data-controller="bridge--sign-out" hidden></div>
    <% end %>
  </body>
</html>
