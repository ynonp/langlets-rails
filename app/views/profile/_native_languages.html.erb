<%# A select keeps the profile compact while the bridge still persists the
    selected ISO code in the native app before navigating. %>
<select
  data-controller="bridge--language-selection"
  data-action="change->bridge--language-selection#selectLanguage"
  aria-label="Learning language"
  class="w-full px-4 py-3 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 font-semibold border border-gray-200 dark:border-gray-700 rounded-2xl cursor-pointer"
>
  <% languages.each do |language| %>
    <option
      value="<%= language.iso_name %>"
      data-redirect-url="<%= language_redirect_url(language.iso_name) %>"
      <%= "selected" if current_language&.id == language.id %>
    >
      <%= language.native_name %> — <%= language.english_name %>
    </option>
  <% end %>
</select>
