# Langlets Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# DATABASE_URL=postgresql://username:password@localhost/langlets_development

# Azure Cognitive Services (Text-to-Speech)
# Get your key from: https://portal.azure.com/
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# OpenAI API (for AI features)
# Get your key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Gemini AI (Google)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS S3 (for production file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_BUCKET=your_bucket_name_here

# YouTube Data API (optional, for enhanced video features)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# DeepL Translation API (optional)
# Get your key from: https://www.deepl.com/pro-api
# DEEPL_API_KEY=your_deepl_api_key_here

# Rails Configuration
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Secret key base (generate with: rails secret)
# SECRET_KEY_BASE=

# Host configuration
# RAILS_HOST=localhost:3000

# Email configuration (for Devise)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# OAuth Configuration (optional)
# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Background Jobs
# GOOD_JOB_EXECUTION_MODE=async
# GOOD_JOB_QUEUES=default:5
# GOOD_JOB_MAX_THREADS=5

# OpenTelemetry (optional, for monitoring)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=langlets

# Application Settings
# DEFAULT_LOCALE=en
# AVAILABLE_LOCALES=en,es,fr,ar,he
