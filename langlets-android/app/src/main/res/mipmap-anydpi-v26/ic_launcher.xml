<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: the rose speech-bubble mark on the slate gradient, matching
  the iOS AppIcon. Both come from public/icon.svg — change that file and both
  platforms need porting, there is no build step that does it for you.

  The background is a drawable rather than @color/app_background now, because
  the iOS icon's ground is a gradient. See ic_launcher_background.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
