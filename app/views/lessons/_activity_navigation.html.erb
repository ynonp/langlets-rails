<%
  current_activity_order = params[:a].to_i
  current_activity_order = @activity.order if current_activity_order == 0
%>

<% step_base = "w-[30px] h-[30px] rounded-full inline-flex items-center justify-center font-extrabold text-[13px] no-underline flex-shrink-0 transition-transform" %>
<div class="flex items-center gap-2.5 px-5 py-3 bg-emerald-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-700 flex-shrink-0 overflow-x-auto activity-stepnav">
  <% unless native_app? %>
    <%= link_to @course_path,
      class: "flex items-center justify-center flex-shrink-0 text-gray-400 dark:text-gray-600",
      title: t(".back_to_course"),
      data: { :"turbo-frame" => "_top", :turbo => false } do %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    <% end %>
  <% end %>

  <div class="flex-1 flex items-center justify-center gap-2">
    <% if @prev_lesson.present? %>
      <%= link_to course_lesson_path(@course, @prev_lesson),
        class: "#{step_base} bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-700",
        title: t(".previous_lesson"),
        data: { turbo_frame: 'activity' } do %>«<% end %>
    <% end %>

    <% @activities.each do |activity| %>
      <%
        status = if activity.order < current_activity_order
                   "done"
                 elsif activity.order == current_activity_order
                   "current"
                 else
                   "upcoming"
                 end
        step_classes = case status
                       when "done" then "bg-emerald-500 text-white"
                       when "current" then "bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 ring-2 ring-emerald-500"
                       else "bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 border border-gray-200 dark:border-gray-700"
                       end
      %>
      <%= link_to course_lesson_path(@course, @lesson, a: activity.order),
        class: "#{step_base} #{step_classes}",
        data: { turbo_frame: 'activity' }, aria: { label: t(".activity", number: activity.order) } do %>
        <% if status == "done" %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <% else %>
          <%= activity.order %>
        <% end %>
      <% end %>
    <% end %>

    <% if @next_lesson.present? %>
      <%= link_to course_lesson_path(@course, @next_lesson),
        class: "#{step_base} bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-700",
        title: t(".next_lesson"),
        data: {
          turbo_frame: 'activity',
          controller: 'lesson-navigation',
          action: 'click->lesson-navigation#markLessonCompleted',
          'lesson-navigation-lesson-id-value': @lesson.id
        } do %>»<% end %>
    <% else %>
      <%= link_to course_path(@course.slug),
        class: "#{step_base} bg-emerald-500 text-white",
        title: t(".back_to_course"),
        data: {
          controller: 'lesson-navigation',
          action: 'click->lesson-navigation#markLessonCompleted',
          'lesson-navigation-lesson-id-value': @lesson.id
        } do %>»<% end %>
    <% end %>
  </div>

  <div class="w-[22px] flex-shrink-0"></div>
</div>
