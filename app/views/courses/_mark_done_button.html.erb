<% if user_signed_in? %>
  <% if all_done %>
    <%= button_to reset_progress_course_path(course.slug),
        method: :post,
        class: "inline-flex items-center gap-2 px-4 py-3 sm:px-6 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition-colors duration-200 shadow-lg hover:shadow-xl",
        data: { turbo: false, confirm: "Reset all progress for this course?", role: "mark-done-button" } do %>
      <span class="hidden sm:inline">&#10003; Done</span>
      <span class="sm:hidden">Done</span>
    <% end %>
  <% else %>
    <%= button_to mark_done_course_path(course.slug),
        method: :post,
        class: "inline-flex items-center gap-2 px-4 py-3 sm:px-6 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded-lg transition-colors duration-200 shadow-lg hover:shadow-xl",
        data: { turbo: false, role: "mark-done-button" } do %>
      <span class="hidden sm:inline">Mark As Done</span>
      <span class="sm:hidden">Done</span>
    <% end %>
  <% end %>
<% end %>