<%# The floating Add button. Tabs themselves are native — AppTabBarController
    in langlets-ios draws a UITabBarController with one navigator per tab — so
    this floats in the corner rather than sitting in a web tab bar. Fixed, so
    screens need app-scroll-pad or their last card hides underneath it. %>
<%# Offset lives in app-fab-offset rather than inline, because in the native app
    it has to clear UITabBar as well as the home indicator and that's a rule the
    stylesheet can express per-context. %>
<%= link_to new_app_import_request_path,
            class: "app-fab-shadow app-fab-offset fixed right-5 z-30 w-11 h-11 rounded-full bg-app-accent text-app-on-accent-sm flex items-center justify-center",
            aria: { label: "Add a video" } do %>
  <%= app_icon "plus", class: "w-5 h-5" %>
<% end %>
