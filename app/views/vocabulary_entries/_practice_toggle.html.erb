<div id="<%= dom_id(entry, :practice) %>">
  <button type="submit" name="practicing" value="<%= !entry.practising? %>"
          data-testid="vocabulary-practice-toggle"
          aria-pressed="<%= entry.practising? %>"
          class="inline-flex items-center gap-3 rounded-full border border-[#DED4C2] bg-[#FFFDF8] py-2 pl-4 pr-2 text-sm font-semibold hover:border-[#C4451C]">
    <span><%= t("app.vocabulary_entries.show.practice") %></span>
    <span class="flex h-7 w-[46px] shrink-0 items-center rounded-full p-[3px] transition-colors <%= entry.practising? ? "bg-[#0F6E56]" : "bg-[#CFC2AB]" %>">
      <span class="block h-[22px] w-[22px] rounded-full bg-white transition-transform <%= "translate-x-[18px]" if entry.practising? %>"></span>
    </span>
  </button>

  <p class="mt-3 text-sm text-[#716A5D]">
    <%= entry.practising? ? t("app.vocabulary_entries.show.practice_on") : t("app.vocabulary_entries.show.practice_off") %>
  </p>
</div>
