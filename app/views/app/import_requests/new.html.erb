<% content_for :title, t(".page_title") %>

<%# Rendered as a full page, not a Turbo Frame overlay. iOS presents it as a real
    bottom sheet via the path configuration (context: modal, modal_style: medium),
    which gives a native grabber and dismissal gesture; a frame-based overlay
    would fight that and you'd get two competing dismissals. The sheet chrome
    below is CSS so it still looks right in a desktop browser.

    One screen, one input, and it accepts exactly one thing: a link to a YouTube
    video, or the bare id out of one. Searching YouTube from here would mean the
    Data API, a key and a quota to nurse, for a step the user has usually already
    taken in the YouTube app before they ever opened this sheet. %>
<div class="min-h-dvh flex flex-col justify-end bg-transparent">
  <div class="app-sheet-top bg-app-sheet rounded-t-app-sheet px-5 pt-2.5 pb-11 flex flex-col gap-4">
    <div class="flex justify-center">
      <div class="w-9 h-[5px] rounded-full bg-white/20"></div>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <h1 class="text-xl font-extrabold tracking-[-0.4px]"><%= t(".title") %></h1>
        <span class="flex items-center gap-1.5 bg-app-pill rounded-full py-1 px-2.5">
          <%= app_icon "bolt", class: "w-[11px] h-[11px] text-app-accent" %>
          <span class="text-app-credits text-xs font-bold"><%= app_credits_label(current_user.credit_balance) %></span>
        </span>
      </div>

      <%= link_to app_home_path,
                  class: "w-[30px] h-[30px] rounded-full bg-app-pill flex items-center justify-center text-app-text-2",
                  aria: { label: "Close" } do %>
        <%= app_icon "close", class: "w-3.5 h-3.5" %>
      <% end %>
    </div>

    <% if flash[:alert] %>
      <p class="rounded-app-field border-[0.5px] border-red-500/30 bg-red-500/10 text-red-300 text-[13px] leading-relaxed py-3 px-3.5">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <%# An empty balance no longer blocks the screen. The user should get all the
        way to a rendered preview of what they'd be importing and only then meet
        the paywall — seeing the thing is the reason to buy it (§5.1). %>
    <div data-controller="add-video"
         data-add-video-resolve-url-value="<%= resolve_app_import_requests_path %>"
         class="flex flex-col gap-4">

      <div class="flex flex-col gap-1.5">
        <%# Border turns green once the value parses as a video. %>
        <div class="app-inset-hairline bg-app-inset rounded-app-input py-3 px-3.5 flex items-center gap-2.5 transition-colors"
             data-add-video-target="field">
          <%= app_icon "link", class: "w-4 h-4 shrink-0 text-app-text-3" %>

          <%# inputmode=url rather than type=url: the URL keyboard is the right
              one, but type=url would fight a bare video id, which is a perfectly
              good thing to paste here. %>
          <input type="text"
                 inputmode="url"
                 data-add-video-target="input"
                 data-action="input->add-video#inputChanged"
                 placeholder="<%= t(".paste_placeholder") %>"
                 value="<%= params[:url] %>"
                 autofocus autocomplete="off" autocapitalize="off"
                 autocorrect="off" spellcheck="false"
                 enterkeyhint="go"
                 class="flex-1 min-w-0 bg-transparent text-[13px] text-app-text placeholder:text-app-text-3 outline-none">

          <button type="button"
                  data-add-video-target="clear"
                  data-action="add-video#clearInput"
                  class="hidden shrink-0 text-app-text-3"
                  aria-label="Clear">
            <%= app_icon "close", class: "w-3.5 h-3.5" %>
          </button>
        </div>

        <%# Hint and confirmation occupy the same slot so the layout doesn't jump
            when a link resolves. %>
        <p class="text-app-text-3 text-[11px] pl-0.5" data-add-video-target="hint">
          <%= t(".url_hint") %>
        </p>
        <p class="hidden items-center gap-1 text-app-accent text-[11px] pl-0.5"
           data-add-video-target="recognized">
          <%= app_icon "check_circle", class: "w-3 h-3" %>
          <%= t(".link_recognized") %>
        </p>
      </div>

      <%# Clipboard assist. Best-effort: WKWebView only hands over the pasteboard
          after a user gesture, so this often stays hidden on device and the user
          just pastes by hand. Reading it natively would need a bridge component. %>
      <button type="button"
              data-add-video-target="clipboardChip"
              data-action="add-video#useClipboard"
              class="hidden self-start items-center gap-1.5 bg-app-pill rounded-full py-2 px-3.5 text-app-text-2 text-[13px] font-semibold">
        <%= app_icon "plus", class: "w-3.5 h-3.5" %>
        <%= t(".paste_copied_link") %>
      </button>

      <%# Everything below the bar — empty state, preview card, errors — is one
          swappable region the server owns entirely. The Stimulus controller only
          points this frame at #resolve; it never renders a state itself. %>
      <turbo-frame id="add_video_result">
        <%= render "app/import_requests/empty_state" %>
      </turbo-frame>
    </div>
  </div>
</div>
