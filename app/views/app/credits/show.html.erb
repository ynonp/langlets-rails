<% content_for :title, "Credits · langlets." %>

<%# Presented as a bottom sheet by the path configuration, same as Add a video. %>
<div class="min-h-dvh flex flex-col justify-end">
  <div class="app-sheet-top app-sheet-pad bg-app-sheet rounded-t-app-sheet px-5 pt-2.5 flex flex-col gap-4">
    <div class="flex justify-center">
      <div class="w-9 h-[5px] rounded-full bg-white/20"></div>
    </div>

    <div class="flex justify-end">
      <%= link_to app_home_path,
                  class: "w-[30px] h-[30px] rounded-full bg-app-pill flex items-center justify-center text-app-text-2",
                  aria: { label: "Close" } do %>
        <%= app_icon "close", class: "w-3.5 h-3.5" %>
      <% end %>
    </div>

    <% if @balance.positive? %>
      <div class="flex flex-col items-center text-center gap-2.5 pb-2">
        <div class="w-14 h-14 rounded-full bg-app-accent/[0.14] flex items-center justify-center">
          <%= app_icon "bolt", class: "w-[26px] h-[26px] text-app-accent", stroke: 1.2 %>
        </div>
        <h2 class="text-xl font-extrabold tracking-[-0.4px]">
          <%= pluralize(@balance, "credit") %> left
        </h2>
        <p class="text-app-text-2 text-sm leading-[1.45] max-w-[290px]">
          Each import uses 1 credit. Adding something from the Library is always free.
        </p>
      </div>
    <% else %>
      <%= render "app/credits/out_of_credits_body" %>
    <% end %>

    <% if params[:payment] == "submitted" %>
      <div class="rounded-2xl bg-app-accent/[0.14] px-4 py-3 text-center text-sm text-app-text-2">
        Payment submitted. PayPal will notify us when it completes, then your balance will update.
      </div>
    <% end %>

    <% if @paypal_client.configured? %>
      <section class="flex flex-col gap-3" aria-labelledby="credit-packs-title">
        <h3 id="credit-packs-title" class="text-center text-sm font-bold text-app-text-2">Buy credits with PayPal</h3>

        <div class="grid grid-cols-3 gap-2">
          <% @credit_packs.each do |pack| %>
            <form action="<%= @paypal_client.checkout_url %>" method="post" data-turbo="false" target="_top">
              <input type="hidden" name="cmd" value="_xclick">
              <input type="hidden" name="business" value="<%= @paypal_client.merchant_id %>">
              <input type="hidden" name="item_name" value="<%= pack.credits %> Langlets credits">
              <input type="hidden" name="item_number" value="<%= pack.item_number %>">
              <input type="hidden" name="amount" value="<%= pack.price %>">
              <input type="hidden" name="currency_code" value="USD">
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="no_shipping" value="1">
              <input type="hidden" name="charset" value="utf-8">
              <input type="hidden" name="custom" value="<%= @paypal_client.purchase_token(user: current_user, pack:) %>">
              <input type="hidden" name="notify_url" value="<%= request.base_url + paypal_notification_path(lang: nil) %>">
              <input type="hidden" name="return" value="<%= request.base_url + app_credits_path(payment: "submitted") %>">
              <input type="hidden" name="cancel_return" value="<%= request.base_url + app_credits_path %>">

              <button type="submit"
                      class="w-full rounded-2xl border border-white/15 px-2 py-3 text-center hover:border-app-accent">
                <span class="block text-base font-extrabold"><%= pack.credits %></span>
                <span class="block text-xs text-app-text-3">$<%= pack.price %></span>
              </button>
            </form>
          <% end %>
        </div>
        <p class="text-center text-[11px] leading-relaxed text-app-text-3">
          Credits are added only after PayPal confirms the completed payment.
        </p>
      </section>
    <% else %>
      <p class="rounded-2xl bg-red-500/10 px-4 py-3 text-center text-xs text-red-300">
        PayPal purchases are temporarily unavailable.
      </p>
    <% end %>

    <% if (video_url = Youtube::Url.canonical(params[:url])) %>
      <%= link_to "Back to the video", new_app_import_request_path(url: video_url),
                  class: "block text-center text-app-text-3 text-[13px] py-1" %>
    <% end %>
  </div>
</div>
