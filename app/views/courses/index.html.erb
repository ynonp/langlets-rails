<% content_for :head do %>
  <title>Langlets - Learn Languages Through Interactive Video Clips</title>
  <%= render_meta_tags(
    title: "Practice your target language with videos you love",
    description: "Turn any video into comprehensible input, or practice with our existing Langlets collection. Understand every word, save new vocabulary for spaced-repetition practice, and enjoy TV shows, music, authentic native content, and more.",
    url: canonical_url(root_path),
    image_url: canonical_url("/cover.png"),
    image_width: 1731,
    image_height: 909
  ) %>
  <meta name="keywords" content="language learning, interactive video, learn English, learn Hebrew, learn French, learn Spanish, learn Arabic, bilingual education">
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<% end %>

<% content_for :canonical_url, canonical_url(root_path) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/website" %>
  <%= render "shared/structured_data/faq_page" %>
  <% if @playlists.any? %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Featured Playlists on Langlets",
      "itemListElement": [
        <% @playlists.each_with_index do |lp, idx| %>
          {
            "@type": "ListItem",
            "position": <%= idx + 1 %>,
            "url": "<%= j canonical_url(playlist_path(lp)) %>",
            "name": "<%= j lp.name %>"
          }<%= "," unless idx == @playlists.size - 1 %>
        <% end %>
      ]
    }
    </script>
  <% end %>
<% end %>

<%
  # Playlist membership does not affect this feed: it is one newest-first
  # preview of all published courses.
  grid_courses = @all_courses.first(8)

  # One accent dot per language, keyed by base ISO. Falls back to the brand red.
  lang_dot = Hash.new("#C4451C").merge(
    "es" => "#E8B93E", "fr" => "#7C9ED9", "ar" => "#6FBF8F",
    "he" => "#C98BD9", "de" => "#E89A5C", "en" => "#8FB7E0", "ru" => "#D98B8B"
  )
  base_iso = ->(language) { language&.iso_name.to_s.split("-").first.to_s.downcase }

  # Keep every available language pill visible even when one is selected via
  # ?lang=. The Stimulus controller ignores unknown selections.
  filter_langs = @all_courses.map(&:language).compact.uniq { |l| base_iso.call(l) }

  free_credits = User::SIGNUP_CREDITS

  slides = [
    { img: "/homepage/slide-1.png", caption: "Listen with a synchronized transcript & translation" },
    { img: "/homepage/slide-2.png", caption: "Replay sentences with focused listening practice" },
    { img: "/homepage/slide-3.png", caption: "Practice individual words from the video" }
  ]
%>

<style>
  .lp {
    --bg:#FAF6EF; --ink:#1E1B16; --accent:#C4451C; --accent-d:#9E3410;
    --muted:#55503F; --faint:#8A8170; --card:#FFFDF8; --shadow:#EADFC9;
    --dark:#1E1B16; --dark-fg:#FAF6EF; --dark-muted:#B5AC98;
    min-height:100vh; display:flex; flex-direction:column;
    background:var(--bg); color:var(--ink);
    font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  /* Zero-specificity default (via :where) so anchors inherit their surrounding
     text colour, and every component rule below can set its own without a
     specificity war. */
  :where(.lp a) { color:inherit; text-decoration:none; }
  .lp ::selection { background:#F4D8A6; }
  .lp-display { font-family:'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif; }

  /* Nav — same 1100 content column + 40px padding as the hero and library, so
     the brand's left edge lines up with the hero headline and "Jump right in". */
  .lp-nav { display:flex; align-items:center; justify-content:space-between; gap:24px;
    padding:20px 40px; max-width:1180px; width:100%; margin:0 auto; box-sizing:border-box; flex-wrap:wrap; }
  .lp-brand { display:flex; align-items:baseline; gap:8px; }
  .lp-brand-name { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:26px; letter-spacing:-0.02em; color:var(--ink); }
  .lp-brand-dot { width:8px; height:8px; border-radius:50%; background:var(--accent); display:inline-block; transform:translateY(-2px); }
  .lp-nav-links { display:flex; align-items:center; gap:28px; font-size:15px; font-weight:500; flex-wrap:wrap; }
  .lp-navlink { color:var(--ink); }
  .lp-navlink:hover { color:var(--accent); }
  .lp-pill { background:var(--ink); color:var(--bg); padding:10px 20px; border-radius:999px; font-weight:600; }
  .lp-pill:hover { color:var(--bg); background:#000; }
  .lp-signout { background:none; border:none; padding:0; font:inherit; color:var(--ink); font-weight:500; cursor:pointer; }
  .lp-signout:hover { color:var(--accent); }

  /* Hero — max-width is 1100 (the shared content column) plus the 40px
     horizontal padding on each side, so the border-box padding doesn't inset
     the content past the library/footer edges below it. */
  .lp-hero { max-width:1180px; margin:0 auto; padding:40px 40px 56px; box-sizing:border-box; width:100%;
    display:grid; grid-template-columns:1.15fr 1fr; gap:56px; align-items:center; }
  .lp-h1 { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:52px; line-height:1.02;
    letter-spacing:-0.03em; margin:0 0 16px; text-wrap:balance; }
  .lp-lead { font-size:17px; line-height:1.55; color:var(--muted); margin:0 0 28px; max-width:520px; text-wrap:pretty; }
  .lp-paste { display:flex; gap:10px; background:var(--card); border:2px solid var(--ink); border-radius:16px;
    padding:8px; max-width:540px; }
  .lp-paste input { flex:1; border:none; outline:none; background:transparent; font-family:'Instrument Sans', sans-serif;
    font-size:16px; color:var(--ink); padding:8px 10px; min-width:0; }
  .lp-create { background:var(--accent); color:var(--card); border:none; border-radius:10px; padding:11px 28px;
    font-family:'Bricolage Grotesque', sans-serif; font-weight:700; font-size:16px; cursor:pointer; }
  .lp-create:hover { background:var(--accent-d); }
  .lp-note { margin-top:12px; background:#F2EADB; border-radius:12px; padding:11px 16px; font-size:14.5px;
    color:var(--muted); max-width:524px; box-sizing:border-box; }
  .lp-note strong { color:var(--ink); }
  .lp-meta { display:flex; gap:20px; margin-top:16px; font-size:13.5px; color:var(--faint); flex-wrap:wrap; }

  /* Slideshow */
  .lp-slideshow { display:flex; flex-direction:column; gap:14px; }
  .lp-slide-frame { background:#0B1220; border:2px solid var(--ink); border-radius:18px; overflow:hidden; box-shadow:6px 6px 0 var(--shadow); }
  .lp-slide-img { width:100%; height:400px; object-fit:contain; object-position:top; display:block; background:#0B1220; }
  .lp-slide-nav { display:flex; align-items:center; gap:14px; }
  .lp-arrow { background:var(--card); border:1px solid #E4DCCC; border-radius:999px; width:34px; height:34px;
    font-size:15px; cursor:pointer; color:var(--ink); flex-shrink:0; }
  .lp-arrow:hover { border-color:var(--accent); color:var(--accent); }
  .lp-caption { flex:1; font-size:14.5px; line-height:1.45; color:var(--ink); font-weight:600; }
  .lp-dots { display:flex; gap:7px; justify-content:center; }
  .lp-dot { width:8px; height:8px; border-radius:50%; border:none; padding:0; cursor:pointer; background:#DDD3BE; }

  /* Library */
  .lp-library { background:var(--dark); color:var(--dark-fg); padding:72px 40px 80px; }
  .lp-lib-inner { max-width:1100px; margin:0 auto; }
  .lp-lib-head { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:32px; }
  .lp-h2 { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:36px; letter-spacing:-0.02em; margin:0 0 8px; }
  .lp-lib-sub { margin:0; font-size:16.5px; color:var(--dark-muted); }
  .lp-filters { display:flex; gap:8px; flex-wrap:wrap; }
  .lp-chip { background:transparent; color:var(--dark-muted); border:1px solid #4A443A; border-radius:999px;
    padding:9px 18px; font-family:'Instrument Sans', sans-serif; font-size:14.5px; font-weight:600; cursor:pointer; }
  .lp-chip:hover { border-color:var(--accent); }
  .lp-chip.is-active { background:var(--bg); color:var(--ink); }
  .lp-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:20px; }
  .lp-card { display:flex; flex-direction:column; background:#2A261F; border-radius:16px; overflow:hidden;
    color:var(--dark-fg); border:1px solid #3A352C; }
  .lp-card:hover { border-color:var(--accent); color:var(--dark-fg); }
  .lp-card-thumb { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; background:#0B1220; }
  .lp-card-body { padding:16px 18px 18px; display:flex; flex-direction:column; gap:8px; flex:1; }
  .lp-card-title { font-weight:600; font-size:15.5px; line-height:1.35; display:-webkit-box;
    -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .lp-card-meta { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--dark-muted); margin-top:auto; }
  .lp-card-dot { width:7px; height:7px; border-radius:50%; display:inline-block; }
  .lp-empty { color:var(--dark-muted); font-size:16px; }
  .lp-browse-all { display:flex; justify-content:center; margin-top:32px; }
  .lp-browse-all a { display:inline-flex; align-items:center; justify-content:center; border:1px solid #5A5245; border-radius:999px;
    padding:12px 22px; color:var(--dark-fg); font-weight:700; }
  .lp-browse-all a:hover { border-color:var(--accent); color:var(--dark-fg); }

  /* Pricing — same 1100 content column + 40px padding as the hero, so its
     content edges line up with the rest of the page. */
  .lp-pricing { max-width:1180px; margin:0 auto; padding:88px 40px; box-sizing:border-box; width:100%; }
  .lp-price-grid { display:grid; grid-template-columns:1.1fr 1fr; gap:56px; align-items:center; }
  .lp-price-h { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:40px; letter-spacing:-0.02em; margin:0 0 16px; }
  .lp-price-lead { font-size:17px; line-height:1.6; color:var(--muted); margin:0 0 20px; text-wrap:pretty; }
  .lp-price-list { display:flex; flex-direction:column; gap:10px; font-size:15.5px; color:var(--ink); }
  .lp-price-item { display:flex; gap:10px; align-items:baseline; }
  .lp-check { color:var(--accent); font-weight:700; }
  .lp-price-card { background:var(--dark); color:var(--dark-fg); border-radius:22px; padding:36px; box-shadow:8px 8px 0 var(--shadow); }
  .lp-price-eyebrow { font-family:'Bricolage Grotesque', sans-serif; font-weight:700; font-size:15px; letter-spacing:0.08em; color:var(--dark-muted); margin-bottom:14px; }
  .lp-price-row { display:flex; align-items:baseline; gap:10px; margin-bottom:6px; }
  .lp-price-amount { font-family:'Bricolage Grotesque', sans-serif; font-weight:800; font-size:56px; letter-spacing:-0.03em; }
  .lp-price-unit { font-size:18px; color:var(--dark-muted); }
  .lp-price-sub { font-size:15px; color:var(--dark-muted); margin-bottom:26px; }
  .lp-price-cta { display:block; text-align:center; background:var(--accent); color:var(--card); border-radius:12px;
    padding:15px; font-family:'Bricolage Grotesque', sans-serif; font-weight:700; font-size:17px; }
  .lp-price-cta:hover { background:var(--accent-d); color:var(--card); }
  .lp-price-fine { text-align:center; font-size:13px; color:var(--faint); margin-top:12px; }

  /* Footer */
  .lp-footer { border-top:1px solid #E4DCCC; padding:28px 40px; margin-top:auto; }
  .lp-footer-inner { max-width:1100px; margin:0 auto; display:flex; justify-content:space-between; align-items:center;
    gap:20px; flex-wrap:wrap; font-size:14px; color:var(--faint); }
  .lp-footer-links { display:flex; gap:20px; }
  .lp-footer-links a { color:var(--faint); }
  .lp-footer-links a:hover { color:var(--accent); }

  @media (max-width:860px) {
    .lp-nav { padding:16px 20px; }
    .lp-hero { grid-template-columns:1fr; gap:36px; padding:24px 20px 40px; }
    .lp-h1 { font-size:38px; }
    .lp-library { padding:56px 20px 64px; }
    .lp-pricing { padding:56px 20px; }
    .lp-price-grid { grid-template-columns:1fr; gap:36px; }
    .lp-slide-img { height:320px; }
    .lp-footer { padding:24px 20px; }
  }
  @media (max-width:560px) {
    .lp-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .lp-card-body { padding:11px 12px 13px; gap:6px; }
    .lp-card-title { font-size:13px; }
    .lp-card-meta { font-size:11px; align-items:flex-start; }
  }
</style>

<div class="lp">
  <!-- Nav -->
  <nav class="lp-nav">
    <%= link_to root_path, class: "lp-brand", "aria-label": "Langlets home" do %>
      <span class="lp-brand-name">langlets</span>
      <span class="lp-brand-dot"></span>
    <% end %>
    <div class="lp-nav-links">
      <%= link_to "Browse Langlets", gallery_path, class: "lp-navlink" %>
      <a href="#pricing" class="lp-navlink">Pricing</a>
      <% if user_signed_in? %>
        <%= link_to "Add a video", new_app_import_request_path(lang: current_language_code), class: "lp-navlink" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, form_class: "lp-signout-form", class: "lp-signout" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "lp-navlink" %>
        <%= link_to "Start Free", new_user_registration_path(returnto: request.fullpath), class: "lp-pill" %>
      <% end %>
    </div>
  </nav>

  <!-- Hero -->
  <header class="lp-hero">
    <div>
      <h1 class="lp-h1">Practice your target language with videos you love</h1>
      <p class="lp-lead">Turn native YouTube videos you enjoy into structured listening and vocabulary practice—designed for intermediate learners.</p>

      <%= form_with url: user_signed_in? ? new_app_import_request_path : guest_import_requests_path,
                    method: user_signed_in? ? :get : :post, data: { turbo: false } do %>
        <input type="hidden" name="lang" value="<%= current_language_code %>">
        <div class="lp-paste">
          <input type="text" name="url" inputmode="url" autocomplete="off" autocapitalize="off"
                 autocorrect="off" spellcheck="false" enterkeyhint="go"
                 placeholder="Paste a YouTube video link" aria-label="YouTube video link">
          <button type="submit" class="lp-create">Create</button>
        </div>
      <% end %>

      <% unless user_signed_in? %>
        <div class="lp-note"><strong>Almost there —</strong> sign up to claim your <%= free_credits %> free credits and we'll start building this lesson.</div>
      <% end %>

      <div class="lp-meta">
        <span>⏱ Ready in ~3 minutes</span>
        <span>First <%= free_credits %> lessons free. No card required</span>
      </div>
    </div>

    <div class="lp-slideshow"
         data-controller="homepage-carousel"
         data-homepage-carousel-slides-value="<%= slides.to_json %>">
      <div class="lp-slide-frame">
        <img class="lp-slide-img"
             data-homepage-carousel-target="image"
             src="<%= slides.first[:img] %>"
             alt="<%= slides.first[:caption] %>">
      </div>
      <div class="lp-slide-nav">
        <button type="button" class="lp-arrow" aria-label="Previous"
                data-action="homepage-carousel#arrow" data-homepage-carousel-step-param="-1">←</button>
        <div class="lp-caption" data-homepage-carousel-target="caption"><%= slides.first[:caption] %></div>
        <button type="button" class="lp-arrow" aria-label="Next"
                data-action="homepage-carousel#arrow" data-homepage-carousel-step-param="1">→</button>
      </div>
      <div class="lp-dots">
        <% slides.each_with_index do |_slide, i| %>
          <button type="button" class="lp-dot" aria-label="Go to slide <%= i + 1 %>"
                  data-homepage-carousel-target="dot"
                  data-action="homepage-carousel#select" data-homepage-carousel-index-param="<%= i %>"></button>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Library -->
  <section id="library" class="lp-library"
           data-controller="homepage-filter"
           data-homepage-filter-initial-lang-value="<%= current_language_code %>">
    <div class="lp-lib-inner">
      <div class="lp-lib-head">
        <div>
          <h2 class="lp-h2">Jump right in</h2>
          <p class="lp-lib-sub">Pick any recently created Langlet and start practicing immediately.</p>
        </div>
        <% if filter_langs.size > 1 %>
          <div class="lp-filters">
            <button type="button" class="lp-chip"
                    data-homepage-filter-target="chip" data-homepage-filter-lang-param="all"
                    data-action="homepage-filter#filter">All</button>
            <% filter_langs.each do |language| %>
              <button type="button" class="lp-chip"
                      data-homepage-filter-target="chip"
                      data-homepage-filter-lang-param="<%= base_iso.call(language) %>"
                      data-action="homepage-filter#filter"><%= localized_language_name(language) %></button>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if grid_courses.any? %>
        <div class="lp-grid">
          <% grid_courses.each do |course| %>
            <% video_id = course_youtube_video_id(course) %>
            <% iso = base_iso.call(course.language) %>
            <%= link_to course_path(id: course.slug), class: "lp-card",
                  data: { "homepage-filter-target": "card", lang: iso } do %>
              <img class="lp-card-thumb" loading="lazy" alt=""
                   src="<%= youtube_thumbnail_url(video_id) %>">
              <div class="lp-card-body">
                <div class="lp-card-title" dir="<%= course.language&.rtl? ? "rtl" : "ltr" %>">
                  <%= course.localized_name.presence || t("courses.card.untitled") %>
                </div>
                <div class="lp-card-meta">
                  <span class="lp-card-dot" style="background: <%= lang_dot[iso] %>;"></span>
                  <span><%= localized_language_name(course.language) %> · <%= t("courses.lesson_count", count: course.lessons_count) %></span>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="lp-empty">No Langlets yet — paste a video above to create the first one.</p>
      <% end %>
      <div class="lp-browse-all"><%= link_to "Browse All Langlets", gallery_path %></div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="lp-pricing">
    <div class="lp-price-grid">
      <div>
        <h2 class="lp-price-h">Simple, honest pricing</h2>
        <p class="lp-price-lead">Credits pay for the AI pipeline that builds your lessons — and help keep the site running.</p>
        <div class="lp-price-list">
          <div class="lp-price-item"><span class="lp-check">✓</span><span>1 credit = 1 video turned into a full lesson</span></div>
          <div class="lp-price-item"><span class="lp-check">✓</span><span><%= free_credits %> free credits when you sign up — no card needed</span></div>
          <div class="lp-price-item"><span class="lp-check">✓</span><span>Credits never expire, browse the library free forever</span></div>
        </div>
      </div>
      <div class="lp-price-card">
        <div class="lp-price-eyebrow">CREDIT PACK</div>
        <div class="lp-price-row">
          <span class="lp-price-amount">$10</span>
          <span class="lp-price-unit">= 20 credits</span>
        </div>
        <div class="lp-price-sub">That's 20 videos of your choice, 50¢ each.</div>
        <% if user_signed_in? %>
          <% if @paypal_client.configured? %>
            <%= render layout: "paypal/form",
                       locals: {
                         paypal_client: @paypal_client,
                         pack: @homepage_credit_pack,
                         cancel_path: root_path
                       } do %>
              <button type="submit" class="lp-price-cta w-full">Buy 20 credits</button>
            <% end %>
          <% else %>
            <button type="button" class="lp-price-cta w-full opacity-60" disabled>Buy 20 credits</button>
          <% end %>
        <% else %>
          <%= link_to "Start Creating Langlets", new_user_registration_path(returnto: request.fullpath), class: "lp-price-cta" %>
        <% end %>
        <div class="lp-price-fine">One-time purchase · no subscription</div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="lp-footer">
    <div class="lp-footer-inner">
      <span>© <%= Date.current.year %> Langlets · practice languages with native content</span>
      <div class="lp-footer-links">
        <%= link_to "Privacy Policy", "/home/privacy" %>
        <%= link_to "Terms of Service", "/home/terms" %>
      </div>
    </div>
  </footer>
</div>
