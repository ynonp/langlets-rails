<%# Expects:
  params[:phrases] - An array of phrases data: [original_text, translated_text, timestamp_start, timestamp_end]
  params[:l1] - Language code for original_phrase (for example "he", "en", "es", "ar-ps")
  params[:l2] - Language code for translated_phrase (for example "he", "en", "es", "ar-ps")
  params[:video_id] - YouTube video ID
  params[:start_timestamp] - Start timestamp for the video segment
  params[:end_timestamp] - End timestamp for the video segment
  
  This activity shows one phrase in Spanish at a time at the top and 4 possible translations below.
  The user needs to select the correct translation. After selection, the next phrase appears.
  The game continues until all phrases are completed.
  When a phrase appears, the user can click the speaker icon to hear the audio from the video.
 %>

<% phrases = (params[:phrases] || []) %>
<% total_phrases = phrases.length %>
<% l1_rtl = params[:l1].rtl %>
<% l2_rtl = params[:l2].rtl %>

<div
    data-controller="match-activity"
    data-match-activity-l1-value="<%= params[:l1].iso_name %>"
    data-match-activity-total-phrases-value="<%= total_phrases %>"
    class="flex-col flex items-center bg-gray-800">
  
  <div class="w-full max-w-[640px] p-4 sm:p-6 rounded-lg shadow-lg">
    <div class="mb-1">
      <h2 class="text-xl sm:text-2xl text-white mb-2"><%= @activity.text_header || "Click On The Translation" %></h2>
      <p class="text-gray-400 text-sm sm:text-base mb-2">
        <span data-match-activity-target="progressText">Question 1 of <%= total_phrases %></span>
      </p>
      <div class="w-full bg-gray-700 rounded-full h-2.5 mt-4">
        <div data-match-activity-target="progressBar" id="progress" class="bg-green-500 h-2.5 rounded-full w-0 transition-all duration-500"></div>
      </div>
    </div>
    
    <% phrases.each_with_index do |(original, translation, timestamp_start, timestamp_end), index| %>
      <div 
        data-controller="video-player"
        data-video-player-video-id-value="<%= params[:video_id] %>"
        data-video-player-mini-player-value="true"
        data-video-player-segment-start-value="<%= timestamp_to_seconds(timestamp_start) %>"
        data-video-player-segment-end-value="<%= timestamp_to_seconds(timestamp_end) %>"
        data-match-activity-target="phraseContainer"
        data-index="<%= index %>"
        data-action="match-activity:play-video->video-player#handlePlayVideo"
        class="phraseContainer <%= index == 0 ? '' : 'hidden' %>">

        <!-- Hidden YouTube Player for this phrase -->
        <div data-video-player-target="player" class="hidden w-0 h-0 overflow-hidden"></div>

        <!-- Original phrase (Spanish) -->
        <div class="my-4 text-md md:text-xl text-white bg-gray-700 w-full text-left px-4 py-4 border border-gray-700 rounded-lg bg-gray-800 flex items-center justify-between">
          <span><%= original %></span>
          <button 
            data-action="click->match-activity#playPhraseAudio"
            data-match-activity-target="speakerButton"
            data-phrase="<%= original %>"
            data-phrase-index="<%= index %>"
            class="<%= l1_rtl ? "text-right" : "text-left" %> ml-3 p-2 text-gray-400 hover:text-white transition-colors duration-200 flex-shrink-0"
            title="Play audio">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
            </svg>
          </button>
        </div>
        
        <!-- Options section for this phrase -->
        <div class="space-y-3" data-match-activity-target="optionsContainer" data-phrase-index="<%= index %>">
          <% 
            # Create distractors - using other translations
            all_translations = phrases.map { |p| p[1] }
            # Remove the correct answer from potential distractors
            distractors = all_translations - [translation]
            # Take 3 random distractors
            distractors = distractors.sample(3)
            # Add the correct answer
            options = distractors + [translation]
            # Shuffle the options
            options = options.shuffle
          %>
          
          <% options.each do |option| %>
            <button 
              data-action="click->match-activity#selectOption"
              data-match-activity-target="optionButton"
              data-correct="<%= option == translation %>"
              class="optionButton <%= l2_rtl ? 'text-right' : 'text-left' %> w-full px-4 py-4 border border-gray-700 rounded-lg bg-gray-900 hover:bg-gray-700 text-white transition-all duration-200 text-base text-md md:text-xl">
              <%= option %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <div data-match-activity-target="feedbackMessage" class="hidden mt-4 p-3 rounded-lg text-center text-lg font-medium"></div>
    
    <div data-match-activity-target="completionMessage" class="hidden mt-8 p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-center sm:text-left text-xl font-bold text-white">Great job!</h3>
        <p class="text-center sm:text-left text-gray-300">You've completed all the phrases.</p>
      </div>
      <a href="<%= @next_activity_path %>" class="w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center">Next</a>
    </div>
  </div>  
</div>

<style>
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-5px); }
  40%, 80% { transform: translateX(5px); }
}

.animate-shake {
  animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
}

@keyframes fade-in {
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fade-in 0.5s ease-out forwards;
}

.correct-answer {
  background-color: rgba(16, 185, 129, 0.2) !important;
  border-color: rgb(16, 185, 129) !important;
}

.incorrect-answer {
  background-color: rgba(239, 68, 68, 0.2) !important;
  border-color: rgb(239, 68, 68) !important;
}
</style> 
