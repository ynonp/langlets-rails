<% content_for :head do %>
  <title><%= @playlist.name %> - Langlets</title>
  <%= render_meta_tags(
    title: "#{@playlist.name} - Langlets",
    description: playlist_description(@playlist),
    url: canonical_url(playlist_path(@playlist)),
    image_url: @playlist.cover_image_url.presence || @playlist.hero_image_url.presence
  ) %>
<% end %>

<% content_for :canonical_url, canonical_url(playlist_path(@playlist)) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/breadcrumb_list", items: [
    { name: "Home", url: canonical_url(root_path) },
    { name: @playlist.name, url: canonical_url(playlist_path(@playlist)) }
  ] %>
<% end %>

<div class="min-h-screen flex flex-col bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50">
<!-- Playlist Header -->
<header class="py-6 border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <%= link_to root_path, class: "text-emerald-600 dark:text-emerald-400 hover:opacity-80 transition-opacity", title: t("shared.home") do %>
        <%= render "shared/home_icon", size: 26 %>
      <% end %>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">
        <%= @playlist.name %>
      </h1>
    </div>

    <% if user_signed_in? %>
      <% daily_xp = ActivityLog.daily_xp_for_user(current_user) %>
      <% streak_info = ActivityLog.streak_info_for_user(current_user) %>
      <% streak = streak_info[:count] %>

      <div class="flex items-center space-x-4">
        <div class="hidden sm:flex" data-testid="header-theme-desktop">
          <%= render "shared/theme_toggle" %>
        </div>
        <!-- XP Display -->
        <div class="flex items-center space-x-6">
          <!-- Day Streak -->

          <div class="flex items-center">
            <% bg_class = streak_background_class(streak_info[:status]) %>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 font-extrabold text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
                <path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.177A7.547 7.547 0 0 1 6.648 6.61a.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248Z" clip-rule="evenodd" />
              </svg>
              <%= streak %> day<%= 's' if streak != 1 %>
            </div>
          </div>

          <!-- Today's XP -->
          <div class="hidden sm:flex items-center" data-testid="header-xp-desktop">
            <div class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-bold bg-blue-500 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <%= daily_xp %> XP
            </div>
          </div>
        </div>

        <!-- User Menu -->
        <div class="relative group"
             data-controller="profile-menu"
             data-action="click@document->profile-menu#close">
          <input type="checkbox" id="user-menu-toggle" class="hidden peer" data-profile-menu-target="toggle">
          <label for="user-menu-toggle" class="flex items-center cursor-pointer">
            <img src="<%= 'https://ui-avatars.com/api/?name=' + ERB::Util.url_encode(current_user.email) %>" alt="Avatar" class="w-10 h-10 rounded-full border-2 border-emerald-500 shadow" />
          </label>
          <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg shadow-lg opacity-0 invisible peer-checked:opacity-100 peer-checked:visible transition-all duration-150 z-50">
            <% if native_app? %>
              <% current_lang = Language.find_by(iso_name: params[:lang]) %>
              <%= link_to onboarding_language_path(returnto: request.fullpath), class: "flex items-center px-4 py-3 text-gray-900 dark:text-gray-50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-150" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2 text-emerald-600 dark:text-emerald-400">
                  <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM8.288 9.01a.75.75 0 0 1 1.042-.018 14.83 14.83 0 0 0 2.39 1.68c.826.495 1.74.845 2.674 1.029a.75.75 0 0 1-.28 1.473 16.303 16.303 0 0 1-3.248-.986 16.304 16.304 0 0 1-2.578-1.813.75.75 0 0 1 0-1.365Zm4.922 4.49a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm-5.25-2.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm"><%= t("shared.menu.learning_language", language: current_lang&.native_name || t("shared.menu.select")) %></span>
              <% end %>
              <div class="border-t border-gray-200 dark:border-gray-800 my-1"></div>
            <% end %>
            <div class="sm:hidden px-4 py-3" data-testid="header-theme-mobile-menu">
              <%= render "shared/theme_toggle" %>
            </div>
            <div class="sm:hidden px-4 pb-3" data-testid="header-xp-mobile-menu">
              <div class="flex items-center bg-blue-500 px-3 py-1 rounded-full text-sm font-semibold text-white w-fit">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                </svg>
                <%= daily_xp %> XP
              </div>
            </div>
            <div class="sm:hidden border-t border-gray-200 dark:border-gray-800 my-1"></div>
            <% current_user.languages_with_saved_words.order(:iso_name).each do |language| %>
              <%= button_to t("shared.menu.review_words", language: language.iso_name), review_lessons_path(language_code: language.iso_name),
                method: :post,
                class: "w-full text-left px-4 py-3 text-yellow-700 dark:text-yellow-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-150",
                data: { turbo: false }
              %>
            <% end %>
            <% if current_user.languages_with_saved_words.exists? %>
              <div class="border-t border-gray-200 dark:border-gray-800 my-1"></div>
            <% end %>
            <%= link_to t("shared.menu.profile"), profile_path,
              class: "block px-4 py-3 text-gray-900 dark:text-gray-50 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-150"
            %>
            <%= link_to t("shared.menu.connected_apps"), settings_connections_path,
              class: "block px-4 py-3 text-gray-900 dark:text-gray-50 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-150"
            %>
            <%= link_to t("shared.menu.logout"),
              destroy_user_session_path(returnto: request.fullpath),
              method: :delete,
              data: { turbo_method: :delete },
              class: "block px-4 py-3 text-gray-900 dark:text-gray-50 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-150"
            %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
        <span class="text-gray-500 dark:text-gray-400 text-sm sm:text-base hidden sm:block"><%= t("shared.sign_in_prompt") %></span>
        <div class="flex items-center gap-2">
          <%= render "shared/theme_toggle" %>
          <%= link_to t(".sign_up"), new_user_registration_path(returnto: request.fullpath), class: "inline-flex items-center justify-center gap-2 h-10 px-4 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm transition-colors" %>
          <%= link_to t(".log_in"), new_user_session_path(returnto: request.fullpath), class: "inline-flex items-center justify-center gap-2 h-10 px-4 rounded-2xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-extrabold text-sm transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</header>

<main class="w-full max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
      data-controller="playlist-courses"
      data-playlist-courses-playlist-id-value="<%= @playlist.id %>"
      data-playlist-courses-current-page-value="<%= @page %>"
      data-playlist-courses-has-more-value="<%= @has_more %>">

  <!-- Playlist Description -->
  <% if @playlist.description.present? %>
    <section class="mb-8">
      <p class="text-gray-500 dark:text-gray-400 text-lg"><%= @playlist.description %></p>
    </section>
  <% end %>

  <!-- Search and Filters Section -->
  <section class="mb-8">
    <!-- Search Bar -->
    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="relative flex-1 max-w-md">
        <input type="text"
               placeholder="<%= t(".search_placeholder") %>"
               class="w-full px-4 py-3 pl-12 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-50 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
               data-playlist-courses-target="searchInput"
               data-action="input->playlist-courses#search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 absolute left-4 top-4 text-gray-400 dark:text-gray-500">
          <path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd" />
        </svg>
      </div>

      <% if user_signed_in? && can?(:destroy, @playlist) %>
        <%= form_with url: playlist_path(@playlist), method: :delete, class: "shrink-0" do %>
          <button type="button" data-action="playlist-courses#openDelete"
                  class="inline-flex items-center gap-1.5 h-11 px-4 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 font-semibold text-sm transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
            </svg>
            Delete
          </button>

          <span data-playlist-courses-target="deleteOverlay"
                class="playlist-sheet-overlay hidden fixed inset-0 z-[100] flex items-end sm:items-center justify-center bg-black/60"
                role="dialog" aria-modal="true" aria-labelledby="delete-playlist-title">
            <span class="playlist-sheet block w-full max-w-md rounded-t-3xl sm:rounded-3xl bg-white dark:bg-gray-900 p-6 text-left shadow-2xl">
              <strong id="delete-playlist-title" class="block text-lg font-extrabold text-gray-900 dark:text-gray-50"><%= t(".delete_title") %></strong>
              <span class="mt-2 block text-sm text-gray-600 dark:text-gray-300"><%= t(".delete_message", name: @playlist.name) %></span>
              <span class="mt-6 flex gap-3">
                <button type="button" data-action="playlist-courses#closeDelete"
                        class="flex-1 h-11 rounded-full border border-gray-300 dark:border-gray-600 font-bold text-gray-700 dark:text-gray-200"><%= t(".cancel") %></button>
                <button type="submit"
                        class="flex-1 h-11 rounded-full bg-red-600 hover:bg-red-700 text-white font-extrabold"><%= t(".delete") %></button>
              </span>
            </span>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Loading Indicator -->
  <div class="hidden text-center py-8" data-playlist-courses-target="loadingIndicator">
    <div class="inline-flex items-center px-4 py-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg">
      <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-gray-500 dark:text-gray-400"><%= t(".loading_courses") %></span>
    </div>
  </div>

  <!-- Courses Grid -->
  <section>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8"
         data-playlist-courses-target="coursesGrid">
      <%= render 'courses', courses: @courses %>
    </div>

    <!-- Load More Button (fallback for when infinite scroll doesn't work) -->
    <% if @has_more %>
      <div class="text-center mt-8">
        <button type="button"
                class="inline-flex items-center justify-center gap-2 h-14 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors"
                data-playlist-courses-target="loadMoreButton"
                data-action="click->playlist-courses#loadMore">
          Load More Courses
        </button>
      </div>
    <% end %>
  </section>

  <!-- Infinite Scroll Trigger -->
  <div data-playlist-courses-target="infiniteScrollTrigger" class="h-1"></div>
</main>

<footer class="bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
      <div class="text-gray-500 dark:text-gray-400 text-sm">
        <%= t("shared.footer.copyright", year: Date.current.year) %>
      </div>
      <div class="flex space-x-6">
        <%= link_to t("shared.footer.privacy_policy"), "/home/privacy", class: "text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-50 text-sm transition-colors duration-200" %>
        <%= link_to t("shared.footer.terms_of_service"), "/home/terms", class: "text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-50 text-sm transition-colors duration-200" %>
      </div>
    </div>
  </div>
</footer>
</div>
