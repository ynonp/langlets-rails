<%
    phrases = params[:phrases]
    rtl = params[:rtl]
%>

<style>
  @keyframes pulse-attention {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  
  @keyframes correct-feedback {
    0% { background-color: rgb(55, 65, 81); }
    50% { background-color: rgb(34, 197, 94); }
    100% { background-color: rgb(55, 65, 81); }
  }
  
  @keyframes incorrect-feedback {
    0% { background-color: rgb(55, 65, 81); }
    50% { background-color: rgb(239, 68, 68); }
    100% { background-color: rgb(55, 65, 81); }
  }
  
  .word-option-button {
    animation: pulse-attention 1.5s infinite ease-in-out;
  }
  
  .correct-animation {
    animation: correct-feedback 0.6s ease-in-out;
  }
  
  .incorrect-animation {
    animation: incorrect-feedback 0.6s ease-in-out;
  }
</style>

<div
    class="flex-col flex items-center bg-gray-800 overflow-hidden"
    data-controller="listen-activity video-player"
    data-video-player-video-id-value="<%= params[:video_id] %>"
    data-video-player-mini-player-value="true"
    data-video-player-segment-start-value="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
    data-video-player-segment-end-value="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
    data-video-player-current-text-line-class="bg-gray-700"
    data-next-activity-path="<%= @next_activity_path %>"
    data-action="listen-activity:pause-video->video-player#handlePauseVideo listen-activity:play-video->video-player#handlePlayVideo video-player:phrase-activated->listen-activity#handlePhraseActivated"
>
  <div class="w-full max-w-[640px] p-4 sm:p-6 rounded-lg shadow-lg flex flex-col h-[calc(100vh-160px)]">
    <div class="mb-6 text-center">
      <h2 class="text-xl sm:text-2xl text-white mb-2"><%= @activity.text_header || 'Listen and click on the missing word' %></h2>
      <p class="text-sm sm:text-base text-gray-400"><%= @activity.text_subheader %></p>
    </div>
    <div class="flex items-center space-x-3">
      <button data-video-player-target="playButton" data-action="click->video-player#togglePlayback" id="audio-play-button" class="text-white bg-blue-600 p-2 rounded-full hover:bg-blue-700 transition">
        ▶
      </button>
      <div class="flex-1 h-2 bg-gray-600 rounded-full">
        <div
            data-video-player-target="progressBar" id="audio-progress-bar" class="h-full bg-blue-500 rounded-full transition-all duration-100" style="width: 0%"></div>
      </div>
    </div>
    <!-- Hidden YouTube Player -->
    <div data-video-player-target="player" id="hidden-player" class="hidden w-0 h-0 overflow-hidden"></div>

    <!-- Completion Message (Initially Hidden) -->
    <div class="my-4 p-4 bg-gray-700 border border-gray-600 rounded-lg text-center flex flex-col sm:flex-row items-center justify-between gap-4 hidden" data-listen-activity-target="completion">
      <div>
        <h3 class="text-center sm:text-left text-xl font-bold text-white">Great job!</h3>
        <p class="text-center sm:text-left text-gray-300">You've completed all the listening exercises.</p>
      </div>
      <a
        href="<%= @next_activity_path %>"
        data-turbo-frame="_top"
        class="w-full sm:w-auto px-6 py-3 sm:py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-200 text-center">
          Next
      </a>
    </div>    

    <!-- Control Bar -->
    <div class="my-4 flex justify-between items-center">
      <label class="flex items-center text-white">
        <input type="checkbox" data-listen-activity-target="showTranslation" data-action="change->listen-activity#toggleTranslation" class="mr-2">
        Show Translation
      </label>
    </div>

    <!-- Phrases Container with scrolling -->
    <div
        id="phrases-container"
        data-video-player-target="container"
        data-listen-activity-target="phrasesContainer"
        class="w-full mx-auto bg-gray-800 flex-1 overflow-y-auto"
        dir="<%= rtl ? 'rtl' : 'ltr' %>"
        >
      <div
        id="phrases-list" 
        data-video-player-target="phrasesList"
        class="text-white text-sm sm:text-base pb-14 ">
        <% phrases.each_with_index do |phrase, phrase_index| %>
          <div
            data-video-player-target="subtitles"
            data-listen-activity-target="phrase"
            data-timestamp="<%= timestamp_to_seconds(phrase['timestamp']) %>"
            data-phrase-id="<%= phrase_index %>"
            class="px-4 py-3 transition-all duration-200">
            <div class="text-white text-md md:text-xl">
              <%= render_phrase_with_blanks(phrase) %>
            </div>
            <div class="text-teal-400 mt-1 text-md md:text-xl hidden" data-listen-activity-target="translation">
              <%= phrase['text_l2'] %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Word Selection Area -->
    <div class="my-6 flex justify-center space-x-4" data-listen-activity-target="wordSelection">
      <% 
        first_phrase_with_tokens = phrases.find { |p| p['token_translations'].present? && p['token_translations'].any? }
        if first_phrase_with_tokens
          first_token = first_phrase_with_tokens['token_translations'].first
          words = []
          
          if first_token
            correct_word = first_token['original_text']
            similar_word = first_token['similar_sound']
            
            if correct_word.present? && similar_word.present?
              words = [{word: correct_word, correct: true}, {word: similar_word, correct: false}].shuffle
            elsif correct_word.present?
              words = [{word: correct_word, correct: true}, {word: "alternative", correct: false}].shuffle
            end
          end
          
          words.each do |word_data| 
      %>
            <button 
              data-listen-activity-target="wordOption" 
              data-word="<%= word_data[:word] %>" 
              data-correct="<%= word_data[:correct] %>"
              data-action="click->listen-activity#selectWord"
              class="px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white font-medium rounded-lg transition-colors duration-200 text-center word-option-button">
              <%= word_data[:word] %>
            </button>
      <%  end
        end 
      %>
    </div>

  </div>
</div>
