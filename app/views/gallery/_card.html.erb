<% if entry.is_a?(Course) %>
  <%= link_to course_path(entry), class: "gallery-card" do %>
    <img src="<%= course_thumbnail_url(entry) %>"
         alt="<%= entry.localized_name %>" class="gallery-card-image">
    <div class="gallery-card-body">
      <span class="gallery-card-kind"><%= t("supplemental.course") %></span>
      <h2 class="app-clamp-2"><%= entry.localized_name %></h2>
      <p><%= localized_language_name(entry.language) %> · <%= t("courses.lesson_count", count: entry.lessons_count) %></p>
    </div>
  <% end %>
<% else %>
  <%= link_to playlist_path(entry), class: "gallery-card" do %>
    <% if entry.cover_image_url.present? %>
      <img src="<%= entry.cover_image_url %>" alt="<%= entry.name %>" class="gallery-card-image">
    <% else %>
      <div class="gallery-card-image gallery-card-placeholder"></div>
    <% end %>
    <div class="gallery-card-body">
      <span class="gallery-card-kind gallery-card-kind-playlist"><%= t("supplemental.playlist") %></span>
      <h2><%= entry.name %></h2>
      <p><%= t("supplemental.langlet_count", count: entry.visible_clip_count) %></p>
    </div>
  <% end %>
<% end %>
