<%
    phrases = params[:phrases]
    l1_rtl = params[:l1_rtl]
    l2_rtl = params[:l2_rtl]

    timestamp_start = params[:start_timestamp]
    timestamp_end = params[:end_timestamp]

    wv_prefs = current_user ? current_user.watch_video_preferences : User::WATCH_VIDEO_DEFAULTS
%>

<%= content_for :head do %>

<% end %>

<div
    class="contents"
    data-controller="watch-video-activity"
    data-main-video-player-target="videoListener videoSegment"
    data-action="
      video:play->main-video-player#fullPlayerStartPlayback
      video:stop->main-video-player#fullPlayerStopPlayback
      video:play->watch-video-activity#handleVideoStart
      video:end->watch-video-activity#handleVideoEnd
      video:stop->watch-video-activity#handleVideoPause
      video:progress->watch-video-activity#progress
    "
    data-show-player="true"
    data-segment-start="<%= timestamp_to_seconds(params[:start_timestamp]) %>"
    data-segment-end="<%= timestamp_to_seconds(params[:end_timestamp]) %>"
    data-watch-video-activity-current-text-line-class="line-active"
    data-watch-video-activity-word-timing-value="<%= params[:word_timing] ? true : false %>"
    data-watch-video-activity-prefs-url-value="<%= watch_video_preferences_path %>"
>
  <div class="contents">
    <!-- Header: title + translation toggle -->
    <div class="order-4 flex items-center justify-between px-5 pt-3 pb-2">
      <div class="font-mono text-xs font-extrabold uppercase tracking-wide text-emerald-600 dark:text-emerald-400"><%= t(".tap_any_word") %></div>
      <div class="flex items-center gap-4">
        <% if params[:word_timing] %>
          <label class="inline-flex items-center gap-2 text-xs font-bold text-gray-500 dark:text-gray-400 cursor-pointer">
            <input type="checkbox" <%= "checked" if wv_prefs["karaoke"] %>
              data-watch-video-activity-target="showKaraoke"
              data-action="change->watch-video-activity#toggleKaraoke">
            <%= t(".karaoke") %>
          </label>
        <% end %>
        <label class="inline-flex items-center gap-2 text-xs font-bold text-gray-500 dark:text-gray-400 cursor-pointer">
          <input type="checkbox" <%= "checked" if wv_prefs["translation"] %>
            data-watch-video-activity-target="showTranslation"
            data-action="change->watch-video-activity#toggleTranslation">
          <%= t(".translation") %>
        </label>
      </div>
    </div>

    <% if @activity.text_header.present? %>
      <div class="order-4 px-5 pb-2">
        <h2 class="text-lg font-extrabold tracking-tight"><%= @activity.text_header %></h2>
        <% if @activity.text_subheader.present? %>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mt-0.5"><%= @activity.text_subheader %></p>
        <% end %>
      </div>
    <% end %>

    <!-- Phrases breakdown -->
    <div
        data-controller="popover-translation"
        data-popover-translation-saved-ids-value="<%= current_user ? current_user.saved_phrase_tokens.pluck(:id).to_json : '[]' %>"
        id="phrases-container"
        data-watch-video-activity-target="container"
        data-action="click->popover-translation#showPopup scroll->popover-translation#hidePopup:passive click@document->popover-translation#hidePopup scroll@document->popover-translation#hidePopup"
        class="order-4 flex-1 overflow-y-auto flex flex-col gap-4 px-5"
        style="padding-bottom: calc(16px + env(safe-area-inset-bottom));"
        >
      <div id="phrases-list" data-watch-video-activity-target="phrasesList"
           data-action="click->main-video-player#seekToTimestamp">
        <% phrases.each do |phrase| %>
          <div
            data-watch-video-activity-target="subtitles"
            data-timestamp="<%= timestamp_to_seconds(phrase.timestamp) %>"
            class="phrase block cursor-pointer rounded-2xl px-3.5 py-3 hover:bg-gray-100 dark:hover:bg-gray-800"
          >
            <div class="text-xl font-extrabold leading-relaxed" dir="<%= l1_rtl ? 'rtl' : 'ltr' %>">
              <%= wrap_tokens_in_spans(phrase, { class: "token cursor-pointer rounded px-0.5 border-b-[2.5px] border-dotted border-gray-400 dark:border-gray-600 hover:bg-emerald-100 dark:hover:bg-emerald-900/40" }) %>
            </div>
            <div class="mt-1 text-base italic text-gray-500 dark:text-gray-400 <%= 'hidden' unless wv_prefs["translation"] %>" data-watch-video-activity-target="translation" dir="<%= l2_rtl ? 'rtl' : 'ltr' %>">
              <%= phrase.text_l2 %>
            </div>
          </div>
        <% end %>
      </div>
      <!-- Translation Popup -->
      <%= render partial: 'activities/translation_popup', locals: { popup_class: "hidden absolute z-40 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 border border-gray-200 dark:border-gray-700 rounded-2xl p-3 shadow-md min-w-[180px]", l1_rtl: l1_rtl } %>
    </div>

    <!-- Start practice -->
    <div class="order-4 px-5 flex-shrink-0 pt-3 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700" style="padding-bottom: calc(20px + env(safe-area-inset-bottom));">
      <a href="<%= @next_activity_path %>"
         data-watch-video-activity-target="startPracticeButton"
         class="w-full inline-flex items-center justify-center gap-2 h-16 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-base tracking-wide transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24"><path d="M13 2L4 14h6l-1 8 9-12h-6z" fill="#fff"/></svg>
        <%= t(".start_practice") %>
      </a>
    </div>
  </div>
</div>

<style>
/* the subtitle line currently playing (set by watch-video-activity controller) */
[data-controller="watch-video-activity"] .line-active {
  background: var(--color-emerald-100) !important;
}
[data-theme="dark"] [data-controller="watch-video-activity"] .line-active {
  background: color-mix(in oklab, var(--color-emerald-900) 40%, transparent) !important;
}

/* karaoke: the word currently being sung (set by watch-video-activity controller) */
[data-controller="watch-video-activity"] .s-token-active {
  background: var(--color-emerald-500);
  color: #fff;
  border-radius: 6px;
}
</style>
