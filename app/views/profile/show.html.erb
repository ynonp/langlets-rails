<% content_for :head do %>
  <title><%= t("channels.profile.page_title") %></title>
<% end %>

<div class="min-h-screen bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50">
  <div class="profile-safe-area max-w-3xl mx-auto py-8">
    <div class="flex items-center gap-3 mb-2">
      <%= link_to root_path, class: "text-emerald-600 dark:text-emerald-400" do %>
        <%= render "shared/home_icon", size: 26 %>
      <% end %>
      <h1 class="text-2xl sm:text-3xl font-bold"><%= t("shared.menu.profile") %></h1>
    </div>
    <p class="font-semibold text-[15.5px] mb-8 text-gray-500 dark:text-gray-400">
      <%= current_user.email %>
    </p>

    <% if notice.present? %>
      <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md mb-6 px-4 py-3.5 text-emerald-600 dark:text-emerald-400">
        <%= notice %>
      </div>
    <% end %>

    <%# --------------------------------------------------------- Account %>
    <%# Native only — Pro is bought in the iOS app, so there is nothing to
        upgrade to from the web profile page. %>
    <% if native_app? %>
      <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
        <div class="flex items-center justify-between gap-4 mb-1.5">
          <h2 class="text-lg font-extrabold tracking-tight"><%= t("profile.account.heading") %></h2>
          <span class="shrink-0 text-xs font-extrabold rounded-md px-2 py-1 <%= current_user.pro? ? "bg-emerald-600 text-white" : "bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400" %>">
            <%= current_user.pro? ? t("profile.account.type_pro") : t("profile.account.type_free") %>
          </span>
        </div>

        <% if current_user.pro? %>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400"><%= t("profile.account.pro_description") %></p>
        <% else %>
          <%= link_to t("profile.account.upgrade_cta"), app_pro_path,
                class: "mt-1 w-full inline-flex items-center justify-center h-12 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-extrabold text-center" %>
        <% end %>
      </div>
    <% end %>

    <%# ---------------------------------------------------------------- XP %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
      <div class="flex items-baseline justify-between mb-1.5">
        <h2 class="text-lg font-extrabold tracking-tight"><%= t("profile.xp.heading") %></h2>
        <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">
          <%= t("profile.xp.all_time", count: number_with_delimiter(@total_xp)) %>
        </p>
      </div>
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-5">
        <% if @streak[:count].positive? %>
          <%# Two whole sentences rather than a suffix: where the "not today
              yet" clause goes is the translator's call. %>
          <%= t(@streak[:completed_today] ? "profile.xp.streak" : "profile.xp.streak_pending", count: @streak[:count]) %>
        <% else %>
          <%= t("profile.xp.no_streak") %>
        <% end %>
      </p>

      <% max_xp = [@xp_series.map { |day| day[:xp] }.max.to_i, 1].max %>
      <div class="flex items-end justify-between gap-2 sm:gap-3 h-44"
           role="img"
           aria-label="<%= @xp_series.map { |day| t("profile.xp.day_xp", day: l(day[:date], format: "%A"), xp: day[:xp]) }.join(', ') %>">
        <% @xp_series.each do |day| %>
          <% is_today = day[:date] == Time.zone.now.to_date %>
          <div class="flex-1 flex flex-col items-center justify-end h-full gap-2">
            <span class="text-xs font-extrabold <%= day[:xp].positive? ? 'text-gray-900 dark:text-gray-50' : 'text-gray-300 dark:text-gray-700' %>">
              <%= day[:xp] %>
            </span>

            <%# Full-height track so the bars share a common baseline. %>
            <div class="w-full flex-1 flex items-end rounded-lg bg-gray-100 dark:bg-gray-800/60 overflow-hidden">
              <div class="w-full rounded-lg transition-all <%= is_today ? 'bg-emerald-500' : 'bg-emerald-500/45' %>"
                   style="height: <%= day[:xp].positive? ? [(day[:xp] / max_xp.to_f * 100).round, 4].max : 0 %>%">
              </div>
            </div>

            <span class="text-xs font-bold <%= is_today ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400' %>">
              <%= day[:date].strftime("%a") %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <%# ----------------------------------------------------- Notifications %>
    <%# Which channels this account wants. Everything the app tells the user is
        recorded on /notifications regardless of what is chosen here, which is
        what makes turning a channel off safe to offer. %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
      <div class="flex items-baseline justify-between gap-4 mb-1.5">
        <h2 class="text-lg font-extrabold tracking-tight"><%= t("notifications.preferences.heading") %></h2>
        <%= link_to t("notifications.title"), notifications_path,
                    class: "text-sm font-bold text-emerald-600 dark:text-emerald-400 whitespace-nowrap" %>
      </div>
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-4">
        <%= t("notifications.preferences.description") %>
      </p>

      <%= form_with url: profile_notifications_path, method: :patch, scope: :user, class: "flex flex-col sm:flex-row gap-3" do |form| %>
        <fieldset class="flex-1">
          <legend class="sr-only"><%= t("notifications.preferences.label") %></legend>
          <%# What makes "neither channel" submittable: with every box unchecked
              the browser sends nothing under this name, and the preference would
              silently keep the value the user just turned off. %>
          <%= hidden_field_tag "user[notification_delivery][]", "", id: nil %>
          <div class="flex flex-col sm:flex-row gap-3">
            <% User::NOTIFICATION_DELIVERIES.each do |channel| %>
              <label class="flex-1 flex items-center gap-3 px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-2xl bg-white dark:bg-gray-900 font-semibold cursor-pointer">
                <%= check_box_tag "user[notification_delivery][]", channel,
                      current_user.notification_delivery.include?(channel),
                      id: "user_notification_delivery_#{channel}",
                      class: "w-5 h-5 accent-emerald-600" %>
                <%= t("notifications.preferences.#{channel}") %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <%= form.submit t("channels.actions.save"), class: "self-start sm:self-auto px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold cursor-pointer" %>
      <% end %>
    </div>

    <%# The iOS permission state itself. Separate from the preference above:
        this one is about this installation, and only iOS can answer it. %>
    <% if native_app? %>
      <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6"
           data-controller="bridge--notification-preference"
           data-bridge--notification-preference-endpoint-value="<%= app_device_tokens_path %>">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-extrabold tracking-tight mb-1.5"><%= t("profile.push.heading") %></h2>
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400"
               data-bridge--notification-preference-target="status">
              <%= t("profile.push.description") %>
            </p>
          </div>

          <button type="button"
                  data-bridge--notification-preference-target="button"
                  data-action="bridge--notification-preference#enable"
                  class="shrink-0 inline-flex items-center justify-center h-11 px-5 rounded-xl text-white text-sm font-extrabold whitespace-nowrap bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50">
            <%= t("profile.push.enable") %>
          </button>

          <label style="display: none"
                 class="shrink-0 relative inline-flex items-center cursor-pointer"
                 data-bridge--notification-preference-target="switch">
            <input type="checkbox"
                   role="switch"
                   aria-label="<%= t("profile.push.switch_label") %>"
                   data-bridge--notification-preference-target="switchInput"
                   data-action="change->bridge--notification-preference#toggle"
                   class="sr-only peer">
            <span class="w-12 h-7 rounded-full bg-gray-300 dark:bg-gray-700 peer-checked:bg-emerald-600 transition-colors
                         after:content-[''] after:absolute after:top-1 after:left-1 after:w-5 after:h-5 after:rounded-full
                         after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-5"></span>
          </label>
        </div>
      </div>
    <% end %>

    <%# ------------------------------------------------------------- Theme %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5 mb-6">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-extrabold tracking-tight mb-1.5"><%= t("profile.theme.heading") %></h2>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">
            <%= t("profile.theme.description", theme: t("profile.theme.#{current_theme}")) %>
          </p>
        </div>
        <%= render "shared/theme_toggle" %>
      </div>
    </div>

    <%# Nothing on this page is unsaved — language and theme both apply on the
        spot — so this is a way out, not a save. Deliberately outside a card:
        it's a page-level action, not another setting. %>
    <%= link_to t("profile.continue"), root_path,
          data: { turbo_action: "replace" },
          class: "w-full inline-flex items-center justify-center gap-2 h-14 mb-6 rounded-2xl text-white font-extrabold transition-colors bg-emerald-600 hover:bg-emerald-700" %>

    <%# ---------------------------------------------------- Delete account %>
    <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md p-5">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-extrabold tracking-tight mb-1.5"><%= t("profile.delete.heading") %></h2>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">
            <%= t("profile.delete.description") %>
          </p>
        </div>
        <%= button_to t("profile.delete.button"), registration_path(:user), method: :delete,
              data: { turbo_confirm: t("profile.delete.confirm") },
              class: "inline-flex items-center justify-center h-11 px-5 rounded-xl text-white text-sm font-extrabold whitespace-nowrap transition-colors bg-red-600 hover:bg-red-700 cursor-pointer",
              form: { class: "shrink-0" } %>
      </div>
    </div>
  </div>
</div>
