<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50">
    <main class="flex flex-col min-h-screen"
          data-controller="audio-cache"
          data-action="click->audio-cache#handleClick:capture audio-cache:play->audio-cache#playEvent audio-cache:preload->audio-cache#preloadEvent audio-cache:stop->audio-cache#stop">
      <%= yield %>
    </main>

    <%= yield :structured_data %>
    <% unless content_for?(:structured_data) %>
      <%= render "shared/structured_data/website" %>
    <% end %>

    <% if params[:signed_out].present? %>
      <div data-controller="bridge--sign-out" hidden></div>
    <% end %>
  </body>
</html>
