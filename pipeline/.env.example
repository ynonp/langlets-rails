# Copy to .env (gitignored) for local runs; on Deno Deploy set these in the
# dashboard instead. Real environment variables take precedence over this file.

# Shared secret signing traffic in both directions (Rails must use the same).
PIPELINE_HMAC_SECRET=devsecret

# extract_lyrics: lyrics text (Gemini) + word alignment (ElevenLabs)
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVEN_LABS_KEY=

# All other LLM steps (Ollama cloud)
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1

# Full LLM outputs are printed to the console (on by default; 0 to silence).
# PIPELINE_LOG_LLM=0
