<% content_for :head do %>
  <% thumb_url = course_thumbnail_url(@course) %>

  <title><%= @course.localized_name %> - Langlets</title>
  <meta name="turbo-cache-control" content="no-cache">
  <%= render_meta_tags(
    title: "#{@course.localized_name} - Langlets",
    description: course_description(@course),
    url: canonical_url(course_path(@course)),
    image_url: thumb_url
  ) %>
  <%= hreflang_tags_for_course(@course) %>
<% end %>

<% content_for :canonical_url, canonical_url(course_path(@course)) %>

<% content_for :structured_data do %>
  <%= render "shared/structured_data/breadcrumb_list", items: [
    { name: "Home", url: canonical_url(root_path) },
    { name: @course.localized_name, url: canonical_url(course_path(@course)) }
  ] %>
  <%= render "shared/structured_data/course", course: @course, description: course_description(@course), course_url: canonical_url(course_path(@course)) %>
  <% if (embed_url = video_embed_url(@course)) %>
    <%= render "shared/structured_data/video_object",
        name: @course.localized_name,
        description: course_description(@course),
        thumbnail_url: course_thumbnail_url(@course),
        embed_url: embed_url,
        content_url: @course.main_media_url,
        upload_date: @course.created_at.iso8601 %>
  <% end %>
<% end %>

<%
  course_rtl = @course.language&.rtl || false
  preview_embed_url = video_embed_url(@course)
  streak = user_signed_in? ? @streak_info[:count] : 0
%>

<div class="min-h-screen flex flex-col bg-emerald-50 dark:bg-gray-950 text-gray-900 dark:text-gray-50 mx-auto w-full max-w-[480px]">
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Header: back + streak + avatar -->
    <header class="flex items-center justify-between px-5 mt-3.5 mb-4">
      <%= link_to root_path, class: "hover:opacity-80 transition-opacity text-emerald-600 dark:text-emerald-400", title: t("shared.home") do %>
        <%= render "shared/home_icon", size: 24 %>
      <% end %>

      <div class="flex items-center gap-2.5">
        <%= render "shared/theme_toggle" %>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 font-extrabold text-sm">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
            <path d="M12 2c1 3 4 4.5 4 8a4 4 0 0 1-8 0c0-1 .3-1.8.8-2.5C8 8.8 7 10.3 7 12.5a5 5 0 0 0 10 0c0-4.2-3-6.5-5-10.5z" fill="oklch(0.68 0.2 40)"/>
            <path d="M12 9c.7 1.3 2 2 2 3.6a2 2 0 0 1-4 0c0-1 .6-1.8 2-3.6z" fill="oklch(0.82 0.15 70)"/>
          </svg>
          <span><%= streak %></span>
        </div>

        <% if user_signed_in? %>
          <%= render "shared/user_menu",
            avatar_type: :initial,
            logout_data: { turbo_method: :delete, controller: "auth", action: "click->auth#signOut" } %>
        <% else %>
          <%= link_to t(".sign_up"), new_user_registration_path(returnto: request.fullpath), class: "inline-flex items-center justify-center gap-2 h-10 px-4 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm transition-colors" %>
        <% end %>
      </div>
    </header>

      <!-- Scrollable content -->
      <div class="flex-1 overflow-y-auto flex flex-col gap-4 px-5 pb-2">

        <% if notice %>
          <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md px-4 py-3 text-emerald-600 dark:text-emerald-400"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl shadow-md px-4 py-3 text-red-600 dark:text-red-400"><%= alert %></div>
        <% end %>

        <!-- Hero: title + video -->
        <%# Any signed-in user can add a course to their own playlists; admins manage the system playlists here too. %>
        <% can_add_to_playlists = user_signed_in? %>
        <div class="relative bg-white dark:bg-gray-900 dark:border dark:border-gray-800 rounded-3xl p-5 shadow-md"<%= raw(can_add_to_playlists ? " data-controller=\"course-paths\" data-course-paths-course-id-value=\"#{@course.slug}\"" : "") %>>
          <% if can_add_to_playlists %>
            <button type="button"
                    data-action="course-paths#open"
                    aria-label="Add to playlists"
                    class="absolute top-4 right-4 z-10 w-9 h-9 inline-flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-gray-700 transition-colors shadow-sm">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            </button>
            <%= render "courses/add_to_paths_modal", course: @course %>
          <% end %>
          <div class="flex items-center gap-1.5 mb-2 pr-10">
            <% if @course.language %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md font-mono font-extrabold text-[11px] tracking-wide text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/40"><%= lang_badge_code(@course.language) %></span>
            <% end %>
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400"><%= t("courses.lesson_count", count: @lessons.size) %></span>
          </div>
          <h1 class="text-2xl font-extrabold tracking-tight mb-3.5" dir="<%= course_rtl ? 'rtl' : 'ltr' %>"><%= @course.localized_name %></h1>

          <% if preview_embed_url.present? %>
            <%# TikTok is shot vertically, so the box follows the provider. %>
            <div class="rounded-2xl overflow-hidden bg-gray-100 dark:bg-gray-800 mb-3.5 mx-auto <%= 'max-w-[280px]' if @course.tiktok? %>" style="aspect-ratio: <%= video_aspect_ratio(@course) %>;">
              <iframe class="w-full h-full block border-0" src="<%= preview_embed_url %>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          <% end %>

          <div class="flex gap-2.5">
            <% if @course.show_full_course_player %>
              <%= link_to course_full_player_path(@course.slug), class: "flex-1 inline-flex items-center justify-center gap-2 h-14 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold transition-colors" do %>
                <svg width="18" height="18" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg>
                <%= t(".watch_full_video") %>
              <% end %>
            <% end %>
            <% if user_signed_in? %>
              <%= render "courses/mark_done_button", course: @course, all_done: @all_done %>
            <% end %>
          </div>
        </div>

        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 -mt-1.5">
          <%= t(".intro") %>
        </p>

        <!-- Lessons -->
        <div class="pb-1.5">
          <div class="flex items-baseline justify-between mb-2.5">
            <h2 class="text-lg font-extrabold tracking-tight"><%= t(".lessons") %></h2>
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400" id="lessons-done-count"><%= t(".done", current: @lessons.count(&:completed?), total: @lessons.size) %></span>
          </div>

          <div class="flex flex-col gap-2" data-controller="scroll-into-view" data-action="turbo:load@document->scroll-into-view#handleTurboLoad">
            <% @lessons.each_with_index do |lesson, index| %>
              <%= render "courses/lesson_row",
                    lesson: lesson,
                    course: @course,
                    index: index,
                    is_first_incomplete: (lesson.id == @first_incomplete_lesson_id) %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="border-t mt-auto bg-white dark:bg-gray-900 border-gray-200 dark:border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
          <div class="text-xs font-semibold text-gray-500 dark:text-gray-400">
            <%= t("shared.footer.copyright", year: Date.current.year) %>
          </div>
          <div class="flex space-x-6">
            <%= link_to t("shared.footer.privacy_policy"), "/home/privacy", class: "text-xs font-semibold text-gray-500 dark:text-gray-400 hover:opacity-70" %>
            <%= link_to t("shared.footer.terms_of_service"), "/home/terms", class: "text-xs font-semibold text-gray-500 dark:text-gray-400 hover:opacity-70" %>
          </div>
        </div>
      </div>
    </footer>
</div>
