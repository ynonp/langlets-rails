<div class="sprout" style="--hue: 150;">
  <div class="min-h-screen w-full flex items-center justify-center relative" style="background: var(--bg); min-height: 100dvh;">
    <!-- Close button -->
    <% close_path = params[:returnto].presence || root_path %>
    <%= link_to close_path, class: "s-ctl absolute", style: "top: 24px; left: 16px; box-shadow: none;" do %>
      <svg class="w-6 h-6" fill="none" stroke="var(--muted)" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    <% end %>

    <!-- Sign up link -->
    <div class="absolute" style="top: 30px; right: 18px;">
      <% signup_params = params[:returnto].present? ? { returnto: params[:returnto] } : {} %>
      <%= link_to "SIGN UP", new_user_registration_path(signup_params), class: "font-bold tracking-wide", style: "color: var(--accent);" %>
    </div>

    <!-- Login form container -->
    <div class="w-full max-w-md px-6">
      <div class="text-center mb-8">
        <h1 class="s-h1" style="font-size: 30px;">Log in</h1>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <% if params[:returnto].present? %>
          <%= hidden_field_tag :returnto, params[:returnto] %>
        <% end %>

        <div>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email or username", class: "s-input" %>
        </div>

        <div class="relative">
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "s-input", style: "padding-right: 90px;" %>
          <div class="absolute" style="right: 16px; top: 50%; transform: translateY(-50%);">
            <% forgot_params = params[:returnto].present? ? { returnto: params[:returnto] } : {} %>
            <%= link_to "FORGOT?", new_password_path(resource_name, forgot_params), class: "text-sm font-bold tracking-wide", style: "color: var(--faint);" %>
          </div>
        </div>

        <div>
          <%= f.submit "LOG IN", class: "s-btn s-btn--full s-btn--lg" %>
        </div>

        <div class="s-divider">OR</div>
      <% end %>

      <div class="grid grid-cols-2 gap-4 mt-5">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
          method: :post,
          form: { class: "w-full", data: { turbo: false, controller: "bridge--google-auth", action: "submit->bridge--google-auth#authorize" } },
          class: "s-social" do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24" style="color: var(--text);">
            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          GOOGLE
        <% end %>

        <%= button_to user_github_omniauth_authorize_path,
          method: :post,
          form: { class: "w-full", data: { turbo: false, controller: "bridge--auth-bridge", action: "submit->bridge--auth-bridge#startOAuth", bridge__auth_bridge_provider_value: "github" } },
          class: "s-social" do %>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" style="color: var(--text);">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GITHUB
        <% end %>
      </div>

      <!-- Terms and Privacy -->
      <div class="mt-8 text-center">
        <p class="s-small">
          By signing in to Langlets, you agree to our
          <a href="#" style="color: var(--text); font-weight: 700;">Terms</a> and
          <a href="#" style="color: var(--text); font-weight: 700;">Privacy Policy</a>
        </p>
      </div>
    </div>
  </div>
</div>
